import { ScrollView } from "std-widgets.slint";
import { Field, Role, TextButton } from "controls.slint";
import { Tok } from "tokens.slint";

export struct GitWorktreeRow {
    path: string,
    branch: string,
    current: bool,
    status: string,
}

export component GitWorktreesView inherits Rectangle {
    in property <string> repository;
    in property <[GitWorktreeRow]> rows;
    in property <string> note;
    in property <string> busy-text;
    in property <bool> has-head;
    in property <int> focus-generation;
    in-out property <int> selected: -1;
    in-out property <string> parent-folder;
    in-out property <string> folder-name;
    in-out property <string> branch-name;
    callback action(string);
    pure callback allowed(string) -> bool;
    pure callback action-title(string) -> string;
    callback browse();
    callback shortcut(string, bool, bool, bool) -> bool;

    background: Tok.paper;
    changed focus-generation => { keys.focus(); }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.action("git.worktree-back");
                return accept;
            }
            if event.text == Key.Return && root.allowed("git.worktree-open") {
                root.action("git.worktree-open");
                return accept;
            }
            if root.rows.length > 0 && (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.selected = clamp(root.selected + (event.text == Key.UpArrow ? -1 : 1), 0, root.rows.length - 1);
                return accept;
            }
            return root.shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) ? accept : reject;
        }
    }

    VerticalLayout {
        Rectangle {
            height: 62px;
            background: Tok.chrome;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        title: root.action-title("git.worktree-back");
                        enabled: root.allowed("git.worktree-back");
                        clicked => { root.action("git.worktree-back"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 3px;
                    Text { text: @tr("Worktrees"); font-size: 16px; font-weight: 650; color: Tok.ink-strong; }
                    Text { text: root.repository; font-size: 12px; color: Tok.ink-muted; overflow: elide; }
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        title: root.action-title("git.worktree-open");
                        enabled: root.allowed("git.worktree-open");
                        role: Role.primary;
                        clicked => { root.action("git.worktree-open"); }
                    }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px;
                spacing: 8px;
                if root.note != "": Text { text: root.note; color: Tok.ink-muted; wrap: word-wrap; }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    VerticalLayout {
                        width: parent.visible-width;
                        alignment: start;
                        spacing: 4px;
                        for row[index] in root.rows: Rectangle {
                            height: 56px;
                            border-radius: 5px;
                            background: root.selected == index ? Tok.accent-soft : (hit.has-hover ? Tok.chrome : transparent);
                            VerticalLayout {
                                padding: 8px;
                                spacing: 3px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: row.branch;
                                        font-weight: 650;
                                        color: Tok.ink-strong;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if row.current: Text { text: @tr("Current Worktree"); color: Tok.accent; }
                                    if row.status != "": Text { text: row.status; color: Tok.ink-muted; }
                                }
                                Text { text: row.path; color: Tok.ink-muted; font-size: 12px; overflow: elide; }
                            }
                            hit := TouchArea {
                                clicked => { root.selected = index; keys.focus(); }
                                double-clicked => {
                                    root.selected = index;
                                    if root.allowed("git.worktree-open") { root.action("git.worktree-open"); }
                                }
                            }
                        }
                    }
                }
                if root.selected >= 0: Text {
                    text: root.rows[root.selected].path;
                    wrap: char-wrap;
                    color: Tok.ink-muted;
                    font-size: 12px;
                }
            }
            Rectangle { width: 1px; background: Tok.rule; }
            Rectangle {
                width: min(360px, root.width * 0.45);
                background: Tok.chrome;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: @tr("New Worktree");
                        color: Tok.ink-strong;
                        font-size: 15px;
                        font-weight: 650;
                    }
                    Text {
                        text: root.has-head ? @tr("Create a new branch from the current commit.")
                            : @tr("A commit is required to create a worktree.");
                        color: Tok.ink-muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.parent-folder == "" ? @tr("Select the parent folder") : root.parent-folder;
                            horizontal-stretch: 1;
                            color: Tok.ink;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        TextButton {
                            title: @tr("Browse…");
                            clicked => { root.browse(); }
                        }
                    }
                    Field {
                        height: 30px;
                        placeholder: @tr("New folder name");
                        text <=> root.folder-name;
                        shortcut(event) => { return root.shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) ? accept : reject; }
                    }
                    Field {
                        height: 30px;
                        placeholder: @tr("New branch name");
                        text <=> root.branch-name;
                        shortcut(event) => { return root.shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) ? accept : reject; }
                    }
                    TextButton {
                        title: root.action-title("git.worktree-create");
                        enabled: root.allowed("git.worktree-create");
                        clicked => { root.action("git.worktree-create"); }
                    }
                    if root.busy-text != "": Text { text: root.busy-text; color: Tok.ink-muted; wrap: word-wrap; }
                    Text {
                        text: @tr("To add a worktree to this Workspace, select it in the list and open it.");
                        color: Tok.ink-muted;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
