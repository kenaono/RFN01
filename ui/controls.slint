// The small pieces the chrome is built from.
//
// The window used to be made of `Button`s carrying Japanese labels, which is
// why the toolbar needed 44px and two rows: a label is as wide as its longest
// word. Icons are all one size, so the row that holds them is as short as the
// icon, and what each one does is said by a tooltip instead of by the button.
//
// Icons are `Path`s rather than images. An image would have to be a file on
// disk and could not take its colour from `Tok`, so a button could not tint its
// icon when it is hovered or switched on; a path can, and the whole set stays
// in one place — `Icons` below — where it can be read.

import { Tok } from "tokens.slint";

// The path data for every icon the window draws, in a 16×16 box.
//
// SVG path syntax, which is what `Path.commands` speaks. They are stroked, not
// filled, so each one is a line drawing and the stroke colour is the tint.
export global Icons {
    out property <string> menu: "M2.5 4.5h11M2.5 8h11M2.5 11.5h11";
    out property <string> sidebar: "M3 2.5h10a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5h-10a1.5 1.5 0 0 1-1.5-1.5v-8a1.5 1.5 0 0 1 1.5-1.5z M6 2.5v11";
    // Three dots. Each is a segment a fifth of a pixel long, which a round cap
    // turns into a dot the width of the stroke — a stroked circle that small
    // reads as a ring rather than a point.
    out property <string> more: "M8 3.4v0.2M8 7.9v0.2M8 12.4v0.2";
    // The same three dots lying down, for a row rather than a column.
    out property <string> dots: "M3.9 8h0.2M7.9 8h0.2M11.9 8h0.2";
    out property <string> plus: "M8 3.5v9M3.5 8h9";
    out property <string> minus: "M3.5 8h9";
    out property <string> horizontal: "M3 4.5h10M3 8h10M3 11.5h6";
    out property <string> vertical: "M11.5 3v10M8 3v10M4.5 3v6";
    out property <string> folder: "M1.5 3.5h4l1.5 2h7.5v7a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1z";
    out property <string> search: "M11.5 7a4.5 4.5 0 1 1-9 0 4.5 4.5 0 1 1 9 0M10.6 10.6 14 14";
    out property <string> history: "M14 8a6 6 0 1 1-6-6 6 6 0 0 1 6 6M8 4.5V8l2.5 1.5";
    out property <string> outline: "M3 4h10M5.5 8h7.5M8 12h5";
    // Sliders rather than a gear: a gear at 16px is a ring of specks, and what
    // the row below the four panels opens is a panel of values to move.
    out property <string> settings:
        "M2.5 4.5h3M8.5 4.5h5M2.5 8h7M12.5 8h1M2.5 11.5h2M7.5 11.5h6"
        + "M8.5 4.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 1 1 3 0"
        + "M12.5 8a1.5 1.5 0 1 1-3 0 1.5 1.5 0 1 1 3 0"
        + "M7.5 11.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 1 1 3 0";
    out property <string> down: "M4.5 6.5 8 10 11.5 6.5";
    out property <string> up: "M4.5 9.5 8 6 11.5 9.5";
    // Two arrows passing each other: what replacing one word with another is.
    out property <string> replace: "M2.5 5.5h8l-2-2M13.5 10.5h-8l2 2";
    // A pane divided, for the status bar.
    out property <string> split: "M1.5 2.5h13v11h-13zM8 2.5v11";
    out property <string> warning: "M8 2.5 14.5 13.5h-13zM8 6.5v3M8 11.4v0.1";
    out property <string> close: "M4.5 4.5 11.5 11.5M11.5 4.5 4.5 11.5";
    out property <string> preview: "M1.5 8c2-3 4.2-4.5 6.5-4.5s4.5 1.5 6.5 4.5c-2 3-4.2 4.5-6.5 4.5s-4.5-1.5-6.5-4.5z M9.6 8a1.6 1.6 0 1 1-3.2 0 1.6 1.6 0 1 1 3.2 0";
}

// One line drawing, tinted by whoever holds it.
export component Icon inherits Rectangle {
    in property <string> commands;
    in property <brush> tint: Tok.ink-muted;

    width: 16px;
    height: 16px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.commands;
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

// A button that is an icon and a tooltip, and nothing else.
//
// `checked` is for the buttons that report a state rather than doing something
// once — the sidebar toggle, the writing direction — so that "this is on" and
// "the pointer is here" never look the same.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> checked: false;
    /// Dimmed and deaf. **For a button whose command means nothing here** —
    /// 追加要件 2026-09-06 turns the two writing directions off over a shell,
    /// and a button that looks alive and does nothing is worse than one that
    /// says it is not.
    in property <bool> enabled: true;
    /// Square, and 26px unless something it has to sit inside is smaller — a
    /// tree row is 24px, and a button taller than its row overlaps the rows
    /// either side of it.
    in property <length> size: 26px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: 5px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: root.checked
        ? Tok.accent-soft
        : (touch.has-hover && root.enabled ? Tok.chrome-sunken : transparent);

    // A child with no x/y sits at the corner, not in the middle, so the two
    // are said here rather than left to the default.
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: root.icon;
        tint: root.checked ? Tok.accent-strong : (touch.has-hover ? Tok.ink-strong : Tok.ink-muted);
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    // Last, and that is the whole of why it works.
    //
    // The lowering pass puts the area it generates at the index the `Tooltip`
    // was written at, and children are hit-tested from the last one back, so a
    // `Tooltip` written above the TouchArea sits underneath it and never sees
    // the pointer. On top it observes the move without claiming it, and the
    // TouchArea below still gets the click.
    //
    // Built in, so the delay before it appears, the placement beside the
    // pointer and the turn away from the edge of the screen are not ours to
    // get wrong. It is drawn in the widget style's colours rather than in
    // `Tok`, which is the price of not writing it.
    //
    // `text` is a styled-text and a string does not become one on its own, so
    // the value goes through `@markdown`. That means a tip is read as markdown:
    // keep `*` and `_` out of one, or the word around them turns italic.
    // Guarded, so a button without a tip does not raise an empty box. The
    // lowering pass forwards the condition onto the area it generates, which is
    // why `if` is allowed here where `for` is not.
    if root.tip != "": Tooltip {
        text: @markdown("\{root.tip}");
    }
}

// 書き手の報告 2026-09-08: **縦書きのペインで設定画面に打ち込むと、IMEが縦のまま。**
//
// 変換候補の並びは合成フォントで決まり（技術検証 7.2）、それは窓に1つしかない
// ——**組版の向きはペインのものだが、欄はペインではない。**素の欄が鍵盤を取ったら
// 横に戻し、返したらRustがペインの向きへ戻す。
//
// **大域なのは、欄が窓の根を知らないからである。**`Field`は`controls.slint`の部品で、
// 使う側ごとに配線すると**新しい欄を足すたびに忘れられる**種類の配線になる。
/// 「終わりまで」を表す選択の終端（`Field`）。**位置ではなく合図**なので、
/// ありえない負の数にしてある。
export global Selection {
    out property <int> everything: -1;
}

export global Ime {
    /// 素の欄が鍵盤を取った（true）／返した（false）。
    callback field-focus(bool);
    /// 配置が済んだあと、候補窓の位置を送り直した（書き手の報告 2026-09-09）。
    /// **診断ログのためだけにある**——効いたかどうかを画面の外から確かめられる
    /// ようにしておく。
    callback settled();
}

// A line of text the writer types into.
//
// The same builtin `TextInput` a `LineEdit` is made of — the cursor, the
// selection and every editing key are Slint's — inside a box drawn in `Tok`,
// for the same reason `TextButton` exists.
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    // A one-way binding, not `<=>`: the input's own `has-focus` is read-only,
    // and a two-way binding needs both ends to be writable.
    out property <bool> has-focus: input.has-focus;
    // **どの欄でも、打っているあいだIMEは横書き**（上の`Ime`）。
    changed has-focus => {
        if (!self.has-focus) {
            settle.running = false;
        }
        Ime.field-focus(self.has-focus);
    }
    callback accepted();
    callback edited();
    /// Escape, which a field has to pass on rather than swallow: the bar it
    /// sits in is what closes (要件 6.7).
    callback escaped();
    /// A key the field is asked about before the text gets it. Return `accept`
    /// to take it; the default is `reject`, which is what an unanswered
    /// callback returns, so a field nobody asks about behaves as before.
    ///
    /// **This is how a shortcut still works while the writer is typing in the
    /// field it opened** — `Ctrl+F` in the find box is the same key it was in
    /// the document, and the key handler above the field never sees it.
    callback shortcut(event: KeyEvent) -> EventResult;

    height: 28px;
    background: Tok.paper;
    border-radius: 5px;
    border-width: 1px;
    border-color: input.has-focus ? Tok.accent : Tok.rule-strong;
    // A click anywhere in the box, including the padding either side of the
    // text, is a click in the field.
    forward-focus: input;

    /// Called by whoever raised the bar this field is in.
    public function take-focus() {
        input.focus();
        root.arrive(0);
    }

    /// Put the keyboard here with `count` characters already selected from the
    /// start, so that typing replaces them (追加要件 2026-09-06). Renaming
    /// `Part01設計.md` means changing `Part01設計`, and a field that selected
    /// the whole thing would ask for `.md` to be typed again.
    public function take-focus-selecting(count: int) {
        input.focus();
        input.set-selection-offsets(0, count);
        root.arrive(count);
    }

    /// 鍵盤をここへ置き、入っている文字をぜんぶ選ぶ。**打てば置き換わる**
    /// ——`Ctrl+F`をもう一度押した書き手は、たいてい別の語を探しに来ている。
    ///
    /// **IMEの候補窓の位置は、配置が済んでからもう一度送る**（書き手の報告
    /// 2026-09-09：「検索バーを出してIMEを起動すると、IMEが入力ボックスと
    /// 重なる。マウスでクリックすると直る」）。Slintは`FocusIn`の瞬間に
    /// カーソル矩形を`InputMethodRequest::Enable`へ入れてWindowsへ渡すが
    /// （`i-slint-core/items/text.rs`）、**生まれたばかりの欄はまだ配置されて
    /// いない**ので、古い矩形が渡って候補窓がそこへ出る。クリックで直るのは
    /// `ensure_focus_and_ime`が正しい座標で送り直すからで、その送り直しを
    /// 時計でやる——`select-all`は`update_ime`＝`Update`を通り、winitが
    /// `set_ime_cursor_area`を呼ぶ。
    public function take-focus-selecting-all() {
        input.focus();
        input.select-all();
        root.arrive(Selection.everything);
    }

    /// 鍵盤がプログラムから来たときに要る2つ。
    ///
    /// 1. **IMEを横書きへ**。`changed has-focus`に任せていたが、**生まれたときから
    ///    焦点を持っている欄では変化が起きない**ので、その回だけ誰も言わなかった
    ///    ——縦書きのペインから開いた帯で、IMEは縦のままだったことになる。
    /// 2. **候補窓の位置を送り直す時計を起こす**（下の`settle`）。
    ///
    /// `selection`は**呼び手が頼んだ選択**で、時計はそれを出し直す。
    /// 書き手の報告 2026-09-09：名前の変更で「一度拡張子を除く名前が選ばれるが、
    /// 次の瞬間に拡張子まで広がる」——時計が`select-all`を掛けていた。
    /// **送り直しは、選び直しではない。**
    function arrive(selection: int) {
        root.settle-end = selection;
        Ime.field-focus(true);
        settle.running = true;
    }

    /// 時計が出し直す選択の終わり。`Selection.everything`は「ぜんぶ」。
    property <int> settle-end: 0;

    // 上の送り直し。**1回だけ動く。**打ち始めたら止める——選び直しが書き手の
    // 打った字を選んでしまわないように（`edited`で止めている）。
    settle := Timer {
        interval: 100ms;
        running: false;
        triggered => {
            settle.running = false;
            // **空の欄では`select-all`が何も送らない**（2026-09-09、Slintの
            // `move_cursor`は`if text.is_empty() { return false; }`で戻る）。
            // 帯は開いた直後が空なので、これが最初の直しが効かなかった理由
            // である。`set-selection-offsets`は`set_cursor_position`を素通しで
            // 呼ぶので、**空でも必ず**`update_ime`＝`set_ime_cursor_area`まで
            // 届く。そのあとで選び直す（中身があれば「打てば置き換わる」を保つ）。
            // **送り直しは、選び直しではない。**呼び手が頼んだ選択をそのまま
            // 出し直す——`select-all`を掛けていたせいで、名前の変更で拡張子まで
            // 選択が広がっていた（書き手の報告 2026-09-09）。
            if (root.settle-end == Selection.everything) {
                // 空でも必ず届く一手を先に。`select-all`は空だと何もしない。
                input.set-selection-offsets(0, 0);
                input.select-all();
            } else if (root.settle-end > 0) {
                input.set-selection-offsets(0, root.settle-end);
            } else if (root.text == "") {
                // 頼まれた選択が無い欄。**空のときだけ**位置を送り直せる
                // ——空の欄はカーソルが0にしかなく、動かすものが無いからである。
                // 中身のある欄でこれを打てば、書き手の置いたカーソルを頭へ
                // 引き戻すことになる。そちらは、欄が「何を選びたいか」を
                // 言うようになってからでよい。
                input.set-selection-offsets(0, 0);
            }
            Ime.settled();
        }
    }

    // Under the input, so the pointer reaches the text rather than this.
    if root.text == "": Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.placeholder;
        color: Tok.ink-faint;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        font-size: 13px;
        color: Tok.ink;
        selection-background-color: Tok.accent-soft;
        selection-foreground-color: Tok.ink-strong;
        vertical-alignment: center;
        single-line: true;
        accepted => {
            root.accepted();
        }
        edited => {
            // 打ち始めたら、候補窓の送り直しは要らない——打鍵そのものが
            // `update_ime`を通す。ここで止めないと、100ms以内に打った字を
            // 選び直してしまう。
            settle.running = false;
            root.edited();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.escaped();
                return accept;
            }
            return root.shortcut(event);
        }
    }
}

// One tab in one pane's strip (要件 6.3).
//
// **A tab is as wide as its name.** It was made to shrink instead, once, so
// that a strip could hold more tabs than it had room for; what that produced
// was a row of tabs too narrow to read, which is not more tabs — it is none.
// The strip scrolls now, and this stays wide enough to be read.
//
// `overflow: elide` is still here for the other end: a name past `max-width` is
// cut with an ellipsis rather than allowed to push the rest of the strip along.
// It also means the name's own min-width is zero (`builtins.slint`, Text), so
// if the strip is ever short of room the name is what gives way rather than the
// close cross or the unsaved dot.
export component Tab inherits Rectangle {
    in property <string> title;
    in property <bool> edited;
    in property <bool> current;
    /// This is the tab being written in: the one in front of the pane that has
    /// the keyboard (要件 6.3).
    ///
    /// **The accent is what says "the keyboard is here"** — that is what this
    /// palette keeps it for. Every pane's front tab used to wear it, so with
    /// more than two panes on screen nothing said which one the writer was in.
    /// Now the front tab of the other panes says only "this is the one in
    /// front", in a line that carries no accent at all.
    in property <bool> focused;
    /// The paper of the pane this strip belongs to, so that the tab in front is
    /// the top edge of the page rather than a shape sitting above it. The two
    /// panes do not have the same paper (要件 7.2 縦書き／横書き), so it is
    /// asked for rather than assumed.
    in property <brush> paper: Tok.paper;
    callback chosen();
    callback closed();
    /// 要件 6.5: this tab is being carried along the strip.
    ///
    /// The first length is where the pointer is **in the strip's coordinates** —
    /// this tab's own x plus where the pointer sits inside it. What the strip
    /// has to decide is which tab the pointer is over, and that is a question
    /// about the strip rather than about any one tab.
    ///
    /// The other two are the same point in the **window's** coordinates, which
    /// is the only way to say where the hand is once it has left this strip:
    /// the panes it may be over are somewhere else entirely (要件 6.5).
    callback grabbed(length, length, length);
    callback dragged(length, length, length);
    /// Let go after being carried. A press that never moved far enough is a
    /// `chosen` instead, so one of the two always happens and never both.
    ///
    /// **Where the hand let go, in the window's coordinates** (要件 6.5). A tab
    /// can be carried out of its own strip and into another pane, so the place
    /// it landed cannot be said in the coordinates of the strip it left.
    callback dropped(length, length);
    /// The pointer is inside this tab while another one is being carried.
    callback pointed-at();
    /// 追加要件 2026-09-06: the right button, with where it was pressed **in
    /// the strip's own coordinates**: this tab's x plus where inside it the
    /// hand is, and the tab's own bottom edge.
    ///
    /// **Not the window's** (書き手の報告 2026-09-07・3回目). A window
    /// coordinate has to be turned back into the pane's before a popup can use
    /// it, and a menu placed that way came out an inch to the right of the
    /// hand. The strip stands at the pane's top-left corner, so what is handed
    /// over here is already in the coordinates the popup is placed in — nothing
    /// is converted, and nothing can be converted with a stale number. It is
    /// what the pane's own context menu has always done (`self.mouse-x`,
    /// straight through).
    callback menu-asked(length, length);
    /// The same, for the shell a terminal tab is running.
    callback shell-asked(length, length);
    /// Start renaming from somewhere else (the right button's menu).
    ///
    /// **A count rather than a call**, because a tab is a repeated element and
    /// nothing outside a repeater can reach into one (技術検証 6.24). The strip
    /// bumps this for the one tab it means, and only that tab sees a change.
    in property <int> rename-asked;
    /// The carry is over, whether it ended in a drop or was taken away. **Any
    /// carry that starts raises exactly one of these**, so what is drawn during
    /// one is always cleared.
    callback carry-ended();

    /// Where the pointer is while some tab is being carried, in the strip's
    /// coordinates, and whether one is being carried at all. **Every tab is
    /// told**, and the one the pointer falls inside answers.
    in property <bool> carrying: false;
    in property <length> carry-x: 0px;
    /// This is the tab being carried, so it is drawn as having left its place.
    in property <bool> carried: false;
    /// 追加要件 2026-09-06: this tab stands for a file, so its name is one the
    /// writer can change. A buffer that has never been saved has no name on
    /// disk to change, and holding one down does nothing.
    in property <bool> renamable;
    /// 追加要件 2026-09-07: this tab is a shell, so holding it down offers
    /// another one. **The same press as a rename** — a tab that cannot be
    /// renamed is a tab whose long press was doing nothing.
    in property <bool> switchable;
    /// Where the pointer was when the press landed, in the strip's coordinates
    /// (追加要件 2026-09-07).
    property <length> held-at-x;
    property <length> held-at-y;
    /// Whether this press has already opened that menu. **A timer that is still
    /// running is a timer that fires again**, and the rename case stops itself
    /// by setting `renaming`; this is the same brake for the other answer.
    property <bool> asked-shell: false;
    /// How much of the title is the name without its extension, in characters.
    /// **Worked out where the name is** (Rust), because Slint cannot look for
    /// the last dot in a string.
    in property <int> stem-length;
    /// 書き手の報告 2026-09-07: this tab is only being looked through, and the
    /// next file clicked in the left panel takes its place. **Italics** — the
    /// one thing a strip of names can say without taking any width.
    in property <bool> provisional;
    /// The name the writer typed into the tab. **Raised on Enter only** — a
    /// rename moves a file, and losing focus is not somebody saying yes.
    callback renamed(string);
    /// Which edge of this tab the carried one would come to rest against:
    /// -1 the leading edge, 1 the trailing edge, 0 neither. **An edge rather
    /// than a tab**, because what the writer is choosing is a gap.
    in property <int> landing: 0;
    /// Where this tab is inside the strip, raised whenever it is the one in
    /// front. The strip scrolls to it (要件 6.3).
    ///
    /// **The tab reports itself rather than being asked.** A tab comes to the
    /// front from the strip, from the list of tabs, from the file tree, by its
    /// neighbour being closed and by being restored at startup; what those have
    /// in common is only the tab ending up in front, and the strip cannot know
    /// where a tab is without asking the layout that put it there.
    callback shown(length, length);

    function report() {
        if (root.current) {
            root.shown(root.x, root.width);
        }
    }

    // 要件 6.5: whether the pointer being carried is inside this tab. Worked
    // out here rather than in the strip so that the `changed` handler that
    // reports it sits beside the others, in the component that owns the
    // geometry it reads.
    property <bool> under-carry: root.carrying
        && root.carry-x >= root.x
        && root.carry-x < root.x + root.width;
    changed under-carry => {
        if (root.under-carry) {
            root.pointed-at();
        }
    }

    // Whether the pointer went down on this tab, where it went down, and
    // whether it has since travelled far enough to be a carry rather than a
    // click. **Four pixels**: a click with a hand on it is not perfectly still,
    // and a tab that jumped at the first tremble could not be chosen at all.
    property <bool> pressing: false;
    property <length> press-x;
    property <bool> carrying-self: false;
    /// The press has already been taken as a rename, so the release must not
    /// also be taken as a choice.
    property <bool> renaming: false;
    /// 追加要件 2026-09-06: the name is being typed **in the tab itself**.
    ///
    /// **The tab owns this**, and nothing outside has to be told: one tab is
    /// edited at a time because one press starts it, and the strip is
    /// republished when the rename lands (which builds these elements again and
    /// so clears it). Escape and losing the keyboard both put it back.
    property <bool> editing: false;

    // 追加要件 2026-09-06: **a press that stays still and stays down is a
    // rename.** Half a second, and only while the press is neither a carry nor
    // over already: `running` is a binding, so the conditions that end it are
    // written into the binding rather than assigned from inside the handler.
    changed rename-asked => {
        if (root.renamable && root.rename-asked > 0) {
            root.renaming = true;
            root.editing = true;
        }
    }

    hold := Timer {
        interval: 500ms;
        running: root.pressing
            && (root.renamable || root.switchable)
            && !root.carrying-self
            && !root.renaming
            && !root.asked-shell;
        triggered => {
            if (root.switchable) {
                root.asked-shell = true;
                root.shell-asked(root.held-at-x, root.held-at-y);
            } else {
                root.renaming = true;
                root.editing = true;
            }
        }
    }

    // `init` as well as the changes, for the reason 6.11 records elsewhere: a
    // tab that is in front from the moment it is created never raises a change
    // to say so.
    init => {
        root.report();
    }
    changed current => {
        root.report();
    }
    changed x => {
        root.report();
    }
    changed width => {
        root.report();
    }

    height: 28px;
    // The tab being carried is drawn as having left its place (要件 6.5). It
    // stays where it was — the strip does not reorder under the hand, because
    // republishing it would take the element whose grab is running (6.18) —
    // so what says a tab is in the air is that it has gone pale.
    opacity: root.carried ? 0.45 : 1.0;
    // A floor and a ceiling, not a size: a tab is as wide as its name between
    // the two. The floor keeps 無題1 from being a stub too small to aim at, and
    // the ceiling stops one long name from taking the whole strip. **Neither is
    // a squeeze**: the scroll view around the strip asks for the width the tabs
    // want, so what is between the two is the name's own width (要件 6.3).
    min-width: 80px;
    max-width: 240px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    background: root.current
        ? root.paper
        : (touch.has-hover ? Tok.chrome-sunken : transparent);

    // Which tab is in front. Drawn rather than given as a border, because a
    // border is on all four sides and this is on one.
    if root.current: Rectangle {
        y: 0;
        height: 2px;
        background: root.focused ? Tok.accent : Tok.rule-strong;
    }

    // 追加要件 2026-09-06: **the name is changed where it is written.** A
    // dialog for a name that is already on screen asks the writer to look
    // somewhere else to change what they were looking at.
    if root.editing: Field {
        width: parent.width;
        height: parent.height;
        // **From `init`, because the element is created already editing** and
        // so never raises a change to say it started (6.11's rule). Its id is
        // not reachable from outside either: an `if` compiles to a repeater
        // (技術検証 6.24), and nothing outside a repeater can name what is in
        // it — which is why the timer above only sets the flag.
        init => {
            self.text = root.title;
            self.take-focus-selecting(root.stem-length);
        }
        accepted => {
            root.editing = false;
            root.renamed(self.text);
        }
        escaped => {
            root.editing = false;
        }
        // **Losing the keyboard cancels.** A click elsewhere is the writer
        // going somewhere else, not agreeing to move a file.
        changed has-focus => {
            if (!self.has-focus) {
                root.editing = false;
            }
        }
    }

    HorizontalLayout {
        visible: !root.editing;
        padding-left: 11px;
        // Room for the cross, which is not in this layout: it has to be
        // declared after the touch area below to be clickable at all.
        padding-right: root.current ? 24px : 11px;
        spacing: 7px;

        Text {
            text: root.title;
            // Three steps, not two: the tab being written in, the tab in front
            // of some other pane, and the rest.
            color: root.focused
                ? Tok.accent-strong
                : (root.current ? Tok.ink-strong : Tok.ink-muted);
            font-italic: root.provisional;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }

        // 要件 8.4: work that is not in the file yet. A dot rather than the
        // `*` the title used to carry, so that the name is the whole of what
        // is elided when the strip is full.
        if root.edited: Rectangle {
            width: 6px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Tok.accent;
            }
        }
    }

    touch := TouchArea {
        // **Not `clicked`.** A click is a press and a release in the same
        // place, which is exactly the case a carry is not; both have to come
        // out of the same press, so the press is followed here rather than
        // being asked about afterwards.
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                root.menu-asked(root.x + touch.mouse-x, root.y + root.height);
                return;
            }
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.pressing = true;
                root.carrying-self = false;
                root.renaming = false;
                // 追加要件 2026-09-07: **where the hand is, taken now.** The
                // long press opens the same menu the right button does, so it
                // is placed by the very expression six lines up — read in the
                // handler that has it, rather than inside the timer that fires
                // half a second later.
                root.asked-shell = false;
                root.held-at-x = root.x + touch.mouse-x;
                root.held-at-y = root.y + root.height;
                root.press-x = touch.mouse-x;
            }
            if (event.kind == PointerEventKind.up) {
                if (root.carrying-self) {
                    root.dropped(
                        root.absolute-position.x + touch.mouse-x,
                        root.absolute-position.y + touch.mouse-y);
                    root.carry-ended();
                } else if (root.pressing && !root.renaming) {
                    // **Not after a rename.** The question is already up, and
                    // a tab switch under it would move the pane out from
                    // beneath the name being typed.
                    root.chosen();
                }
                root.pressing = false;
                root.carrying-self = false;
            }
            if (event.kind == PointerEventKind.cancel) {
                if (root.carrying-self) {
                    root.carry-ended();
                }
                root.pressing = false;
                root.carrying-self = false;
            }
        }
        moved => {
            if (!root.pressing) {
                return;
            }
            if (!root.carrying-self
                && (touch.mouse-x > root.press-x + 4px
                    || touch.mouse-x < root.press-x - 4px)) {
                root.carrying-self = true;
                root.grabbed(
                    root.x + touch.mouse-x,
                    root.absolute-position.x + touch.mouse-x,
                    root.absolute-position.y + touch.mouse-y);
            }
            if (root.carrying-self) {
                root.dragged(
                    root.x + touch.mouse-x,
                    root.absolute-position.x + touch.mouse-x,
                    root.absolute-position.y + touch.mouse-y);
            }
        }
    }

    // 要件 6.5: the gap the carried tab would fall into, drawn on the edge it
    // would come to rest against. A mark between two tabs rather than on one,
    // because the place a tab lands is a gap and not a neighbour.
    if root.landing != 0: Rectangle {
        x: root.landing < 0 ? -1px : parent.width - 1px;
        y: 0;
        width: 2px;
        height: parent.height;
        background: Tok.accent;
    }

    // After the area that chooses the tab, and that is the whole of why it
    // works: children are hit-tested from the last one back, so the cross sees
    // the click first and the rest of the tab still answers everywhere else.
    // The same ordering the tooltip in `IconButton` depends on.
    //
    // Only the tab in front carries one. A cross on every tab is a row of ways
    // to lose the wrong document, and the tabs are narrow enough already.
    if root.current: Rectangle {
        x: parent.width - 22px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        background: cross.has-hover ? Tok.chrome-sunken : transparent;

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            commands: Icons.close;
            tint: cross.has-hover ? Tok.ink-strong : Tok.ink-faint;
        }

        cross := TouchArea {
            clicked => {
                root.closed();
            }
        }
    }
}

/// What a button is for, which is the whole of what tells them apart
/// (`Overlays.dc.html`). **Only one of these is a colour**: the primary is the
/// thing the writer came to do, the danger is the one that loses something, and
/// everything else is an outline.
export enum Role {
    normal,
    primary,
    danger,
    quiet,
}

// A button with a word in it, for the places an icon cannot say enough — the
// answers to a question, and the two replace commands.
//
// Not `Button` from the widget set: that one is drawn by the chosen style and
// its palette is `out` properties all the way down (技術検証 6.22), so a window
// in purple would have grey buttons in it.
export component TextButton inherits Rectangle {
    in property <string> title;
    in property <Role> role: Role.normal;
    in property <bool> enabled: true;
    /// 長押しで別のことをする釦（書き手の求め 2026-09-08）。
    ///
    /// **タブの名前を変えるのと同じ作法**（追加要件 2026-09-06）——半秒押したままに
    /// すると`held`が出る。同じ意味の操作は同じ手つきであるべきなので、間隔も揃える。
    in property <bool> holdable: false;
    callback held();
    /// Fill whatever it is put in, rather than fitting its word. **For a column
    /// of answers**: a question with four of them in Japanese is wider than any
    /// card it fits in, and a row that overflows draws its buttons over the
    /// edge (6.23).
    in property <bool> wide: false;
    callback clicked();

    height: 28px;
    // The word plus the padding either side of it, as a floor and a ceiling
    // rather than a width: a ceiling that is the floor is a fixed size, and
    // lifting it is what lets a layout stretch this one to its own width.
    // **A wide one may also be narrowed**, because its word is a font family
    // name and some of those are longer than the panel.
    //
    // **`preferred-width`, never `width`.** The label's width is what the
    // layout gave it, and the layout works from these two — asking for it here
    // is a binding loop the compiler catches (min-width → layout → width →
    // label.width → min-width). The preferred width is the text's own, which
    // nothing here decides.
    min-width: root.wide ? 44px : label.preferred-width + 22px;
    max-width: root.wide ? 100000px : label.preferred-width + 22px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.role == Role.primary
        ? Tok.accent
        : (root.role == Role.danger
            ? Tok.alert
            : (root.role == Role.quiet ? transparent : Tok.rule-strong));
    background: root.role == Role.primary
        ? (touch.has-hover ? Tok.accent-strong : Tok.accent)
        : (touch.has-hover ? Tok.accent-faint : (root.role == Role.quiet ? transparent : Tok.paper));
    opacity: root.enabled ? 1.0 : 0.45;

    label := Text {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 22px;
        horizontal-alignment: root.wide ? left : center;
        text: root.title;
        overflow: elide;
        font-size: 13px;
        color: root.role == Role.primary
            ? Tok.paper
            : (root.role == Role.danger
                ? Tok.alert
                : (root.role == Role.quiet ? Tok.ink-muted : Tok.ink));
    }

    /// 長押しが済んだ——**離したときの`clicked`は押下ではない。**
    property <bool> held-already: false;
    /// `touch.pressed`を見るための写し。**押し始めで必ず消す**ので、指が釦の外へ
    /// 出て`clicked`が来なかったときも、次の押下に持ち越さない。
    property <bool> down: touch.pressed;
    changed down => {
        if (root.down) {
            root.held-already = false;
        }
    }

    hold := Timer {
        interval: 500ms;
        running: root.holdable && root.down && !root.held-already;
        triggered => {
            root.held-already = true;
            root.held();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            // 長押しとして受けたものを、離すときにもう一度押下として受けない。
            if (root.held-already) {
                return;
            }
            root.clicked();
        }
    }
}


// 追加要件 2026-09-08: 設定の面を選ぶ帯。
//
// **設定は一枚に収まらなくなった。**要件 9 の書式だけで20行あり、そこへ
// 書字方向を持たない設定（既定の接続先、自動退避）が増えていく。群ごとに
// 分けて、一度に一つだけ出す。
//
// **`TextButton`ではない。**すぐ下には同じ形の釦が2つ並んでいる——シートを
// 選ぶ「Horizontal／Vertical」で、そちらは*この面の中の*選択である。両方が
// 同じ見た目なら、画面はどちらが上位かを言えない。こちらは下線で言う。
export component PanelTab inherits Rectangle {
    in property <string> title;
    in property <bool> current;
    callback clicked();

    height: 26px;
    // **`preferred-width`、`width`ではない**（`TextButton`と同じ理由）：幅は
    // レイアウトがこの2つから決めるもので、ここで自分の幅を読めば束縛の輪に
    // なる。
    min-width: label.preferred-width + 16px;
    max-width: label.preferred-width + 16px;
    border-radius: 4px;
    background: touch.has-hover && !root.current ? Tok.accent-faint : transparent;

    label := Text {
        x: 8px;
        y: (parent.height - self.height) / 2 - 1px;
        text: root.title;
        font-size: 12px;
        font-weight: root.current ? 600 : 400;
        color: root.current ? Tok.ink-strong : Tok.ink-muted;
    }

    // いま居る面の下の線。**アクセントで引く**——この窓がアクセントに使わせて
    // いるのは「ここに鍵盤がある」で、開いている設定の面はまさにそれである。
    if root.current: Rectangle {
        x: 4px;
        y: parent.height - 2px;
        width: parent.width - 8px;
        height: 2px;
        border-radius: 1px;
        background: Tok.accent;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The mark on a setting that only does something in one writing direction
// (要件 9): `H` for horizontal, `V` for vertical.
//
// **Without it, a writer moves a number or picks a font while looking at the
// pane it cannot reach.** 要件 9 writes the line spacing as horizontal
// writing's, the character advance and column gap as vertical writing's, and
// the body font as one of each — so half the panel is about the pane the writer
// is not in, and only this says which half.
export component Tag inherits Rectangle {
    in property <string> text;

    width: 16px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 15px;
        border-radius: 3px;
        background: Tok.chrome-sunken;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.text;
            color: Tok.ink-muted;
            font-size: 10px;
        }
    }
}

// A label, a value, and the two steps either side of it.
//
// Steps rather than a slider because every one of these re-lays out the whole
// document: a drag would remeasure on each frame, the way the pane resize did
// before it was debounced.
export component StepRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    /// `H` or `V`, when the number only does something in one writing
    /// direction (要件 9 asks for the line spacing of horizontal text and for
    /// the advance and column gap of vertical text). **Without it, a writer
    /// moves a number while looking at the pane it cannot reach.**
    in property <string> only;
    callback stepped(int);

    height: 28px;

    HorizontalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            color: Tok.ink-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.only != "": Tag {
            text: root.only;
            horizontal-stretch: 0;
        }

        IconButton {
            icon: Icons.minus;
            tip: "Less";
            clicked => {
                root.stepped(-1);
            }
        }

        Text {
            text: root.value;
            color: Tok.ink;
            font-size: 12px;
            min-width: 50px;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        IconButton {
            icon: Icons.plus;
            tip: "More";
            clicked => {
                root.stepped(1);
            }
        }
    }
}

// Everything about one kind of text: how large, what colour, which family
// (要件 9).
//
// **One row per thing being set.** The size, the colour and the family were
// three sections once, and finding H3 meant counting rows in all three; what is
// being set is H3, and those are three sides of it.
export component TextRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> shown;
    in property <string> family;
    callback stepped(int);
    callback picked();
    callback chose-font();

    height: 28px;

    HorizontalLayout {
        spacing: 4px;

        Text {
            text: root.label;
            color: Tok.ink-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 0;
            min-width: 34px;
        }

        IconButton {
            size: 20px;
            horizontal-stretch: 0;
            icon: Icons.minus;
            clicked => {
                root.stepped(-1);
            }
        }

        Text {
            text: root.value;
            color: Tok.ink;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 0;
            min-width: 46px;
        }

        IconButton {
            size: 20px;
            horizontal-stretch: 0;
            icon: Icons.plus;
            clicked => {
                root.stepped(1);
            }
        }

        // The swatch is a button: a square of colour beside a row of controls
        // says "press me" whether or not it does anything, so it does.
        Rectangle {
            width: 24px;
            horizontal-stretch: 0;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 20px;
                border-radius: 4px;
                border-width: 1px;
                border-color: swatch.has-hover ? Tok.accent : Tok.rule-strong;
                background: root.shown;

                swatch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked();
                    }
                }
            }
        }

        TextButton {
            wide: true;
            title: root.family;
            clicked => {
                root.chose-font();
            }
        }
    }
}

// A colour: what it looks like, and pressing it to change it.
//
// **Picked, not typed** (要件 9). The six digits were a field here once, and
// the swatch beside it did nothing — which read as a colour that could not be
// changed. Windows draws the picker; the digits are still how a colour is
// written into the settings file, where a person can edit them.
export component ColorCell inherits Rectangle {
    in property <string> label;
    in property <color> shown;
    callback picked();

    height: 28px;

    HorizontalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            color: Tok.ink-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 30px;
        }

        Rectangle {
            width: 24px;
            horizontal-stretch: 0;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 20px;
                border-radius: 4px;
                border-width: 1px;
                border-color: swatch.has-hover ? Tok.accent : Tok.rule-strong;
                background: root.shown;

                swatch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked();
                    }
                }
            }
        }
    }
}

// A label and what is set, opened by pressing it: a font family (要件 9), and
// anything else later that is chosen from a list rather than stepped.
export component PickRow inherits Rectangle {
    in property <string> label;
    in property <string> only;
    in property <string> value;
    callback pressed();

    height: 28px;

    HorizontalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            color: Tok.ink-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 0;
            min-width: 54px;
        }

        if root.only != "": Tag {
            text: root.only;
            horizontal-stretch: 0;
        }

        TextButton {
            wide: true;
            title: root.value;
            clicked => {
                root.pressed();
            }
        }
    }
}

// One line of a menu.
//
// The shortcut is written rather than bound, because the keys are handled by
// the window's `FocusScope` and by Rust, not here: a menu that claimed a
// shortcut it did not own would be the second opinion that goes stale.
export component MenuRow inherits Rectangle {
    in property <string> title;
    in property <string> shortcut;
    /// The row that stands for what is already the case — the tab in front, in
    /// the list of tabs. **Shown, not hidden**: a list you are picking from has
    /// to say where you are in it.
    in property <bool> checked: false;
    /// Answer when the pointer is *released* over the row rather than when it
    /// is clicked on it.
    ///
    /// **For a menu opened by holding a button down.** The press that opened it
    /// happened somewhere else, so there is no click here to wait for — the
    /// writer slides onto a row and lets go. A row that did both would answer
    /// twice for an ordinary click, so it is one or the other.
    in property <bool> on-release: false;
    callback activated();

    height: 28px;
    border-radius: 5px;
    background: root.checked
        ? Tok.accent-soft
        : (touch.has-hover ? Tok.accent-faint : transparent);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 12px;

        Text {
            text: root.title;
            color: root.checked ? Tok.ink-strong : Tok.ink;
            font-size: 13px;
            // A title is a file name here, and a frame is a fixed width: without
            // this a long one is drawn straight through the side of the menu.
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.shortcut;
            color: Tok.ink-faint;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }

    touch := TouchArea {
        clicked => {
            if (!root.on-release) {
                root.activated();
            }
        }
        pointer-event(event) => {
            if (root.on-release && event.kind == PointerEventKind.up) {
                root.activated();
            }
        }
    }
}

// 追加要件 2026-09-07: one of the words a New Tab offers.
//
// **A link, not a button.** There is nothing else on that page, so a row of
// framed buttons would be the only thing on it and would read as a dialog
// asking to be dismissed. What is wanted is the feel of a page with three
// things written on it, any of which can be pressed.
export component LinkRow inherits Rectangle {
    in property <string> title;
    /// The shortcut that does the same thing, when there is one.
    in property <string> hint;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Tok.accent-faint : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Text {
            text: root.title;
            color: touch.has-hover ? Tok.accent-strong : Tok.accent;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.hint;
            color: Tok.ink-faint;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The rule between groups of rows. Inset, so it separates the titles rather
// than cutting the frame in two.
export component MenuSep inherits Rectangle {
    height: 11px;

    Rectangle {
        y: 5px;
        x: 6px;
        width: parent.width - 12px;
        height: 1px;
        background: Tok.rule;
    }
}

// The frame a menu is drawn in. The caller fills it with rows.
export component MenuFrame inherits Rectangle {
    background: Tok.paper;
    border-radius: 10px;
    border-width: 1px;
    border-color: Tok.rule-strong;
    drop-shadow-color: #1713213d;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;

    @children
}

/// A bar the writer drags a number along (追加要件 2026-09-06: 右下の倍率).
///
/// **Built here rather than taken from `std-widgets`.** Everything in this
/// window is drawn from `Tok`, and a widget carrying the system's own style
/// would be the one thing on screen that belongs to a different design.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 50;
    /// 追加要件 2026-09-07: stand it up. **The larger number is at the top** —
    /// a zoom is something a writer turns *up*, and a bar that grew downwards
    /// would answer the word with its opposite.
    in property <bool> vertical: false;
    /// The writer moved it. **Reported rather than applied** — what the number
    /// means belongs to whoever asked for the bar.
    callback moved(float);

    height: root.vertical ? 150px : 22px;
    // The travel is the track minus the handle: the handle's own width is the
    // part of the bar it can never reach past.
    property <length> grip: 14px;
    property <float> span: max(0.001, root.maximum - root.minimum);
    property <float> fraction: clamp((root.value - root.minimum) / root.span, 0.0, 1.0);

    Rectangle {
        x: root.vertical ? (parent.width - 4px) / 2 : 0;
        y: root.vertical ? 0 : (parent.height - 4px) / 2;
        width: root.vertical ? 4px : parent.width;
        height: root.vertical ? parent.height : 4px;
        background: Tok.rule;
        border-radius: 2px;

        // **What is filled in is the part below the handle** when the bar
        // stands up, so the ink grows the way the number does.
        Rectangle {
            x: 0;
            y: root.vertical ? parent.height * (1.0 - root.fraction) : 0;
            width: root.vertical ? parent.width : parent.width * root.fraction;
            height: root.vertical ? parent.height * root.fraction : parent.height;
            background: Tok.accent-soft;
            border-radius: 2px;
        }
    }

    Rectangle {
        x: root.vertical
            ? (parent.width - root.grip) / 2
            : (parent.width - root.grip) * root.fraction;
        y: root.vertical
            ? (parent.height - root.grip) * (1.0 - root.fraction)
            : (parent.height - root.grip) / 2;
        width: root.grip;
        height: root.grip;
        border-radius: root.grip / 2;
        background: touch.pressed || touch.has-hover ? Tok.accent-strong : Tok.accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        // **The press moves it too**, so a writer can put the number where they
        // are pointing rather than having to find the handle first.
        pointer-event(event) => {
            if (event.button == PointerEventButton.left
                && event.kind == PointerEventKind.down) {
                root.moved(root.vertical ? root.up-at(self.mouse-y) : root.at(self.mouse-x));
            }
        }
        moved => {
            if (self.pressed) {
                root.moved(root.vertical ? root.up-at(self.mouse-y) : root.at(self.mouse-x));
            }
        }
    }

    pure function at(x: length) -> float {
        return root.minimum
            + root.span * clamp((x - root.grip / 2) / max(1px, root.width - root.grip), 0.0, 1.0);
    }

    pure function up-at(y: length) -> float {
        return root.minimum + root.span * clamp(
            1.0 - (y - root.grip / 2) / max(1px, root.height - root.grip), 0.0, 1.0);
    }
}
