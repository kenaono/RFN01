import { ScrollView } from "std-widgets.slint";
import { Tok } from "tokens.slint";
import { Role, TextButton } from "controls.slint";

// One row of the Workspace list. `is-default` and `is-active` are two
// different Workspaces can each be true for at once — the one launched into
// automatically, and the one the tree is scoped to right now — and both are
// worth telling apart on screen (Workspace設計.md: "デフォルトWorkspaceを一つ
// 設定できる…手動で切り替えたWorkspaceをリンクの範囲に使う").
export struct WorkspaceRow {
    name: string,
    is-default: bool,
    is-active: bool,
}

// One shared folder, as it applies to the Workspace currently selected in the
// manager. `mode-auto` is that folder's own save mode — shared by every
// Workspace referencing it, never per-Workspace (仕様: "保存方式はフォルダ単位の
// 共通設定"), which is why toggling it here is worth the visual warning this
// component draws beside it.
export struct WorkspaceFolderRow {
    path: string,
    users: string,
    mode-auto: bool,
    // The directory could not be found the last time this was checked —
    // 仕様 "見つからないフォルダはその状態を示し、場所変更・取り外しで整理できる".
    missing: bool,
}

// A folder registered somewhere in the ledger but not referenced by any
// Workspace any more — 仕様 "未使用設定を整理できる".
export struct UnusedFolderRow {
    path: string,
}

component Banner inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    background: root.danger ? #f8d7da : Tok.accent-faint;
    border-radius: 6px;
    height: label.preferred-height + 16px;

    label := Text {
        x: 10px;
        width: parent.width - 20px;
        y: 8px;
        text: root.text;
        color: root.danger ? #7a1f27 : Tok.ink;
        font-size: 12px;
        wrap: word-wrap;
    }
}

component SectionTitle inherits Text {
    color: Tok.ink-muted;
    font-size: 12px;
    font-weight: 600;
}

// One folder row under the selected Workspace: its path, a save-mode toggle,
// reordering, and detaching it from this Workspace (not deleting its shared
// registration — see `Registry::remove_root` vs. `remove_unused_folder`).
component FolderRow inherits Rectangle {
    in property <string> path;
    in property <string> users;
    in property <bool> mode-auto;
    in property <bool> missing;
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    callback mode-toggled();
    callback move-up();
    callback move-down();
    callback detached();
    callback relocated();

    height: root.missing ? 182px : 162px;
    border-radius: 6px;
    background: touch.has-hover ? Tok.chrome-sunken : transparent;
    touch := TouchArea { }

    VerticalLayout {
        padding: 6px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: root.path;
                color: root.missing ? Tok.alert : Tok.ink;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                Tooltip { text: @markdown("\{root.path}"); }
            }

            if root.missing: TextButton {
                wide: true;
                title: @tr("Relocate…");
                clicked => { root.relocated(); }
            }
        }

        if root.missing: Text {
            text: @tr("Folder not found");
            color: Tok.alert;
            font-size: 12px;
        }

        Text {
            text: @tr("Used by: ") + root.users;
            color: Tok.ink-muted;
            font-size: 12px;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 4px;

            TextButton {
                wide: true;
                title: root.mode-auto ? @tr("Auto-Save") : @tr("Backup");
                role: root.mode-auto ? Role.primary : Role.normal;
                clicked => { root.mode-toggled(); }
            }

        }
        HorizontalLayout {
            spacing: 4px;
            TextButton {
                wide: true;
                title: @tr("Move Up");
                enabled: root.can-move-up;
                clicked => { root.move-up(); }
            }
            TextButton {
                wide: true;
                title: @tr("Move Down");
                enabled: root.can-move-down;
                clicked => { root.move-down(); }
            }
        }
        HorizontalLayout {
            TextButton {
                wide: true;
                title: @tr("Detach");
                clicked => { root.detached(); }
            }
        }
    }
}

component WorkspaceListRow inherits Rectangle {
    in property <string> name;
    in property <bool> is-default;
    in property <bool> is-active;
    in property <bool> selected;
    callback chosen();

    height: 32px;
    border-radius: 6px;
    background: root.selected
        ? Tok.accent-soft
        : (touch.has-hover ? Tok.chrome-sunken : transparent);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        Text {
            text: root.name;
            color: root.selected ? Tok.ink-strong : Tok.ink;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.is-active: Text {
            text: "●";
            color: Tok.accent;
            font-size: 10px;
            vertical-alignment: center;
        }
        if root.is-default: Text {
            text: "★";
            color: Tok.ink-muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
}

export component WorkspaceManager inherits Rectangle {
    background: Tok.paper;

    in property <bool> read-error;
    in property <string> read-error-text;
    callback read-error-reset-requested();

    in property <[WorkspaceRow]> workspaces;
    in property <int> selected: -1;
    callback row-chosen(int);
    callback create-requested();
    callback clone-requested();
    in property <bool> cloning;
    callback duplicate-requested();
    callback rename-requested();
    callback default-toggled();
    callback remove-requested();
    callback reset-view-requested();

    in property <[WorkspaceFolderRow]> folders;
    callback folder-add-requested();
    callback folder-mode-toggled(int);
    callback folder-move-up-requested(int);
    callback folder-move-down-requested(int);
    callback folder-detached(int);
    callback folder-relocated(int);

    in property <[UnusedFolderRow]> unused-folders;
    callback unused-folder-removed(int);

    callback closed();
    callback open-selected();
    callback leave-requested();
    in property <bool> active;


    VerticalLayout {
        padding: 8px; spacing: 8px;
        VerticalLayout {
            vertical-stretch: 0;
            Text { text: @tr("Workspaces"); color: Tok.ink-strong; font-size: 15px; font-weight: 600; horizontal-stretch: 1; }
            if root.active: TextButton {
                wide: true; title: @tr("Back to Files"); clicked => { root.closed(); } }
        }
        ScrollView {
            horizontal-stretch: 1; vertical-stretch: 1;
            VerticalLayout {
                alignment: start; spacing: 8px;
                if root.read-error: Banner { danger: true; text: root.read-error-text; }
                if root.read-error: TextButton {
                wide: true; title: @tr("Reset the Workspace Registry…"); role: Role.danger; clicked => { root.read-error-reset-requested(); } }
                TextButton {
                wide: true; title: @tr("New Workspace…"); clicked => { root.create-requested(); } }
                TextButton {
                    wide: true; title: root.cloning ? @tr("Cloning Repository…") : @tr("Clone Repository…");
                    enabled: !root.cloning && !root.read-error;
                    clicked => { root.clone-requested(); }
                }
                if root.workspaces.length == 0: Text { text: @tr("Create a Workspace, then add folders."); color: Tok.ink-muted; font-size: 12px; wrap: word-wrap; }
                for row[index] in root.workspaces: WorkspaceListRow {
                    name: row.name; is-default: row.is-default; is-active: row.is-active;
                    selected: index == root.selected;
                    chosen => { root.row-chosen(index); }
                }
                Text { text: @tr("● Active   ★ Default at startup"); color: Tok.ink-muted; font-size: 11px; wrap: word-wrap; }
                if root.selected >= 0: VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: root.workspaces[root.selected].name; overflow: elide; }
                    TextButton {
                wide: true; title: @tr("Open Workspace"); role: Role.primary; clicked => { root.open-selected(); } }
                    HorizontalLayout {
                        spacing: 4px;
                        TextButton {
                wide: true; title: @tr("Rename…"); clicked => { root.rename-requested(); } }
                        TextButton {
                wide: true; title: @tr("Duplicate…"); clicked => { root.duplicate-requested(); } }
                    }
                    TextButton {
                wide: true; title: root.workspaces[root.selected].is-default ? @tr("Unset Default") : @tr("Set Default"); clicked => { root.default-toggled(); } }
                    SectionTitle { text: @tr("Folders"); }
                    TextButton {
                wide: true; title: @tr("Add Folder…"); clicked => { root.folder-add-requested(); } }
                    Text { text: @tr("Save mode applies to this folder in every Workspace that uses it."); color: Tok.ink-muted; font-size: 12px; wrap: word-wrap; }
                    for row[index] in root.folders: FolderRow {
                        path: row.path; users: row.users; mode-auto: row.mode-auto; missing: row.missing;
                        can-move-up: index > 0; can-move-down: index < root.folders.length - 1;
                        mode-toggled => { root.folder-mode-toggled(index); }
                        move-up => { root.folder-move-up-requested(index); }
                        move-down => { root.folder-move-down-requested(index); }
                        detached => { root.folder-detached(index); }
                        relocated => { root.folder-relocated(index); }
                    }
                    if root.folders.length == 0: Text { text: @tr("No folders in this Workspace yet"); color: Tok.ink-muted; font-size: 12px; wrap: word-wrap; }
                    TextButton {
                wide: true; title: @tr("Reset View…"); clicked => { root.reset-view-requested(); } }
                    TextButton {
                wide: true; title: @tr("Remove…"); role: Role.danger; clicked => { root.remove-requested(); } }
                }
                if root.active: TextButton {
                wide: true; title: @tr("Leave Workspace…"); clicked => { root.leave-requested(); } }
                if root.unused-folders.length > 0: SectionTitle { text: @tr("Unused Folder Settings"); }
                for row[index] in root.unused-folders: VerticalLayout {
                    spacing: 4px;
                    Text { text: row.path; color: Tok.ink-muted; font-size: 12px; overflow: elide; }
                    TextButton {
                wide: true; title: @tr("Remove…"); clicked => { root.unused-folder-removed(index); } }
                }
            }
        }
    }
}
