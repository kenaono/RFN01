import { HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";
import { EditorPane, PaneScreen, PreviewTile, PreviewSelectionRect, TabInfo, WordModeRow } from "editor-pane.slint";
import { Slider } from "controls.slint";
import { Tok } from "tokens.slint";
import { ColorCell, Field, Icon, IconButton, Icons, Ime, MenuFrame, MenuRow, MenuSep, PanelTab, PickRow, Role, StepRow, TextButton, TextRow } from "controls.slint";
// **Rustから触れるように名前を通す**：大域はこの根のファイルから輸出されていないと
// 窓の外から見えない。
export { Ime }
import { QuickDraft } from "quick-draft.slint";

/// 要件 7.9: 設定画面が出す語群の1行。
///
/// **数はモードを建てたときの結果**である（`WordMarks::build`）。画面はそれを
/// 読むだけ——数え役は1つ。
/// 語群の中の1行（単語チェックモード要件 4.2、2026-09-08）。
///
/// **語か、覚え書きか。**`#`で始まる行は覚え書きで、木には積まれず、語数にも
/// 数えられない——一覧の中では見出しとして立つ。
export struct WordRow {
    text: string,
    note: bool,
}

export struct WordGroupRow {
    name: string,
    words: int,
    /// **色を持つか**（2026-09-08）。持たない語群＝除外語群は、木には積まれて
    /// 最長一致で勝つが、何も塗らない——`カリオン`を入れておくと、その中で
    /// `リオン`が光らなくなる。
    paints: bool,
    /// 色を付けられない語の数（同じモードの他の語群と衝突）。**0でないことが目印**。
    conflicts: int,
    /// 同じ語群の中で二度書かれた語の数。色は付くので、掃除の手がかり。
    repeated: int,
    shown: color,
}

/// 重複ひとつぶんの言い分（要件 7.9）。
export struct WordTroubleRow {
    word: string,
    /// 真なら色を付けていない（セットをまたいだ衝突）。偽なら言うだけ。
    conflict: bool,
    /// どこで起きたか、書き手の言葉で。
    told: string,
}

// Re-exported so they stay part of this window's public API: Rust builds the
// pane model and the tile and selection models inside it, and they reach it
// through the generated types.
export { PaneScreen, PreviewTile, PreviewSelectionRect, TabInfo }

// 要件 12: a window of its own, opened from the menu here. **Exported through
// this file** because that is the one Slint compiles (`build.rs`).
export { QuickDraft }

// One boundary between two panes, where the layout tree put it (要件 6.4).
//
// Rust flattens the tree into these because Slint cannot draw one: a component
// may not instantiate itself, so a nesting of unknown depth has to arrive as a
// list of rectangles.
export struct PaneBoundary {
    x: float,
    y: float,
    width: float,
    height: float,
    // Whether the panes it divides sit side by side, which is what makes this a
    // vertical line that moves horizontally.
    side-by-side: bool,
}

// One row of the left pane, whichever of its three things is showing
// (要件 6.2).
//
// Flattened by Rust for the reason the pane boundaries are: a component may not
// instantiate itself, so a nesting of unknown depth arrives as a list that says
// how deep each row is. **The other two panels borrow the same shape** — a
// search result sits one step in under the file it was found in, and a history
// entry sits at the left — so one list draws all three.
export struct LeftRow {
    name: string,
    // How far in the row sits: from the work folder in the tree, from the file
    // it was found in among search results.
    depth: int,
    // Only the tree has these two; the other panels leave them false.
    folder: bool,
    // Whether this folder's contents are in the rows below it.
    open: bool,
    // Which row holds this one, and -1 for the ones the work folder holds
    // itself (要件 5.2). **So that a row can say where something let go on it
    // would land**: pointing at a file means the folder that file is in, and
    // the row cannot ask a path what holds it. The other panels leave it -1.
    parent: int,
}

export component AppWindow inherits Window {
    // The document in front, then the editor's name. It said
    // 「Editor - 横書き・縦書き切り替え検証」 until 2026-09-06, which was the
    // title of the technical validation this grew out of — true once, and a
    // title bar is the one place a writer reads the name of what they are in.
    // `RFN Edit` is the name the editor already writes on disk
    // (`%LOCALAPPDATA%\RFN Edit\`, `RFN-EDIT-SESSION`).
    title: root.document-title + " - RFN Edit";
    // 追加要件 2026-09-06: 紫背景に編集器の頭文字（`RE` — RFN Edit）。
    // The title bar and the task bar
    // read this. **Not the file's icon in Explorer** — that is a resource
    // compiled into the executable, which needs a build dependency this
    // repository does not vendor; `ui/icon.png` is the drawing either would use.
    icon: @image-url("icon.png");
    // preferred-*, not width/height: setting width and height on a Window makes
    // it a fixed size the window manager enforces, which is why the window could
    // not be resized at all. These give the same starting size and still resize.
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 400px;

    // Every pane, in pane-number order: row N is pane N. **One row is one
    // pane's whole view of the document** — its tiles, its caret, its scroll —
    // so the panes below are one repeated element rather than a copy of the
    // same bindings per pane, and an Nth pane is an Nth row (ペイン分割設計 5).
    //
    // in-out because some of the fields are written by the pane itself; the
    // rest are written from Rust.
    in-out property <[PaneScreen]> panes;
    // The boundaries between them, and the size of the area they were placed
    // in. The area is reported back because only the window knows it, and the
    // tree cannot hand out pixels it has not been told about.
    in property <[PaneBoundary]> boundaries;
    in-out property <float> editor-area-width: 0;
    in-out property <float> editor-area-height: 0;
    /// One boundary was dragged, by this much in each direction. Which of the
    /// two matters is the boundary's own business (要件 6.4).
    callback boundary-moved(int, float, float);
    /// The editing area is a different size, so the tree has different pixels
    /// to hand out.
    callback editor-area-resized();

    // The left pane (要件 6.2). Explorer only for now; 検索 and 履歴 are the
    // other two things it will show.
    in property <[LeftRow]> left-rows;
    in property <string> work-folder;
    in-out property <bool> tree-open: true;
    // 追加要件 2026-09-06: how wide the left pane is, in pixels.
    //
    // **A number rather than a length**, because it crosses to Rust for the
    // session (要件 8.5) and comes back the same way. The bounds are here and
    // in `tree_width_from` — the drag holds it and a stored value is held to
    // the same, so a session cannot put the panel where the pointer could not
    // bring it back from.
    in-out property <float> tree-width: 260;
    // Which of Explorer, 検索 and 履歴 is showing: 0, 1, 2 (要件 6.2). **Rust
    // holds it**, because the rows it puts in `left-rows` have to agree with
    // it, and a click means something different in each.
    in-out property <int> left-tab: 0;
    // The tabs themselves, so their number and their order live in one place;
    // `LeftTab::from_index` in Rust reads the same order.
    callback left-tab-chosen(int);
    /// Which row the file commands act on, or -1 for none. **Rust decides it**
    /// — it holds the selection by path, and works out where that sits every
    /// time the rows change (要件 5.2).
    /// Which row the file commands act on (要件 5.2). **Rust owns it** — it is
    /// worked out from the selected path every time the rows are drawn — but a
    /// right click moves it here first, because the row a menu is opening from
    /// has to look chosen before Rust has drawn anything.
    in-out property <int> tree-selected: -1;
    /// A row was clicked. What that does belongs to the panel showing:
    /// a folder opens or closes, a file is opened, a search result is gone to.
    callback left-row-activated(int);
    // 書き手の報告 2026-09-07: **二度目のクリックは「これを開いておく」。**
    // 一度のクリックは覗くだけで、次に選んだファイルがそのタブを取る。
    callback left-row-kept(int);
    callback work-folder-requested();
    /// The work folders opened before this one, newest first (要件 5.1).
    /// Names with the folder that holds them, the way the 履歴 panel names a
    /// file — Rust draws them, and the one already open is not among them.
    in property <[string]> recent-folders;
    /// Go back to one of them, by its place in that list.
    callback recent-folder-chosen(int);
    // The whole work folder, not the document in front (要件 7.7). Its own
    // field, separate from the find bar's: one asks about a document and the
    // other about a folder, and they are not the same question.
    in-out property <string> folder-needle;
    in property <string> folder-status;
    // 要件 7.7（2026-09-07追加）: どのフォルダを歩くか。名前だけを出し、
    // 道のりはマウスを載せたときに出す。`scoped`は作業フォルダより内側に
    // 絞られているかどうかで、**絞られていることが見えていなければ、
    // 見つからない言葉の理由が画面のどこにも無い。**
    in property <string> search-folder;
    in property <string> search-folder-path;
    in property <bool> search-folder-scoped;
    callback search-folder-requested();
    callback search-folder-reset();
    callback folder-search-requested();
    // 要件 2: the search runs on a thread of its own, so the answer arrives
    // after the callback that asked for it has long returned. **Rung by that
    // thread, through the event loop** — nothing here decides when.
    callback folder-search-finished();
    /// A file command, by the position of its button: 0 新規ファイル,
    /// 1 新規フォルダー, 2 名前変更, 3 複製, 4 削除, 5 エクスプローラー
    /// (要件 5.2). One callback carrying a number, the way a pane is named by
    /// its index; `TreeCommand::from_index` is the one place it is read.
    callback tree-command(int);
    /// Choose a row without acting on it (要件 5.2). What a right click does
    /// that a left click must not: the commands act on what is chosen, and
    /// opening the file or folding the folder is not what was asked for.
    callback left-row-picked(int);

    /// 要件 5.2: the row being carried through the tree, and where the hand is.
    ///
    /// **Held by the window** for the reason a carried tab's point is (要件
    /// 6.5): the row that was picked up and the row it is being offered to are
    /// two different rows, and neither can see the other. Each candidate
    /// compares the point with its own rectangle and answers for itself, and
    /// what it answers is what Rust is told to do — so the row that lights up
    /// and the folder the file lands in cannot disagree.
    ///
    /// **The rows are not drawn again while a carry is going on.** Publishing
    /// them would rebuild the very row whose grab is running (6.18/6.24), so
    /// the move happens after the hand lets go, from Rust, through a `Timer`.
    property <bool> tree-carrying: false;
    property <int> tree-carried-from: -1;
    /// Where the hand is, **in the coordinates the rows are laid out in**: `x`
    /// across a row, `y` down the list from its first row. Not the window's,
    /// and never `absolute-position` — an element carrying an `opacity` is
    /// wrapped in an `Opacity` item, and `absolute-position` then counts the
    /// row's place in the layout twice (6.26). Every row already knows its own
    /// `y` in this space, which is the only space the comparison needs.
    property <length> tree-carry-x;
    property <length> tree-carry-y;
    /// Where the rows under the carried one stop, from `file_tree::subtree_end`.
    /// Rows in `[tree-carried-from, tree-carry-end)` cannot receive it: a folder
    /// may not go inside itself. **Set once, when the carry starts** — a
    /// property costs no redraw of the rows, which is why Rust may be asked
    /// this in the middle of a drag at all.
    in-out property <int> tree-carry-end: 0;
    /// The row of the folder the carried one is already in, `-1` for the work
    /// folder itself. **It cannot receive what it already holds**, and saying
    /// so is what keeps every mark true: a mark that appears and then does
    /// nothing teaches the writer to distrust the ones that do.
    in-out property <int> tree-carry-parent: -1;
    /// Which row the hand is over: a row's number, `-1` the heading, `-2`
    /// nowhere. **Where it lands is `tree-drop-into`** — pointing at a file
    /// means the folder that file is in (要件 5.2), so the two differ whenever
    /// the writer aims at a folder's contents rather than at its name.
    property <int> tree-drop-hand: -2;
    /// The folder the carried row would land in, as a row's number, `-1` the
    /// work folder itself, `-2` nowhere. The work folder is the panel's own heading,
    /// because that heading **is** the work folder's name — and it is the one
    /// target that is always on screen, which is what a row scrolled out of
    /// sight is not.
    property <int> tree-drop-into: -2;
    /// A carry started at this row: Rust answers with `tree-carry-end`.
    callback tree-row-grabbed(int);
    /// A carried row was let go into `tree-drop-into` (要件 5.2).
    callback tree-row-dropped(int, int);
    /// 要件 5.2: one line in the diagnostic log for one gesture on a row — the
    /// row, how many moves reached it, whether the press ever did, whether it
    /// became a carry, where it would have landed, and whether the grab was
    /// taken away. **The rows sit inside a `ScrollView`**, and a Flickable
    /// delays a press and may claim the drag as a scroll (`flickable.rs`), so
    /// "it does not move" has more than one place to fail and only the log can
    /// say which one it was.
    callback tree-row-traced(int, int, bool, bool, int, bool);

    // Finding and replacing inside the document in front of the writer
    // (要件 7.7). One bar for the window rather than one per pane: the question
    // is about a document, and which document is the focused pane's business.
    in-out property <bool> find-open: false;
    // E1: 語・置換語・帯が言うことは`PaneScreen`の行にある（**面ごと**）。
    // ここに残っているのは、帯が「どの面に・どの形で」出ているかだけ。
    /// Bumped whenever the bar is asked for. **The search field cannot be
    /// reached from outside the bar** — an id does not cross a conditional —
    /// so the field watches this instead and takes the keyboard itself, which
    /// is the same shape the panes use for 6.14.
    in-out property <int> find-generation: 0;
    /// 帯が出たときに鍵盤をそこへ置くか（E1）。**F3から出したときだけ偽**
    /// ——本文で押した鍵で書き手が欄へ連れて行かれるのは、探し直しではない。
    in-out property <bool> find-focus: true;
    /// True searches on from the caret, false back towards the start.
    callback find-requested(bool);
    /// 検索の語が打ち変えられた。**数え直すだけ**で、本文のカーソルは動かない
    /// （E1）。
    callback find-typed();
    /// 探し方の入切（E1）。0＝大小の別、1＝単語単位、2＝範囲の中だけ。
    /// **範囲だけは入れるときに選択を写し取る**ので、Rustが答える。
    callback find-option(int);
    /// E1の④: 探した語の履歴を1つ遡る／戻る。1つめは↑か、2つめは置換欄か。
    callback find-history(bool, bool);
    // E4: 指定の行へ行く帯。**窓に1つ**——検索の帯と同じで、開いているペインが
    // その帯の相手である。
    in-out property <bool> goto-open: false;
    in-out property <int> goto-pane: 0;
    in-out property <string> goto-line;
    in-out property <string> goto-status;
    in-out property <int> goto-generation: 0;
    callback goto-requested(bool);
    callback goto-typed();
    callback goto-accepted();
    /// 探す条件を捨てる（E1、書き手の求め 2026-09-09）。
    callback find-cleared();
    /// Which pane the find bar is in, and whether it has its replace row
    /// (要件 7.7). **The bar is one document's**, so it is drawn inside the
    /// pane holding that document rather than across the window.
    in-out property <int> find-pane: 0;
    in-out property <bool> find-replacing: false;
    callback replace-requested();
    callback replace-all-requested();
    // Bumped from Rust after a toolbar command, to put the keyboard back where
    // it was. A pane is typed into through its IME TextInput, which only ever
    // takes focus on a pointer-up inside the pane — so a Button click, and a
    // modal dialog taking the window's focus away and giving it back, both
    // leave the editor unable to receive a keystroke until it is clicked again.
    in-out property <int> focus-generation: 0;
    // Which pane last held the keyboard, so that restoring it does not move it
    // to the other one in Split. Readable from Rust because leaving Split has
    // to carry the caret from the pane that was being written in (要件 7.2).
    in-out property <int> focused-pane: 0;
    in property <string> document-title: "無題1";
    // Whether the text has changed since it last agreed with its file. Set
    // from Rust the moment the flag moves, not polled.
    in property <bool> document-edited: false;
    /// 要件 10: what the status bar counts. **Five strings rather than one**,
    /// so the bar can space them the way it draws everything else and the
    /// warning can be the one thing in it that is not grey.
    in property <string> count-lines;
    in property <string> count-body;
    in property <string> count-source;
    in property <string> count-selected;
    /// 要件 10: where the caret is in the file, as `Ln 12, Col 5`. **Empty
    /// unless the pane showing it is on the source** — the preview's places
    /// are not the file's, so a column counted there would name a column the
    /// file does not have.
    in property <string> count-caret;
    in property <string> count-warning;
    /// 要件 E2: この文書の文字コードと改行——`UTF-8 BOM・CRLF`。
    in property <string> count-encoding;
    /// いまの文字コードが、開き直しの一覧の何番目か（要件 E2 の②）。
    /// **番号はRust側でしか作らない**——UTF-8 0／UTF-16 LE 1／UTF-16 BE 2／
    /// CP932 3で、BOMの有無は別に持っている（読むときは印を見るので、
    /// 開き直しで選ぶのは表のほうだけである）。
    in property <int> count-encoding-id;
    /// 開き直せるか＝この文書にファイルがあるか（要件 E2 の②）。
    in property <bool> count-encoding-reopenable;
    /// この文字コードで読み直す（要件 E2 の②）。
    callback reopen-encoding(int);

    /// E1: いま探している語と、その数——`「白猫」3 / 12`。**帯が閉じていても
    /// 見えている**唯一の場所で、打鍵のたびに数え直すので古くならない。
    in property <string> count-find;
    // 何かが起きたときに言うこと——開けない、組めない、保存できない、語を足した。
    //
    // **出る場所はステータスバー**（書き手の報告 2026-09-10：「何も言わないので、
    // 何か出した方がいいと思いました」）。以前は縦書きのペインの紙の上にだけ出して
    // いたので、**横書きで書いている書き手には一言も届いていなかった**——保存が
    // 断られたことさえ画面のどこにも無かった。窓に1つの場所へ移してある。
    in property <string> render-status;
    // The three quantities the typography validation is about. Character
    // spacing is extra advance as a percentage of the character's own size, so
    // 0 is DirectWrite's own; the other two are multipliers, so 100 is.
    /// 要件 9's values, **two sheets end to end**: the horizontal one's and
    /// then the vertical one's. What is on a sheet belongs to that direction —
    /// there is nothing to mark, because everything the panel shows while a
    /// sheet is chosen is that sheet's.
    ///
    /// `sheet-numbers` holds ten per sheet: the body size, the line advance,
    /// the character advance, the page margin, then H1 to H6. `palette` holds
    /// eight: the body ink, H1 to H6's, then the paper. `sheet-fonts` holds
    /// eight the same way, with the code family last. Rust owns all three; the
    /// panel reads the rows for `sheet` and asks Rust to change them.
    in property <[int]> sheet-numbers;
    in property <[color]> palette;
    in property <[string]> sheet-fonts;
    /// Which sheet the panel is showing: 0 horizontal, 1 vertical.
    in-out property <int> sheet: 0;
    /// 追加要件 2026-09-08: どの群を出しているか——0 General、1 Text、
    /// 2 Layout、3 Page。
    ///
    /// **窓が持つ**（パネルの中ではなく）。`PopupWindow`の中身は開くたびに
    /// 作り直されるので、そこに置いた値は毎回0へ戻る——書き手が Layout を
    /// 見ていて閉じ、また開けば、見たいのは Layout である。
    property <int> settings-tab: 0;
    /// What the picker lists, and what it is picking for. The list is read from
    /// the system the first time it is opened.
    in property <[string]> font-names;
    in-out property <int> font-slot: 0;
    in property <string> font-current;
    // A question with real buttons, drawn over the editor (要件 8.3, 8.4).
    //
    // **Not a Windows message box.** Those come with the buttons Windows has —
    // はい／いいえ／キャンセル — so what each one means has to go in the
    // paragraph above them. A question about losing work is exactly the
    // question that must not be answered by reading a paragraph, and 要件 8.3
    // asks for four choices where a message box offers three.
    //
    // It also runs no message loop of its own, which is what froze the editor
    // in 6.18 when a modal was opened from inside a repeater's callback. Every
    // tab's close button is inside one.
    in property <string> question-text;
    in property <[string]> question-choices;
    in property <bool> question-open: false;
    // A question answered by typing a name rather than by pressing one of
    // several buttons (要件 5.2). The same overlay: a name is still a question,
    // and a second way of asking one would be a second thing to keep clear of
    // 6.18.
    in property <bool> question-asks-name: false;
    in-out property <string> question-name;
    // Bumped when a name is asked for, so the field takes the keyboard. Same
    // shape as `find-generation`, and for the same reason: an id does not cross
    // a conditional.
    in-out property <int> question-generation: 0;
    // Which button was pressed, by position. **The last choice is always the
    // way out**: Esc answers with it, and so does anything else that dismisses
    // the question without choosing.
    callback question-answered(int);
    /// The second half of what a question says: what it costs, under the line
    /// that asks it. Empty when the question is one line.
    in property <string> question-detail;
    /// Which answer is the one that loses work (要件 8.4), counted the way Rust
    /// names them, or -1. **Told rather than guessed**: the button that throws
    /// something away has to look unlike the one beside it, and reading the
    /// label to decide would break the first time a label is reworded.
    in property <int> question-danger: -1;

    // Everything a pane raises. **The first argument is always which pane** —
    // its row of `panes`, counted from 0. Rust turns it back into a `PaneId`
    // and nothing else tells the panes apart, so a repeater only has to pass
    // its `index` here instead of a literal (ペイン分割設計 5).
    callback pane-selection-start(int, float, float, bool);
    /// E3の②: 行そのものを動かす・写す・消す。
    callback pane-line-edit(int, int);
    /// E10: 選んだ行を箇条書きにする、やめる。0=印、1=番号。
    callback pane-list-edit(int, int);
    /// E3の③: Enterで字下げ・箇条書き・引用を継ぐ。2つめはShiftが押されているか。
    callback pane-enter(int, bool);
    callback pane-selection-update(int, float, float);
    callback pane-selection-end(int, float, float);
    callback pane-select-all(int);
    callback pane-scroll-changed(int, float);
    /// 要件 8.5: the pane was told to move the view, and this is where it
    /// actually went. **Two numbers because they can differ**: a `Flickable`
    /// holds its viewport inside what the content allows, so a scroll asked for
    /// before the new document's size reached the view is a scroll that lands
    /// somewhere else.
    callback pane-scroll-applied(int, float, float);
    callback pane-resized(int);
    /// 文字が入ってきた。**変換から確定したものかどうか**まで言う——シェルへは
    /// 貼り付けではなく打鍵として渡すため。
    callback pane-text-input(int, string, bool);
    /// One keystroke for the shell in front of a pane (追加要件 Terminal).
    callback pane-terminal-key(int, string, int, bool, bool, bool);
    /// The wheel over a shell (追加要件 Terminal).
    callback pane-terminal-scrolled(int, float);
    /// The strip along the foot of a pane (追加要件 Terminal).
    callback pane-below-toggled(int);
    callback pane-below-resized(int, length);
    callback pane-below-key(int, string, int, bool, bool, bool);
    callback pane-below-scrolled(int, float);
    callback pane-below-selection(int, float, float, int);
    callback pane-below-sent(int);
    /// 書き手の報告 2026-09-08: 下段のシェルで選んでいるものを写す
    /// （要件 11.2 の`Ctrl+Shift+C`と同じ道）。
    callback pane-below-copy(int);
    callback pane-below-draft-edited(int, string);
    callback pane-navigate(int, bool);
    /// 要件 7.2 の変換、下段のシェルの上で。
    callback pane-below-preedit(int, string);
    callback pane-below-text(int, string, bool);
    /// 要件 11.3 の手つきで下段へ移る（true）／本文へ戻る（false）。
    callback pane-below-focus(int, bool);
    /// 追加要件 2026-09-06: the right button's rows that the window answers.
    callback pane-close-clean(int);
    callback pane-copy-path(int, int);
    /// A shell wrote something. **Rung from its reading thread**, so it says
    /// only that: which pane, and what changed, are decided on this side.
    callback terminal-woken();
    /// 追加要件 Terminal: open a shell in the pane the writer is in. The number
    /// is which shell, as a position in `terminal-shells`.
    callback terminal-requested(int);
    /// The shells a terminal tab can be opened on (追加要件 Terminal). **Named
    /// by Rust**, because the list is what can actually be started.
    in property <[string]> terminal-shells;
    /// 追加要件 2026-09-08: 設定ファイルが並べているシェルを、書かれたままの
    /// 形で（`名前 | コマンド行`）。
    ///
    /// **画面はこれを読まない。**メニューが読むのは上の`terminal-shells`——
    /// この機械に実際にあるものだけを名前で並べたほうである。ここに在るのは
    /// 「設定ファイルへ書き戻すもの」で、書き戻す関数が持っているのは窓だけ
    /// だから、窓が持っている。要件 9 の数・色・書体と同じ置き方。
    in property <[string]> terminal-shell-lines;
    /// 要件 7.9（2026-09-08）: **単語チェックモード**（書き手の指摘：ソースの
    /// 予約語の色分けと同じ考え）。**モードが語群を持ち、語群が色を持つ。**
    ///
    /// 選べるモード。**先頭は「なし」（番号0）**——色分けを止めるのにモードを
    /// 消す必要は無い（コードエディタの`Plain Text`にあたる）。
    in property <[WordModeRow]> word-mode-names;
    /// 前に出ている文書のモードの番号と、その名前。**ステータスバーに出る**（要件 10）。
    ///
    /// **指すのは番号、読むのは名前。**名前で指していたときは、モードの名前を
    /// 変えた瞬間に文書のモードが切れていた。
    in property <int> word-mode;
    in property <string> word-mode-name;
    /// **色分けが働いていない理由**（空なら働いている、2026-09-08）。
    ///
    /// この機能の値打ちは**色が付かなかったこと**にあるので（単語チェックモード
    /// 要件 2.1.1）、働いていない状態は**打ち間違えたのと同じ見た目になる**。
    /// 黙っていると、書き手は自分の原稿のほうを疑う。
    in property <string> word-mode-trouble;
    /// 前に出ている文書のモードを、この番号にする（ステータスバーから）。
    callback word-mode-chosen(int);
    /// そのペインの前に出ているタブのモードを、この番号にする（タブのメニューから）。
    callback pane-word-mode-chosen(int, int);
    /// 設定画面が開いているモード（-1でどれも開いていない）。**Rustが持つ**
    /// ——中身（語群・語・重複）はRustが作るモデルなので、開く先が変わったら
    /// 作り直さなければならない（書き手の報告 2026-09-08）。
    in-out property <int> word-mode-opened-at: -1;
    callback word-mode-opened(int);
    callback word-group-opened(int);
    /// いま名前を訊いている先（0＝訊いていない／1＝新しいモード／2＝新しい語群／
    /// 3＝モードの名前を変える／4＝語群の名前を変える）。
    ///
    /// **設定は一枚で終える**（書き手の求め 2026-09-08、単語チェックモード要件 7.4）。
    /// 名前は別の問いにせず、**この画面の中の欄で受ける**——「決定すると次の画面」が
    /// 続くと、何をしているのか分からなくなる。**一度に開くのは一つ**なので、
    /// 旗を2つ持たずに1つの数で言う。
    in-out property <int> word-naming: 0;
    in-out property <string> word-new-name;
    /// 名前が使えなかったときの言葉。**この画面の中に出す**——下の帯へ出すと、
    /// 目はいま欄の上にある。
    in-out property <string> word-naming-trouble;
    /// 名前を変えている行（3・4のときだけ意味がある）。
    in-out property <int> word-naming-at: -1;
    callback word-mode-renamed(int, string);
    callback word-group-renamed(int, string);
    /// 単語帳のファイルをタブで開く（単語チェックモード要件 5.4）。
    callback word-file-edited();
    /// その中の語群。
    in property <[WordGroupRow]> word-group-rows;
    /// 語の一覧を開いている語群（-1で閉じている）。**開いているものだけ語を窓へ
    /// 渡す**——数千語を毎回渡さないため。
    in-out property <int> word-group-opened-at: -1;
    in property <[WordRow]> word-group-words;
    /// 取り込みで見つかった重複。**色を付けられなかったものが先**に並ぶ。
    in property <[WordTroubleRow]> word-troubles;
    /// 全部でいくつ見つかったか（一覧は`SHOWN_TROUBLES`までしか出さない）。
    in property <int> word-trouble-count;
    /// いま重複の一覧を開いているか。
    in-out property <bool> word-troubles-shown: false;
    /// 前に出ている文書のモードの語群の名前。**編集面の右ボタンが「どこへ足すか」を
    /// 並べる**のに使う。
    in property <[string]> word-group-names;
    /// そのペインで選んでいる語を、何番目の語群へ足すか。
    callback pane-word-added(int, int);
    /// その語群から語を1つ落とす。
    callback word-removed(int, string);
    callback word-mode-added(string);
    callback word-mode-removed(int);
    callback word-group-added(int, string);
    callback word-group-removed(int);
    callback word-group-colour-picked(int);
    /// 除外語群にする／やめる（2026-09-08）。
    callback word-group-paint-toggled(int);
    /// 1行1語のファイルから足す／へ書き出す（**あってもよい道**）。
    callback word-group-imported(int);
    callback word-group-exported(int);
    /// 追加要件 2026-09-07: **どれが既定か。**接続先を訊かない場所——`＋`のNew Tab、
    /// タブ列のメニュー、ペインの下段——はすべてこれを起こす。設定にも残る。
    in-out property <int> default-shell: 0;
    callback default-shell-chosen(int);
    /// 追加要件 2026-09-08: 端末の見た目（要件 6.8）。
    ///
    /// **紙とは別に持つ。**要件 9 のシートは原稿の紙の設定で、端末を黒地で使うことと
    /// 何の関係も無い。書字方向も持たないので、設定でもシートの外に立つ。
    /// 16色（SGR）はここに無い——背景の明るさからRustが決める。
    in-out property <color> terminal-paper: #fcf9ef;
    in-out property <color> terminal-ink: #24211e;
    in-out property <string> terminal-font: "Consolas";
    in-out property <int> terminal-size: 15;
    /// どれを変えたのか（0 背景、1 文字）。色はWindowsの色ダイアログで選ぶので、
    /// 要件 9 の`color-picked`と同じ形——**開いてから戻ってくるまでのあいだに、
    /// 何を選んでいたのかを覚えておく場所**が要る。
    callback terminal-colour-picked(int);
    callback terminal-font-picked();
    /// 書体の一覧は要件 9 のものと同じ`font-menu`を使う。**どちらの欄のために
    /// 開いたか**を、開いた側がここで言う——戻る先だけが違う。
    in-out property <bool> font-for-terminal: false;
    callback terminal-size-stepped(int);
    /// 黒地／紙のひとまとめの選択。**背景と文字を一度に置く**——片方だけ変えた状態は
    /// 読めない画面で、そこを通らせない。
    callback terminal-theme-chosen(bool);
    /// 追加要件 2026-09-08: 要件 8.1 の自動退避を働かせるかどうか。
    ///
    /// **既定はOn。**何も言っていない書き手は、未保存の中身を捨ててくれとは
    /// 言っていない。Offにした瞬間に、置いてある作業コピーは全部消える。
    in-out property <bool> autosave: true;
    callback autosave-toggled(bool);
    // 要件 7.8・要件 10: 本文文字数がルビの読みを数えるか。**初期値は数えない**
    // ——投稿サイトへ出すための字数はルビを含まない。打ち込んだ量を知りたい
    // 人には逆が要るので、これは「正解が二つある」たぐいで、選ばせる。
    in-out property <bool> count-ruby: false;
    callback count-ruby-toggled(bool);
    // 要件 E9: ルビと傍点の記法を読むか。**既定はOn**——要件7.8がその記法で
    // 組めと言っているので、切りたい書き手が切る側である。**切ったら記号を
    // そのまま字として出す**（原稿のバイト列は元から変えていない）。
    // 数え方ではなく読み方なので、`count-ruby`と違って本文そのものが変わる。
    in-out property <bool> ruby-marks: true;
    callback ruby-marks-toggled(bool);
    /// 書き手の決定 2026-09-11: **どの記号を箇条書きの印として読むか**（`-`／`*`／`+`の
    /// 順に、読むなら真）。切った記号の行はただの本文になる。**3つとも同格**
    /// （CommonMarkがそう認めている）なので、`-`も切れる。
    in-out property <[bool]> bullet-marks: [true, true, true];
    callback bullet-mark-toggled(int);
    /// E3の④: `Tab`／`Shift+Tab`。2つめはShiftが押されているか。
    callback pane-tab(int, bool);
    callback pane-preedit-changed(int, string);
    callback pane-backspace(int);
    callback pane-delete(int);
    callback pane-move(int, int, bool);
    callback pane-home-end(int, bool, bool, bool);
    callback pane-preview-toggled(int);
    /// Turn a pane's tab the other way (要件 7.2). Costs that pane's engine
    /// being built again, so it is a button and never a side effect.
    callback pane-direction-toggled(int);
    /// Undo in the pane, or redo. True is the way forwards (要件 7.1, 11.2).
    callback pane-undo(int, bool);
    /// Copy the pane's selection, or cut it. True takes it out (要件 11.2).
    callback pane-copy(int, bool);
    /// Step through a pane's tabs (要件 11.3). True goes backwards.
    callback pane-tab-stepped(int, bool);
    /// Give the keyboard to the pane in a direction (要件 11.3): 0 left,
    /// 1 right, 2 up, 3 down. Rust decides which pane that is, from the
    /// rectangles the panes were placed in, and sets `focused-pane` itself.
    callback pane-focus-moved(int, int);
    /// Ask the Kill Ring for something, in a pane (要件 11.4・11.6).
    callback pane-kill(int, int);
    /// Start selecting in a pane, or stop (要件 11.4 の`Ctrl+Space`).
    callback pane-mark-toggled(int, bool);
    /// Divide the focused pane, right or down (要件 6.4). True is right.
    callback divide-requested(bool);
    /// Bring the arrangement back to the focused pane, gathering the tabs of
    /// the panes that go into it (要件 6.4).
    callback close-others-requested();
    /// Change the focused pane's place with the pane in a direction (要件 6.4):
    /// 0 left, 1 right, 2 up, 3 down — the numbering 要件 11.3's arrows use.
    callback swap-requested(int);
    // True when the pane taking input runs vertically. The IME lays its own
    // windows out from this, so it has to be told when focus moves.
    callback ime-vertical-requested(bool);
    /// 要件 9, 11.5: magnify one pane, in notches. **The pane is named** —
    /// the wheel acts on the pane it is over and the keys on the pane holding
    /// the keyboard, and neither is "the window".
    callback pane-zoom(int, int);
    callback pane-zoom-reset(int);
    /// 追加要件 2026-09-06: the zoom, straight to a number (the bar in the
    /// status bar). **A percentage, not notches** — the bar knows where it was
    /// put, and turning that into steps and back would round twice.
    callback pane-zoom-set(int, int);
    /// Move one of 要件 9's numbers. **The first argument says which**, in the
    /// order the panel draws them: 0 body size, 1 line height, 2 char spacing,
    /// 3 column gap, 4 to 9 the six heading levels. One callback rather than
    /// one each, the way `tree-command` carries the file commands.
    callback sheet-step(int, int);
    /// 要件 9: a setting given a value outright rather than stepped, for the
    /// ones whose values are a choice and not a quantity.
    callback sheet-chose(int, int);
    /// How many numbers one sheet holds in `sheet-numbers` (要件 9).
    ///
    /// **Rust owns it** (`SHEET_NUMBERS`) and sets it here, because the model is
    /// laid out by Rust and the window only reads it. It was a literal in a
    /// dozen places until adding two settings moved every row: the ones written
    /// as `sheet * 10` were all found, and the two written as the absolute row
    /// they landed on were not — so the vertical pane took its page margin from
    /// the line height and stood 100px off the top of its column.
    in-out property <int> sheet-stride: 12;
    /// The picker is about to open for one of the four families (要件 9): Rust
    /// reads the system's list if it has not yet, and says which family is the
    /// one set now. **Called before `show`**, so the list is there to draw.
    callback font-picked(int);
    /// A family was chosen for that slot.
    callback font-chosen(int, string);
    /// The swatch beside a colour was pressed (要件 9). The picker Windows
    /// draws is opened by Rust, from the event loop rather than from this
    /// click: it runs a message loop of its own (6.18).
    callback color-picked(int);
    callback typography-reset();
    callback open-file-requested();
    /// 要件 12: open the quick draft window.
    ///
    /// **A request, not the window.** The one thing 要件 12.2 asks of the way
    /// it is opened is that opening it be separable from the click that opened
    /// it, so that a global shortcut can be given the same handle later.
    callback quick-draft-requested();
    callback save-requested();
    callback save-as-requested();
    /// Write every open document that has a file (要件 8.2). The one file
    /// command that is not about one pane, which is why it hangs off the app
    /// menu and Save with it does not.
    callback save-all-requested();
    /// Show the focused pane's document in Explorer (要件 5.2).
    callback reveal-requested();
    /// A pane's strip. **The first argument is which pane**, like everything
    /// else a pane raises; the position is in that pane's own strip.
    callback pane-tab-selected(int, int);
    callback pane-tab-closed(int, int);
    /// 追加要件 2026-09-06: a tab was held down — change the name of the file
    /// it stands for (要件 5.2).
    callback pane-tab-renamed(int, int, string);
    /// 要件 6.5: which pane's strip a tab was carried out of, from where in it,
    /// which place in that same strip it was over, and where the hand let go.
    ///
    /// **The point is in the editing area's coordinates**, which is where the
    /// pane rectangles are: Rust places the panes into that area and can say
    /// which of them a point is in without being told anything more.
    callback pane-tab-dropped(int, int, int, float, float);
    /// 要件 6.5: the carry that is going on, if one is — which pane it started
    /// in and where the hand is, in the editing area's coordinates.
    ///
    /// **Held by the window because a carry crosses the panes.** No pane can
    /// see another one, so the pane a tab would land in cannot be told by the
    /// pane it came from; each of them is given the point and answers for
    /// itself, against the rectangle it was placed in.
    property <bool> carrying: false;
    property <float> carry-x;
    property <float> carry-y;
    /// Close every tab in the window but the one in front of this pane, or
    /// every one (要件 6.3). No position: the pane says which tab is kept, and
    /// nothing else.
    callback pane-close-others(int);
    callback pane-close-all(int);
    callback pane-new-tab(int);
    // 追加要件 2026-09-07: New Tab に立っている三つの言葉のうち二つ。
    // **前に出ているタブがまだ何でもないなら、そのタブがそれになる**——
    // 何でもないタブが無ければ、これまでどおり新しいタブを開く。
    callback pane-new-file(int);
    callback pane-new-terminal(int, int);
    callback pane-switch-shell(int, int);
    /// Publish the strips again. Called from Rust when a document's unsaved
    /// marker moves, which is the one change to a strip that does not come from
    /// something the writer did to the strip itself.
    callback republish-tabs();

    /// Close whichever of the window's own menus is open, and say whether one
    /// was. The panes close theirs; this is what they ask about afterwards.
    ///
    /// The tree's row menus are not here: each one belongs to the row it hangs
    /// from, inside a repeater, and there is nothing to name from out here.
    /// They close by being clicked away from.
    function dismiss-menus() -> bool {
        if (app-menu.is-open) {
            app-menu.close();
            return true;
        }
        // **`settings-panel.is-open` is not read**, and closing it blind is
        // the price. Reading it makes the compiler generate a setter for
        // `is-open`, and the code it writes for a `show()` that reaches up
        // through two components does not compile (技術検証 6.22). This one is
        // opened from inside the app menu and from inside a pane; the others
        // are opened from the component that declares them. Closing a popup
        // that is not open does nothing, so what is lost is only the answer:
        // Escape closes this panel without being able to say that it did.
        settings-panel.close();
        // The folder history is closed blind for the same reason, and it is
        // the same case: it is opened from a row inside the app menu, which is
        // two components up from here (要件 5.1). Reading its `is-open` is what
        // makes that `show()` fail to compile — tried, and it does.
        recent-menu.close();
        return false;
    }

    VerticalBox {
        spacing: 0px;

        // 要件 6.1: the left pane, the editing area and the status bar. The
        // left pane is the writer's way into the work folder (要件 6.2) and can
        // be put away when the writing needs the width.
        HorizontalLayout {
            spacing: 0px;

            // The rail stays whatever the panel does, so putting the panel
            // away does not lose which of the four the writer was in — and a
            // fifth panel later costs a button rather than a redesign. The four
            // used to be tabs across the top of the panel: 260px in four equal
            // shares is 62px, which 「アウトライン」 does not fit in, and a name
            // cut short is not a name.
            Rectangle {
                width: 40px;
                background: Tok.chrome-raised;

                // **The whole of the window's own chrome is this rail**
                // (2026-09-06). There was a 34px bar above everything holding
                // two buttons — the menu, and whether the panel was showing.
                // The menu belongs at the head of the rail as readily as
                // anywhere, and the second button was saying something the four
                // below it can say by themselves: pressing the panel you are
                // already in puts it away. A row that holds two buttons costs a
                // row of the document.
                //
                // (40 - 26) / 2 on x, so the button sits in the middle of the
                // rail; 30px apart down it.
                IconButton {
                    x: 7px;
                    y: 4px;
                    icon: Icons.menu;
                    tip: "Menu";
                    clicked => {
                        app-menu.show();
                    }
                }

                // **Pressing the panel already showing puts it away**, which is
                // what the sidebar button used to be for. Nothing is lost by
                // closing it: the rail stays, and which of the four the writer
                // was in stays with it.
                IconButton {
                    x: 7px;
                    y: 40px;
                    icon: Icons.folder;
                    tip: "Explorer";
                    checked: root.tree-open && root.left-tab == 0;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 0);
                        root.left-tab = 0;
                        root.left-tab-chosen(0);
                        root.focus-generation += 1;
                    }
                }

                IconButton {
                    x: 7px;
                    y: 70px;
                    icon: Icons.search;
                    tip: "Search";
                    checked: root.tree-open && root.left-tab == 1;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 1);
                        root.left-tab = 1;
                        root.left-tab-chosen(1);
                        root.focus-generation += 1;
                    }
                }

                IconButton {
                    x: 7px;
                    y: 100px;
                    icon: Icons.history;
                    tip: "History";
                    checked: root.tree-open && root.left-tab == 2;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 2);
                        root.left-tab = 2;
                        root.left-tab-chosen(2);
                        root.focus-generation += 1;
                    }
                }

                IconButton {
                    x: 7px;
                    y: 130px;
                    icon: Icons.outline;
                    tip: "Outline";
                    checked: root.tree-open && root.left-tab == 3;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 3);
                        root.left-tab = 3;
                        root.left-tab-chosen(3);
                        root.focus-generation += 1;
                    }
                }

                // Declared here so its position is read against the rail. A popup is
                // its own layer, so it is drawn over the panes without the window
                // having to hold it last the way the question overlay does.
                //
                // `close-on-click-outside` is the whole of "click away to dismiss".
                // Escape is not wired yet: a FocusScope in here would take the
                // keyboard, and clicking away closes the popup without running any
                // of our code, so there would be no moment left to hand the
                // keyboard back to the pane.
                app-menu := PopupWindow {
                    x: 40px;
                    y: 4px;
                    width: 264px;
                    close-policy: close-on-click-outside;

                    MenuFrame {
                        width: 264px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;

                            MenuRow {
                                title: "Open File…";
                                shortcut: "Ctrl+O"; activated => {
                                    app-menu.close();
                                    root.open-file-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            MenuRow {
                                title: "Open Folder…";
                                activated => {
                                    app-menu.close();
                                    root.work-folder-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            // Nothing to go back to on a first run, and a row that
                            // opens an empty menu is a row that lies.
                            if root.recent-folders.length > 0: MenuRow {
                                title: "Recent Folders";
                                // The mark a submenu carries, in the column the
                                // shortcuts use. There is no key for this one.
                                shortcut: "▸";
                                // **Shown first, closed second**, which is the
                                // opposite of every plain row above and the same
                                // as the tab list's rows. An `if` compiles to a
                                // repeater, so this row is a repeated element:
                                // closing the menu takes the element whose handler
                                // is running with it, and the line after it never
                                // runs. Written the other way round the row is
                                // there, the menu closes, and nothing opens.
                                activated => {
                                    recent-menu.show();
                                    app-menu.close();
                                }
                            }
                            MenuRow {
                                title: "New Terminal";
                                // The mark a submenu carries, in the column the
                                // shortcuts use — the same one Recent Folders
                                // has. **Shown first, closed second**, for the
                                // reason written there.
                                shortcut: "▸";
                                activated => {
                                    shell-menu.show();
                                    app-menu.close();
                                }
                            }
                            MenuRow {
                                title: "Quick Draft…";
                                activated => {
                                    app-menu.close();
                                    root.quick-draft-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            MenuSep { }
                            MenuRow {
                                title: "Save All";
                                activated => {
                                    app-menu.close();
                                    root.save-all-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            MenuSep { }
                            // 追加要件 2026-09-08: **探す相手がいないときは
                            // 出さない。**この行は要件 7.7 の帯をいま鍵盤を
                            // 持っているペインの上に開くが、そこにシェルが
                            // 立っているなら帯が読むのはその裏の見えない文書
                            // ——押せて、開いて、何も見つからない。
                            //
                            // **`if`の中の行は頼んでから閉じる**（6.24）。
                            if !root.panes[root.focused-pane].terminal: MenuRow {
                                title: "Find in File…";
                                shortcut: "Ctrl+F"; activated => {
                                    root.find-pane = root.focused-pane;
                                    root.find-replacing = false;
                                    root.find-open = true;
                                    root.find-generation += 1;
                                    root.focus-generation += 1;
                                    app-menu.close();
                                }
                            }
                            // E4: 指定の行へ。**探す相手がいないときは出さない**
                            // のは上の行と同じ理由で、シェルの立っているペインに
                            // 行番号は無い。
                            //
                            // **頼んでから閉じる**（技術検証 6.24）。条件付きの行は
                            // `repeater`なので、先に閉じるとハンドラが走っている当の
                            // 要素ごと消え、次の行へ来ない——書き手の報告 2026-09-10：
                            // 「6だけうまくいきませんでした」。上の`Find in File…`が
                            // 頼んでから閉じているのは、同じ穴を踏んだからである。
                            if !root.panes[root.focused-pane].terminal: MenuRow {
                                title: "Go to Line…";
                                shortcut: "Ctrl+G";
                                activated => {
                                    // メニューから来た求めは「そちらへ移りたい」で
                                    // あって、閉じてほしいという意味ではない。
                                    root.goto-requested(true);
                                    app-menu.close();
                                }
                            }
                            MenuRow {
                                title: "Find in Folder…";
                                activated => {
                                    app-menu.close();
                                    root.tree-open = true;
                                    root.left-tab = 1;
                                    root.left-tab-chosen(1);
                                    root.focus-generation += 1;
                                }
                            }
                        }
                    }
                }

                // 要件 5.1: the folders worked in before this one. A menu of its
                // own rather than a submenu — the row above closes `app-menu` and
                // shows this one, which is how `Layout…` already opens a panel
                // from a menu. It stands in the same place, so the list appears
                // where the writer was looking.
                // 追加要件 Terminal: which shell the new tab runs. **A list
                // rather than two rows**, because the writer will meet the same
                // choice again in the `+` button and it should read the same
                // way in both places.
                shell-menu := PopupWindow {
                    x: 40px;
                    y: 4px;
                    width: 264px;
                    close-policy: close-on-click-outside;

                    MenuFrame {
                        width: 264px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;

                            for shell[index] in root.terminal-shells: MenuRow {
                                title: shell;
                                // **閉じるのは最後**（2026-09-07）。`close`の
                                // 後ろに書いたものは、木ごと捨てられた行から
                                // `root`へ登れずに落ちることがある——下の
                                // `recent-menu`の注記と同じ話で、順を揃えた。
                                activated => {
                                    root.terminal-requested(index);
                                    root.focus-generation += 1;
                                    shell-menu.close();
                                }
                            }
                        }
                    }
                }

                recent-menu := PopupWindow {
                    x: 40px;
                    y: 4px;
                    width: 264px;
                    close-policy: close-on-click-outside;

                    MenuFrame {
                        width: 264px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;

                            for folder[index] in root.recent-folders: MenuRow {
                                title: folder;
                                // **Chosen first, closed second**, for the reason
                                // the tab list gives: these rows are a repeater
                                // inside the popup, and closing first takes the
                                // element whose handler is running with it.
                                activated => {
                                    root.recent-folder-chosen(index);
                                    root.focus-generation += 1;
                                    recent-menu.close();
                                }
                            }
                        }
                    }
                }

                // 追加要件 2026-09-06: **everything that is set for the whole
                // editor is behind this one button**, and it stands at the foot
                // of the rail rather than among the four above it — those four
                // choose what the panel beside them shows, and this one opens
                // something else entirely. The writer asked for it in the
                // bottom-left corner, which is where the rail ends.
                IconButton {
                    x: 7px;
                    y: parent.height - self.height - 7px;
                    icon: Icons.settings;
                    tip: "Settings";
                    clicked => {
                        settings-panel.show();
                        root.focus-generation += 1;
                    }
                }
            }

            if root.tree-open: Rectangle {
                width: root.tree-width * 1px;
                background: Tok.chrome;

                VerticalLayout {
                    padding: 0px;

                    if root.left-tab == 0: tree-head := Rectangle {
                        height: 34px;
                        // 要件 5.2: the work folder itself is a place to let a
                        // row go, and this heading is its name. **The one
                        // target that cannot be scrolled away** — the rows can
                        // be, and a mark that is sometimes absent is not a
                        // mark (6.25).
                        // **The band directly above the list**, said in the
                        // list's own coordinates: the heading is what the panel
                        // puts there, so one heading's height above the first
                        // row that is shown is the heading.
                        property <bool> under-carry: root.tree-carrying
                            && root.work-folder != ""
                            && root.tree-carry-parent != -1
                            && root.tree-carry-x >= 0px
                            && root.tree-carry-x < self.width
                            && root.tree-carry-y < -tree-view.viewport-y
                            && root.tree-carry-y >= -tree-view.viewport-y - self.height;
                        // **Cleared by whoever set it**, so that leaving a
                        // target and entering another can happen in either
                        // order without the two undoing each other.
                        changed under-carry => {
                            if (self.under-carry) {
                                root.tree-drop-hand = -1;
                                root.tree-drop-into = -1;
                            } else if (root.tree-drop-hand == -1) {
                                root.tree-drop-hand = -2;
                                root.tree-drop-into = -2;
                            }
                        }
                        // **Lit by any row whose folder is the work folder**,
                        // not only by the hand being on the heading: a file
                        // sitting at the top of the tree says "into the work
                        // folder", and this is where the work folder is drawn.
                        property <bool> receiving: root.tree-carrying
                            && root.tree-drop-into == -1;
                        background: self.receiving ? Tok.accent-faint : Tok.chrome-raised;
                        border-width: self.receiving ? 2px : 0px;
                        border-color: Tok.accent;

                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 6px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 2px;

                            Text {
                                text: root.work-folder == ""
                                    ? "No folder open"
                                    : root.work-folder;
                                color: Tok.ink;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            // 要件 5.2: **the two commands that have no row to
                            // act on.** The other four are each row's own, in
                            // the menu it carries; these two cannot be, because
                            // a folder with nothing in it has no row to ask.
                            // The three never appear together: with no work
                            // folder there is nothing to create in, and opening
                            // one is the only thing left to do.
                            if root.work-folder == "": IconButton {
                                icon: Icons.folder;
                                tip: "Open Folder";
                                clicked => {
                                    root.work-folder-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            // 追加要件 2026-09-06: **the `+` asks what kind**,
                            // the same three-way question the tab strip's `+`
                            // asks — a file, a shell, or a folder.
                            // **釦と一緒の箱に入れる**（書き手の指摘 2026-09-07:
                            // メニューが☰の場所に出る）。popupはレイアウトの
                            // 子にならないので、行に直に置くと座標の原点が
                            // 「ボタンの列の左上」——つまり左のレールの隣——に
                            // なり、`-150px`はそこから更に左＝☰の上へ出ていた。
                            // 箱の中なら原点はこの釦自身で、真下に置ける。
                            //
                            // 釦とpopupを同じ`if`の中へ入れられるのは、両方が
                            // 同じ要素の中にいるから（技術検証6.24が言うのは
                            // 「repeaterの外から中のidは掴めない」で、中から
                            // 中は掴める）。
                            if root.work-folder != "": Rectangle {
                                width: 26px;
                                height: 26px;

                                IconButton {
                                    icon: Icons.plus;
                                    tip: "New";
                                    clicked => {
                                        tree-plus-menu.show();
                                    }
                                }

                            tree-plus-menu := PopupWindow {
                                x: 0;
                                y: 28px;
                                width: 220px;
                                close-policy: close-on-click-outside;

                                MenuFrame {
                                    width: 220px;

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 1px;

                                        // **頼んでから閉じる**（2026-09-07）。
                                        // `close`はこの行の立っている木を捨てる
                                        // ので、後に書いたものは届かないことが
                                        // ある。
                                        MenuRow {
                                            title: "New File…";
                                            activated => {
                                                root.tree-command(0);
                                                tree-plus-menu.close();
                                            }
                                        }
                                        MenuRow {
                                            title: "New Terminal";
                                            activated => {
                                                root.terminal-requested(root.default-shell);
                                                root.focus-generation += 1;
                                                tree-plus-menu.close();
                                            }
                                        }
                                        MenuRow {
                                            title: "New Folder…";
                                            activated => {
                                                root.tree-command(1);
                                                tree-plus-menu.close();
                                            }
                                        }
                                    }
                                }
                            }
                            }
                            // **The folder button opens a folder** (追加要件
                            // 2026-09-06). Making a folder moved into the `+`
                            // beside it, where the other two "new" rows are; a
                            // button that made one and a button that opened one
                            // wore the same icon and did opposite things.
                            if root.work-folder != "": IconButton {
                                icon: Icons.folder;
                                tip: "Open Folder";
                                clicked => {
                                    root.work-folder-requested();
                                    root.focus-generation += 1;
                                }
                            }
                        }
                    }

                    // 要件 7.7: the question this panel asks is about the
                    // work folder, so it has its own field. The find bar above
                    // the editor asks about one document; the two are different
                    // questions and share nothing.
                    if root.left-tab == 1: Rectangle {
                        background: Tok.accent-faint;
                        vertical-stretch: 0;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            needle-in-folder := Field {
                                placeholder: "Search in folder";
                                text <=> root.folder-needle;
                                // Built when the panel is, so asking for it is
                                // enough to type into it.
                                init => {
                                    self.take-focus();
                                }
                                accepted => {
                                    root.folder-search-requested();
                                }
                            }

                            // 歩くフォルダ。押すと選び直せる。
                            HorizontalLayout {
                                spacing: 4px;

                                Rectangle {
                                    height: 24px;
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: pick-folder.has-hover
                                        ? Tok.chrome-raised
                                        : (root.search-folder-scoped
                                            ? Tok.accent-soft
                                            : transparent);

                                    Icon {
                                        x: 4px;
                                        y: (parent.height - self.height) / 2;
                                        commands: Icons.folder;
                                        tint: root.search-folder-scoped
                                            ? Tok.accent-strong
                                            : Tok.ink-faint;
                                    }

                                    Text {
                                        x: 24px;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width - 28px;
                                        text: root.search-folder;
                                        color: root.search-folder-scoped
                                            ? Tok.accent-strong
                                            : Tok.ink-muted;
                                        font-size: 12px;
                                        overflow: elide;
                                    }

                                    pick-folder := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search-folder-requested();
                                        }
                                    }

                                    // 道のりはここに出す。**TouchAreaより後に
                                    // 書く**——先に書くと下に敷かれてポインタを
                                    // 見ない（`IconButton`に同じ注記がある）。
                                    if root.search-folder-path != "": Tooltip {
                                        text: @markdown("\{root.search-folder-path}");
                                    }
                                }

                                if root.search-folder-scoped: IconButton {
                                    icon: Icons.close;
                                    tip: "Search the whole work folder";
                                    size: 24px;
                                    clicked => {
                                        root.search-folder-reset();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                TextButton {
                                    title: "Search";
                                    clicked => {
                                        root.folder-search-requested();
                                    }
                                }

                                Text {
                                    text: root.folder-status;
                                    color: Tok.accent;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    tree-view := ScrollView {
                        // 要件 5.2: the point being carried, but only while it
                        // is over the rows the writer can see. **A row scrolled
                        // out of sight still has a place in the list**, and the
                        // point is in that same list — so the part of it that
                        // is on screen is asked for here, once, rather than by
                        // every row. `viewport-y` is negative as the list is
                        // scrolled, so the top of what is shown is `-viewport-y`
                        // rows down.
                        property <bool> holds-carry: root.tree-carrying
                            && root.tree-carry-x >= 0px
                            && root.tree-carry-x < self.width
                            && root.tree-carry-y >= -self.viewport-y
                            && root.tree-carry-y < -self.viewport-y + self.visible-height;

                        VerticalLayout {
                            alignment: start;

                            for row[index] in root.left-rows: tree-row := Rectangle {
                                height: 24px;
                                // 要件 5.2: what this row can be given. A file
                                // is not a place to put anything, the folder
                                // it is already in cannot be given what it
                                // holds, and a folder cannot go inside itself.
                                // The folder a file sits in is drawn one row
                                // up wherever it is, so aiming at that costs
                                // nothing — and this way no mark ever says a
                                // drop will happen where it will not. The rows
                                // from the carried one to
                                // `tree-carry-end` are what is under it.
                                // Where something let go on this row would go:
                                // a folder takes it in, and anything else means
                                // the folder it is in — the same rule that
                                // decides where a new file is made (要件 5.2).
                                property <int> destination: row.folder
                                    ? index
                                    : row.parent;
                                property <bool> takes-carry: root.tree-carrying
                                    && root.left-tab == 0
                                    && self.destination != root.tree-carry-parent
                                    && (self.destination < root.tree-carried-from
                                        || self.destination >= root.tree-carry-end);
                                // Only the flow direction is compared: a row is
                                // as wide as the panel, and the view above has
                                // already answered for the other axis. **The
                                // row's own `y`**, which is where the layout put
                                // it and is the same space the point is in.
                                property <bool> under-carry: self.takes-carry
                                    && tree-view.holds-carry
                                    && root.tree-carry-y >= self.y
                                    && root.tree-carry-y < self.y + self.height;
                                changed under-carry => {
                                    if (self.under-carry) {
                                        root.tree-drop-hand = index;
                                        root.tree-drop-into = self.destination;
                                    } else if (root.tree-drop-hand == index) {
                                        root.tree-drop-hand = -2;
                                        root.tree-drop-into = -2;
                                    }
                                }
                                // **Two marks, because there are two answers.**
                                // The hand is on this row; what it lands in is
                                // the folder — and when the writer is pointing
                                // inside an open folder, that folder is a
                                // different row (or the heading).
                                property <bool> receiving: root.tree-carrying
                                    && root.tree-drop-into == index;
                                property <bool> pointed: root.tree-carrying
                                    && root.tree-drop-hand == index;
                                // The row in the writer's hand has gone pale,
                                // the way a carried tab does (要件 6.5): it
                                // stays where it is, because the tree is not
                                // drawn again until the hand lets go.
                                opacity: (root.tree-carrying
                                    && index == root.tree-carried-from) ? 0.45 : 1.0;
                                border-width: self.receiving ? 2px : 0px;
                                border-color: Tok.accent;
                                // The selected row is the one the file commands
                                // act on (要件 5.2), so it has to be visible
                                // which one it is.
                                background: self.receiving || self.pointed
                                    ? Tok.accent-faint
                                    : (index == root.tree-selected
                                        ? Tok.accent-soft
                                        : (entry.has-hover ? Tok.accent-faint : transparent));

                                // Whether the button went down on this row,
                                // where it went down, and whether it has since
                                // travelled far enough to be a carry rather
                                // than a click. **Four pixels**, the same as a
                                // tab's: a hand resting on a row is not
                                // perfectly still.
                                property <bool> pressing: false;
                                property <length> press-x;
                                property <length> press-y;
                                property <bool> carrying-self: false;
                                // How many moves reached this row while it was
                                // pressed. `0` says the press or the drag never
                                // arrived at all, which is a different fault
                                // from a carry that found nowhere to land.
                                property <int> moves: 0;

                                entry := TouchArea {
                                    // The hand is closed while a row is in it.
                                    mouse-cursor: tree-row.carrying-self
                                        ? MouseCursor.grabbing
                                        : MouseCursor.default;
                                    // **Not `clicked`.** A click is a press and
                                    // a release in the same place, which is
                                    // exactly what a carry is not, and both
                                    // come out of the same press — so the press
                                    // is followed here rather than asked about
                                    // afterwards (要件 5.2, and `Tab` in
                                    // controls.slint says it for 要件 6.5).
                                    //
                                    // 要件 5.2: the right button asks a row
                                    // what can be done to it. **Choosing the
                                    // row is not opening it** — the commands
                                    // act on what is chosen, and neither the
                                    // file nor the fold was asked for.
                                    //
                                    // The number is put here rather than left
                                    // to Rust, because Rust answers by drawing
                                    // the rows again — which would take this
                                    // row, and the menu hanging from it, away
                                    // in the middle of opening it.
                                    pointer-event(event) => {
                                        if (root.left-tab == 0
                                            && event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down) {
                                            root.tree-selected = index;
                                            root.left-row-picked(index);
                                            row-menu.show();
                                        }
                                        if (event.button != PointerEventButton.left) {
                                            return;
                                        }
                                        if (event.kind == PointerEventKind.down) {
                                            tree-row.pressing = true;
                                            tree-row.carrying-self = false;
                                            tree-row.moves = 0;
                                            tree-row.press-x = entry.mouse-x;
                                            tree-row.press-y = entry.mouse-y;
                                        }
                                        if (event.kind == PointerEventKind.up) {
                                            root.tree-row-traced(index,
                                                tree-row.moves,
                                                tree-row.pressing,
                                                tree-row.carrying-self,
                                                root.tree-drop-into,
                                                false);
                                            if (tree-row.carrying-self) {
                                                // **Asked first, put down
                                                // second**: the move is what
                                                // the drop means, and Rust is
                                                // told it before the marks it
                                                // was drawn from are cleared.
                                                root.tree-row-dropped(
                                                    index, root.tree-drop-into);
                                                root.tree-carrying = false;
                                                root.tree-carried-from = -1;
                                                root.tree-drop-hand = -2;
                                                root.tree-drop-into = -2;
                                            } else if (tree-row.pressing) {
                                                root.left-row-activated(index);
                                                root.focus-generation += 1;
                                            }
                                            tree-row.pressing = false;
                                            tree-row.carrying-self = false;
                                        }
                                        if (event.kind == PointerEventKind.cancel) {
                                            root.tree-row-traced(index,
                                                tree-row.moves,
                                                tree-row.pressing,
                                                tree-row.carrying-self,
                                                root.tree-drop-into,
                                                true);
                                            if (tree-row.carrying-self) {
                                                root.tree-carrying = false;
                                                root.tree-carried-from = -1;
                                                root.tree-drop-hand = -2;
                                                root.tree-drop-into = -2;
                                            }
                                            tree-row.pressing = false;
                                            tree-row.carrying-self = false;
                                        }
                                    }
                                    double-clicked => {
                                        root.left-row-kept(index);
                                    }
                                    moved => {
                                        tree-row.moves += 1;
                                        if (!tree-row.pressing || root.left-tab != 0) {
                                            return;
                                        }
                                        // **The point before the carry.** Every
                                        // row watches it, so setting `carrying`
                                        // first would have them all answer once
                                        // against a position from no drag at
                                        // all (要件 6.5 says the same of tabs).
                                        root.tree-carry-x = entry.mouse-x;
                                        root.tree-carry-y = tree-row.y + entry.mouse-y;
                                        if (!tree-row.carrying-self
                                            && (entry.mouse-x > tree-row.press-x + 4px
                                                || entry.mouse-x < tree-row.press-x - 4px
                                                || entry.mouse-y > tree-row.press-y + 4px
                                                || entry.mouse-y < tree-row.press-y - 4px)) {
                                            tree-row.carrying-self = true;
                                            root.tree-carried-from = index;
                                            root.tree-drop-hand = -2;
                                            root.tree-drop-into = -2;
                                            // Rust answers with how far the
                                            // rows under this one reach, and
                                            // answering costs no redraw.
                                            root.tree-row-grabbed(index);
                                            root.tree-carrying = true;
                                        }
                                    }
                                }

                                Text {
                                    // Depth is drawn rather than nested, because
                                    // the rows arrive flat (see `LeftRow`).
                                    x: 8px + row.depth * 14px;
                                    text: (row.folder ? (row.open ? "▾ " : "▸ ") : "　")
                                        + row.name;
                                    color: Tok.ink-strong;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    // Room for the `…`, which is not in a layout
                                    // with it: the button has to be declared
                                    // after the area that opens the row to take
                                    // a click at all.
                                    width: parent.width - self.x
                                        - (root.left-tab == 0 ? 28px : 8px);
                                }

                                // The same menu as the right button, for a
                                // pointer that is already on the row. Only the
                                // tree has one: a search hit and a heading are
                                // not files to be renamed.
                                if (root.left-tab == 0
                                    && (index == root.tree-selected || entry.has-hover)): IconButton {
                                    x: parent.width - self.width - 3px;
                                    y: (parent.height - self.height) / 2;
                                    size: 20px;
                                    icon: Icons.dots;
                                    clicked => {
                                        root.tree-selected = index;
                                        root.left-row-picked(index);
                                        row-menu.show();
                                    }
                                }

                                // One per row, which is what makes placing it
                                // free: it hangs from the row it acts on. The
                                // compiler builds it when it is shown, not when
                                // the row is drawn.
                                //
                                // **Closed before the command, the opposite of
                                // the tab list** (技術検証 6.22): these rows are
                                // written out rather than repeated, so closing
                                // does not take the element running the handler
                                // with it — and half of these commands draw the
                                // tree again, which does take the row away.
                                row-menu := PopupWindow {
                                    x: 8px;
                                    y: 24px;
                                    width: 230px;
                                    close-policy: close-on-click-outside;

                                    MenuFrame {
                                        width: 230px;

                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 1px;

                                            MenuRow {
                                                title: "New File…";
                                                activated => {
                                                    row-menu.close();
                                                    root.tree-command(0);
                                                }
                                            }
                                            MenuRow {
                                                title: "New Folder…";
                                                activated => {
                                                    row-menu.close();
                                                    root.tree-command(1);
                                                }
                                            }
                                            MenuSep { }
                                            MenuRow {
                                                title: "Rename…";
                                                activated => {
                                                    row-menu.close();
                                                    root.tree-command(2);
                                                }
                                            }
                                            MenuRow {
                                                title: "Duplicate";
                                                activated => {
                                                    row-menu.close();
                                                    root.tree-command(3);
                                                    root.focus-generation += 1;
                                                }
                                            }
                                            MenuRow {
                                                title: "Reveal in Explorer";
                                                activated => {
                                                    row-menu.close();
                                                    root.tree-command(5);
                                                    root.focus-generation += 1;
                                                }
                                            }
                                            MenuSep { }
                                            // 要件 7.7（2026-09-07追加）: 見えて
                                            // いるフォルダを指して絞る。
                                            MenuRow {
                                                title: "Search in This Folder";
                                                activated => {
                                                    row-menu.close();
                                                    root.tree-command(6);
                                                }
                                            }
                                            MenuSep { }
                                            MenuRow {
                                                title: "Delete…";
                                                activated => {
                                                    row-menu.close();
                                                    root.tree-command(4);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 追加要件 2026-09-06: the edge the writer drags to make the left
            // pane wider or narrower.
            //
            // **The same shape as the boundaries between panes** — a wide grab
            // area with a thin line drawn inside it, thickening under the
            // pointer — because it is the same gesture and the hand should not
            // have to learn it twice. **A delta, not a position**: the layout
            // moves this element under the pointer, so `mouse-x` comes back to
            // `pressed-x` and the next event reports only what is new (the pane
            // boundaries say the same thing above).
            if root.tree-open: Rectangle {
                width: 9px;
                background: transparent;

                Rectangle {
                    x: tree-grab.has-hover || tree-grab.pressed ? 3px : 4px;
                    width: tree-grab.has-hover || tree-grab.pressed ? 3px : 1px;
                    height: parent.height;
                    background: tree-grab.has-hover || tree-grab.pressed
                        ? Tok.accent
                        : Tok.rule;
                }

                tree-grab := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        root.tree-width = max(160, min(640,
                            root.tree-width + (self.mouse-x - self.pressed-x) / 1px));
                    }
                }
            }

            editor-row := Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                // The tree can only hand out pixels it has been told about, and the
                // window is the only one who knows how many there are. Reported at
                // `init` as well as on change, for 6.11's reason: this element is
                // built at its final size on the first frame, so a size that is
                // right from birth never fires a change event.
                init => {
                    root.editor-area-width = self.width / 1px;
                    root.editor-area-height = self.height / 1px;
                    root.editor-area-resized();
                }
                changed width => {
                    root.editor-area-width = self.width / 1px;
                    root.editor-area-resized();
                }
                changed height => {
                    root.editor-area-height = self.height / 1px;
                    root.editor-area-resized();
                }

                for pane[index] in root.panes: Rectangle {
                    x: pane.x * 1px;
                    y: pane.y * 1px;
                    width: pane.width * 1px;
                    height: pane.height * 1px;

                    // Everything that tells the panes apart is the tab in front of
                    // each (要件 7.2), and the row behind it. A pane the tree does
                    // not name has no width, and then it is not here at all — which
                    // is what 6.11 and 6.14 are about: `EditorPane` reports its size
                    // and takes the keyboard at `init` as well as on change,
                    // because it is built when it becomes visible.
                    if pane.width > 0: EditorPane {
                        // 要件 7.7: one bar, in the pane that asked for it.
                        find-open: root.find-open && pane.id == root.find-pane;
                        find-focus: root.find-focus;
                        find-replacing: root.find-replacing;
                        find-needle <=> pane.find-needle;
                        find-replacement <=> pane.find-replacement;
                        find-status: pane.find-status;
                        find-match-case: pane.find-match-case;
                        find-whole-word: pane.find-whole-word;
                        find-regex: pane.find-regex;
                        find-in-scope: pane.find-scope-end > pane.find-scope-start;
                        find-generation: root.find-generation;
                        goto-open: root.goto-open && pane.id == root.goto-pane;
                        goto-line <=> root.goto-line;
                        goto-status: root.goto-status;
                        goto-generation: root.goto-generation;
                        width: parent.width;
                        height: parent.height;

                        vertical: pane.vertical;
                        // 要件 6.3: which pane the writer is in. The same flag
                        // `takes-focus` below reads, so the tab that looks
                        // focused and the pane that takes the keyboard cannot
                        // disagree.
                        focused: pane.id == root.focused-pane;
                        // 要件 6.4: which ways this pane has somebody to change
                        // places with. Rust works it out where it places them.
                        swap-left: pane.swap-left;
                        swap-right: pane.swap-right;
                        swap-up: pane.swap-up;
                        swap-down: pane.swap-down;
                        background: pane.vertical ? Tok.paper-alt : Tok.paper;
                        // 要件 9: this pane's sheet — the paper and the margin
                        // are that direction's, like everything else on it.
                        page-background: pane.vertical
                            ? root.palette[15]
                            : root.palette[7];
                        // **The pane picks the sheet, not the panel**: this is
                        // the margin of the direction this pane is writing in.
                        page-margin: root.sheet-numbers[
                            (pane.vertical ? 1 : 0) * root.sheet-stride + 3] * 1px;
                        // **One pane says it, not both.** A failure is about the
                        // document rather than about a direction, and saying it
                        // twice reads as two failures.
                        // **紙の上には出さない**（2026-09-10）。同じ知らせが2か所に
                        // 出ると、書き手はどちらが新しいかを考えることになる。
                        status: "";
                        // The vertical pane indents its own text instead of padding
                        // the column, because its scroll view has to reach the edge.
                        text-indent: pane.vertical ? 12px : 0px;
                        // 要件 9's 余白, on the axes that are not the flow.
                        // A vertical pane keeps nothing on its left and right:
                        // that is the axis its text runs along, and the margin
                        // there belongs to the engine rather than to the box.
                        side-padding: pane.vertical ? 0px : root.sheet-numbers[3] * 1px;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;

                        tabs: pane.tabs;
                        active-tab: pane.active-tab;
                        preview: pane.preview;

                        tiles: pane.tiles;
                        selection-rects: pane.selection-rects;
                        match-rects: pane.match-rects;
                        scope-rects: pane.scope-rects;
                        content-width: pane.content-width;
                        content-height: pane.content-height;
                        caret-visible: pane.caret-visible;
                        caret-x: pane.caret-x;
                        caret-y: pane.caret-y;
                        caret-width: pane.caret-width;
                        caret-height: pane.caret-height;
                        ime-anchor-x: pane.ime-anchor-x;
                        ime-anchor-y: pane.ime-anchor-y;
                        ime-anchor-width: pane.ime-anchor-width;
                        ime-anchor-height: pane.ime-anchor-height;
                        // The ones the pane writes. Two-way against a model row is
                        // a write to the model itself, not to a copy of the row, so
                        // Rust reads what the pane last put there.
                        ime-buffer <=> pane.ime-buffer;
                        scroll-x <=> pane.scroll-x;
                        scroll-y <=> pane.scroll-y;
                        scroll-to-x: pane.scroll-x;
                        scroll-to-y: pane.scroll-y;
                        scroll-generation: pane.scroll-generation;
                        scroll-applied(to, now) => {
                            root.pane-scroll-applied(pane.id, to, now);
                        }
                        shown-width <=> pane.shown-width;
                        shown-height <=> pane.shown-height;
                        focus-generation: root.focus-generation;
                        // **Only the pane the writer is in.** The old rule let
                    // every pane take the keyboard whenever there was no split,
                    // which meant two of them answered at once whenever the
                    // window had not been told there was one. Rust keeps
                    // `focused-pane` naming a pane that is on screen
                    // (`place_panes`), so this needs no second condition.
                    takes-focus: pane.id == root.focused-pane;

                        resized => { root.pane-resized(pane.id); }
                        scrolled(offset) => { root.pane-scroll-changed(pane.id, offset); }
                        selection-start(x, y, extend) => {
                            root.pane-selection-start(pane.id, x, y, extend);
                        }
                        line-edit(what) => {
                            root.pane-line-edit(pane.id, what);
                        }
                        list-edit(what) => {
                            root.pane-list-edit(pane.id, what);
                        }
                        enter-pressed(soft) => {
                            root.pane-enter(pane.id, soft);
                        }
                        selection-update(x, y) => { root.pane-selection-update(pane.id, x, y); }
                        selection-end(x, y) => { root.pane-selection-end(pane.id, x, y); }
                        select-all => { root.pane-select-all(pane.id); }
                        text-input(text, committed) => {
                            root.pane-text-input(pane.id, text, committed);
                        }
                        terminal: pane.terminal;
                        empty: pane.empty;
                        terminal-shells: root.terminal-shells;
                        default-shell: root.default-shell;
                        terminal-key(text, number, ctrl, alt, shift) => {
                            root.pane-terminal-key(pane.id, text, number, ctrl, alt, shift);
                        }
                        terminal-scrolled(delta) => {
                            root.pane-terminal-scrolled(pane.id, delta);
                        }
                        below-kind: pane.below-kind;
                        below-height: pane.below-height;
                        below-tiles: pane.below-tiles;
                        below-draft <=> pane.below-draft;
                        below-draft-lines: pane.below-draft-lines;
                        below-draft-edited(text) => {
                            root.pane-below-draft-edited(pane.id, text);
                        }
                        below-focus-generation: pane.below-focus-generation;
                        below-toggled => { root.pane-below-toggled(pane.id); }
                        navigate-requested(forward) => {
                            root.pane-navigate(pane.id, forward);
                        }
                        below-resized(height) => { root.pane-below-resized(pane.id, height); }
                        below-key(text, number, ctrl, alt, shift) => {
                            root.pane-below-key(pane.id, text, number, ctrl, alt, shift);
                        }
                        below-scrolled(delta) => { root.pane-below-scrolled(pane.id, delta); }
                        // **One callback for the three phases**, told apart by
                        // the number: 0 begins, 1 drags, 2 lets go.
                        below-selection-start(x, y) => { root.pane-below-selection(pane.id, x, y, 0); }
                        below-selection-update(x, y) => { root.pane-below-selection(pane.id, x, y, 1); }
                        below-selection-end(x, y) => { root.pane-below-selection(pane.id, x, y, 2); }
                        below-sent => { root.pane-below-sent(pane.id); }
                        below-copy => { root.pane-below-copy(pane.id); }
                        below-caret-x: pane.below-caret-x;
                        below-caret-y: pane.below-caret-y;
                        below-buffer <=> pane.below-buffer;
                        below-preedit(text) => { root.pane-below-preedit(pane.id, text); }
                        below-text(text, committed) => {
                            root.pane-below-text(pane.id, text, committed);
                        }
                        quick-draft-requested => { root.quick-draft-requested(); }
                        close-clean-tabs => { root.pane-close-clean(pane.id); }
                        copy-path-requested(index) => { root.pane-copy-path(pane.id, index); }
                        open-file-requested => { root.open-file-requested(); }
                        // The strip's own menu opens the default shell: the
                        // writer asked for a terminal, not for a distribution.
                        below-entered => { root.pane-below-focus(pane.id, true); }
                        below-left => { root.pane-below-focus(pane.id, false); }
                        tab-pressed(back) => { root.pane-tab(pane.id, back); }
                        preedit-changed(text) => { root.pane-preedit-changed(pane.id, text); }
                        backspace-pressed => { root.pane-backspace(pane.id); }
                        delete-pressed => { root.pane-delete(pane.id); }
                        move-caret(direction, extend) => {
                            root.pane-move(pane.id, direction, extend);
                        }
                        home-end(to-end, whole, extend) => {
                            root.pane-home-end(pane.id, to-end, whole, extend);
                        }
                        save-requested => { root.save-requested(); }
                        // **The key that opened the bar closes it** (要件 7.7):
                        // the same key, in the same pane, for the same one of
                        // the two shapes. Anything else — the other key, or the
                        // other pane — moves the bar rather than shutting it,
                        // because that is what was asked for.
                        find-requested(replacing) => {
                            root.focused-pane = pane.id;
                            // **同じ鍵は閉じる。ただし鍵盤がまだ欄に無いなら、
                            // 先に連れて行く**（E1、書き手の求め 2026-09-09）
                            // ——F3で静かに出た帯にCtrl+Fを押した書き手は、
                            // 閉じたいのではなく打ちたい。
                            if (root.find-open
                                && root.find-pane == pane.id
                                && root.find-replacing == replacing
                                && root.find-focus) {
                                root.find-open = false;
                                root.focus-generation += 1;
                                root.find-typed();
                            } else {
                                root.find-focus = true;
                                root.find-pane = pane.id;
                                root.find-replacing = replacing;
                                root.find-open = true;
                                root.find-generation += 1;
                                // **開いた瞬間に件数が出ている**（E1）。前に
                                // 探した語がそのまま欄に残っているので、
                                // 「いま何件あるか」は開けば分かってよい。
                                // 語が無ければこれが帯を空にする。
                                root.find-typed();
                            }
                        }
                        find-step(forwards) => {
                            root.find-requested(forwards);
                        }
                        find-typed => {
                            root.find-typed();
                        }
                        find-option(which) => {
                            root.find-option(which);
                        }
                        find-history(back, replacing) => {
                            root.find-history(back, replacing);
                        }
                        // E4: 出すのはRust——**開いた瞬間に「1〜128行」と言う**
                        // には、その文書に何行あるかを知っていなければならない。
                        goto-requested(taking) => {
                            root.focused-pane = pane.id;
                            root.goto-requested(taking);
                        }
                        goto-typed => {
                            root.goto-typed();
                        }
                        goto-accepted => {
                            root.goto-accepted();
                        }
                        goto-dismissed => {
                            root.goto-open = false;
                            root.focus-generation += 1;
                        }
                        find-cleared => {
                            root.find-cleared();
                        }
                        // **出すだけ。**`find-requested`は同じ鍵で閉じるので、
                        // F3から呼ぶと帯が消える。鍵盤も動かさない（世代を
                        // 上げない）——F3は本文で押される鍵である。
                        find-shown => {
                            if (!root.find-open || root.find-pane != pane.id) {
                                root.find-focus = false;
                                root.find-pane = pane.id;
                                root.find-replacing = false;
                                root.find-open = true;
                                root.find-typed();
                            }
                        }
                        replace-one => {
                            root.replace-requested();
                        }
                        replace-every => {
                            root.replace-all-requested();
                        }
                        find-dismissed => {
                            root.find-open = false;
                            root.focus-generation += 1;
                            // **閉じる鍵が、色を消す鍵でもある**（E1の③）。
                            // 帯が閉じたことは窓の中の出来事なので、こう言って
                            // やらないとRustは塗り直しに来ない。
                            root.find-typed();
                        }
                        tab-selected(index) => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id;
                            root.pane-tab-selected(pane.id, index);
                            root.focus-generation += 1;
                        }
                        tab-closed(index) => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id;
                            root.pane-tab-closed(pane.id, index);
                            root.focus-generation += 1;
                        }
                        tab-renamed(index, name) => {
                            root.focused-pane = pane.id;
                            root.pane-tab-renamed(pane.id, index, name);
                            // **No focus generation.** The question that opens
                            // takes the keyboard for its name field, and
                            // handing it back to the pane in the same frame is
                            // the fight 要件 5.2's four name commands already
                            // record.
                        }
                        // Whether the hand is over this pane. The rectangle
                        // is the one Rust placed it in, so this and the pane
                        // `drop_tab` decides on are the same answer.
                        carry-over: root.carrying
                            && root.carry-x >= pane.x
                            && root.carry-x < pane.x + pane.width
                            && root.carry-y >= pane.y
                            && root.carry-y < pane.y + pane.height;
                        carry-moved(at-x, at-y) => {
                            root.carry-x =
                                (at-x - editor-row.absolute-position.x) / 1px;
                            root.carry-y =
                                (at-y - editor-row.absolute-position.y) / 1px;
                            root.carrying = true;
                        }
                        carry-finished => {
                            root.carrying = false;
                        }
                        tab-dropped(from, to, at-x, at-y) => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it. Where the tab lands may
                            // move the keyboard on again; that is Rust's to say.
                            root.focused-pane = pane.id;
                            root.pane-tab-dropped(
                                pane.id,
                                from,
                                to,
                                (at-x - editor-row.absolute-position.x) / 1px,
                                (at-y - editor-row.absolute-position.y) / 1px);
                            root.focus-generation += 1;
                        }
                        new-tab-requested => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id;
                            root.pane-new-tab(pane.id);
                            root.focus-generation += 1;
                        }
                        new-file-requested => {
                            root.focused-pane = pane.id;
                            root.pane-new-file(pane.id);
                            root.focus-generation += 1;
                        }
                        new-terminal-requested(shell) => {
                            root.focused-pane = pane.id;
                            root.pane-new-terminal(pane.id, shell);
                            root.focus-generation += 1;
                        }
                        tab-shell-chosen(shell) => {
                            root.focused-pane = pane.id;
                            root.pane-switch-shell(pane.id, shell);
                            root.focus-generation += 1;
                        }
                        preview-toggled => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id;
                            root.pane-preview-toggled(pane.id);
                            root.focus-generation += 1;
                        }
                        direction-toggled => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id;
                            root.pane-direction-toggled(pane.id);
                            root.focus-generation += 1;
                        }
                        // The pane's own menu. Which pane it acts on is
                        // settled once, when it opens, rather than by every
                        // row — and being the pane the menu hangs from is what
                        // the two "left pane / right pane" buttons used to
                        // have to ask.
                        menu-opened => {
                            root.focused-pane = pane.id;
                        }
                        split-requested(right) => {
                            root.divide-requested(right);
                            root.focus-generation += 1;
                        }
                        swap-requested(towards) => {
                            root.focused-pane = pane.id;
                            root.swap-requested(towards);
                            root.focus-generation += 1;
                        }
                        close-others-requested => {
                            root.close-others-requested();
                            root.focus-generation += 1;
                        }
                        save-as-requested => {
                            root.save-as-requested();
                            root.focus-generation += 1;
                        }
                        reveal-requested => {
                            root.reveal-requested();
                            root.focus-generation += 1;
                        }
                        close-active-tab => {
                            root.pane-tab-closed(pane.id, pane.active-tab);
                            root.focus-generation += 1;
                        }
                        close-other-tabs => {
                            root.pane-close-others(pane.id);
                            root.focus-generation += 1;
                        }
                        close-all-tabs => {
                            root.pane-close-all(pane.id);
                            root.focus-generation += 1;
                        }
                        layout-requested => {
                            // **この面の組み方を開く**ので、開く先はそのタブ。
                            root.settings-tab = 4;
                            settings-panel.show();
                        }
                        // **No `focus-generation` here**: the wheel sends
                        // this from wherever the pointer is, and taking the
                        // keyboard away from the pane the writer is typing in
                        // is not part of magnifying the one they are pointing
                        // at. The menu rows come back to the pane they hang
                        // from through `menu-opened`.
                        zoom-stepped(notches) => {
                            root.pane-zoom(pane.id, notches);
                        }
                        zoom-reset-requested => {
                            root.pane-zoom-reset(pane.id);
                        }
                        undo-requested(forwards) => { root.pane-undo(pane.id, forwards); }
                        copy-requested(cut) => { root.pane-copy(pane.id, cut); }
                        tab-stepped(backwards) => { root.pane-tab-stepped(pane.id, backwards); }
                        focus-moved(towards) => { root.pane-focus-moved(pane.id, towards); }
                        kill-requested(what) => { root.pane-kill(pane.id, what); }
                        // 要件 7.9（2026-09-08）: 選んだ語を単語帳へ。
                        word-sets: root.word-group-names;
                        // 要件 7.9: このタブのモードを、このタブのメニューから。
                        word-modes: root.word-mode-names;
                        word-mode: pane.word-mode;
                        word-mode-chosen(mode) => {
                            root.pane-word-mode-chosen(pane.id, mode);
                        }
                        has-selection: pane.selection-rects.length > 0;
                        word-add-requested(at) => {
                            root.pane-word-added(pane.id, at);
                        }
                        mark-toggled(rectangular) => {
                            root.pane-mark-toggled(pane.id, rectangular);
                        }
                        escaped() => {
                            return root.dismiss-menus();
                        }
                        focus-taken => {
                            root.ime-vertical-requested(pane.vertical);
                            root.focused-pane = pane.id;
                        }
                    }
                }

                // Wider than the line it draws, so there is something to grab. The
                // line stays 1px until the pointer is on it.
                for boundary[index] in root.boundaries: Rectangle {
                    x: boundary.x * 1px;
                    y: boundary.y * 1px;
                    width: boundary.width * 1px;
                    height: boundary.height * 1px;

                    Rectangle {
                        x: boundary.side-by-side
                            ? (grab.has-hover || grab.pressed ? 3px : 4px)
                            : 0px;
                        y: boundary.side-by-side
                            ? 0px
                            : (grab.has-hover || grab.pressed ? 3px : 4px);
                        width: boundary.side-by-side
                            ? (grab.has-hover || grab.pressed ? 3px : 1px)
                            : parent.width;
                        height: boundary.side-by-side
                            ? parent.height
                            : (grab.has-hover || grab.pressed ? 3px : 1px);
                        background: grab.has-hover || grab.pressed ? Tok.accent : Tok.rule-strong;
                    }

                    grab := TouchArea {
                        mouse-cursor: boundary.side-by-side ? ew-resize : ns-resize;

                        // The delta, not a position: once the layout has moved this
                        // element under the pointer, `mouse-x` is back at
                        // `pressed-x` and the next event reports only what is new.
                        // Anchoring to a start position would double-count.
                        moved => {
                            root.boundary-moved(
                                index,
                                (self.mouse-x - self.pressed-x) / 1px,
                                (self.mouse-y - self.pressed-y) / 1px,
                            );
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 28px;
            background: Tok.chrome;

            // The rule is the top of this bar rather than the bottom of the
            // editing area, so that the bar is one thing.
            Rectangle {
                y: 0;
                height: 1px;
                background: Tok.rule;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 14px;

                Text {
                    // The marker is the whole of the unsaved indication, so it
                    // has to be beside the name rather than anywhere else.
                    text: root.document-edited
                        ? root.document-title + " *"
                        : root.document-title;
                    color: Tok.ink;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    // The one thing here that can be any length. Elided, so a
                    // long name gives way rather than pushing the counts off
                    // the end of the bar.
                    max-width: 280px;
                    overflow: elide;
                }

                Text {
                    text: root.count-lines;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.count-body;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.count-source;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.count-selected;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                // 要件 E2: **この文書が何で書かれているか。**開いたファイルの
                // 文字コードと改行で、新しい文書はこの編集器が書く形（UTF-8・LF）。
                // **押せば選べる**（E2の②、2026-09-10）——単語モードと倍率が
                // 同じ帯で押せるのと同じ形で、ここも「いま書いているものに
                // ついての設定」である。
                if root.count-encoding != "": Rectangle {
                    width: encoding-text.preferred-width + 12px;
                    horizontal-stretch: 0;
                    background: encoding-touch.has-hover ? Tok.chrome-raised : transparent;
                    border-radius: 4px;

                    encoding-text := Text {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        text: root.count-encoding;
                        color: Tok.ink-muted;
                        font-size: 12px;
                    }

                    encoding-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            encoding-menu.show();
                        }
                    }

                    // **押した言葉の真上に出す**（技術検証 6.30：押した釦と
                    // 同じ箱の中に置く）。**高さは数えて書く**——自分の高さを
                    // 訊きながら位置を決めるのは輪になった問いである（倍率の
                    // 一覧と同じ）。中身は3つ（見出し・線・4行／一言）で、間は2つ：
                    // 6+22+1+11+1+115+6＝162、開き直せないときは4行(115)が
                    // 一言(40)になるので 87。
                    //
                    // **保存はここに無い**（書き手の判断 2026-09-10：「ステータス
                    // バーで切り替えるのは、読み方だと思います」）。書く文字コードは
                    // 名前を付けて保存の欄で選ぶ——保存は行き先を決める操作なので、
                    // 決めごとが1つのダイアログに集まっているほうがよい。
                    encoding-menu := PopupWindow {
                        x: 0px;
                        y: -6px - (root.count-encoding-reopenable ? 162px : 87px);
                        width: 220px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 220px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 1px;

                                // **何をする一覧かを言う。**この帯が受け持つのは
                                // **読み方**で、書き方（保存の文字コード）は名前を
                                // 付けて保存の欄にある——同じ言葉で2つのことを
                                // させない（要件 E2：2つは別の操作である）。
                                Text {
                                    height: 22px;
                                    text: "この文字コードで開き直す";
                                    color: Tok.ink-faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }

                                MenuSep { }

                                // **ファイルが無ければ行を出さない**（要件 7.7）。
                                // 押せて、何も起きない行は、働いていないことを
                                // 隠している。
                                if !root.count-encoding-reopenable: Text {
                                    height: 40px;
                                    text: "まだ保存していない文書は\n開き直せません";
                                    color: Tok.ink-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }

                                // **頼んでから閉じる**（技術検証 6.24）。条件の
                                // 付いた行は繰り返し要素なので、先に閉じると
                                // ハンドラごと消える。
                                if root.count-encoding-reopenable: VerticalLayout {
                                    spacing: 1px;

                                    MenuRow {
                                        title: "UTF-8";
                                        checked: root.count-encoding-id == 0;
                                        activated => {
                                            root.reopen-encoding(0);
                                            encoding-menu.close();
                                        }
                                    }
                                    MenuRow {
                                        title: "UTF-16 LE";
                                        checked: root.count-encoding-id == 1;
                                        activated => {
                                            root.reopen-encoding(1);
                                            encoding-menu.close();
                                        }
                                    }
                                    MenuRow {
                                        title: "UTF-16 BE";
                                        checked: root.count-encoding-id == 2;
                                        activated => {
                                            root.reopen-encoding(2);
                                            encoding-menu.close();
                                        }
                                    }
                                    MenuRow {
                                        title: "CP932";
                                        checked: root.count-encoding-id == 3;
                                        activated => {
                                            root.reopen-encoding(3);
                                            encoding-menu.close();
                                        }
                                    }
                                }

                            }
                        }
                    }
                }

                // 要件 10: only the source has a line and a column to give.
                if root.count-caret != "": Text {
                    text: root.count-caret;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                // E1: **いま探している語が、この文書に何回あるか。**帯は閉じて
                // いることがあり、F3はそれでも効く——**効いたのが見えないのは、
                // 効かないのと見分けがつかない**ので、答えはここに出ている。
                // 打鍵のたびに数え直すので古くならない。
                if root.count-find != "": Text {
                    text: root.count-find;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    max-width: 280px;
                    overflow: elide;
                }

                // **起きたことは、どの向きの面で書いていても見える**（書き手の
                // 報告 2026-09-10）。数の並びより先に読めるよう、色を持たせてある
                // ——ここに出るのは「保存できません」のような、書き手が次の一手を
                // 決めなければならない知らせである。
                if root.render-status != "": Text {
                    text: root.render-status;
                    color: Tok.alert;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    overflow: elide;
                    max-width: 520px;
                }

                // 要件 7.3: a paragraph long enough to cost a keystroke. The
                // one thing in the bar that is not grey, because it is the one
                // thing that is about to be a problem.
                if root.count-warning != "": Text {
                    text: root.count-warning;
                    color: Tok.alert;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                // The only thing in the row that grows.
                Rectangle {
                    horizontal-stretch: 1;
                }

                // 要件 7.9（2026-09-08）: **単語チェックモード。**コードエディタが
                // 言語モードを出しているのと同じ場所である——いまどのモードかが
                // 常に見えていて、押せば切り替わる（書き手の指摘：構造として
                // 「自分の単語チェックモード」があればよい）。
                //
                // **モードは文書ごと**なので、前に出ているタブのものが出る。
                // 倍率の隣にあるのは、どちらも「いま書いているものについての
                // 設定」だからである。
                Rectangle {
                    width: mode-text.preferred-width + 12px;
                    horizontal-stretch: 0;
                    background: mode-touch.has-hover ? Tok.chrome-raised : transparent;
                    border-radius: 4px;

                    mode-text := Text {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        // **働いていない理由は、モードの名前の隣に出す。**
                        // 帯の言葉は次の報せで流れるが、これは続いているあいだ
                        // ずっと出ていなければならない。
                        text: root.word-mode-trouble == ""
                            ? root.word-mode-name
                            : root.word-mode-name + " · " + root.word-mode-trouble;
                        color: root.word-mode-trouble == "" ? Tok.ink-muted : Tok.alert;
                        font-size: 12px;
                    }

                    mode-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            mode-menu.show();
                        }
                    }

                    // **押した数の真上に出す**（倍率と同じ罠を踏まないため、
                    // 押した釦と同じ箱の中に置く＝技術検証 6.30）。
                    mode-menu := PopupWindow {
                        x: 0px;
                        y: -6px - min(root.word-mode-names.length, 12) * 30px;
                        width: 200px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 200px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 1px;

                                // **頼んでから閉じる**（技術検証 6.24）。
                                for row in root.word-mode-names: MenuRow {
                                    title: row.name;
                                    checked: row.id == root.word-mode;
                                    activated => {
                                        root.word-mode-chosen(row.id);
                                        mode-menu.close();
                                    }
                                }
                            }
                        }
                    }
                }

                // 要件 9: the zoom belongs to a pane now, so the bar shows
                // the focused pane's — the bar is about what the writer is
                // working in, the same as the counts to its left.
                // 追加要件 2026-09-06: **the number opens the bar that moves
                // it.** It was a readout; a writer who wants 130% had to press
                // Ctrl+= three times or find the pane's menu.
                Rectangle {
                    width: zoom-text.preferred-width + 12px;
                    horizontal-stretch: 0;
                    background: zoom-touch.has-hover ? Tok.chrome-raised : transparent;
                    border-radius: 4px;

                    zoom-text := Text {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        text: root.panes[root.focused-pane].zoom + "%";
                        color: Tok.ink-muted;
                        font-size: 12px;
                    }

                    zoom-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            zoom-menu.show();
                        }
                    }

                    // 書き手の報告 2026-09-07: **数の真上に立てる。**It hung from
                    // the row rather than from the number — a popup inside a
                    // layout is not laid out, so its corner was the *bar's*
                    // corner and the panel came up at the far left, an inch of
                    // window away from what had been clicked. Sitting inside
                    // the number's own box makes the two coordinates the same
                    // question, and standing the bar up keeps the whole thing
                    // as narrow as the number under it.
                    zoom-menu := PopupWindow {
                        x: (parent.width - 76px) / 2;
                        // **Told rather than measured.** The panel has to sit
                        // clear of the number it came from, and a popup asked
                        // for its own height while it is deciding where to be
                        // is a question in a circle: 8+16+6+150+6+28+8.
                        y: -228px;
                        width: 76px;
                        height: 222px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 76px;
                            height: 222px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                Text {
                                    text: root.panes[root.focused-pane].zoom + "%";
                                    color: Tok.ink;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }

                                Slider {
                                    vertical: true;
                                    minimum: 50;
                                    maximum: 240;
                                    value: root.panes[root.focused-pane].zoom;
                                    // **Ten at a time**, the step the keys and
                                    // the wheel already move by (要件 11.5):
                                    // the same number should be reachable
                                    // whichever way the writer moves it.
                                    moved(percent) => {
                                        root.pane-zoom-set(
                                            root.focused-pane,
                                            round(percent / 10) * 10);
                                    }
                                }

                                TextButton {
                                    title: "100%";
                                    wide: true;
                                    clicked => {
                                        zoom-menu.close();
                                        root.pane-zoom-reset(root.focused-pane);
                                        root.focus-generation += 1;
                                    }
                                }
                            }
                        }
                    }
                }

                // How the editing area is divided, in the one place that is
                // about the window rather than about the document.
                Rectangle {
                    width: arrangement.width + 21px;
                    horizontal-stretch: 0;

                    Icon {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        commands: Icons.split;
                        tint: Tok.ink-muted;
                    }

                    arrangement := Text {
                        x: 21px;
                        y: (parent.height - self.height) / 2;
                        // 要件 6.3: how many panes the editing area is
                        // divided into. A name for each of two panes could not
                        // survive the third.
                        text: root.panes.length > 1
                            ? "Panes: " + root.panes.length
                            : "One pane";
                        color: Tok.ink-muted;
                        font-size: 12px;
                    }
                }
            }
        }
    }

    // Opened from either menu, because there is only one set of values.
    //
    // 要件 9 makes the display settings one thing for the whole app — the zoom
    // is the only part that belongs to a pane, which is why it stays in the
    // pane's own menu and is not here. Two surfaces onto one set of values
    // would be two chances to disagree.
    // 要件 9: the families this machine has. **Beside the panel rather than
    // inside it**, so that opening it is not a click inside the panel closing
    // the panel; the two stack, and clicking away closes whichever is on top.
    //
    // Chosen first, closed second — these rows are a repeater inside a popup,
    // and closing first takes the element running the handler with it
    // (技術検証 6.22).
    font-menu := PopupWindow {
        x: (root.width - 320px) / 2;
        y: 90px;
        width: 320px;
        close-policy: close-on-click-outside;

        MenuFrame {
            width: 320px;

            VerticalLayout {
                padding: 6px;

                ScrollView {
                    height: 340px;

                    VerticalLayout {
                        alignment: start;
                        spacing: 1px;

                        for family[index] in root.font-names: MenuRow {
                            title: family;
                            checked: family == root.font-current;
                            activated => {
                                root.font-chosen(root.font-slot, family);
                                font-menu.close();
                            }
                        }
                    }
                }
            }
        }
    }

    settings-panel := PopupWindow {
        // Wider than a menu: 要件 9's six heading sizes are three to a row, and
        // three of them do not fit in a menu's 250px.
        x: (root.width - 380px) / 2;
        y: 40px;
        width: 380px;
        close-policy: close-on-click-outside;

        MenuFrame {
            width: 380px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 10px;

                    Text {
                        text: "SETTINGS";
                        color: Tok.ink-muted;
                        font-size: 11px;
                        letter-spacing: 0.9px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Text {
                        // 要件 9: the settings are the app's, not a pane's, and
                        // they are the formatted view's — the source is drawn
                        // plain whatever is set here.
                        text: "Live preview · all panes";
                        color: Tok.ink-faint;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Tok.rule;
                }

                // 追加要件 2026-09-08: **一度に一つの群だけ出す。**
                // 設定は増える一方で、一枚に積むと下のほうは窓から
                // 落ちる。帯で群を選び、下はその群だけになる。
                //
                // 面の並びは**書字方向を持つかどうか**で切れている：
                // General だけが方向を持たず、残りの3面はどれも
                // シート（横書き／縦書き）の上の値である。だから
                // シートを選ぶ釦は General には無く、他の3面に在る。
                HorizontalLayout {
                    alignment: start;
                    spacing: 2px;

                    PanelTab {
                        title: "General";
                        current: root.settings-tab == 0;
                        clicked => {
                            root.settings-tab = 0;
                        }
                    }
                    PanelTab {
                        title: "Terminal";
                        current: root.settings-tab == 1;
                        clicked => {
                            root.settings-tab = 1;
                        }
                    }
                    PanelTab {
                        title: "Words";
                        current: root.settings-tab == 2;
                        clicked => {
                            root.settings-tab = 2;
                        }
                    }
                    PanelTab {
                        title: "Text";
                        current: root.settings-tab == 3;
                        clicked => {
                            root.settings-tab = 3;
                        }
                    }
                    PanelTab {
                        title: "Layout";
                        current: root.settings-tab == 4;
                        clicked => {
                            root.settings-tab = 4;
                        }
                    }
                    PanelTab {
                        title: "Page";
                        current: root.settings-tab == 5;
                        clicked => {
                            root.settings-tab = 5;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Tok.rule;
                }

                if root.settings-tab == 0: VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "FILES";
                        color: Tok.ink-faint;
                        font-size: 10px;
                        letter-spacing: 0.9px;
                    }

                    // 追加要件 2026-09-08: 要件 8.1 の自動退避。**On/Offと、
                    // Offが何を意味するかを、同じ場所で言う**——「切ってある
                    // 間は書かない」だけなら、置いてある古い退避が次の起動で
                    // 戻ってきて、書き手の言ったこととちょうど逆になる。
                    HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: "Auto-save";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TextButton {
                            title: root.autosave ? "On" : "Off";
                            role: root.autosave ? Role.primary : Role.normal;
                            clicked => {
                                root.autosave-toggled(!root.autosave);
                            }
                        }
                    }

                    // 書き手の報告 2026-09-11: **見出しが中身を言っていなかった。**
                    // `FILES`の下にルビの記法も箇条書きの字も並んでいて、どれも
                    // ファイルの話ではない——**画面とソースが食い違えば、書き手と
                    // 私が別のものを指して話すことになる。**記法の読み書きは
                    // ここから下である。
                    Text {
                        text: "MARKUP";
                        color: Tok.ink-faint;
                        font-size: 10px;
                        letter-spacing: 0.9px;
                    }

                    // 要件 7.8（2026-09-09）: ルビを本文の字数に数えるか。
                    // **「正解が二つある」から選ばせる**——投稿サイトへ出す
                    // ための字数はルビを含まず、打ち込んだ量を知りたいときは
                    // 含む。編集器がどちらかに決めると、もう一方の用事の人が
                    // 毎回数え直すことになる。
                    HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: "Count ruby";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TextButton {
                            title: root.count-ruby ? "On" : "Off";
                            role: root.count-ruby ? Role.primary : Role.normal;
                            clicked => {
                                root.count-ruby-toggled(!root.count-ruby);
                            }
                        }
                    }

                    Text {
                        text: root.count-ruby
                            ? "《よみ》も本文の字数に入れます。"
                            : "《よみ》は本文の字数に入れません。";
                        color: Tok.ink-faint;
                        font-size: 11px;
                        overflow: elide;
                    }

                    // 要件 E9: ルビと傍点の記法を読むか。**Markdownの標準では
                    // ない**ので、切れなければ「この編集器でしか正しく見えない
                    // 書き方」を書き手に強いることになる。ルビと傍点を1つの旗で
                    // 切るのは、同じ記法の一族だからである。
                    HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: "Ruby markup";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TextButton {
                            title: root.ruby-marks ? "On" : "Off";
                            role: root.ruby-marks ? Role.primary : Role.normal;
                            clicked => {
                                root.ruby-marks-toggled(!root.ruby-marks);
                            }
                        }
                    }

                    Text {
                        text: root.ruby-marks
                            ? "｜漢字《かんじ》と《《傍点》》を記法として読みます。"
                            : "記号をそのまま字として出します。";
                        color: Tok.ink-faint;
                        font-size: 11px;
                        overflow: elide;
                    }

                    // 書き手の決定 2026-09-11: **どれを箇条書きの印として読むか。**
                    // CommonMarkは`-`・`*`・`+`を同格に認めているので、この編集器も
                    // 同格に扱う——**`-`も切れる**（「*も標準ということなら、扱いは
                    // 同じであるべき」）。切った記号の行はただの本文になり、記号も
                    // そのまま字として出る（原稿のバイト列は変えない）。
                    HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: "Bullet marks";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        for mark[index] in ["-", "*", "+"]: TextButton {
                            title: mark;
                            role: root.bullet-marks[index] ? Role.primary : Role.normal;
                            clicked => {
                                root.bullet-mark-toggled(index);
                            }
                        }
                    }

                    Text {
                        text: !root.bullet-marks[0] && !root.bullet-marks[1]
                            && !root.bullet-marks[2]
                            ? "箇条書きの印はありません（どの記号もただの本文です）。"
                            : (root.bullet-marks[0] ? "- " : "")
                                + (root.bullet-marks[1] ? "* " : "")
                                + (root.bullet-marks[2] ? "+ " : "")
                                + "を箇条書きの印として読みます。";
                        color: Tok.ink-faint;
                        font-size: 11px;
                        overflow: elide;
                    }

                    // **折り返さない。**`wrap: word-wrap`のTextは、`min-width`が
                    // 0になる代わりに`preferred-width`が「一行に伸ばしたときの
                    // 幅」のまま残る（`builtins.slint`, Text）。popupは開くとき
                    // に`preferred`で、その後の更新では`min`で大きさを決め直す
                    // ので、両者が食い違うぶんだけ**開いた直後に寸法が変わる**。
                    // `overflow: elide`なら`min-width`は同じく0で、高さは一行
                    // ぶんに定まる——幅と高さが互いを見ない形にしておく。
                    Text {
                        text: root.autosave
                            ? "入力が止まって2秒、続いていても5秒ごとに退避します。"
                            : "退避しません。切り替えたときに作業コピーも消えます。";
                        color: Tok.ink-faint;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                // 追加要件 2026-09-08（要件 6.8）: **端末は紙とは別の設定を持つ。**
                // 黒地で使う人が多く、要件9のシート（原稿の紙）と同じ値で決める
                // ものではない。書字方向も持たないので、シートを選ぶ釦はここにも
                // 無い。
                if root.settings-tab == 1: VerticalLayout {
                    spacing: 8px;

                    // 追加要件 2026-09-07: **書字方向を持たない設定はここ**。
                    // 2026-09-08 からはこの面が丸ごとそれで、シートを選ぶ釦は
                    // 隣の3面にある。
                    Text {
                        text: "TERMINAL";
                        color: Tok.ink-faint;
                        font-size: 10px;
                        letter-spacing: 0.9px;
                    }

                    PickRow {
                        label: "Default";
                        value: root.terminal-shells[root.default-shell];
                        pressed => {
                            default-shell-menu.show();
                        }
                    }

                    // **原点はこの群の左上**（技術検証 6.30：popupを
                    // レイアウトに直に置くと、そのレイアウトの左上から
                    // 数える）。帯の下に群が入ったので、パネルの上端から
                    // 数えていた78pxは、この群の中の78pxになった——
                    // 見出し13px＋間8px＋行28pxの、行の下。
                    default-shell-menu := PopupWindow {
                        x: 60px;
                        y: 52px;
                        width: 240px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 240px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 1px;

                                // **頼んでから閉じる**（書き手の報告 2026-09-07:
                                // WSL以外に変えられない）。`close`はこのメニューの
                                // 木を——この行と、行を包む`for`ごと——捨てるので、
                                // その後で`root`へ登ろうとすると生成されたコードは
                                // `parent.upgrade()`に失敗し、**黙って何もしない**。
                                // タブの接続先の一覧で同じことを踏んだ。
                                for shell[index] in root.terminal-shells: MenuRow {
                                    title: shell;
                                    checked: index == root.default-shell;
                                    activated => {
                                        root.default-shell-chosen(index);
                                        default-shell-menu.close();
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Tok.rule;
                    }

                    Text {
                        text: "APPEARANCE";
                        color: Tok.ink-faint;
                        font-size: 10px;
                        letter-spacing: 0.9px;
                    }

                    // **黒地と紙を、ひとまとめで置く。**背景だけ黒くして文字が
                    // 黒のままの画面は読めない——そこを通らせないために、2つを
                    // 一度に決める道を先に出す。細かく決めたい人のために、下に
                    // 1色ずつの行も残してある。
                    HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: "Theme";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TextButton {
                            title: "Paper";
                            clicked => {
                                root.terminal-theme-chosen(false);
                            }
                        }
                        TextButton {
                            title: "Dark";
                            clicked => {
                                root.terminal-theme-chosen(true);
                            }
                        }
                    }

                    ColorCell {
                        label: "Background";
                        shown: root.terminal-paper;
                        picked => {
                            root.terminal-colour-picked(0);
                        }
                    }

                    ColorCell {
                        label: "Text Color";
                        shown: root.terminal-ink;
                        picked => {
                            root.terminal-colour-picked(1);
                        }
                    }

                    PickRow {
                        label: "Font";
                        value: root.terminal-font;
                        pressed => {
                            root.terminal-font-picked();
                            font-menu.show();
                        }
                    }

                    StepRow {
                        label: "Size";
                        value: root.terminal-size + " px";
                        stepped(by) => {
                            root.terminal-size-stepped(by);
                        }
                    }

                    // **16色は選ばせない**（要件 6.8）。選ばせれば16回選ぶことに
                    // なり、しかも選び終えるまで読めない。
                    Text {
                        text: "SGRの16色は背景の明るさから選びます。";
                        color: Tok.ink-faint;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                // 要件 7.9（2026-09-08）: **単語チェックモード。**書き手の指摘の
                // とおり、考え方はソースの予約語の色分けと同じ——C言語モードが
                // 予約語・型・前処理をそれぞれの色で持つように、**モードが語群を
                // 持ち、語群が色を持つ**。
                //
                // **どのモードを使うかはここで決めない。**それは文書ごとの話で、
                // ステータスバーから選ぶ（要件 10）。ここは中身を作る場所である。
                if root.settings-tab == 2: VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "MODES";
                        color: Tok.ink-faint;
                        font-size: 10px;
                        letter-spacing: 0.9px;
                    }

                    for mode[index] in root.word-mode-names: HorizontalLayout {
                        spacing: 6px;

                        // **先頭の「なし」は作ったモードではない**ので出さない。
                        if index > 0 && !(root.word-naming == 3
                            && root.word-naming-at == index - 1): TextButton {
                            wide: true;
                            title: mode.name;
                            role: root.word-mode-opened-at == index - 1
                                ? Role.primary
                                : Role.normal;
                            // **開くのはRustに頼む**（書き手の報告 2026-09-08：
                            // モードを選んでも何も出ない）。中身（語群・語・重複）は
                            // Rustが作って窓へ渡すモデルなので、こちら側で数字を
                            // 変えただけでは**誰も作り直さない**——押した先が
                            // 空のままだったのはそれである。
                            clicked => {
                                root.word-mode-opened(
                                    root.word-mode-opened-at == index - 1 ? -1 : index - 1);
                            }
                            // **長押しで名前を変える**（書き手の求め 2026-09-08）。
                            // タブの名前と同じ手つきで、**作るときと同じ欄**が
                            // その場に出る（単語チェックモード要件 7.4）。
                            holdable: true;
                            held => {
                                root.word-new-name = mode.name;
                                root.word-naming-trouble = "";
                                root.word-naming-at = index - 1;
                                root.word-naming = 3;
                            }
                        }
                        // **いまこの文書が使っているモード**（同日追加、書き手の
                        // 報告：設定上どちらも同じに見える）。開いて中を見ている
                        // ことと、いま色が付いていることは別のことである。
                        if index > 0 && mode.id == root.word-mode
                            && !(root.word-naming == 3
                                && root.word-naming-at == index - 1): Text {
                            text: "この文書";
                            color: Tok.accent;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        if index > 0 && !(root.word-naming == 3
                            && root.word-naming-at == index - 1): TextButton {
                            title: "×";
                            role: Role.quiet;
                            clicked => {
                                root.word-mode-removed(index - 1);
                            }
                        }

                        // 名前を変えているあいだ、この行はその欄になる。
                        if root.word-naming == 3 && root.word-naming-at == index - 1: Field {
                            placeholder: "モードの名前";
                            text <=> root.word-new-name;
                            init => {
                                self.take-focus();
                            }
                            accepted => {
                                root.word-mode-renamed(index - 1, root.word-new-name);
                            }
                            escaped => {
                                root.word-naming = 0;
                            }
                        }
                        if root.word-naming == 3 && root.word-naming-at == index - 1: TextButton {
                            title: "決定";
                            role: Role.primary;
                            clicked => {
                                root.word-mode-renamed(index - 1, root.word-new-name);
                            }
                        }
                        if root.word-naming == 3 && root.word-naming-at == index - 1: TextButton {
                            title: "取消";
                            role: Role.quiet;
                            clicked => {
                                root.word-naming = 0;
                            }
                        }
                    }

                    // 書き手の求め 2026-09-08: **設定は一枚で終える。**
                    // 名前は別の問いにしない——問いは窓の中に描くもの（要件
                    // 8.3・8.4）で、このパネルはその上に浮いている別の窓だから、
                    // **訊くたびにパネルが消えて戻る**ことになる。「決定すると
                    // 次の画面」が続くと、何をしているのか分からなくなる。
                    // **欄はこの場に出し、この場で終える。**
                    if root.word-naming != 1: HorizontalLayout {
                        alignment: start;

                        TextButton {
                            title: "New Mode";
                            role: Role.primary;
                            clicked => {
                                root.word-new-name = "";
                                root.word-naming-trouble = "";
                                root.word-naming = 1;
                            }
                        }
                    }

                    if root.word-naming == 1: HorizontalLayout {
                        spacing: 6px;

                        Field {
                            placeholder: "モードの名前";
                            text <=> root.word-new-name;
                            // **出たときに鍵盤をここへ。**押した手はもう名前を
                            // 打つつもりでいる。`if`の中の要素はここからしか
                            // 触れないので、外から呼ばずに自分で取る。
                            init => {
                                self.take-focus();
                            }
                            accepted => {
                                root.word-mode-added(root.word-new-name);
                            }
                            escaped => {
                                root.word-naming = 0;
                            }
                        }
                        TextButton {
                            title: "追加";
                            role: Role.primary;
                            clicked => {
                                root.word-mode-added(root.word-new-name);
                            }
                        }
                        TextButton {
                            title: "取消";
                            role: Role.quiet;
                            clicked => {
                                root.word-naming = 0;
                            }
                        }
                    }

                    if root.word-naming != 0 && root.word-naming-trouble != "": Text {
                        text: root.word-naming-trouble;
                        color: Tok.alert;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if root.word-mode-names.length <= 1: Text {
                        text: "モードを作り、その中に語群（人物・地名など）を作ります。"
                            + "文書ごとにモードを選ぶのは下のステータスバーからです。";
                        color: Tok.ink-faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if root.word-mode-opened-at >= 0: Rectangle {
                        height: 1px;
                        background: Tok.rule;
                    }

                    // **開いたモードの名前を出す。**「GROUPS」だけでは、どの
                    // モードの中を見ているのか画面に無かった（書き手の報告
                    // 2026-09-08）。`+ 1`は先頭の「なし」の分。
                    if root.word-mode-opened-at >= 0: Text {
                        text: "GROUPS — "
                            + root.word-mode-names[root.word-mode-opened-at + 1].name;
                        color: Tok.ink-faint;
                        font-size: 10px;
                        letter-spacing: 0.9px;
                    }

                    if root.word-mode-opened-at >= 0: VerticalLayout {
                        spacing: 8px;

                        for row[index] in root.word-group-rows: HorizontalLayout {
                            spacing: 6px;

                            // 色見本。押すとWindowsの色ダイアログ（要件 9 と同じ道）。
                            Rectangle {
                                width: 24px;
                                horizontal-stretch: 0;

                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 24px;
                                    height: 20px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: swatch.has-hover ? Tok.accent : Tok.rule-strong;
                                    // **色を持たない語群は、色の無い升目**
                                    // （除外語群、2026-09-08）。
                                    background: row.paints ? row.shown : Tok.chrome-sunken;

                                    if !row.paints: Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "—";
                                        color: Tok.ink-faint;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    swatch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.word-group-colour-picked(index);
                                        }
                                    }
                                }
                            }

                            // **名前も釦である**（書き手の求め 2026-09-08）。
                            // 押せば語の一覧が開き、**長押しすれば名前を変えられる**
                            // ——モードの行と同じ手つきにする。
                            if !(root.word-naming == 4
                                && root.word-naming-at == index): TextButton {
                                wide: true;
                                // **開いている語群には印を付ける。**下に出ている
                                // `Import…`と`この語群を消す`がどれに効くのかは、
                                // この印だけが言う。
                                role: root.word-group-opened-at == index
                                    ? Role.primary
                                    : Role.quiet;
                                title: row.name;
                                clicked => {
                                    root.word-group-opened(
                                        root.word-group-opened-at == index ? -1 : index);
                                }
                                holdable: true;
                                held => {
                                    root.word-new-name = row.name;
                                    root.word-naming-trouble = "";
                                    root.word-naming-at = index;
                                    root.word-naming = 4;
                                }
                            }

                            // **語数と、色を付けられなかった数。**押すと一覧が開く
                            // ——アプリの中で見て、アプリの中で消せることが、辞書を
                            // 書き手に管理させないということである。
                            if !(root.word-naming == 4
                                && root.word-naming-at == index): TextButton {
                                role: Role.quiet;
                                title: row.conflicts > 0
                                    ? row.words + "語 / 重複" + row.conflicts
                                    : (row.repeated > 0
                                        ? row.words + "語 (二重" + row.repeated + ")"
                                        : row.words + "語");
                                clicked => {
                                    root.word-group-opened(
                                        root.word-group-opened-at == index ? -1 : index);
                                }
                            }

                            // 名前を変えているあいだ、この行はその欄になる
                            // （色見本だけは残す——どの語群かはそれで分かる）。
                            if root.word-naming == 4 && root.word-naming-at == index: Field {
                                placeholder: "語群の名前";
                                text <=> root.word-new-name;
                                init => {
                                    self.take-focus();
                                }
                                accepted => {
                                    root.word-group-renamed(index, root.word-new-name);
                                }
                                escaped => {
                                    root.word-naming = 0;
                                }
                            }
                            if root.word-naming == 4 && root.word-naming-at == index: TextButton {
                                title: "決定";
                                role: Role.primary;
                                clicked => {
                                    root.word-group-renamed(index, root.word-new-name);
                                }
                            }
                            if root.word-naming == 4 && root.word-naming-at == index: TextButton {
                                title: "取消";
                                role: Role.quiet;
                                clicked => {
                                    root.word-naming = 0;
                                }
                            }
                        }

                        // **語群が1つも無いモード。**作った直後はここに来る——
                        // 何も出ないのは「効かなかった」に見える（書き手の報告
                        // 2026-09-08）ので、**次にすることを書いておく**。
                        if root.word-group-rows.length == 0: Text {
                            text: "このモードにはまだ語群がありません。"
                                + "`New Group`で人物・地名などの語群を作り、色を決めます。";
                            color: Tok.ink-faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        // 開いている語群の語。**アプリの中で消せる**（要件 7.9）。
                        if root.word-group-opened-at >= 0: Rectangle {
                            height: 152px;
                            background: Tok.chrome-raised;
                            border-radius: 6px;

                            ScrollView {
                                x: 8px;
                                y: 6px;
                                width: parent.width - 16px;
                                height: parent.height - 12px;

                                VerticalLayout {
                                    alignment: start;
                                    spacing: 1px;

                                    for word in root.word-group-words: HorizontalLayout {
                                        spacing: 6px;

                                        Text {
                                            text: word.text;
                                            // **覚え書きは薄く。**語の並びの中で
                                            // 見出しとして読めればよく、語と同じ
                                            // 濃さで出ると語の数が分からなくなる。
                                            color: word.note ? Tok.ink-faint : Tok.ink;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        TextButton {
                                            title: "×";
                                            role: Role.quiet;
                                            clicked => {
                                                root.word-removed(
                                                    root.word-group-opened-at, word.text);
                                            }
                                        }
                                    }

                                    if root.word-group-words.length == 0: Text {
                                        text: "まだ語がありません。本文で語を選んで右ボタン、"
                                            + "`単語帳へ追加`から入れられます。"
                                            + "`#`で始まる行は覚え書きです。";
                                        color: Tok.ink-faint;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // **開いている語群についてすることは、その語群の下に置く**
                        // （書き手の報告 2026-09-08：名前が「…」に潰れていた）。
                        // 行に釦を5つ並べると、380pxの幅では**いちばん大事な名前が
                        // 先に潰れる**——名前は行に、することは開いた先に。
                        //
                        // **消すのもここである。**語を1万まで入れられるものを、
                        // 一覧の行の`×`ひとつで消せてよいはずがない。
                        if root.word-group-opened-at >= 0: HorizontalLayout {
                            alignment: start;
                            spacing: 6px;

                            TextButton {
                                title: "Import…";
                                clicked => {
                                    root.word-group-imported(root.word-group-opened-at);
                                }
                            }
                            TextButton {
                                title: "Export…";
                                clicked => {
                                    root.word-group-exported(root.word-group-opened-at);
                                }
                            }
                            // **除外語群にする／やめる**（書き手と決めた 2026-09-08）。
                            // 色を持たない語群は木に積まれて最長一致で勝ち、しかし
                            // 何も塗らない——`カリオン`を入れておくと、その中で
                            // `リオン`が光らなくなる。
                            TextButton {
                                title: root.word-group-rows[root.word-group-opened-at].paints
                                    ? "色を付けない"
                                    : "色を付ける";
                                clicked => {
                                    root.word-group-paint-toggled(root.word-group-opened-at);
                                }
                            }
                            TextButton {
                                title: "この語群を消す";
                                role: Role.danger;
                                clicked => {
                                    root.word-group-removed(root.word-group-opened-at);
                                }
                            }
                        }

                        if root.word-naming == 2: HorizontalLayout {
                            spacing: 6px;

                            Field {
                                placeholder: "語群の名前";
                                text <=> root.word-new-name;
                                init => {
                                    self.take-focus();
                                }
                                accepted => {
                                    root.word-group-added(
                                        root.word-mode-opened-at, root.word-new-name);
                                }
                                escaped => {
                                    root.word-naming = 0;
                                }
                            }
                            TextButton {
                                title: "追加";
                                role: Role.primary;
                                clicked => {
                                    root.word-group-added(
                                        root.word-mode-opened-at, root.word-new-name);
                                }
                            }
                            TextButton {
                                title: "取消";
                                role: Role.quiet;
                                clicked => {
                                    root.word-naming = 0;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;

                            if root.word-naming != 2: TextButton {
                                title: "New Group";
                                // **一枚で終える**（`New Mode`の注記）。
                                clicked => {
                                    root.word-new-name = "";
                                    root.word-naming-trouble = "";
                                    root.word-naming = 2;
                                }
                            }
                            // **重複は畳んで置く。**普段は数だけ見えていればよく、
                            // 直すときにだけ開く。
                            if root.word-trouble-count > 0: TextButton {
                                title: root.word-troubles-shown
                                    ? "重複を閉じる"
                                    : "重複 " + root.word-trouble-count + " 件";
                                clicked => {
                                    root.word-troubles-shown = !root.word-troubles-shown;
                                }
                            }
                        }

                        // 要件 7.9: **参照画面。**どの語が、どこで、色が付いているのか
                        // いないのか。
                        if root.word-troubles-shown: Rectangle {
                            height: 152px;
                            background: Tok.chrome-raised;
                            border-radius: 6px;

                            ScrollView {
                                x: 8px;
                                y: 6px;
                                width: parent.width - 16px;
                                height: parent.height - 12px;

                                VerticalLayout {
                                    alignment: start;
                                    spacing: 2px;

                                    for trouble in root.word-troubles: HorizontalLayout {
                                        spacing: 6px;

                                        Text {
                                            text: trouble.conflict ? "色なし" : "二重";
                                            color: trouble.conflict ? Tok.alert : Tok.ink-faint;
                                            font-size: 11px;
                                            horizontal-stretch: 0;
                                            min-width: 44px;
                                        }
                                        Text {
                                            text: trouble.word;
                                            color: Tok.ink;
                                            font-size: 12px;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: trouble.told;
                                            color: Tok.ink-faint;
                                            font-size: 11px;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    if root.word-trouble-count > root.word-troubles.length: Text {
                                        text: "ほかに "
                                            + (root.word-trouble-count - root.word-troubles.length)
                                            + " 件";
                                        color: Tok.ink-faint;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Tok.rule;
                    }

                    // 単語チェックモード要件 5.4（書き手の求め 2026-09-08）:
                    // **辞書そのものを開く。**画面から作った表と同じものを、
                    // この編集器で直接直せる——**行に1つの形にしてあるのは、
                    // 人が読んで直せるためでもある**（同要件 4.2）。
                    HorizontalLayout {
                        spacing: 6px;

                        TextButton {
                            title: "Edit…";
                            // **頼んでから閉じる**（技術検証 6.24）。開く先はタブで、
                            // 書き手はもうこの画面を見ていない。
                            clicked => {
                                root.word-file-edited();
                                settings-panel.close();
                            }
                        }
                        Text {
                            text: "単語帳のファイルをタブで開きます。保存すると取り込みます。";
                            color: Tok.ink-faint;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }


                // どの面にいても、値はいまのシートのもの——だから帯のすぐ
                // 下に在る（要件 9）。
                if root.settings-tab > 2: VerticalLayout {
                    spacing: 8px;

                    // 要件 9: which sheet is being set. **Everything below belongs
                    // to it** — there is nothing to mark, because a value that is
                    // on screen while 縦書き is chosen is the vertical one.
                    HorizontalLayout {
                        spacing: 2px;

                        TextButton {
                            title: "Horizontal";
                            role: root.sheet == 0 ? Role.primary : Role.normal;
                            clicked => {
                                root.sheet = 0;
                            }
                        }
                        TextButton {
                            title: "Vertical";
                            role: root.sheet == 1 ? Role.primary : Role.normal;
                            clicked => {
                                root.sheet = 1;
                            }
                        }
                    }
                }

                if root.settings-tab == 3: VerticalLayout {
                    spacing: 8px;

                    // One row per kind of text: how large, what colour, which
                    // family. The numbers are the rows of the models — ten numbers,
                    // eight colours and eight families to a sheet — and the same
                    // numbers are what the callbacks carry.
                    TextRow {
                        label: "Body";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride] + " px";
                        shown: root.palette[root.sheet * 8 + 0];
                        family: root.sheet-fonts[root.sheet * 8 + 0];
                        stepped(by) => {
                            root.sheet-step(0, by);
                        }
                        picked => {
                            root.color-picked(0);
                        }
                        chose-font => {
                            root.font-picked(0);
                            font-menu.show();
                        }
                    }

                    TextRow {
                        label: "H1";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 4] + "%";
                        shown: root.palette[root.sheet * 8 + 1];
                        family: root.sheet-fonts[root.sheet * 8 + 1];
                        stepped(by) => {
                            root.sheet-step(4, by);
                        }
                        picked => {
                            root.color-picked(1);
                        }
                        chose-font => {
                            root.font-picked(1);
                            font-menu.show();
                        }
                    }

                    TextRow {
                        label: "H2";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 5] + "%";
                        shown: root.palette[root.sheet * 8 + 2];
                        family: root.sheet-fonts[root.sheet * 8 + 2];
                        stepped(by) => {
                            root.sheet-step(5, by);
                        }
                        picked => {
                            root.color-picked(2);
                        }
                        chose-font => {
                            root.font-picked(2);
                            font-menu.show();
                        }
                    }

                    TextRow {
                        label: "H3";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 6] + "%";
                        shown: root.palette[root.sheet * 8 + 3];
                        family: root.sheet-fonts[root.sheet * 8 + 3];
                        stepped(by) => {
                            root.sheet-step(6, by);
                        }
                        picked => {
                            root.color-picked(3);
                        }
                        chose-font => {
                            root.font-picked(3);
                            font-menu.show();
                        }
                    }

                    TextRow {
                        label: "H4";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 7] + "%";
                        shown: root.palette[root.sheet * 8 + 4];
                        family: root.sheet-fonts[root.sheet * 8 + 4];
                        stepped(by) => {
                            root.sheet-step(7, by);
                        }
                        picked => {
                            root.color-picked(4);
                        }
                        chose-font => {
                            root.font-picked(4);
                            font-menu.show();
                        }
                    }

                    TextRow {
                        label: "H5";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 8] + "%";
                        shown: root.palette[root.sheet * 8 + 5];
                        family: root.sheet-fonts[root.sheet * 8 + 5];
                        stepped(by) => {
                            root.sheet-step(8, by);
                        }
                        picked => {
                            root.color-picked(5);
                        }
                        chose-font => {
                            root.font-picked(5);
                            font-menu.show();
                        }
                    }

                    TextRow {
                        label: "H6";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 9] + "%";
                        shown: root.palette[root.sheet * 8 + 6];
                        family: root.sheet-fonts[root.sheet * 8 + 6];
                        stepped(by) => {
                            root.sheet-step(9, by);
                        }
                        picked => {
                            root.color-picked(6);
                        }
                        chose-font => {
                            root.font-picked(6);
                            font-menu.show();
                        }
                    }
                }

                if root.settings-tab == 4: VerticalLayout {
                    spacing: 8px;

                    // 要件 9 calls the flow advance 行間 in horizontal writing and
                    // 列間隔 in vertical writing. **One quantity, two names**: the
                    // label follows the sheet, because on this sheet that is what
                    // it is.
                    StepRow {
                        label: root.sheet == 0 ? "Line height" : "Column gap";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 1] + "%";
                        stepped(by) => {
                            root.sheet-step(1, by);
                        }
                    }

                    StepRow {
                        label: "Char advance";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 2] + "%";
                        stepped(by) => {
                            root.sheet-step(2, by);
                        }
                    }

                    StepRow {
                        label: "Page margin";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 3] + " px";
                        stepped(by) => {
                            root.sheet-step(3, by);
                        }
                    }

                    // 要件 9: how long a line may be. **Two switches that cannot
                    // both be on**, and neither of them on is the third answer: the
                    // line is not wrapped at all. One value holds all three, so
                    // "both on" is not a state this can reach — and pressing the
                    // one that is on turns it off, which is how the writer says
                    // "neither" without a button for it.
                    HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: "Wrap";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        // **The state that is an absence is still named.** With
                        // neither switch on, a row of unlit buttons reads as a
                        // setting nobody has made rather than as the setting it is.
                        if root.sheet-numbers[root.sheet * root.sheet-stride + 10] == 0: Text {
                            text: "not wrapped";
                            color: Tok.ink-faint;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        TextButton {
                            title: "Width";
                            role: root.sheet-numbers[root.sheet * root.sheet-stride + 10] == 1
                                ? Role.primary
                                : Role.normal;
                            clicked => {
                                root.sheet-chose(10,
                                    root.sheet-numbers[root.sheet * root.sheet-stride + 10] == 1
                                        ? 0
                                        : 1);
                            }
                        }
                        TextButton {
                            title: "Pane";
                            role: root.sheet-numbers[root.sheet * root.sheet-stride + 10] == 2
                                ? Role.primary
                                : Role.normal;
                            clicked => {
                                root.sheet-chose(10,
                                    root.sheet-numbers[root.sheet * root.sheet-stride + 10] == 2
                                        ? 0
                                        : 2);
                            }
                        }
                    }

                    // In characters of body text, because that is what a line
                    // length means: the number stays true when the body size or the
                    // zoom changes, and a width in pixels would not.
                    if root.sheet-numbers[root.sheet * root.sheet-stride + 10] == 1: StepRow {
                        label: "Line length";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 11] + " chars";
                        stepped(by) => {
                            root.sheet-step(11, by);
                        }
                    }

                    // 要件 9（2026-09-07追加）: 行番号。**どちらの面にも置く**
                    // ——横書きでは行の頭の余白に、縦書きでは列の頭（面の上端）に、
                    // 同じ形で立つ。数字はどちらでも正立させる。
                    HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: "Line numbers";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TextButton {
                            title: root.sheet-numbers[root.sheet * root.sheet-stride + 12] == 1
                                ? "Shown"
                                : "Hidden";
                            role: root.sheet-numbers[root.sheet * root.sheet-stride + 12] == 1
                                ? Role.primary
                                : Role.normal;
                            clicked => {
                                root.sheet-chose(12,
                                    root.sheet-numbers[root.sheet * root.sheet-stride + 12] == 1
                                        ? 0
                                        : 1);
                            }
                        }
                    }

                    // 要件 7.8（2026-09-09）: ルビと傍点。**大きさも位置も
                    // 親文字に対する比率**で、面ごとに持つ——縦書きと横書きでは
                    // ルビの置き場所そのものが違うので、読める大きさも同じとは
                    // 限らない。位置は0が行の箱の端（行間の空きの外側）で、
                    // 上げるほど字に近づく。
                    StepRow {
                        label: "Ruby size";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 13] + "%";
                        stepped(by) => {
                            root.sheet-step(13, by);
                        }
                    }

                    StepRow {
                        label: "Ruby position";
                        value: root.sheet-numbers[root.sheet * root.sheet-stride + 14] + "%";
                        stepped(by) => {
                            root.sheet-step(14, by);
                        }
                    }

                    // 要件 7.8（書き手の決定 2026-09-09）: 縦中横。半角の数字を
                    // 1〜2桁なら1マスに正立させ、3桁以上は1桁ずつ縦に並べる。
                    // **縦書きのシートにだけ出す**——縦中横は縦書きの中でしか
                    // 起きないので、横書きの面に置けば「押しても何も起きない
                    // 切り替え」になる。
                    if root.sheet == 1: HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: "Tate-chu-yoko";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TextButton {
                            title: root.sheet-numbers[root.sheet * root.sheet-stride + 15] == 1
                                ? "Upright"
                                : "Sideways";
                            role: root.sheet-numbers[root.sheet * root.sheet-stride + 15] == 1
                                ? Role.primary
                                : Role.normal;
                            clicked => {
                                root.sheet-chose(15,
                                    root.sheet-numbers[root.sheet * root.sheet-stride + 15] == 1
                                        ? 0
                                        : 1);
                            }
                        }
                    }

                    // 書き手の決定 2026-09-11: **原稿の記号ごとに、画面へ出る字。**
                    // 「三種類の文字に箇条書きの意味を与え、それぞれに、表現として
                    // どう見せるかを設定できるように」——`- 項目`と`* 項目`を別の
                    // 丸で出せる、というのがその意味である。
                    //
                    // **読むと決めていない記号は、見せ方も設定できない**（書き手の
                    // 求めた依存関係）。切ってある記号の行はただの本文で、印そのものが
                    // 出ないので、ここで丸を選んでも効くところが無い——**働かない
                    // 切り替えを画面に置かない**（単語チェックモード要件 2.1.1）。
                    for mark[at] in ["-", "*", "+"]: HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: at == 0 ? "Bullet marks" : "";
                            color: Tok.ink;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: mark;
                            color: root.bullet-marks[at] ? Tok.ink : Tok.ink-faint;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        if root.bullet-marks[at]: HorizontalLayout {
                            spacing: 2px;

                            for glyph[index] in ["•", "・", "○"]: TextButton {
                                title: glyph;
                                role: root.sheet-numbers[root.sheet * root.sheet-stride
                                    + 16 + at] == index
                                    ? Role.primary
                                    : Role.normal;
                                clicked => {
                                    root.sheet-chose(16 + at, index);
                                }
                            }
                        }

                        if !root.bullet-marks[at]: Text {
                            text: "General で切ってあります";
                            color: Tok.ink-faint;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.settings-tab == 5: VerticalLayout {
                    spacing: 8px;

                    // 書き手の報告 2026-09-08: `Paper`だけでは何のことか読めない
                    // ——この面には紙の**色**と、コードの**書体**が並んでいて、
                    // どちらも「紙」「コード」としか言っていなかった。
                    ColorCell {
                        label: "Paper Color";
                        shown: root.palette[root.sheet * 8 + 7];
                        picked => {
                            root.color-picked(7);
                        }
                    }

                    PickRow {
                        label: "Code Font";
                        value: root.sheet-fonts[root.sheet * 8 + 7];
                        pressed => {
                            root.font-picked(7);
                            font-menu.show();
                        }
                    }
                }

                // 初期値へ戻すのは**書式の両シート全部**（`typography_reset`）
                // なので、書式の面にだけ置く。General の2つはこれで戻らない。
                if root.settings-tab > 2: VerticalLayout {
                    spacing: 8px;

                    Rectangle {
                        height: 1px;
                        background: Tok.rule;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        TextButton {
                            title: "Reset";
                            clicked => {
                                root.typography-reset();
                            }
                        }
                    }
                }
            }
        }
    }

    // Last in the window, so it is drawn over everything the editor shows.
    if root.question-open: Rectangle {
        background: Tok.scrim;

        // Swallows every click that does not land on a button. While the
        // question stands, the document behind it cannot be clicked into.
        TouchArea {}

        // Takes the keyboard away from the pane's IME field, so a keystroke
        // meant for the question does not land in the document. Giving it back
        // is Rust's job (`restore_editor_focus`, 6.14).
        //
        // **The question is inside it**, so that Esc still answers when the
        // name field has the keyboard: a key a field does not use goes up to
        // the scopes above it, and a scope beside it is not above it.
        question-keys := FocusScope {
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.question-answered(root.question-choices.length - 1);
                    accept
                } else {
                    reject
                }
            }

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: min(root.width - 64px, 420px);
                        background: Tok.paper;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Tok.rule-strong;
                        drop-shadow-color: #1713214d;
                        drop-shadow-blur: 40px;
                        drop-shadow-offset-y: 16px;

                        VerticalBox {
                            padding: 20px;
                            spacing: 14px;

                            // What is being asked, and then what it costs. The
                            // two arrive as one string with a blank line
                            // between them, because every message was written
                            // that way before there was anywhere to put the
                            // second half.
                            Text {
                                text: root.question-text;
                                color: Tok.ink-strong;
                                font-size: 15px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            if root.question-detail != "": Text {
                                text: root.question-detail;
                                color: Tok.ink-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            // A question answered by typing (要件 5.2). Built
                            // when the question is, so it takes the keyboard at
                            // `init`; the generation is for a name asked for
                            // while one is already up, which the overlay does
                            // not allow but costs nothing to survive.
                            if root.question-asks-name: Field {
                                property <int> asked: root.question-generation;
                                text <=> root.question-name;
                                init => {
                                    self.take-focus();
                                }
                                changed asked => {
                                    self.take-focus();
                                }
                                // Enter is the first choice, which is the one
                                // that does the thing being named.
                                accepted => {
                                    root.question-answered(0);
                                }
                                // And Escape is the last, like every other way
                                // out of a question. **The field has to pass it
                                // on**: it is inside the scope that would
                                // otherwise hear the key, and a `TextInput`
                                // that keeps Escape keeps it from everyone.
                                escaped => {
                                    root.question-answered(
                                        root.question-choices.length - 1);
                                }
                            }

                            // **One to a line, in the order Rust names them**:
                            // the first does the thing, the last changes
                            // nothing and is what Esc answers with (要件 8.4).
                            //
                            // A row was tried and does not fit. 「作業コピーを
                            // 残して閉じる」 is twelve characters, and four
                            // answers like it are wider than any card that fits
                            // on screen — and a layout that runs out of room
                            // draws over what is beside it rather than wrapping
                            // (6.23). A column fits whatever the words are, in
                            // any language.
                            VerticalLayout {
                                spacing: 8px;

                                for choice[index] in root.question-choices: TextButton {
                                    title: choice;
                                    wide: true;
                                    role: index == 0
                                        ? Role.primary
                                        : (index == root.question-danger
                                            ? Role.danger
                                            : (index == root.question-choices.length - 1
                                                ? Role.quiet
                                                : Role.normal));
                                    clicked => {
                                        root.question-answered(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
