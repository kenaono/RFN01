import { CheckBox, ComboBox, HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";
import { PanelStyleEditor } from "panel-style-editor.slint";
import { PanelStyle, EditorPane, PaneScreen, PreviewTile, PreviewSelectionRect, TabInfo, WallPiece, WordModeRow } from "editor-pane.slint";
// RFN01-47: 本文の右クリックメニューへ出す挿入の行（中身はRustが作る）。
import { InsertRow } from "editor-pane.slint";
import { Slider } from "controls.slint";
import { Tok } from "tokens.slint";
import { TitleMenuBar } from "title-menu-bar.slint";
import { ColorCell, ColourMixer, ColourPalette, Colours, Field, Icon, IconButton, Icons, Ime, MenuFrame, MenuRow, MenuSep, PanelTab, PickRow, Role, SideTab, StepRow, TextButton, TextRow } from "controls.slint";
// **Rustから触れるように名前を通す**：大域はこの根のファイルから輸出されていないと
// 窓の外から見えない。
export { Ime }
export { MenuInput } from "controls.slint";
import { QuickDraft } from "quick-draft.slint";
export { Colours } from "controls.slint";
import { DiffView, DiffRow } from "diff-window.slint";
import { PrintView } from "print-window.slint";
export { DiffRow } from "diff-window.slint";
import { UnusedFolderRow, WorkspaceFolderRow, WorkspaceManager, WorkspaceRow } from "workspace-manager.slint";
export { UnusedFolderRow, WorkspaceFolderRow, WorkspaceRow } from "workspace-manager.slint";
import { BookmarkRow, BookmarkView } from "bookmark-view.slint";
export { BookmarkRow } from "bookmark-view.slint";

/// 要件 7.9: 設定画面が出す語群の1行。
///
/// **数はモードを建てたときの結果**である（`WordMarks::build`）。画面はそれを
/// 読むだけ——数え役は1つ。
/// 語群の中の1行（単語チェックモード要件 4.2、2026-09-08）。
///
/// **語か、覚え書きか。**`#`で始まる行は覚え書きで、木には積まれず、語数にも
/// 数えられない——一覧の中では見出しとして立つ。
// Keys の面の1行（書き手の求め 2026-09-15）。分類の見出しか、キーの行か。
export struct ShortcutItem {
    id: int,
    name: string,
    key: string,
    header: bool,
    category: int,
    open: bool,
    fixed: bool,
    note: string,
    count: int,
}
export struct WordRow {
    text: string,
    note: bool,
}

export struct WordGroupRow {
    name: string,
    words: int,
    /// **色を持つか**（2026-09-08）。持たない語群＝除外語群は、木には積まれて
    /// 最長一致で勝つが、何も塗らない——`カリオン`を入れておくと、その中で
    /// `リオン`が光らなくなる。
    paints: bool,
    /// 色を付けられない語の数（同じモードの他の語群と衝突）。**0でないことが目印**。
    conflicts: int,
    /// 同じ語群の中で二度書かれた語の数。色は付くので、掃除の手がかり。
    repeated: int,
    shown: color,
}

/// 重複ひとつぶんの言い分（要件 7.9）。
export struct WordTroubleRow {
    word: string,
    /// 真なら色を付けていない（セットをまたいだ衝突）。偽なら言うだけ。
    conflict: bool,
    /// どこで起きたか、書き手の言葉で。
    told: string,
}

// Re-exported so they stay part of this window's public API: Rust builds the
// pane model and the tile and selection models inside it, and they reach it
// through the generated types.
export { PaneScreen, PreviewTile, PreviewSelectionRect, TabInfo, WallPiece }

// 要件 12: a window of its own, opened from the menu here. **Exported through
// this file** because that is the one Slint compiles (`build.rs`).
export { QuickDraft }

// One boundary between two panes, where the layout tree put it (要件 6.4).
//
// Rust flattens the tree into these because Slint cannot draw one: a component
// may not instantiate itself, so a nesting of unknown depth has to arrive as a
// list of rectangles.
export struct PaneBoundary {
    x: float,
    y: float,
    width: float,
    height: float,
    // Whether the panes it divides sit side by side, which is what makes this a
    // vertical line that moves horizontally.
    side-by-side: bool,
}

// One row of the left pane, whichever of its three things is showing
// (要件 6.2).
//
// Flattened by Rust for the reason the pane boundaries are: a component may not
// instantiate itself, so a nesting of unknown depth arrives as a list that says
// how deep each row is. **The other two panels borrow the same shape** — a
// search result sits one step in under the file it was found in, and a history
// entry sits at the left — so one list draws all three.
export struct LeftRow {
    name: string,
    // How far in the row sits: from the work folder in the tree, from the file
    // it was found in among search results.
    depth: int,
    // Only the tree has these two; the other panels leave them false.
    folder: bool,
    // Whether this folder's contents are in the rows below it.
    open: bool,
    // Which row holds this one, and -1 for the ones the work folder holds
    // itself (要件 5.2). **So that a row can say where something let go on it
    // would land**: pointing at a file means the folder that file is in, and
    // the row cannot ask a path what holds it. The other panels leave it -1.
    parent: int,
    // Workspace設計.md phase 3: this row stands for one of the active
    // Workspace's own registered roots, drawn as its own labelled row when
    // more than one folder is active. **Navigation only** — 仕様 "多重root行は
    // rename/move/delete不可、管理画面が取り外しを扱う": a root row can be
    // expanded or collapsed and can receive a drop (it is a folder like any
    // other), but it is never itself renamed, deleted, or carried, and the
    // header above the rows is not a valid drop target while any root row is
    // shown. Only the tree ever sets this; the other panels leave it false.
    is-root: bool,
}

export component AppWindow inherits Window {
    in property <bool> custom-title: false;
    in property <bool> title-maximized: false;
    // Windows owns the caption hit regions, so the frame reports which of the
    // three buttons the pointer is over (1 minimise, 2 maximise, 3 close, 0
    // none) and whether one is held down. Only the faces are drawn here.
    in property <int> title-hot: 0;
    in property <bool> title-pressed: false;
    in-out property <bool> title-menu-visible: false;
    callback title-menu-requested(int);
    callback title-menu-dismissed();
    in-out property <int> title-menu-focus-generation: 0;
    in-out property <int> title-menu-active: 0;
    in-out property <bool> title-menu-open: false;
    /// 分類ごとに開けるか（RFN01-38）。**子が全部無効なら親も無効**——書き手の
    /// 決定 2026-09-21。開けるかどうかはRustが本文を見て決めるので、ここは置き場。
    in-out property <[bool]> title-menu-openable: [true, true, true, true, true, true, true];
    callback title-menu-visibility(bool);
    in-out property <int> menu-pane: -1;
    in-out property <int> menu-action: 0;
    in-out property <int> menu-generation: 0;
    changed title-menu-visible => { root.title-menu-visibility(root.title-menu-visible); }
    /// 印刷プレビューが出入りした（RFN01-44）。**上端の当たり判定を切り替える**ために
    /// Rustへ伝える——プレビューの上側の帯は、この窓がタイトル行として扱っている
    /// 高さに重なっているので、そのままでは中のボタンに指が届かない。
    callback print-active-changed(bool);
    changed print-active => { root.print-active-changed(root.print-active); }
    // The document in front, then the editor's name. It said
    // 「Editor - 横書き・縦書き切り替え検証」 until 2026-09-06, which was the
    // title of the technical validation this grew out of — true once, and a
    // title bar is the one place a writer reads the name of what they are in.
    // `RFN Edit` is the name the editor already writes on disk
    // (`%LOCALAPPDATA%\RFN Edit\`, `RFN-EDIT-SESSION`).
    title: root.document-title + " - RFN Edit";
    // 追加要件 2026-09-06: 紫背景に編集器の頭文字（`RE` — RFN Edit）。
    // The title bar and the task bar
    // read this. **Not the file's icon in Explorer** — that is a resource
    // compiled into the executable, which needs a build dependency this
    // repository does not vendor; `ui/icon.png` is the drawing either would use.
    icon: @image-url("icon.png");
    // preferred-*, not width/height: setting width and height on a Window makes
    // it a fixed size the window manager enforces, which is why the window could
    // not be resized at all. These give the same starting size and still resize.
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 400px;
    // Switching side-panel contents must not impose their inferred maximum
    // height on the native window. Winit clamps the current window size when
    // those constraints change (for example when the Workspace tree hides).
    // Keep the user-selected height, while retaining normal window resizing.
    max-height: 100000px;
    background: transparent;

    // Every pane, in pane-number order: row N is pane N. **One row is one
    // pane's whole view of the document** — its tiles, its caret, its scroll —
    // so the panes below are one repeated element rather than a copy of the
    // same bindings per pane, and an Nth pane is an Nth row (ペイン分割設計 5).
    //
    // in-out because some of the fields are written by the pane itself; the
    // rest are written from Rust.
    in-out property <[PaneScreen]> panes;
    in-out property <int> focused-pane-row;
    property <int> current-pane-row: root.focused-pane < 65536 ? root.focused-pane : root.focused-pane-row;
    // The boundaries between them, and the size of the area they were placed
    // in. The area is reported back because only the window knows it, and the
    // tree cannot hand out pixels it has not been told about.
    in property <[PaneBoundary]> boundaries;
    in-out property <float> editor-area-width: 0;
    out property <float> editor-area-x: editor-row.absolute-position.x / 1px;
    out property <float> editor-area-y: editor-row.absolute-position.y / 1px;
    in-out property <float> editor-area-height: 0;
    /// One boundary was dragged, by this much in each direction. Which of the
    /// two matters is the boundary's own business (要件 6.4).
    callback boundary-moved(int, float, float);
    /// The editing area is a different size, so the tree has different pixels
    /// to hand out.
    callback editor-area-resized();

    // The left pane (要件 6.2). Explorer only for now; 検索 and 履歴 are the
    // other two things it will show.
    in property <[LeftRow]> left-rows;
    in property <string> work-folder;
    // Workspace設計.md phase 3: more than one active root is shown, each as
    // its own row (`LeftRow.is-root`). The heading above the rows no longer
    // stands for one folder in that case, so it is not a place to drop
    // anything — 仕様 "Drag target header invalid for multi-root".
    in property <bool> tree-multi-root;
    in-out property <bool> tree-open: true;
    // 追加要件 2026-09-06: how wide the left pane is, in pixels.
    //
    // **A number rather than a length**, because it crosses to Rust for the
    // session (要件 8.5) and comes back the same way. The bounds are here and
    // in `tree_width_from` — the drag holds it and a stored value is held to
    // the same, so a session cannot put the panel where the pointer could not
    // bring it back from.
    in-out property <float> tree-width: 260;
    // Which of Explorer, 検索 and 履歴 is showing: 0, 1, 2 (要件 6.2). **Rust
    // holds it**, because the rows it puts in `left-rows` have to agree with
    // it, and a click means something different in each.
    in-out property <int> left-tab: 0;
    // The tabs themselves, so their number and their order live in one place;
    // `LeftTab::from_index` in Rust reads the same order.
    callback left-tab-chosen(int);
    /// Which row the file commands act on, or -1 for none. **Rust decides it**
    /// — it holds the selection by path, and works out where that sits every
    /// time the rows change (要件 5.2).
    /// Which row the file commands act on (要件 5.2). **Rust owns it** — it is
    /// worked out from the selected path every time the rows are drawn — but a
    /// right click moves it here first, because the row a menu is opening from
    /// has to look chosen before Rust has drawn anything.
    in-out property <int> tree-selected: -1;
    in property <[string]> tree-root-labels;
    in property <[int]> tree-pane-root-indices;
    property <int> tree-active-root-index: root.focused-pane >= 0 && root.focused-pane < root.tree-pane-root-indices.length
        ? root.tree-pane-root-indices[root.focused-pane] : -1;
    property <length> tree-root-row-height: max(24px, root.left-size * 2px);
    /// A row was clicked. What that does belongs to the panel showing:
    /// a folder opens or closes, a file is opened, a search result is gone to.
    callback left-row-activated(int);
    // 書き手の報告 2026-09-07: **二度目のクリックは「これを開いておく」。**
    // 一度のクリックは覗くだけで、次に選んだファイルがそのタブを取る。
    callback left-row-kept(int);
    // 書き手の求め 2026-09-22: 見出しの一覧を階層で畳む。行の番号は見えている行の。
    callback outline-fold-toggled(int);
    // true で全部畳む、false で全部開く。
    callback outline-fold-all(bool);
    // 見出しの行の右クリック「Add Bookmark…」。行の番号は見えている行の。
    callback outline-bookmark-requested(int);

    // 書き手の求め 2026-09-22: Bookmark View（left-tab 5）。行・並び・選びはRustが決める。
    in property <bool> bookmark-available;
    in property <[BookmarkRow]> bookmark-rows;
    in property <[string]> bookmark-groups;
    in property <bool> bookmark-descending;
    in property <int> bookmark-selected: -1;
    in-out property <string> bookmark-filter;
    in-out property <bool> bookmark-filter-visible;
    callback bookmark-activated(int);
    callback bookmark-toggled(int);
    callback bookmark-cleared();
    callback bookmark-add-current();
    callback bookmark-create-group();
    callback bookmark-sort-toggled();
    callback bookmark-filter-changed();
    callback bookmark-rename(int);
    callback bookmark-remove(int);
    callback bookmark-move-to(int, int);
    callback bookmark-dropped(int, int);
    callback work-folder-requested();

    // Workspace pane state. Legacy switcher callbacks remain for callers/tests.
    in property <bool> workspace-available;
    in property <string> workspace-current-label;
    in property <[string]> workspace-switcher-rows;
    callback workspace-switcher-chosen(int);
    callback workspace-manager-requested();
    callback workspace-manager-closed();
    callback workspace-open-selected();
    callback workspace-leave-requested();
    callback workspace-tree-command(int);
    in property <bool> workspace-context-folder;
    in property <bool> workspace-context-auto;
    in property <bool> workspace-active;
    in-out property <bool> workspace-manager-open;
    in property <bool> workspace-read-error;
    in property <string> workspace-read-error-text;
    callback workspace-read-error-reset-requested();
    in property <[WorkspaceRow]> workspace-rows;
    in property <int> workspace-manager-selected: -1;
    callback workspace-row-chosen(int);
    callback workspace-row-context-chosen(int);
    callback workspace-create-requested();
    callback workspace-clone-requested();
    in property <bool> workspace-cloning;
    callback workspace-duplicate-requested();
    callback workspace-rename-requested();
    callback workspace-default-toggled();
    callback workspace-remove-requested();
    callback workspace-reset-view-requested();
    in property <[WorkspaceFolderRow]> workspace-folder-rows;
    callback workspace-folder-add-requested();
    callback workspace-folder-mode-toggled(int);
    callback workspace-folder-move-up-requested(int);
    callback workspace-folder-move-down-requested(int);
    callback workspace-folder-detached(int);
    callback workspace-folder-relocated(int);
    in property <[UnusedFolderRow]> workspace-unused-folder-rows;
    callback workspace-unused-folder-removed(int);

    /// The work folders opened before this one, newest first (要件 5.1).
    /// Names with the folder that holds them, the way the 履歴 panel names a
    /// file — Rust draws them, and the one already open is not among them.
    in property <[string]> recent-folders;
    /// Go back to one of them, by its place in that list.
    callback recent-folder-chosen(int);
    // The whole work folder, not the document in front (要件 7.7). Its own
    // field, separate from the find bar's: one asks about a document and the
    // other about a folder, and they are not the same question.
    in-out property <string> folder-needle;
    in property <string> folder-status;
    // 要件 7.7（2026-09-07追加）: どのフォルダを歩くか。名前だけを出し、
    // 道のりはマウスを載せたときに出す。`scoped`は作業フォルダより内側に
    // 絞られているかどうかで、**絞られていることが見えていなければ、
    // 見つからない言葉の理由が画面のどこにも無い。**
    in property <string> search-folder;
    in property <string> search-folder-path;
    in property <bool> search-folder-scoped;
    callback search-folder-requested();
    callback search-folder-reset();
    callback folder-search-requested();
    in-out property <string> search-exclusions;
    callback search-exclusions-changed();
    // 要件 2: the search runs on a thread of its own, so the answer arrives
    // after the callback that asked for it has long returned. **Rung by that
    // thread, through the event loop** — nothing here decides when.
    callback folder-search-finished();
    /// A file command, by the position of its button: 0 新規ファイル,
    /// 1 新規フォルダー, 2 名前変更, 3 複製, 4 削除, 5 エクスプローラー
    /// (要件 5.2). One callback carrying a number, the way a pane is named by
    /// its index; `TreeCommand::from_index` is the one place it is read.
    in-out property <int> tree-new-index: -1;
    in-out property <string> tree-new-name;
    in-out property <string> tree-new-error;
    callback tree-new-finished(bool);
    callback tree-command(int);
    callback explorer-command(int);
    in-out property <int> tree-reveal-generation;
    /// Choose a row without acting on it (要件 5.2). What a right click does
    /// that a left click must not: the commands act on what is chosen, and
    /// opening the file or folding the folder is not what was asked for.
    callback left-row-picked(int);
    callback left-context-requested(int);
    in-out property <string> tree-filter;
    in property <int> tree-root-row-count;
    property <bool> workspace-filter-visible: true;
    callback tree-filter-changed();

    /// 要件 5.2: the row being carried through the tree, and where the hand is.
    ///
    /// **Held by the window** for the reason a carried tab's point is (要件
    /// 6.5): the row that was picked up and the row it is being offered to are
    /// two different rows, and neither can see the other. Each candidate
    /// compares the point with its own rectangle and answers for itself, and
    /// what it answers is what Rust is told to do — so the row that lights up
    /// and the folder the file lands in cannot disagree.
    ///
    /// **The rows are not drawn again while a carry is going on.** Publishing
    /// them would rebuild the very row whose grab is running (6.18/6.24), so
    /// the move happens after the hand lets go, from Rust, through a `Timer`.
    property <bool> tree-carrying: false;
    property <bool> tree-pointer-down: false;
    function show-tree-menu(x: length, y: length) {
        root.tree-menu-x = x;
        root.tree-menu-y = y;
        tree-context-menu.show();
    }
    function close-tree-menu() { tree-context-menu.close(); }
    property <length> tree-menu-x;
    property <length> tree-menu-y;
    property <bool> tree-menu-open: tree-context-menu.is-open;
    out property <bool> tree-refresh-blocked: root.tree-carrying || root.tree-pointer-down || root.tree-menu-open || root.tree-new-index >= 0;
    property <int> tree-carried-from: -1;
    /// Where the hand is, **in the coordinates the rows are laid out in**: `x`
    /// across a row, `y` down the list from its first row. Not the window's,
    /// and never `absolute-position` — an element carrying an `opacity` is
    /// wrapped in an `Opacity` item, and `absolute-position` then counts the
    /// row's place in the layout twice (6.26). Every row already knows its own
    /// `y` in this space, which is the only space the comparison needs.
    property <length> tree-carry-x;
    property <length> tree-carry-y;
    /// Where the rows under the carried one stop, from `file_tree::subtree_end`.
    /// Rows in `[tree-carried-from, tree-carry-end)` cannot receive it: a folder
    /// may not go inside itself. **Set once, when the carry starts** — a
    /// property costs no redraw of the rows, which is why Rust may be asked
    /// this in the middle of a drag at all.
    in-out property <int> tree-carry-end: 0;
    /// The row of the folder the carried one is already in, `-1` for the work
    /// folder itself. **It cannot receive what it already holds**, and saying
    /// so is what keeps every mark true: a mark that appears and then does
    /// nothing teaches the writer to distrust the ones that do.
    in-out property <int> tree-carry-parent: -1;
    /// Which row the hand is over: a row's number, `-1` the heading, `-2`
    /// nowhere. **Where it lands is `tree-drop-into`** — pointing at a file
    /// means the folder that file is in (要件 5.2), so the two differ whenever
    /// the writer aims at a folder's contents rather than at its name.
    property <int> tree-drop-hand: -2;
    /// The folder the carried row would land in, as a row's number, `-1` the
    /// work folder itself, `-2` nowhere. The work folder is the panel's own heading,
    /// because that heading **is** the work folder's name — and it is the one
    /// target that is always on screen, which is what a row scrolled out of
    /// sight is not.
    property <int> tree-drop-into: -2;
    /// A carry started at this row: Rust answers with `tree-carry-end`.
    callback tree-row-grabbed(int);
    /// A carried row was let go into `tree-drop-into` (要件 5.2).
    callback tree-row-dropped(int, int);
    /// 要件 5.2: one line in the diagnostic log for one gesture on a row — the
    /// row, how many moves reached it, whether the press ever did, whether it
    /// became a carry, where it would have landed, and whether the grab was
    /// taken away. **The rows sit inside a `ScrollView`**, and a Flickable
    /// delays a press and may claim the drag as a scroll (`flickable.rs`), so
    /// "it does not move" has more than one place to fail and only the log can
    /// say which one it was.
    callback tree-row-traced(int, int, bool, bool, int, bool);

    // Finding and replacing inside the document in front of the writer
    // (要件 7.7). One bar for the window rather than one per pane: the question
    // is about a document, and which document is the focused pane's business.
    in-out property <bool> find-open: false;
    // E1: 語・置換語・帯が言うことは`PaneScreen`の行にある（**面ごと**）。
    // ここに残っているのは、帯が「どの面に・どの形で」出ているかだけ。
    /// Bumped whenever the bar is asked for. **The search field cannot be
    /// reached from outside the bar** — an id does not cross a conditional —
    /// so the field watches this instead and takes the keyboard itself, which
    /// is the same shape the panes use for 6.14.
    in-out property <int> find-generation: 0;
    /// 帯が出たときに鍵盤をそこへ置くか（E1）。**F3から出したときだけ偽**
    /// ——本文で押した鍵で書き手が欄へ連れて行かれるのは、探し直しではない。
    in-out property <bool> find-focus: true;
    /// Open/focus the pane's search or replace bar, or close the focused bar.
    public function toggle-find(pane-id: int, replacing: bool) {
        root.pane-focus-trace(pane-id, replacing ? "replace-toggle-request" : "find-toggle-request");
        root.focused-pane = pane-id;
        if (root.find-open && root.find-pane == pane-id
            && root.find-replacing == replacing && root.find-focus) {
            root.find-open = false;
            root.focus-generation += 1;
        } else {
            root.find-focus = true;
            root.find-pane = pane-id;
            root.find-replacing = replacing;
            root.find-open = true;
            root.find-generation += 1;
        }
        root.find-typed();
        root.pane-focus-trace(pane-id, "find-toggle-finished");
    }
    /// True searches on from the caret, false back towards the start.
    callback find-requested(bool);
    /// 検索の語が打ち変えられた。**数え直すだけ**で、本文のカーソルは動かない
    /// （E1）。
    callback find-typed();
    /// 探し方の入切（E1）。0＝大小の別、1＝単語単位、2＝範囲の中だけ。
    /// **範囲だけは入れるときに選択を写し取る**ので、Rustが答える。
    callback find-option(int);
    /// E1の④: 探した語の履歴を1つ遡る／戻る。1つめは↑か、2つめは置換欄か。
    callback find-history(bool, bool);
    // E4: 指定の行へ行く帯。**窓に1つ**——検索の帯と同じで、開いているペインが
    // その帯の相手である。
    in-out property <bool> goto-open: false;
    in-out property <int> goto-pane: 0;
    in-out property <string> goto-line;
    in-out property <string> goto-status;
    in-out property <int> goto-generation: 0;
    callback goto-requested(bool);
    callback goto-typed();
    callback goto-accepted();
    /// 探す条件を捨てる（E1、書き手の求め 2026-09-09）。
    callback find-cleared();
    /// Which pane the find bar is in, and whether it has its replace row
    /// (要件 7.7). **The bar is one document's**, so it is drawn inside the
    /// pane holding that document rather than across the window.
    in-out property <int> find-pane: 0;
    in-out property <bool> find-replacing: false;
    callback replace-requested();
    callback replace-all-requested();
    // Bumped from Rust after a toolbar command, to put the keyboard back where
    // it was. A pane is typed into through its IME TextInput, which only ever
    // takes focus on a pointer-up inside the pane — so a Button click, and a
    // modal dialog taking the window's focus away and giving it back, both
    // leave the editor unable to receive a keystroke until it is clicked again.
    in-out property <int> focus-generation: 0;
    // Which pane last held the keyboard, so that restoring it does not move it
    // to the other one in Split. Readable from Rust because leaving Split has
    // to carry the caret from the pane that was being written in (要件 7.2).
    in-out property <int> focused-pane: 0;
    in property <string> document-title: "無題1";
    // Whether the text has changed since it last agreed with its file. Set
    // from Rust the moment the flag moves, not polled.
    in property <bool> document-edited: false;
    /// 要件 10: what the status bar counts. **Five strings rather than one**,
    /// so the bar can space them the way it draws everything else and the
    /// warning can be the one thing in it that is not grey.
    in property <string> count-lines;
    in property <string> count-body;
    in property <string> count-source;
    in property <string> count-selected;
    /// 要件 10: where the caret is in the file, as `Ln 12, Col 5`. **Empty
    /// unless the pane showing it is on the source** — the preview's places
    /// are not the file's, so a column counted there would name a column the
    /// file does not have.
    in property <string> count-caret;
    in property <string> count-warning;
    /// 要件 E2: この文書の文字コードと改行——`UTF-8 BOM・CRLF`。
    in property <string> count-encoding;
    /// いまの文字コードが、開き直しの一覧の何番目か（要件 E2 の②）。
    /// **番号はRust側でしか作らない**——UTF-8 0／UTF-16 LE 1／UTF-16 BE 2／
    /// CP932 3で、BOMの有無は別に持っている（読むときは印を見るので、
    /// 開き直しで選ぶのは表のほうだけである）。
    in property <int> count-encoding-id;
    /// 開き直せるか＝この文書にファイルがあるか（要件 E2 の②）。
    in property <bool> count-encoding-reopenable;
    /// 要件 8.3（書き手のレビュー 2026-09-11、S2）: **前にある文書が、外で変わった
    /// まま片付いていない。**`render-status`の知らせは書き手が次へ動けば畳むが、
    /// これは**片付くまで消えない**——保存のときに初めて気づくのでは、そこで
    /// どちらかを捨てることになる。
    in property <bool> count-outside;
    in property <bool> count-missing;
    callback outside-asked();
    callback comparison-dismissed(int);
    /// この文字コードで読み直す（要件 E2 の②）。
    callback reopen-encoding(int);

    /// E1: いま探している語と、その数——`「白猫」3 / 12`。**帯が閉じていても
    /// 見えている**唯一の場所で、打鍵のたびに数え直すので古くならない。
    in property <string> count-find;
    // 何かが起きたときに言うこと——開けない、組めない、保存できない、語を足した。
    //
    // **出る場所はステータスバー**（書き手の報告 2026-09-10：「何も言わないので、
    // 何か出した方がいいと思いました」）。以前は縦書きのペインの紙の上にだけ出して
    // いたので、**横書きで書いている書き手には一言も届いていなかった**——保存が
    // 断られたことさえ画面のどこにも無かった。窓に1つの場所へ移してある。
    in property <string> render-status;
    in property <string> document-save-mode;
    /// 知らせがどのPaneの操作で出たか（書き手の報告 2026-09-15）。**別のPaneで操作が始まれば畳む**
    /// ——Pane1で保存した「Saved」が、Pane2へ移っても残っていた。
    in-out property <int> render-status-pane: -1;
    /// 誰の話か。0 窓全体、1 Pane、2 そのPaneの前のTAB。**頭に付ける名前はここで組む**
    /// ——開いた直後の知らせは、TABが前に出る前に出ていることがある。
    in-out property <int> render-status-scope: 0;
    out property <string> render-status-shown: root.render-status-scope == 2
        ? @tr("{}: {}", root.panes[root.render-status-pane].tabs[root.panes[root.render-status-pane].active-tab].title, root.render-status)
        : root.render-status-scope == 1 ? @tr("Pane {}: {}", root.render-status-pane + 1, root.render-status)
        : root.render-status;
    // The three quantities the typography validation is about. Character
    // spacing is extra advance as a percentage of the character's own size, so
    // 0 is DirectWrite's own; the other two are multipliers, so 100 is.
    /// 要件 9's values, **two sheets end to end**: the horizontal one's and
    /// then the vertical one's. What is on a sheet belongs to that direction —
    /// there is nothing to mark, because everything the panel shows while a
    /// sheet is chosen is that sheet's.
    ///
    /// `sheet-numbers` holds ten per sheet: the body size, the line advance,
    /// the character advance, the page margin, then H1 to H6. `palette` holds
    /// eight: the body ink, H1 to H6's, then the paper. `sheet-fonts` holds
    /// eight the same way, with the code family last. Rust owns all three; the
    /// panel reads the rows for `sheet` and asks Rust to change them.
    in property <[int]> sheet-numbers;
    in property <[color]> palette;
    in property <[string]> sheet-fonts;
    /// Which sheet the panel is showing: 0 horizontal, 1 vertical.
    in-out property <int> sheet: 0;
    /// 追加要件 2026-09-08: どの群を出しているか——0 General、1 Terminal、
    /// 2 Words、3 Text、4 Layout、5 Page、6 Keys。
    ///
    /// **窓が持つ**（設定のTABの中ではなく）。TABの中身はそのTABが前に出る
    /// たびに作り直されるので、そこに置いた値は毎回0へ戻る——書き手が Layout
    /// を見ていて別のTABへ移り、戻ってくれば、見たいのは Layout である。
    in-out property <int> settings-tab: 0;
    /// 追加要件 2026-09-14: 設定のTABを出す（窓に1つ。開いていればそこへ移る）。
    /// 開く群は`settings-tab`を先に置いてから頼む。
    callback settings-requested();
    /// What the picker lists, and what it is picking for. The list is read from
    /// the system the first time it is opened.
    in property <[string]> font-names;
    callback font-list-requested();
    in-out property <int> font-slot: 0;
    in property <string> font-current;
    // A question with real buttons, drawn over the editor (要件 8.3, 8.4).
    //
    // **Not a Windows message box.** Those come with the buttons Windows has —
    // はい／いいえ／キャンセル — so what each one means has to go in the
    // paragraph above them. A question about losing work is exactly the
    // question that must not be answered by reading a paragraph, and 要件 8.3
    // asks for four choices where a message box offers three.
    //
    // It also runs no message loop of its own, which is what froze the editor
    // in 6.18 when a modal was opened from inside a repeater's callback. Every
    // tab's close button is inside one.
    in property <string> question-text;
    in property <[string]> question-choices;
    in property <bool> question-enter-sends;
    in property <bool> question-open: false;
    // A question answered by typing a name rather than by pressing one of
    // several buttons (要件 5.2). The same overlay: a name is still a question,
    // and a second way of asking one would be a second thing to keep clear of
    // 6.18.
    in property <bool> question-asks-name: false;
    in property <bool> question-is-clone: false;
    // 書き手の求め 2026-09-22: 栞を足す問い。Link（読むだけ）・Title（名前の欄）・Group。
    in property <bool> question-is-bookmark: false;
    in property <string> question-bookmark-link;
    // 先頭は「(Root)」。
    in property <[string]> question-bookmark-groups;
    in-out property <int> question-bookmark-group: 0;
    in-out property <string> workspace-clone-destination;
    callback workspace-clone-browse();
    callback workspace-clone-url-edited();
    callback workspace-clone-url-check();
    callback workspace-clone-destination-check();
    in property <string> workspace-clone-url-error;
    in-out property <string> workspace-clone-destination-error;
    in property <bool> workspace-clone-url-checking;
    in-out property <string> question-name;
    // Bumped when a name is asked for, so the field takes the keyboard. Same
    // shape as `find-generation`, and for the same reason: an id does not cross
    // a conditional.
    in-out property <int> question-generation: 0;
    // Which button was pressed, by position. **The last choice is always the
    // way out**: Esc answers with it, and so does anything else that dismisses
    // the question without choosing.
    callback question-answered(int);
    /// The second half of what a question says: what it costs, under the line
    /// that asks it. Empty when the question is one line.
    in property <string> question-detail;
    /// Which answer is the one that loses work (要件 8.4), counted the way Rust
    /// names them, or -1. **Told rather than guessed**: the button that throws
    /// something away has to look unlike the one beside it, and reading the
    /// label to decide would break the first time a label is reworded.
    in property <int> question-danger: -1;

    // Everything a pane raises. **The first argument is always which pane** —
    // its row of `panes`, counted from 0. Rust turns it back into a `PaneId`
    // and nothing else tells the panes apart, so a repeater only has to pass
    // its `index` here instead of a literal (ペイン分割設計 5).
    callback pane-selection-start(int, float, float, bool);
    callback pane-link-open(int, float, float) -> bool;
    // 書き手の求め 2026-09-22: Ctrl+クリックで開ける所の上か（ポインタを手の形にする）。
    callback pane-link-hover(int, float, float) -> bool;
    in-out property <bool> link-popup-open: false;
    in-out property <int> link-popup-pane: -1;
    in-out property <[string]> link-popup-rows;
    in-out property <int> link-popup-selected: 0;
    in-out property <string> link-popup-status;
    callback pane-link-popup-key(int, int) -> bool;
    callback pane-link-popup-chosen(int, int);
    /// E3の②: 行そのものを動かす・写す・消す。
    callback pane-line-edit(int, int);
    /// E10: 選んだ行を箇条書きにする、やめる。0=印、1=番号、2=数え直す。
    /// 3つめは**どの記号か**（`-1`は読む記号のいちばん前）。
    callback pane-list-edit(int, int, int);
    /// RFN01-47: 右クリックメニューの挿入の行。2つめは挿入の番号。
    callback pane-insert-chosen(int, int);
    /// 右クリックメニューが開いた——**そのPaneの挿入の行を組み直す**。
    callback pane-menu-opened(int);
    // 書き手の求め 2026-09-22: 本文の右クリック「Add Bookmark…」。
    callback pane-bookmark-requested(int);
    /// E3の③: Enterで字下げ・箇条書き・引用を継ぐ。2つめはShiftが押されているか。
    callback pane-enter(int, bool);
    callback pane-selection-update(int, float, float);
    callback pane-selection-end(int, float, float);
    callback pane-picture-resize(int, int, int, float, float);
    callback pane-select-all(int);
    callback pane-scroll-changed(int, float);
    callback pane-across-scroll-changed(int, float);
    /// 要件 8.5: the pane was told to move the view, and this is where it
    /// actually went. **Two numbers because they can differ**: a `Flickable`
    /// holds its viewport inside what the content allows, so a scroll asked for
    /// before the new document's size reached the view is a scroll that lands
    /// somewhere else.
    callback pane-scroll-applied(int, float, float);
    callback pane-resized(int);
    /// 文字が入ってきた。**変換から確定したものかどうか**まで言う——シェルへは
    /// 貼り付けではなく打鍵として渡すため。
    callback pane-text-input(int, string, bool);
    /// One keystroke for the shell in front of a pane (追加要件 Terminal).
    callback pane-terminal-key(int, string, int, bool, bool, bool);
    /// The wheel over a shell (追加要件 Terminal).
    callback pane-terminal-scrolled(int, float);
    // 全画面TUIの互換性（2026-09-22）: ペイン、上段0／下段1、以降は`EditorPane`と同じ。
    callback terminal-mouse(int, int, int, int, float, float, float, bool, bool, bool) -> bool;
    callback terminal-focus(int, int, bool);
    /// The strip along the foot of a pane (追加要件 Terminal).
    callback terminal-url(int, int, float, float);
    callback terminal-action(int, int, int);
    callback panel-action(int, int, int);
    callback panel-scrolled(int, float, float);
    callback panel-renamed(int, int, string);
    callback pane-below-toggled(int);
    callback pane-below-resized(int, length);
    callback pane-below-key(int, string, int, bool, bool, bool);
    callback pane-below-scrolled(int, float);
    callback pane-below-selection(int, float, float, int);
    callback pane-below-sent(int);
    /// 書き手の報告 2026-09-08: 下段のシェルで選んでいるものを写す
    /// （要件 11.2 の`Ctrl+Shift+C`と同じ道）。
    callback pane-below-copy(int);
    callback pane-below-draft-edited(int, string);
    callback pane-navigate(int, bool);
    /// 要件 7.2 の変換、下段のシェルの上で。
    callback pane-below-preedit(int, string);
    callback pane-below-text(int, string, bool);
    /// 要件 11.3 の手つきで下段へ移る（true）／本文へ戻る（false）。
    callback pane-below-focus(int, bool);
    /// 追加要件 2026-09-06: the right button's rows that the window answers.
    callback pane-close-clean(int);
    callback pane-copy-path(int, int);
    callback pane-duplicate-tab(int, int);
    /// A shell wrote something. **Rung from its reading thread**, so it says
    /// only that: which pane, and what changed, are decided on this side.
    callback terminal-woken();
    /// 追加要件 Terminal: open a shell in the pane the writer is in. The number
    /// is which shell, as a position in `terminal-shells`.
    callback terminal-requested(int);
    /// The shells a terminal tab can be opened on (追加要件 Terminal). **Named
    /// by Rust**, because the list is what can actually be started.
    in property <[string]> terminal-shells;
    /// 追加要件 2026-09-08: 設定ファイルが並べているシェルを、書かれたままの
    /// 形で（`名前 | コマンド行`）。
    ///
    /// **画面はこれを読まない。**メニューが読むのは上の`terminal-shells`——
    /// この機械に実際にあるものだけを名前で並べたほうである。ここに在るのは
    /// 「設定ファイルへ書き戻すもの」で、書き戻す関数が持っているのは窓だけ
    /// だから、窓が持っている。要件 9 の数・色・書体と同じ置き方。
    in property <[string]> terminal-shell-lines;
    /// 要件 7.9（2026-09-08）: **単語チェックモード**（書き手の指摘：ソースの
    /// 予約語の色分けと同じ考え）。**モードが語群を持ち、語群が色を持つ。**
    ///
    /// 選べるモード。**先頭は「なし」（番号0）**——色分けを止めるのにモードを
    /// 消す必要は無い（コードエディタの`Plain Text`にあたる）。
    in property <[WordModeRow]> word-mode-names;
    /// 前に出ている文書のモードの番号と、その名前。**ステータスバーに出る**（要件 10）。
    ///
    /// **指すのは番号、読むのは名前。**名前で指していたときは、モードの名前を
    /// 変えた瞬間に文書のモードが切れていた。
    in property <int> word-mode;
    in property <string> word-mode-name;
    /// **色分けが働いていない理由**（空なら働いている、2026-09-08）。
    ///
    /// この機能の値打ちは**色が付かなかったこと**にあるので（単語チェックモード
    /// 要件 2.1.1）、働いていない状態は**打ち間違えたのと同じ見た目になる**。
    /// 黙っていると、書き手は自分の原稿のほうを疑う。
    in property <string> word-mode-trouble;
    /// 前に出ている文書のモードを、この番号にする（ステータスバーから）。
    callback word-mode-chosen(int);
    /// そのペインの前に出ているタブのモードを、この番号にする（タブのメニューから）。
    callback pane-word-mode-chosen(int, int);
    /// 設定画面が開いているモード（-1でどれも開いていない）。**Rustが持つ**
    /// ——中身（語群・語・重複）はRustが作るモデルなので、開く先が変わったら
    /// 作り直さなければならない（書き手の報告 2026-09-08）。
    in-out property <int> word-mode-opened-at: -1;
    callback word-mode-opened(int);
    callback word-group-opened(int);
    /// いま名前を訊いている先（0＝訊いていない／1＝新しいモード／2＝新しい語群／
    /// 3＝モードの名前を変える／4＝語群の名前を変える）。
    ///
    /// **設定は一枚で終える**（書き手の求め 2026-09-08、単語チェックモード要件 7.4）。
    /// 名前は別の問いにせず、**この画面の中の欄で受ける**——「決定すると次の画面」が
    /// 続くと、何をしているのか分からなくなる。**一度に開くのは一つ**なので、
    /// 旗を2つ持たずに1つの数で言う。
    in-out property <int> word-naming: 0;
    in-out property <string> word-new-name;
    /// 名前が使えなかったときの言葉。**この画面の中に出す**——下の帯へ出すと、
    /// 目はいま欄の上にある。
    in-out property <string> word-naming-trouble;
    /// 名前を変えている行（3・4のときだけ意味がある）。
    in-out property <int> word-naming-at: -1;
    callback word-mode-renamed(int, string);
    callback word-group-renamed(int, string);
    /// 単語帳のファイルをタブで開く（単語チェックモード要件 5.4）。
    callback word-file-edited();
    /// その中の語群。
    in property <[WordGroupRow]> word-group-rows;
    /// 語の一覧を開いている語群（-1で閉じている）。**開いているものだけ語を窓へ
    /// 渡す**——数千語を毎回渡さないため。
    in-out property <int> word-group-opened-at: -1;
    in property <[WordRow]> word-group-words;
    /// 取り込みで見つかった重複。**色を付けられなかったものが先**に並ぶ。
    in property <[WordTroubleRow]> word-troubles;
    /// 全部でいくつ見つかったか（一覧は`SHOWN_TROUBLES`までしか出さない）。
    in property <int> word-trouble-count;
    /// いま重複の一覧を開いているか。
    in-out property <bool> word-troubles-shown: false;
    /// 前に出ている文書のモードの語群の名前。**編集面の右ボタンが「どこへ足すか」を
    /// 並べる**のに使う。
    in property <[string]> word-group-names;
    /// そのペインで選んでいる語を、何番目の語群へ足すか。
    callback pane-word-added(int, int);
    /// その語群から語を1つ落とす。
    callback word-removed(int, string);
    callback word-mode-added(string);
    callback word-mode-removed(int);
    callback word-group-added(int, string);
    callback word-group-removed(int);
    /// 除外語群にする／やめる（2026-09-08）。
    callback word-group-paint-toggled(int);
    /// 1行1語のファイルから足す／へ書き出す（**あってもよい道**）。
    callback word-group-imported(int);
    callback word-group-exported(int);
    /// 追加要件 2026-09-07: **どれが既定か。**接続先を訊かない場所——`＋`のNew Tab、
    /// タブ列のメニュー、ペインの下段——はすべてこれを起こす。設定にも残る。
    in-out property <int> default-shell: 0;
    callback default-shell-chosen(int);
    /// 追加要件 2026-09-08: 端末の見た目（要件 6.8）。
    ///
    /// **紙とは別に持つ。**要件 9 のシートは原稿の紙の設定で、端末を黒地で使うことと
    /// 何の関係も無い。書字方向も持たないので、設定でもシートの外に立つ。
    /// 16色（SGR）はここに無い——背景の明るさからRustが決める。
    /// 追加要件 2026-09-15（書き手）: **Left Pane**（Explorer・検索結果・最近使ったファイル・見出し）の書式。
    /// 文字の大きさ・背景色・文字色と、フォルダ・ファイルの字の色。書体は変えない（書き手の決め）。
    /// フォルダ・ファイルの色は、付けていなければ文字色（`-own`が偽）。設定の群はTerminalの次に並ぶ。
    in-out property <int> left-size: 12;
    in-out property <color> left-paper: #faf9fc;
    in-out property <color> left-ink: #171321;
    in-out property <bool> left-folder-own: false;
    in-out property <color> left-folder-ink: #171321;
    in-out property <bool> left-file-own: false;
    in-out property <color> left-file-ink: #171321;
    callback left-size-stepped(int);
    callback left-reset();
    in-out property <color> terminal-paper: #fffefa;
    in-out property <color> terminal-ink: #24211e;
    in-out property <[PanelStyle]> panel-defaults;
    callback terminal-settings-edited();
    in-out property <bool> appearance-open;
    in-out property <bool> appearance-default;
    in-out property <string> appearance-title;
    in-out property <PanelStyle> appearance-style;
    callback appearance-requested(int, int);
    callback appearance-applied();
    callback appearance-reset();
    in-out property <bool> appearance-underline-allowed: true;
    in-out property <[string]> shell-profile-names;
    in-out property <int> shell-profile-index;
    in-out property <bool> shell-profile-default;
    in-out property <string> shell-profile-name;
    in-out property <string> shell-profile-executable;
    in-out property <string> shell-profile-arguments;
    in-out property <string> shell-profile-directory;
    callback shell-profile-action(int, int);
    in-out property <bool> terminal-confirm-paste: true;
    in-out property <bool> terminal-confirm-close: true;
    in-out property <int> terminal-history-limit: 10000;
    changed terminal-confirm-paste => { root.terminal-settings-edited(); }
    changed terminal-confirm-close => { root.terminal-settings-edited(); }
    changed terminal-history-limit => { root.terminal-settings-edited(); }
    /// What each log line starts with when a log is started with timestamps.
    in-out property <string> terminal-timestamp-format: "[yyyy-MM-dd HH:mm:ss] ";
    changed terminal-timestamp-format => { root.terminal-settings-edited(); }
    /// The format applied to the current time, shown beside the field.
    pure callback terminal-timestamp-sample(string) -> string;
    /// The timestamp checkbox of the log's save dialog, as it was last left.
    in-out property <bool> terminal-log-stamp-file: false;
    in-out property <string> terminal-font: "Consolas";
    in-out property <int> terminal-size: 15;
    callback terminal-font-picked();
    /// 書体の一覧は要件 9 のものと同じ`font-menu`を使う。**どちらの欄のために
    /// 開いたか**を、開いた側がここで言う——戻る先だけが違う。
    in-out property <bool> font-for-terminal: false;
    callback terminal-size-stepped(int);
    /// 黒地／紙のひとまとめの選択。**背景と文字を一度に置く**——片方だけ変えた状態は
    /// 読めない画面で、そこを通らせない。
    callback terminal-theme-chosen(bool);
    /// 追加要件 2026-09-08: 要件 8.1 の自動退避を働かせるかどうか。
    ///
    /// **既定はOn。**何も言っていない書き手は、未保存の中身を捨ててくれとは
    /// 言っていない。Offにした瞬間に、置いてある作業コピーは全部消える。
    in-out property <bool> autosave: true;
    callback autosave-toggled(bool);
    // 要件 7.8・要件 10: 本文文字数がルビの読みを数えるか。**初期値は数えない**
    // ——投稿サイトへ出すための字数はルビを含まない。打ち込んだ量を知りたい
    // 人には逆が要るので、これは「正解が二つある」たぐいで、選ばせる。
    in-out property <bool> count-ruby: false;
    callback count-ruby-toggled(bool);
    /// 追加要件 2026-09-15（書き手）: 縦書きの紙を横書きに合わせる。On なら全体の紙も、
    /// TAB・Paneに付けた紙も、縦書きと横書きで共通（横書きの色を使う）。
    in-out property <bool> paper-shared: false;
    callback paper-shared-toggled(bool);
    /// 同じく Text と Layout の面（書き手の求め 2026-09-15）。縦書きにしか無い設定（縦中横）は共通にしない。
    in-out property <bool> text-shared: false;
    callback text-shared-toggled(bool);
    in-out property <bool> layout-shared: false;
    callback layout-shared-toggled(bool);
    // 要件 E9: ルビと傍点の記法を読むか。**既定はOn**——要件7.8がその記法で
    // 組めと言っているので、切りたい書き手が切る側である。**切ったら記号を
    // そのまま字として出す**（原稿のバイト列は元から変えていない）。
    // 数え方ではなく読み方なので、`count-ruby`と違って本文そのものが変わる。
    in-out property <bool> ruby-marks: true;
    callback ruby-marks-toggled(bool);
    /// 書き手の決定 2026-09-11: **どの記号を箇条書きの印として読むか**（`-`／`*`／`+`の
    /// 順に、読むなら真）。切った記号の行はただの本文になる。**3つとも同格**
    /// （CommonMarkがそう認めている）なので、`-`も切れる。
    in-out property <[bool]> bullet-marks: [true, true, true];
    callback bullet-mark-toggled(int);
    /// RFN01-47: 本文の右クリックメニューに出す挿入の1段目と、その組の中身。
    /// **中身はRustが作る**——タイトルバーの挿入メニューと同じ言葉・同じ押せる
    /// 条件にするためで、メニューを開いた時点の状態で組み直す。
    in-out property <[InsertRow]> insert-rows;
    in-out property <[InsertRow]> insert-children;
    /// E3の④: `Tab`／`Shift+Tab`。2つめはShiftが押されているか。
    callback pane-tab(int, bool);
    callback pane-preedit-changed(int, string);
    callback pane-backspace(int);
    callback pane-delete(int);
    callback pane-move(int, int, bool);
    callback pane-home-end(int, bool, bool, bool);
    callback pane-preview-toggled(int);
    callback pane-viewer-toggled(int);
    /// Turn a pane's tab the other way (要件 7.2). Costs that pane's engine
    /// being built again, so it is a button and never a side effect.
    callback pane-direction-toggled(int);
    /// Undo in the pane, or redo. True is the way forwards (要件 7.1, 11.2).
    callback pane-undo(int, bool);
    /// Copy the pane's selection, or cut it. True takes it out (要件 11.2).
    callback pane-copy(int, bool);
    callback pane-copy-body(int);
    /// Step through a pane's tabs (要件 11.3). True goes backwards.
    callback pane-tab-stepped(int, bool);
    /// Give the keyboard to the pane in a direction (要件 11.3): 0 left,
    /// 1 right, 2 up, 3 down. Rust decides which pane that is, from the
    /// rectangles the panes were placed in, and sets `focused-pane` itself.
    callback pane-focus-moved(int, int);
    callback pane-focus-trace(int, string);
    callback editor-ime-area(float, float, float, float, bool);
    /// Ask the Kill Ring for something, in a pane (要件 11.4・11.6).
    callback pane-kill(int, int);
    /// Start selecting in a pane, or stop (要件 11.4 の`Ctrl+Space`).
    callback pane-mark-toggled(int, bool);
    /// Escapeで、選んでいる途中から戻る（書き手の報告 2026-09-12）。
    /// **戻るものが無ければ`false`**——鍵はそのまま先へ行く。
    callback pane-escaped(int) -> bool;
    /// 届いたShiftを、Windowsの答えと突き合わせて返す（書き手の報告 2026-09-12）。
    /// **窓の旗は変換をまたぐと古くなる。**
    callback shift-held(bool) -> bool;
    /// Divide the focused pane, right or down (要件 6.4). True is right.
    callback divide-requested(bool);
    /// Bring the arrangement back to the focused pane, gathering the tabs of
    /// the panes that go into it (要件 6.4).
    callback close-others-requested();
    /// Change the focused pane's place with the pane in a direction (要件 6.4):
    /// 0 left, 1 right, 2 up, 3 down — the numbering 要件 11.3's arrows use.
    callback swap-requested(int);
    // True when the pane taking input runs vertically. The IME lays its own
    // windows out from this, so it has to be told when focus moves.
    callback ime-vertical-requested(bool);
    /// 要件 9, 11.5: magnify one pane, in notches. **The pane is named** —
    /// the wheel acts on the pane it is over and the keys on the pane holding
    /// the keyboard, and neither is "the window".
    callback pane-zoom(int, int);
    callback pane-zoom-reset(int);
    /// 追加要件 2026-09-06: the zoom, straight to a number (the bar in the
    /// status bar). **A percentage, not notches** — the bar knows where it was
    /// put, and turning that into steps and back would round twice.
    callback pane-zoom-set(int, int);
    /// Move one of 要件 9's numbers. **The first argument says which**, in the
    /// order the panel draws them: 0 body size, 1 line height, 2 char spacing,
    /// 3 column gap, 4 to 9 the six heading levels. One callback rather than
    /// one each, the way `tree-command` carries the file commands.
    callback sheet-step(int, int);
    /// 要件 9: a setting given a value outright rather than stepped, for the
    /// ones whose values are a choice and not a quantity.
    callback sheet-chose(int, int);
    /// How many numbers one sheet holds in `sheet-numbers` (要件 9).
    ///
    /// **Rust owns it** (`SHEET_NUMBERS`) and sets it here, because the model is
    /// laid out by Rust and the window only reads it. It was a literal in a
    /// dozen places until adding two settings moved every row: the ones written
    /// as `sheet * 10` were all found, and the two written as the absolute row
    /// they landed on were not — so the vertical pane took its page margin from
    /// the line height and stood 100px off the top of its column.
    in-out property <int> sheet-stride: 12;
    /// The picker is about to open for one of the four families (要件 9): Rust
    /// reads the system's list if it has not yet, and says which family is the
    /// one set now. **Called before `show`**, so the list is there to draw.
    callback font-picked(int);
    /// A family was chosen for that slot.
    callback font-chosen(int, string);
    /// C5（書き手の求め 2026-09-15）: 色を選ぶ3つの口。**どの色か**は
    /// (kind, slot) で言う——kind 0 は紙のシート（slot は色の番号、シートは
    /// `sheet`）、1 は端末（0 地、1 字）、2 は語群（slot は語群の番号）。
    callback colour-set(int, int, color);
    /// 追加要件 2026-09-15: 新しく開いたTABにランダムな紙の色を付けるか。0 Off、1 淡色、2 濃色。
    /// 書き手の求めで、TAB・Paneのメニューからは選ばない（おまけなので全体設定だけ）。
    in-out property <int> paper-random: 0;
    callback paper-random-chosen(int);
    /// 追加要件 2026-09-15（書き手）: 表示の言語。0 システムに合わせる、1 日本語、2 English。
    in-out property <int> language: 0;
    /// 選べる言語。**言語の名前はその言語で書く**——読めない言語で出ている画面から戻れるように。
    /// 並びは設定の番号（0 System、1 日本語、2 English）。
    property <[string]> language-names: [@tr("System"), "日本語", "English"];
    callback language-chosen(int);
    /// 追加要件 2026-09-15（書き手）: 背景の壁紙（全体の設定）。0 なし、1 Windowsの壁紙
    /// （画面に固定して敷くので、窓越しにデスクトップが見えているように感じる）、2 画像ファイル。
    in-out property <int> wall-kind: 0;
    in-out property <string> wall-path;
    /// 画像ファイルの置き方。0 タイル、1 縦に合わせる、2 横に合わせる。
    in-out property <int> wall-fit: 0;
    /// 壁紙の濃さ（%）。紙はその分だけ透ける。
    in-out property <int> wall-strength: 30;
    // Global paper transparency. Chrome and text remain opaque.
    in-out property <int> background-transparency: 0;
    callback background-transparency-moved(float);
    in property <[WallPiece]> wall-pieces;
    in property <image> wall-image;
    in property <float> wall-image-width;
    in property <float> wall-image-height;
    in property <length> wall-origin-x;
    in property <length> wall-origin-y;
    callback wall-kind-chosen(int);
    callback wall-file-requested();
    callback wall-fit-chosen(int);
    callback wall-strength-moved(float);
    /// 追加要件 2026-09-15: 文字色のセット（10個）。1つは Body・H1〜H6 の文字色を
    /// 横書き・縦書きの順に14色、`#rrggbb` をカンマで並べた字。空ならまだ無い。
    in property <[string]> ink-sets: ["", "", "", "", "", "", "", "", "", ""];
    /// いまの文字色と同じセットの番号。どれとも違えば -1（「Custom」）。Rust が色から決める。
    in-out property <int> ink-set-chosen: -1;
    callback ink-set-apply(int);
    callback ink-set-save(int);
    callback ink-set-delete(int);
    callback colour-default(int, int);
    callback colour-more(int, int);
    /// 「その他の色」。開くのも決まったあとも Rust。
    in-out property <bool> colour-mixer-open: false;
    in-out property <color> colour-mixer-current;
    in-out property <float> colour-mixer-hue;
    in-out property <float> colour-mixer-saturation;
    in-out property <float> colour-mixer-value;
    pure callback colour-hex-of(color) -> string;
    callback colour-hex-typed(string);
    callback colour-channel-typed(int, string);
    callback colour-mixer-accepted(color);
    /// 書き手の求め 2026-09-15: どの面を初期値へ戻すか——3 Text、4 Layout、5 Page、
    /// 負の数なら書式の全部（「Reset All」から）。
    /// 書き手の求め 2026-09-15: 打って決めた数。本文は px、見出しは %（行の番号は
    /// `sheet-step`と同じ）。
    callback sheet-typed(int, string);
    /// 同じ大きさを pt で。0 が本文、1〜6 が H1〜H6。
    callback sheet-typed-points(int, string);
    callback typography-reset(int);
    callback terminal-reset();
    callback shortcut-reset-all();
    /// General の「Reset All」。確かめてから戻す（Rustが問いを出す）。
    callback reset-all-requested();
    callback open-file-requested();
    callback compare-files-requested();
    callback compare-saved-requested();
    callback compare-head-requested();
    callback reopen-closed-requested();
    /// 畳んでいる分類（ビット）と、押して探しているキー（書き手の求め 2026-09-15）。
    in-out property <int> shortcut-folded: 0;
    in-out property <string> shortcut-key-query;
    callback shortcut-fold(int);
    callback shortcut-key-search(string, bool, bool, bool);
    in-out property <string> shortcut-bindings;
    in-out property <string> shortcut-query;
    /// 設定を探す語（書き手の求め 2026-09-15：「Settingで検索欄が開いていても検索が効きません。可能なら、
    /// 検索した文字の含まれる設定のみがリストされると良い」）。**設定のTABで開いたCtrl+Fの欄の語**で、
    /// 空なら今までどおり群ごとに出す。探しているあいだは全部の群から、名前か見出しに語を含む行だけを出す。
    out property <string> settings-query: root.find-open && root.find-pane < 65536 && root.panes[root.find-pane].settings
        ? root.panes[root.find-pane].find-needle : "";
    property <bool> settings-searching: root.settings-query != "";
    /// 語が名前のどれかに含まれるか（大文字小文字・全角半角を問わない）。Rustが答える。
    pure callback settings-match(string, [string]) -> bool;
    /// 行・見出しを出すか。`labels`はその行の名前と、属する見出し。
    pure function shows-any(labels: [string]) -> bool {
        return !root.settings-searching || root.settings-match(root.settings-query, labels);
    }
    /// 群の面を出すか。探していなければ選んでいる群だけ、探しているあいだは全部（`labels`が
    /// 空でなければ、そのどれかに一致するときだけ——中の行を1つずつ分けない群）。
    pure function shows-group(tab: int, labels: [string]) -> bool {
        if (!root.settings-searching) {
            return root.settings-tab == (tab == 7 ? 0 : (tab == 2 || tab == 4 || tab == 5 ? 3 : tab));
        }
        return labels.length == 0 || root.settings-match(root.settings-query, labels);
    }
    /// 探しているあいだ、見出しに群の名前を付ける——横書き・縦書きの見出しは群をまたぐと同じ字になる。
    pure function section-title(group: string, title: string) -> string {
        return root.settings-searching ? group + " — " + title : title;
    }
    // Keysの一覧も同じ語で絞る（「Search by action」の欄はこの欄にまとめた）。
    changed settings-query => {
        root.shortcut-query = root.settings-query;
        root.shortcut-filter();
    }
    in-out property <string> shortcut-edit;
    in-out property <string> shortcut-status;
    in-out property <int> shortcut-selected: -1;
    in-out property <[ShortcutItem]> shortcut-rows;
    in-out property <[string]> shortcut-keys: ["Ctrl+O", "Ctrl+S", "Ctrl+Shift+S", "Ctrl+W", "Ctrl+F", "Ctrl+H", "Ctrl+G", "Ctrl+Shift+T", "Ctrl+Z", "Ctrl+Y"];
    callback shortcut-filter();
    callback shortcut-save(bool);
    callback shortcut-capture(string, bool, bool, bool);
    callback shortcut-key(string, bool, bool, bool) -> bool;

    // 要件 7.10: 紙の形で見る——印刷プレビュー。
    in-out property <bool> print-active: false;
    in property <string> print-title;
    in property <[image]> print-sheets;
    in property <float> print-sheet-width: 100;
    in property <bool> print-vertical;
    in-out property <int> print-zoom: 100;
    /// 掴んで寄せた量（拡大して紙がはみ出したとき）。
    in-out property <float> print-pan-x;
    in-out property <float> print-pan-y;
    in-out property <float> print-room-wide: 800;
    in-out property <float> print-room-tall: 600;
    callback print-room-changed(length, length);
    callback print-zoomed(int);
    /// 天と地の余白に入れるもの。**左・中・右の3つずつ**を「0,3,0」のように持つ
    /// （0なし／1ファイル名／2日付／3ページ）。
    in property <[string]> print-head;
    in property <[string]> print-foot;
    callback print-trim-written(bool, int, string);
    in property <float> print-aspect: 0.707;
    in-out property <int> print-at;
    in property <int> print-pages;
    in-out property <string> print-status;
    in property <string> print-paper-note;
    /// 紙の本文の大きさ、10分の1ポイント。**0なら画面の設定のまま**（要件 7.10、
    /// 書き手の決定 2026-09-16：「印刷のフォント指定は、デフォルトは画面の指定を
    /// そのまま使い、Optionalで、印刷用のフォントサイズ指定が出来るのがいい」）。
    /// 字体・色・見出しの倍率は画面の設定がそのまま紙へ行く。
    in-out property <int> print-size: 0;
    callback print-size-stepped(int);
    callback print-size-from-screen();
    callback print-paper-pressed();
    in-out property <bool> print-working;
    callback print-turned(int);
    callback print-margin-stepped(int);
    callback print-requested();
    callback print-dismissed();

    in-out property <bool> diff-active: false;
    in property <[DiffRow]> diff-rows;
    in property <string> diff-left-path;
    in property <string> diff-right-path;
    in-out property <string> diff-status;
    in-out property <int> diff-selected-row: -1;
    in property <float> diff-content-width: 1000;
    in property <bool> diff-can-previous;
    in property <bool> diff-can-next;
    callback diff-next-difference(bool);
    callback diff-select-difference(int);
    callback diff-copy-side(bool);
    callback diff-dismissed();
    in property <bool> diff-merge-enabled;
    in property <bool> diff-can-apply;
    callback diff-choose-side(bool);
    callback diff-apply-merge();
    /// 要件 12: open the quick draft window.
    ///
    /// **A request, not the window.** The one thing 要件 12.2 asks of the way
    /// it is opened is that opening it be separable from the click that opened
    /// it, so that a global shortcut can be given the same handle later.
    callback quick-draft-requested();
    callback save-requested();
    callback save-as-requested();
    /// Write every open document that has a file (要件 8.2). The one file
    /// command that is not about one pane, which is why it hangs off the app
    /// menu and Save with it does not.
    callback save-all-requested();
    /// Show the focused pane's document in Explorer (要件 5.2).
    callback reveal-requested();
    /// A pane's strip. **The first argument is which pane**, like everything
    /// else a pane raises; the position is in that pane's own strip.
    callback pane-tab-selected(int, int);
    callback pane-tab-closed(int, int);
    /// 追加要件 2026-09-06: a tab was held down — change the name of the file
    /// it stands for (要件 5.2).
    callback pane-tab-renamed(int, int, string);
    /// 要件 6.5: which pane's strip a tab was carried out of, from where in it,
    /// which place in that same strip it was over, and where the hand let go.
    ///
    /// **The point is in the editing area's coordinates**, which is where the
    /// pane rectangles are: Rust places the panes into that area and can say
    /// which of them a point is in without being told anything more.
    callback pane-tab-dropped(int, int, int, float, float);
    /// 要件 6.5: the carry that is going on, if one is — which pane it started
    /// in and where the hand is, in the editing area's coordinates.
    ///
    /// **Held by the window because a carry crosses the panes.** No pane can
    /// see another one, so the pane a tab would land in cannot be told by the
    /// pane it came from; each of them is given the point and answers for
    /// itself, against the rectangle it was placed in.
    property <bool> carrying: false;
    property <float> carry-x;
    property <float> carry-y;
    /// Close every tab in the window but the one in front of this pane, or
    /// every one (要件 6.3). No position: the pane says which tab is kept, and
    /// nothing else.
    callback pane-close-others(int);
    callback pane-close-all(int);
    callback pane-new-tab(int);
    // 追加要件 2026-09-07: New Tab に立っている三つの言葉のうち二つ。
    // **前に出ているタブがまだ何でもないなら、そのタブがそれになる**——
    // 何でもないタブが無ければ、これまでどおり新しいタブを開く。
    callback pane-new-file(int);
    callback pane-new-terminal(int, int);
    callback pane-switch-shell(int, int);
    /// Publish the strips again. Called from Rust when a document's unsaved
    /// marker moves, which is the one change to a strip that does not come from
    /// something the writer did to the strip itself.
    callback republish-tabs();

    /// Close whichever of the window's own menus is open, and say whether one
    /// was. The panes close theirs; this is what they ask about afterwards.
    ///
    /// The tree's row menus are not here: each one belongs to the row it hangs
    /// from, inside a repeater, and there is nothing to name from out here.
    /// They close by being clicked away from.
    function dismiss-menus() -> bool {
        if (app-menu.is-open) {
            app-menu.close();
            return true;
        }
        // The folder history is closed blind, and it is
        // the same case: it is opened from a row inside the app menu, which is
        // two components up from here (要件 5.1). Reading its `is-open` is what
        // makes that `show()` fail to compile — tried, and it does.
        recent-menu.close();
        return false;
    }

    // The outer layout padding belongs to the chrome, not the transparent paper.
    Rectangle {
        y: root.custom-title ? 36px : 0px;
        width: root.width;
        height: root.height - (root.custom-title ? 36px : 0px);
        border-width: 8px;
        border-color: Tok.paper;
        background: transparent;
    }
    if root.custom-title: TitleMenuBar {
        x: 0px; y: 0px; width: root.width;
        menu-visible: root.title-menu-visible;
        blocked: root.question-open || root.print-active || root.diff-active;
        maximized: root.title-maximized;
        hot: root.title-hot;
        pressed: root.title-pressed;
        document-title: root.document-title;
        focus-generation: root.title-menu-focus-generation;
        selected <=> root.title-menu-active;
        popup-open: root.title-menu-open;
        openable: root.title-menu-openable;
        requested(index) => { root.title-menu-requested(index); }
        dismissed => { root.title-menu-dismissed(); }
        toggled => {
            if root.title-menu-visible { root.title-menu-dismissed(); }
            else { root.title-menu-visible = true; }
        }
    }
    VerticalBox {
        y: root.custom-title ? 36px : 0px;
        height: root.height - (root.custom-title ? 36px : 0px);
        spacing: 0px;

        // 要件 6.1: the left pane, the editing area and the status bar. The
        // left pane is the writer's way into the work folder (要件 6.2) and can
        // be put away when the writing needs the width.
        HorizontalLayout {
            spacing: 0px;

            // The rail stays whatever the panel does, so putting the panel
            // away does not lose which of the four the writer was in — and a
            // fifth panel later costs a button rather than a redesign. The four
            // used to be tabs across the top of the panel: 260px in four equal
            // shares is 62px, which 「アウトライン」 does not fit in, and a name
            // cut short is not a name.
            Rectangle {
                width: 40px;
                background: Tok.chrome-raised;

                // **The whole of the window's own chrome is this rail**
                // (2026-09-06). There was a 34px bar above everything holding
                // two buttons — the menu, and whether the panel was showing.
                // The menu belongs at the head of the rail as readily as
                // anywhere, and the second button was saying something the four
                // below it can say by themselves: pressing the panel you are
                // already in puts it away. A row that holds two buttons costs a
                // row of the document.
                //
                // (40 - 26) / 2 on x, so the button sits in the middle of the
                // rail; 30px apart down it.
                IconButton {
                    visible: !root.custom-title;
                    x: 7px;
                    y: 4px;
                    icon: Icons.menu;
                    tip: @tr("Menu");
                    clicked => {
                        app-menu.show();
                    }
                }

                IconButton {
                    x: 7px; y: root.custom-title ? 4px : 40px;
                    icon: "M1 1h5v5H1zM10 1h5v5h-5zM1 10h5v5H1zM10 10h5v5h-5z";
                    tip: @tr("Workspace");
                    checked: root.tree-open && root.left-tab == 4;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 4);
                        root.left-tab = 4;
                        root.left-tab-chosen(4);
                        root.focus-generation += 1;
                    }
                }

                // **Pressing the panel already showing puts it away**, which is
                // what the sidebar button used to be for. Nothing is lost by
                // closing it: the rail stays, and which of the four the writer
                // was in stays with it.
                IconButton {
                    x: 7px;
                    y: root.custom-title ? 34px : 70px;
                    icon: Icons.folder;
                    tip: @tr("Explorer");
                    checked: root.tree-open && root.left-tab == 0;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 0);
                        root.left-tab = 0;
                        root.left-tab-chosen(0);
                        root.focus-generation += 1;
                    }
                }

                IconButton {
                    x: 7px;
                    y: root.custom-title ? 64px : 100px;
                    icon: Icons.search;
                    tip: @tr("Search");
                    checked: root.tree-open && root.left-tab == 1;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 1);
                        root.left-tab = 1;
                        root.left-tab-chosen(1);
                        root.focus-generation += 1;
                    }
                }

                IconButton {
                    x: 7px;
                    y: root.custom-title ? 94px : 130px;
                    icon: Icons.history;
                    tip: @tr("History");
                    checked: root.tree-open && root.left-tab == 2;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 2);
                        root.left-tab = 2;
                        root.left-tab-chosen(2);
                        root.focus-generation += 1;
                    }
                }

                IconButton {
                    x: 7px;
                    y: root.custom-title ? 124px : 160px;
                    icon: Icons.outline;
                    tip: @tr("Outline");
                    checked: root.tree-open && root.left-tab == 3;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 3);
                        root.left-tab = 3;
                        root.left-tab-chosen(3);
                        root.focus-generation += 1;
                    }
                }

                // 書き手の求め 2026-09-22: Bookmark View。
                IconButton {
                    x: 7px;
                    y: root.custom-title ? 154px : 190px;
                    icon: Icons.bookmark;
                    tip: @tr("Bookmarks");
                    checked: root.tree-open && root.left-tab == 5;
                    clicked => {
                        root.tree-open = !(root.tree-open && root.left-tab == 5);
                        root.left-tab = 5;
                        root.left-tab-chosen(5);
                        root.focus-generation += 1;
                    }
                }

                // Declared here so its position is read against the rail. A popup is
                // its own layer, so it is drawn over the panes without the window
                // having to hold it last the way the question overlay does.
                //
                // `close-on-click-outside` is the whole of "click away to dismiss".
                // Escape is not wired yet: a FocusScope in here would take the
                // keyboard, and clicking away closes the popup without running any
                // of our code, so there would be no moment left to hand the
                // keyboard back to the pane.
                app-menu := PopupWindow {
                    x: 40px;
                    y: 4px;
                    width: 264px;
                    close-policy: close-on-click-outside;

                    MenuFrame {
                        width: 264px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;

                            MenuRow {
                                title: @tr("Open File…");
                                shortcut: root.shortcut-keys[0]; activated => {
                                    app-menu.close();
                                    root.open-file-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            MenuRow {
                                title: @tr("Open Folder…");
                                activated => {
                                    app-menu.close();
                                    root.work-folder-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            MenuRow {
                                title: @tr("Workspaces…");
                                activated => { app-menu.close(); root.workspace-manager-requested(); }
                            }
                            // Nothing to go back to on a first run, and a row that
                            // opens an empty menu is a row that lies.
                            if root.recent-folders.length > 0: MenuRow {
                                title: @tr("Recent Folders");
                                // The mark a submenu carries, in the column the
                                // shortcuts use. There is no key for this one.
                                shortcut: "▸";
                                // **Shown first, closed second**, which is the
                                // opposite of every plain row above and the same
                                // as the tab list's rows. An `if` compiles to a
                                // repeater, so this row is a repeated element:
                                // closing the menu takes the element whose handler
                                // is running with it, and the line after it never
                                // runs. Written the other way round the row is
                                // there, the menu closes, and nothing opens.
                                activated => {
                                    recent-menu.show();
                                    app-menu.close();
                                }
                            }
                            MenuRow {
                                title: @tr("New Terminal");
                                // The mark a submenu carries, in the column the
                                // shortcuts use — the same one Recent Folders
                                // has. **Shown first, closed second**, for the
                                // reason written there.
                                shortcut: "▸";
                                activated => {
                                    shell-menu.show();
                                    app-menu.close();
                                }
                            }
                            MenuRow {
                                title: @tr("Quick Draft…");
                                activated => {
                                    app-menu.close();
                                    root.quick-draft-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            MenuSep { }
                            MenuRow {
                                title: @tr("Save All");
                                activated => {
                                    app-menu.close();
                                    root.save-all-requested();
                                    root.focus-generation += 1;
                                }
                            }
                            MenuSep { }
                            // 追加要件 2026-09-08: **探す相手がいないときは
                            // 出さない。**この行は要件 7.7 の帯をいま鍵盤を
                            // 持っているペインの上に開くが、そこにシェルが
                            // 立っているなら帯が読むのはその裏の見えない文書
                            // ——押せて、開いて、何も見つからない。
                            //
                            // **`if`の中の行は頼んでから閉じる**（6.24）。
                            if !root.panes[root.current-pane-row].terminal: MenuRow {
                                title: @tr("Find in File…");
                                shortcut: root.shortcut-keys[4]; activated => {
                                    root.find-pane = root.focused-pane;
                                    root.find-replacing = false;
                                    root.find-open = true;
                                    root.find-generation += 1;
                                    root.focus-generation += 1;
                                    app-menu.close();
                                }
                            }
                            MenuRow {
                                title: @tr("Find in Folder…");
                                activated => {
                                    app-menu.close();
                                    root.tree-open = true;
                                    root.left-tab = 1;
                                    root.left-tab-chosen(1);
                                    root.focus-generation += 1;
                                }
                            }
                        }
                    }
                }

                // 要件 5.1: the folders worked in before this one. A menu of its
                // own rather than a submenu — the row above closes `app-menu` and
                // shows this one, which is how `Layout…` already opens a panel
                // from a menu. It stands in the same place, so the list appears
                // where the writer was looking.
                // 追加要件 Terminal: which shell the new tab runs. **A list
                // rather than two rows**, because the writer will meet the same
                // choice again in the `+` button and it should read the same
                // way in both places.
                shell-menu := PopupWindow {
                    x: 40px;
                    y: 4px;
                    width: 264px;
                    close-policy: close-on-click-outside;

                    MenuFrame {
                        width: 264px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;

                            for shell[index] in root.terminal-shells: MenuRow {
                                title: shell;
                                // **閉じるのは最後**（2026-09-07）。`close`の
                                // 後ろに書いたものは、木ごと捨てられた行から
                                // `root`へ登れずに落ちることがある——下の
                                // `recent-menu`の注記と同じ話で、順を揃えた。
                                activated => {
                                    root.terminal-requested(index);
                                    root.focus-generation += 1;
                                    shell-menu.close();
                                }
                            }
                        }
                    }
                }

                recent-menu := PopupWindow {
                    x: 40px;
                    y: 4px;
                    width: 264px;
                    close-policy: close-on-click-outside;

                    MenuFrame {
                        width: 264px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;

                            for folder[index] in root.recent-folders: MenuRow {
                                title: folder;
                                // **Chosen first, closed second**, for the reason
                                // the tab list gives: these rows are a repeater
                                // inside the popup, and closing first takes the
                                // element whose handler is running with it.
                                activated => {
                                    root.recent-folder-chosen(index);
                                    root.focus-generation += 1;
                                    recent-menu.close();
                                }
                            }
                        }
                    }
                }

                // 追加要件 2026-09-06: **everything that is set for the whole
                // editor is behind this one button**, and it stands at the foot
                // of the rail rather than among the four above it — those four
                // choose what the panel beside them shows, and this one opens
                // something else entirely. The writer asked for it in the
                // bottom-left corner, which is where the rail ends.
                IconButton {
                    x: 7px;
                    y: parent.height - self.height - 7px;
                    icon: Icons.settings;
                    tip: @tr("Settings");
                    clicked => {
                        root.settings-requested();
                    }
                }
            }

            if root.tree-open: Rectangle {
                width: root.tree-width * 1px;
                background: root.left-paper;

                VerticalLayout {
                    padding: 0px;

                    if root.left-tab == 4 && !root.workspace-active: WorkspaceManager {
                        active: root.workspace-active;
                        open-selected => { root.workspace-open-selected(); }
                        leave-requested => { root.workspace-leave-requested(); }
                        read-error: root.workspace-read-error;
                        read-error-text: root.workspace-read-error-text;
                        read-error-reset-requested => { root.workspace-read-error-reset-requested(); }
                        workspaces: root.workspace-rows;
                        selected: root.workspace-manager-selected;
                        row-chosen(index) => { root.workspace-row-chosen(index); }
                        row-context-chosen(index) => { root.workspace-row-context-chosen(index); }
                        create-requested => { root.workspace-create-requested(); }
                        clone-requested => { root.workspace-clone-requested(); }
                        cloning: root.workspace-cloning;
                        duplicate-requested => { root.workspace-duplicate-requested(); }
                        rename-requested => { root.workspace-rename-requested(); }
                        default-toggled => { root.workspace-default-toggled(); }
                        remove-requested => { root.workspace-remove-requested(); }
                        reset-view-requested => { root.workspace-reset-view-requested(); }
                        folders: root.workspace-folder-rows;
                        folder-add-requested => { root.workspace-folder-add-requested(); }
                        folder-mode-toggled(index) => { root.workspace-folder-mode-toggled(index); }
                        folder-move-up-requested(index) => { root.workspace-folder-move-up-requested(index); }
                        folder-move-down-requested(index) => { root.workspace-folder-move-down-requested(index); }
                        folder-detached(index) => { root.workspace-folder-detached(index); }
                        folder-relocated(index) => { root.workspace-folder-relocated(index); }
                        unused-folders: root.workspace-unused-folder-rows;
                        unused-folder-removed(index) => { root.workspace-unused-folder-removed(index); }
                        closed => {
                                            root.workspace-manager-closed();
                        }
                    }

                    if root.left-tab == 4 && root.workspace-active: VerticalLayout {
                        padding: 6px; spacing: 4px; vertical-stretch: 0;
                        HorizontalLayout {
                            spacing: 2px;
                        Rectangle {
                            height: 30px;
                            min-width: 44px;
                            horizontal-stretch: 1;
                            TextButton {
                                width: parent.width; wide: true;
                                title: root.workspace-current-label + " ▾";
                                clicked => { workspace-name-menu.show(); }
                            }
                            workspace-name-menu := PopupWindow {
                                x: 0px; y: 30px; width: 248px; close-policy: close-on-click-outside;
                                MenuFrame {
                                    width: 248px;
                                    VerticalLayout {
                                        padding: 6px; spacing: 1px;
                                        for name[index] in root.workspace-switcher-rows: MenuRow {
                                            title: name; checked: name == root.workspace-current-label;
                                            activated => { root.workspace-switcher-chosen(index); workspace-name-menu.close(); }
                                        }
                                        MenuSep { }
                                        MenuRow { title: @tr("New Workspace…"); activated => { root.workspace-create-requested(); workspace-name-menu.close(); } }
                                        MenuRow { title: @tr("Rename…"); activated => { root.workspace-rename-requested(); workspace-name-menu.close(); } }
                                        MenuRow { title: @tr("Duplicate…"); activated => { root.workspace-duplicate-requested(); workspace-name-menu.close(); } }
                                        MenuRow {
                                            title: root.workspace-manager-selected >= 0 && root.workspace-rows[root.workspace-manager-selected].is-default ? @tr("Unset Default") : @tr("Set Default");
                                            activated => { root.workspace-default-toggled(); workspace-name-menu.close(); }
                                        }
                                        MenuRow { title: @tr("Reset View…"); activated => { root.workspace-reset-view-requested(); workspace-name-menu.close(); } }
                                        MenuRow { title: @tr("Remove…"); activated => { root.workspace-remove-requested(); workspace-name-menu.close(); } }
                                        MenuSep { }
                                        MenuRow { title: @tr("Show Current Document in Tree"); activated => { root.explorer-command(0); workspace-name-menu.close(); } }
                                        MenuRow { title: @tr("Collapse All"); activated => { root.explorer-command(1); workspace-name-menu.close(); } }
                                        MenuRow { title: @tr("Refresh"); activated => { root.explorer-command(2); workspace-name-menu.close(); } }
                                    }
                                }
                            }
                        }
                            IconButton { icon: Icons.plus; tip: @tr("Add Folder…"); clicked => { root.workspace-tree-command(0); } }
                            IconButton { icon: "M8 1v9M4 6l4 4 4-4M2 11v4h12v-4"; tip: root.workspace-cloning ? @tr("Cloning Repository…") : @tr("Clone Repository…"); enabled: !root.workspace-cloning; clicked => { root.workspace-tree-command(1); } }
                            IconButton { icon: "M1 2h14L9 8v6l-2-1V8z"; tip: @tr("Filter files…"); checked: root.workspace-filter-visible; clicked => { root.workspace-filter-visible = !root.workspace-filter-visible; } }
                        }
                    }
                    if root.left-tab == 5: BookmarkView {
                        available: root.bookmark-available;
                        rows: root.bookmark-rows;
                        groups: root.bookmark-groups;
                        descending: root.bookmark-descending;
                        selected: root.bookmark-selected;
                        filter <=> root.bookmark-filter;
                        filter-visible <=> root.bookmark-filter-visible;
                        text-size: root.left-size;
                        ink: root.left-file-own ? root.left-file-ink : root.left-ink;
                        group-ink: root.left-folder-own ? root.left-folder-ink : root.left-ink;
                        activated(row) => { root.bookmark-activated(row); }
                        toggled(row) => { root.bookmark-toggled(row); }
                        cleared => { root.bookmark-cleared(); }
                        add-current => { root.bookmark-add-current(); }
                        create-group => { root.bookmark-create-group(); }
                        sort-toggled => { root.bookmark-sort-toggled(); }
                        filter-changed => { root.bookmark-filter-changed(); }
                        rename(row) => { root.bookmark-rename(row); }
                        remove(row) => { root.bookmark-remove(row); }
                        move-to(row, group) => { root.bookmark-move-to(row, group); }
                        dropped(row, onto) => { root.bookmark-dropped(row, onto); }
                    }
                    // 書き手の求め 2026-09-22: 見出しの一覧の上に、全部畳む・全部開く。
                    if root.left-tab == 3: HorizontalLayout {
                        padding: 6px; spacing: 2px; vertical-stretch: 0;
                        alignment: start;
                        IconButton { icon: Icons.collapse-all; tip: @tr("Collapse All"); clicked => { root.outline-fold-all(true); } }
                        IconButton { icon: Icons.expand-all; tip: @tr("Expand All"); clicked => { root.outline-fold-all(false); } }
                    }
                    if root.left-tab == 0: tree-head := Rectangle {
                        height: 34px;
                        // 要件 5.2: the work folder itself is a place to let a
                        // row go, and this heading is its name. **The one
                        // target that cannot be scrolled away** — the rows can
                        // be, and a mark that is sometimes absent is not a
                        // mark (6.25).
                        // **The band directly above the list**, said in the
                        // list's own coordinates: the heading is what the panel
                        // puts there, so one heading's height above the first
                        // row that is shown is the heading.
                        property <bool> under-carry: root.tree-carrying
                            && root.work-folder != ""
                            // 仕様 "Drag target header invalid for multi-root":
                            // with more than one active root the heading names
                            // a Workspace, not a folder, and a root row is
                            // where "this Workspace's own top level" is dropped
                            // instead.
                            && !root.tree-multi-root
                            && root.tree-carry-parent != -1
                            && root.tree-carry-x >= 0px
                            && root.tree-carry-x < self.width
                            && root.tree-carry-y < -tree-view.viewport-y
                            && root.tree-carry-y >= -tree-view.viewport-y - self.height;
                        // **Cleared by whoever set it**, so that leaving a
                        // target and entering another can happen in either
                        // order without the two undoing each other.
                        changed under-carry => {
                            if (self.under-carry) {
                                root.tree-drop-hand = -1;
                                root.tree-drop-into = -1;
                            } else if (root.tree-drop-hand == -1) {
                                root.tree-drop-hand = -2;
                                root.tree-drop-into = -2;
                            }
                        }
                        // **Lit by any row whose folder is the work folder**,
                        // not only by the hand being on the heading: a file
                        // sitting at the top of the tree says "into the work
                        // folder", and this is where the work folder is drawn.
                        property <bool> receiving: root.tree-carrying
                            && root.tree-drop-into == -1;
                        background: self.receiving ? Tok.accent-faint : Tok.chrome-raised;
                        border-width: self.receiving ? 2px : 0px;
                        border-color: Tok.accent;

                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 6px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 2px;

                            Rectangle {
                                horizontal-stretch: 1;
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                text: root.work-folder == ""
                                    ? @tr("No folder open")
                                    : root.work-folder;
                                color: Tok.ink;
                                font-size: root.left-size * 1px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.work-folder-requested(); }
                                }
                            }

                            // 要件 5.2: **the two commands that have no row to
                            // act on.** The other four are each row's own, in
                            // the menu it carries; these two cannot be, because
                            // a folder with nothing in it has no row to ask.
                            // The three never appear together: with no work
                            // folder there is nothing to create in, and opening
                            // one is the only thing left to do.
                            if root.work-folder != "": IconButton {
                                icon: "M8 1v3M8 12v3M1 8h3M12 8h3M3.5 3.5h9v9h-9z";
                                tip: @tr("Show Current Document in Tree");
                                clicked => { root.explorer-command(0); }
                            }
                            if root.work-folder != "": IconButton {
                                icon: "M3 2h10v9M1 5h9v9H1zM3 9.5h5";
                                tip: @tr("Collapse All");
                                clicked => { root.explorer-command(1); }
                            }
                            if root.work-folder != "": IconButton {
                                icon: "M13 5a5.5 5.5 0 1 0 0 6M13 1v4H9";
                                tip: @tr("Refresh");
                                clicked => { root.explorer-command(2); }
                            }

                            // 追加要件 2026-09-06: **the `+` asks what kind**,
                            // the same three-way question the tab strip's `+`
                            // asks — a file, a shell, or a folder.
                            // **釦と一緒の箱に入れる**（書き手の指摘 2026-09-07:
                            // メニューが☰の場所に出る）。popupはレイアウトの
                            // 子にならないので、行に直に置くと座標の原点が
                            // 「ボタンの列の左上」——つまり左のレールの隣——に
                            // なり、`-150px`はそこから更に左＝☰の上へ出ていた。
                            // 箱の中なら原点はこの釦自身で、真下に置ける。
                            //
                            // 釦とpopupを同じ`if`の中へ入れられるのは、両方が
                            // 同じ要素の中にいるから（技術検証6.24が言うのは
                            // 「repeaterの外から中のidは掴めない」で、中から
                            // 中は掴める）。
                            if root.work-folder != "": Rectangle {
                                width: 26px;
                                height: 26px;

                                IconButton {
                                    icon: Icons.plus;
                                    tip: @tr("New");
                                    clicked => {
                                        tree-plus-menu.show();
                                    }
                                }

                            tree-plus-menu := PopupWindow {
                                x: 0;
                                y: 28px;
                                width: 220px;
                                close-policy: close-on-click-outside;

                                MenuFrame {
                                    width: 220px;

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 1px;

                                        // **頼んでから閉じる**（2026-09-07）。
                                        // `close`はこの行の立っている木を捨てる
                                        // ので、後に書いたものは届かないことが
                                        // ある。
                                        MenuRow {
                                            title: @tr("New File…");
                                            activated => {
                                                root.tree-command(0);
                                                tree-plus-menu.close();
                                            }
                                        }
                                        MenuRow {
                                            title: @tr("New Terminal");
                                            activated => {
                                                root.terminal-requested(root.default-shell);
                                                root.focus-generation += 1;
                                                tree-plus-menu.close();
                                            }
                                        }
                                        MenuRow {
                                            title: @tr("New Folder…");
                                            activated => {
                                                root.tree-command(1);
                                                tree-plus-menu.close();
                                            }
                                        }
                                    }
                                }
                            }
                            }
                            // **The folder button opens a folder** (追加要件
                            // 2026-09-06). Making a folder moved into the `+`
                            // beside it, where the other two "new" rows are; a
                            // button that made one and a button that opened one
                            // wore the same icon and did opposite things.

                        }
                    }

                    if root.left-tab == 0 || (root.left-tab == 4 && root.workspace-active && root.workspace-filter-visible): Field {
                        height: 28px;
                        placeholder: @tr("Filter files…");
                        text <=> root.tree-filter;
                        edited => { root.tree-filter-changed(); }
                    }
                    // 要件 7.7: the question this panel asks is about the
                    // work folder, so it has its own field. The find bar above
                    // the editor asks about one document; the two are different
                    // questions and share nothing.
                    if root.left-tab == 1: Rectangle {
                        background: Tok.accent-faint;
                        vertical-stretch: 0;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            needle-in-folder := Field {
                                placeholder: @tr("Search in folder");
                                text <=> root.folder-needle;
                                // Built when the panel is, so asking for it is
                                // enough to type into it.
                                init => {
                                    self.take-focus();
                                }
                                accepted => {
                                    root.folder-search-requested();
                                }
                            }

                            // 歩くフォルダ。押すと選び直せる。
                            HorizontalLayout {
                                spacing: 4px;

                                Rectangle {
                                    height: 24px;
                                    horizontal-stretch: 1;
                                    border-radius: 4px;
                                    background: pick-folder.has-hover
                                        ? Tok.chrome-raised
                                        : (root.search-folder-scoped
                                            ? Tok.accent-soft
                                            : transparent);

                                    Icon {
                                        x: 4px;
                                        y: (parent.height - self.height) / 2;
                                        commands: Icons.folder;
                                        tint: root.search-folder-scoped
                                            ? Tok.accent-strong
                                            : Tok.ink-faint;
                                    }

                                    Text {
                                        x: 24px;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width - 28px;
                                        text: root.search-folder;
                                        color: root.search-folder-scoped
                                            ? Tok.accent-strong
                                            : Tok.ink-muted;
                                        font-size: 12px;
                                        overflow: elide;
                                    }

                                    pick-folder := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search-folder-requested();
                                        }
                                    }

                                    // 道のりはここに出す。**TouchAreaより後に
                                    // 書く**——先に書くと下に敷かれてポインタを
                                    // 見ない（`IconButton`に同じ注記がある）。
                                    if root.search-folder-path != "": Tooltip {
                                        text: @markdown("\{root.search-folder-path}");
                                    }
                                }

                                if root.search-folder-scoped: IconButton {
                                    icon: Icons.close;
                                    tip: @tr("Search the whole work folder");
                                    size: 24px;
                                    clicked => {
                                        root.search-folder-reset();
                                    }
                                }
                            }

                            Text { text: @tr("Names to exclude (separate with ;, * and ? allowed)"); color: Tok.ink-muted; font-size: 11px; wrap: word-wrap; }
                            Field {
                                placeholder: @tr("e.g. *.bak; backup/");
                                text <=> root.search-exclusions;
                                edited => { root.search-exclusions-changed(); }
                                accepted => { root.folder-search-requested(); }
                            }
                            HorizontalLayout {
                                spacing: 6px;

                                TextButton {
                                    title: @tr("Search");
                                    clicked => {
                                        root.folder-search-requested();
                                    }
                                }

                                Text {
                                    text: root.folder-status;
                                    color: Tok.accent;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    if (root.left-tab == 0 || root.left-tab == 4) && root.tree-new-index >= 0 && root.tree-new-error != "": Text {
                        text: root.tree-new-error;
                        color: Tok.ink;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    tree-view := ScrollView {
                        visible: (root.left-tab != 4 || root.workspace-active) && root.left-tab != 5;
                        vertical-stretch: self.visible ? 1 : 0;
                        max-height: self.visible ? 100000px : 0px;
                        // 要件 5.2: the point being carried, but only while it
                        // is over the rows the writer can see. **A row scrolled
                        // out of sight still has a place in the list**, and the
                        // point is in that same list — so the part of it that
                        // is on screen is asked for here, once, rather than by
                        // every row. `viewport-y` is negative as the list is
                        // scrolled, so the top of what is shown is `-viewport-y`
                        // rows down.
                        property <bool> holds-carry: root.tree-carrying
                            && root.tree-carry-x >= 0px
                            && root.tree-carry-x < self.width
                            && root.tree-carry-y >= -self.viewport-y
                            && root.tree-carry-y < -self.viewport-y + self.visible-height;

                        VerticalLayout {
                            alignment: start;

                            for row[index] in root.left-rows: tree-row := Rectangle {
                                // 追加要件 2026-09-15: 行の高さは字の大きさに合わせる（12pxで24px）。
                                height: root.left-tab == 4 && row.is-root ? root.tree-root-row-height : max(24px, root.left-size * 2px);
                                property <int> reveal-generation: root.tree-reveal-generation;
                                changed reveal-generation => {
                                    if (root.left-tab == 0 || root.left-tab == 4) && index == root.tree-selected {
                                        tree-view.viewport-y = -min(self.y, max(0px, tree-view.viewport-height - tree-view.visible-height));
                                    }
                                }
                                // 要件 5.2: what this row can be given. A file
                                // is not a place to put anything, the folder
                                // it is already in cannot be given what it
                                // holds, and a folder cannot go inside itself.
                                // The folder a file sits in is drawn one row
                                // up wherever it is, so aiming at that costs
                                // nothing — and this way no mark ever says a
                                // drop will happen where it will not. The rows
                                // from the carried one to
                                // `tree-carry-end` are what is under it.
                                // Where something let go on this row would go:
                                // a folder takes it in, and anything else means
                                // the folder it is in — the same rule that
                                // decides where a new file is made (要件 5.2).
                                property <int> destination: row.folder
                                    ? index
                                    : row.parent;
                                property <bool> takes-carry: root.tree-carrying
                                    && (root.left-tab == 0 || root.left-tab == 4)
                                    && self.destination != root.tree-carry-parent
                                    && (self.destination < root.tree-carried-from
                                        || self.destination >= root.tree-carry-end);
                                // Only the flow direction is compared: a row is
                                // as wide as the panel, and the view above has
                                // already answered for the other axis. **The
                                // row's own `y`**, which is where the layout put
                                // it and is the same space the point is in.
                                property <bool> under-carry: self.takes-carry
                                    && tree-view.holds-carry
                                    && root.tree-carry-y >= self.y
                                    && root.tree-carry-y < self.y + self.height;
                                changed under-carry => {
                                    if (self.under-carry) {
                                        root.tree-drop-hand = index;
                                        root.tree-drop-into = self.destination;
                                    } else if (root.tree-drop-hand == index) {
                                        root.tree-drop-hand = -2;
                                        root.tree-drop-into = -2;
                                    }
                                }
                                // **Two marks, because there are two answers.**
                                // The hand is on this row; what it lands in is
                                // the folder — and when the writer is pointing
                                // inside an open folder, that folder is a
                                // different row (or the heading).
                                property <bool> receiving: root.tree-carrying
                                    && root.tree-drop-into == index;
                                property <bool> pointed: root.tree-carrying
                                    && root.tree-drop-hand == index;
                                // The row in the writer's hand has gone pale,
                                // the way a carried tab does (要件 6.5): it
                                // stays where it is, because the tree is not
                                // drawn again until the hand lets go.
                                property <float> label-opacity: (root.tree-carrying
                                    && index == root.tree-carried-from) ? 0.45 : 1.0;
                                border-width: self.receiving ? 2px : 0px;
                                border-color: Tok.accent;
                                // The selected row is the one the file commands
                                // act on (要件 5.2), so it has to be visible
                                // which one it is.
                                background: self.receiving || self.pointed
                                    ? Tok.accent-faint
                                    : (root.left-tab == 4 && row.is-root
                                        ? (index == root.tree-active-root-index ? Tok.accent-soft : transparent)
                                    : (index == root.tree-selected
                                        ? Tok.accent-soft
                                        : (entry.has-hover ? Tok.accent-faint : transparent)));

                                // Whether the button went down on this row,
                                // where it went down, and whether it has since
                                // travelled far enough to be a carry rather
                                // than a click. **Four pixels**, the same as a
                                // tab's: a hand resting on a row is not
                                // perfectly still.
                                property <bool> pressing: false;
                                changed pressing => { root.tree-pointer-down = self.pressing; }
                                property <length> press-x;
                                property <length> press-y;
                                property <bool> carrying-self: false;
                                // How many moves reached this row while it was
                                // pressed. `0` says the press or the drag never
                                // arrived at all, which is a different fault
                                // from a carry that found nowhere to land.
                                property <int> moves: 0;

                                entry := TouchArea {
                                    enabled: root.tree-new-index < 0 || (root.left-tab != 0 && root.left-tab != 4);
                                    // The hand is closed while a row is in it.
                                    mouse-cursor: tree-row.carrying-self
                                        ? MouseCursor.grabbing
                                        : MouseCursor.default;
                                    // **Not `clicked`.** A click is a press and
                                    // a release in the same place, which is
                                    // exactly what a carry is not, and both
                                    // come out of the same press — so the press
                                    // is followed here rather than asked about
                                    // afterwards (要件 5.2, and `Tab` in
                                    // controls.slint says it for 要件 6.5).
                                    //
                                    // 要件 5.2: the right button asks a row
                                    // what can be done to it. **Choosing the
                                    // row is not opening it** — the commands
                                    // act on what is chosen, and neither the
                                    // file nor the fold was asked for.
                                    //
                                    // The number is put here rather than left
                                    // to Rust, because Rust answers by drawing
                                    // the rows again — which would take this
                                    // row, and the menu hanging from it, away
                                    // in the middle of opening it.
                                    pointer-event(event) => {
                                        if ((root.left-tab == 0 || root.left-tab == 4)
                                            && event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down) {
                                            root.tree-selected = index;
                                            root.left-context-requested(index);
                                            root.show-tree-menu(tree-row.absolute-position.x + 8px, tree-row.absolute-position.y + 24px);
                                        }
                                        // 書き手の求め 2026-09-22: 見出しの右クリックで栞を足す。
                                        if (root.left-tab == 3
                                            && event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down) {
                                            root.outline-menu-row = index;
                                            root.outline-menu-x = tree-row.absolute-position.x + entry.mouse-x;
                                            root.outline-menu-y = tree-row.absolute-position.y + entry.mouse-y;
                                            outline-context-menu.show();
                                        }
                                        if (event.button != PointerEventButton.left) {
                                            return;
                                        }
                                        if (event.kind == PointerEventKind.down) {
                                            tree-row.pressing = true;
                                            tree-row.carrying-self = false;
                                            tree-row.moves = 0;
                                            tree-row.press-x = entry.mouse-x;
                                            tree-row.press-y = entry.mouse-y;
                                        }
                                        if (event.kind == PointerEventKind.up) {
                                            root.tree-row-traced(index,
                                                tree-row.moves,
                                                tree-row.pressing,
                                                tree-row.carrying-self,
                                                root.tree-drop-into,
                                                false);
                                            if (tree-row.carrying-self) {
                                                // **Asked first, put down
                                                // second**: the move is what
                                                // the drop means, and Rust is
                                                // told it before the marks it
                                                // was drawn from are cleared.
                                                root.tree-row-dropped(
                                                    index, root.tree-drop-into);
                                                root.tree-carrying = false;
                                                root.tree-carried-from = -1;
                                                root.tree-drop-hand = -2;
                                                root.tree-drop-into = -2;
                                            } else if (tree-row.pressing && !(root.left-tab == 4 && row.is-root)) {
                                                root.left-row-activated(index);
                                                root.focus-generation += 1;
                                            }
                                            tree-row.pressing = false;
                                            tree-row.carrying-self = false;
                                        }
                                        if (event.kind == PointerEventKind.cancel) {
                                            root.tree-row-traced(index,
                                                tree-row.moves,
                                                tree-row.pressing,
                                                tree-row.carrying-self,
                                                root.tree-drop-into,
                                                true);
                                            if (tree-row.carrying-self) {
                                                root.tree-carrying = false;
                                                root.tree-carried-from = -1;
                                                root.tree-drop-hand = -2;
                                                root.tree-drop-into = -2;
                                            }
                                            tree-row.pressing = false;
                                            tree-row.carrying-self = false;
                                        }
                                    }
                                    double-clicked => {
                                        if !(root.left-tab == 4 && row.is-root) { root.left-row-kept(index); }
                                    }
                                    moved => {
                                        tree-row.moves += 1;
                                        if (!tree-row.pressing || (root.left-tab != 0 && root.left-tab != 4)) {
                                            return;
                                        }
                                        // **The point before the carry.** Every
                                        // row watches it, so setting `carrying`
                                        // first would have them all answer once
                                        // against a position from no drag at
                                        // all (要件 6.5 says the same of tabs).
                                        root.tree-carry-x = entry.mouse-x;
                                        root.tree-carry-y = tree-row.y + entry.mouse-y;
                                        // 仕様 "root row itself not draggable":
                                        // a registered root moves only through
                                        // Workspace management's own reordering,
                                        // never by being picked up here.
                                        if (!row.is-root
                                            && !tree-row.carrying-self
                                            && (entry.mouse-x > tree-row.press-x + 4px
                                                || entry.mouse-x < tree-row.press-x - 4px
                                                || entry.mouse-y > tree-row.press-y + 4px
                                                || entry.mouse-y < tree-row.press-y - 4px)) {
                                            tree-row.carrying-self = true;
                                            root.tree-carried-from = index;
                                            root.tree-drop-hand = -2;
                                            root.tree-drop-into = -2;
                                            // Rust answers with how far the
                                            // rows under this one reach, and
                                            // answering costs no redraw.
                                            root.tree-row-grabbed(index);
                                            root.tree-carrying = true;
                                        }
                                    }
                                }

                                if (root.left-tab == 0 || root.left-tab == 4) && row.folder && !row.is-root && index != root.tree-new-index: Text {
                                    x: 8px + row.depth * root.left-size * 7px / 6;
                                    width: root.left-size * 1px;
                                    height: parent.height;
                                    text: row.open ? "▾" : "▸";
                                    color: root.left-folder-own ? root.left-folder-ink : root.left-ink;
                                    font-size: root.left-size * 1px;
                                    vertical-alignment: center;
                                    opacity: tree-row.label-opacity;
                                }
                                if (root.left-tab == 0 || root.left-tab == 4) && row.folder && !row.is-root && index != root.tree-new-index: Icon {
                                    x: 8px + row.depth * root.left-size * 7px / 6 + root.left-size * 1.2px;
                                    y: (parent.height - self.height) / 2;
                                    width: root.left-size * 1.3px;
                                    height: self.width;
                                    commands: Icons.folder;
                                    tint: root.left-folder-own ? root.left-folder-ink : root.left-ink;
                                    opacity: tree-row.label-opacity;
                                }

                                Text {
                                    visible: !(root.left-tab == 4 && row.is-root) && ((root.left-tab != 0 && root.left-tab != 4) || index != root.tree-new-index);
                                    // Depth is drawn rather than nested, because
                                    // the rows arrive flat (see `LeftRow`).
                                    x: 8px + row.depth * root.left-size * 7px / 6
                                        + ((root.left-tab == 0 || root.left-tab == 4) ? root.left-size * 2.75px : 0px);
                                    text: (root.left-tab == 0 || root.left-tab == 4) ? row.name
                                        : ((row.folder ? (row.open ? "▾ " : "▸ ") : "　") + row.name);
                                    opacity: tree-row.label-opacity;
                                    // 追加要件 2026-09-15: フォルダとファイルで色を分けられる（Explorerの面）。
                                    color: row.folder
                                        ? (root.left-folder-own ? root.left-folder-ink : root.left-ink)
                                        : ((root.left-tab == 0 || root.left-tab == 4) && root.left-file-own ? root.left-file-ink : root.left-ink);
                                    font-size: root.left-size * 1px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    // Room for the `…`, which is not in a layout
                                    // with it: the button has to be declared
                                    // after the area that opens the row to take
                                    // a click at all.
                                    width: parent.width - self.x
                                        - ((root.left-tab == 0 || root.left-tab == 4) ? 28px : 8px);
                                }

                                // 書き手の求め 2026-09-22: 見出しの▸／▾を押すと、その下を畳む・開く。
                                // 行の他の場所は今までどおりその見出しへ行く。**`entry`より後に書く**
                                // ——先に書くと下に敷かれて押せない。
                                if root.left-tab == 3 && row.folder: TouchArea {
                                    x: 4px + row.depth * root.left-size * 7px / 6;
                                    width: root.left-size * 1px + 8px;
                                    mouse-cursor: pointer;
                                    clicked => { root.outline-fold-toggled(index); }
                                }

                                if root.left-tab == 4 && row.is-root: Rectangle {
                                    x: 8px; y: 0px; height: 1px; width: parent.width - 16px;
                                    background: Tok.rule-strong;
                                }
                                if root.left-tab == 4 && row.is-root: Text {
                                    x: 8px; y: 1px;
                                    width: parent.width - 16px; height: parent.height - 1px;
                                    text: root.tree-root-labels[index];
                                    font-size: root.left-size * 1px;
                                    font-weight: index == root.tree-active-root-index ? 600 : 400;
                                    color: index == root.tree-active-root-index ? Tok.accent-strong : root.left-ink;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.left-tab == 1 || (root.left-tab == 4 && row.is-root): Tooltip {
                                    text: @markdown("`\{row.name}`");
                                }

                                if (root.left-tab == 0 || root.left-tab == 4) && index == root.tree-new-index: Field {
                                    x: 8px + row.depth * root.left-size * 7px / 6 + root.left-size * 2.75px;
                                    width: max(20px, parent.width - self.x - 4px);
                                    height: 24px;
                                    text <=> root.tree-new-name;
                                    init => { self.take-focus-selecting-all(); }
                                    accepted => { root.tree-new-finished(true); }
                                    escaped => { root.tree-new-finished(false); }
                                    edited => { root.tree-new-error = ""; }
                                }
                                // The same menu as the right button, for a
                                // pointer that is already on the row. Only the
                                // tree has one: a search hit and a heading are
                                // not files to be renamed.
                                if (!(root.left-tab == 4 && row.is-root) && (root.left-tab == 0 || root.left-tab == 4) && root.tree-new-index < 0
                                    && (index == root.tree-selected || entry.has-hover)): IconButton {
                                    x: parent.width - self.width - 3px;
                                    y: (parent.height - self.height) / 2;
                                    size: 20px;
                                    icon: Icons.dots;
                                    clicked => {
                                        root.tree-selected = index;
                                        root.left-context-requested(index);
                                        root.show-tree-menu(tree-row.absolute-position.x + 8px, tree-row.absolute-position.y + 24px);
                                    }
                                }

                                // One per row, which is what makes placing it
                                // free: it hangs from the row it acts on. The
                                // compiler builds it when it is shown, not when
                                // the row is drawn.
                                //
                                // **Closed before the command, the opposite of
                                // the tab list** (技術検証 6.22): these rows are
                                // written out rather than repeated, so closing
                                // does not take the element running the handler
                                // with it — and half of these commands draw the
                                // tree again, which does take the row away.

                            }
                            if root.left-tab == 4 && root.workspace-active: Rectangle {
                                // A ScrollView sizes an alignment:start layout to its
                                // content, so stretch alone leaves only the minimum.
                                // This row starts immediately after the file rows;
                                // fill the visible space remaining from that position.
                                height: max(48px, tree-view.visible-height
                                    - (root.left-rows.length - root.tree-root-row-count) * max(24px, root.left-size * 2px)
                                    - root.tree-root-row-count * root.tree-root-row-height);
                                vertical-stretch: 0;
                                TouchArea {
                                    pointer-event(event) => {
                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                            root.tree-selected = -1;
                                            root.left-context-requested(-1);
                                            root.show-tree-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.left-tab == 4 && root.workspace-active: TextButton {
                        wide: true; title: @tr("Close Workspace");
                        clicked => { root.workspace-leave-requested(); }
                    }
                }
            }

            // 追加要件 2026-09-06: the edge the writer drags to make the left
            // pane wider or narrower.
            //
            // **The same shape as the boundaries between panes** — a wide grab
            // area with a thin line drawn inside it, thickening under the
            // pointer — because it is the same gesture and the hand should not
            // have to learn it twice. **A delta, not a position**: the layout
            // moves this element under the pointer, so `mouse-x` comes back to
            // `pressed-x` and the next event reports only what is new (the pane
            // boundaries say the same thing above).
            if root.tree-open: Rectangle {
                width: 9px;
                background: Tok.chrome;

                Rectangle {
                    x: tree-grab.has-hover || tree-grab.pressed ? 3px : 4px;
                    width: tree-grab.has-hover || tree-grab.pressed ? 3px : 1px;
                    height: parent.height;
                    background: tree-grab.has-hover || tree-grab.pressed
                        ? Tok.accent
                        : Tok.rule;
                }

                tree-grab := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        root.tree-width = max(160, min(1200,
                            root.tree-width + (self.mouse-x - self.pressed-x) / 1px));
                    }
                }
            }

            editor-row := Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                // The tree can only hand out pixels it has been told about, and the
                // window is the only one who knows how many there are. Reported at
                // `init` as well as on change, for 6.11's reason: this element is
                // built at its final size on the first frame, so a size that is
                // right from birth never fires a change event.
                init => {
                    root.editor-area-width = self.width / 1px;
                    root.editor-area-height = self.height / 1px;
                    root.editor-area-resized();
                }
                changed width => {
                    root.editor-area-width = self.width / 1px;
                    root.editor-area-resized();
                }
                changed height => {
                    root.editor-area-height = self.height / 1px;
                    root.editor-area-resized();
                }

                for pane[index] in root.panes: Rectangle {
                    x: pane.x * 1px;
                    y: pane.y * 1px;
                    width: pane.width * 1px;
                    height: pane.height * 1px;

                    // Everything that tells the panes apart is the tab in front of
                    // each (要件 7.2), and the row behind it. A pane the tree does
                    // not name has no width, and then it is not here at all — which
                    // is what 6.11 and 6.14 are about: `EditorPane` reports its size
                    // and takes the keyboard at `init` as well as on change,
                    // because it is built when it becomes visible.
                    if pane.width > 0: EditorPane {
                        menu-action: root.menu-action;
                        menu-generation: root.menu-pane == pane.id ? root.menu-generation : 0;
                        embedded-panel: pane.embedded-panel;
                        window-height: root.height;
                        // 書き手の決定 2026-09-11: 読む記号ぶんの行を右クリックに
                        // 出すために、窓の言っていることをそのまま渡す。
                        bullet-marks: root.bullet-marks;
                        // 要件 7.7: one bar, in the pane that asked for it.
                        find-open: root.find-open && pane.id == root.find-pane;
                        find-focus: root.find-focus;
                        find-replacing: root.find-replacing;
                        find-needle <=> pane.find-needle;
                        find-replacement <=> pane.find-replacement;
                        find-status: pane.find-status;
                        find-match-case: pane.find-match-case;
                        find-whole-word: pane.find-whole-word;
                        find-regex: pane.find-regex;
                        find-in-scope: pane.find-scope-end > pane.find-scope-start;
                        find-generation: root.find-generation;
                        goto-open: root.goto-open && pane.id == root.goto-pane;
                        goto-line <=> root.goto-line;
                        goto-status: root.goto-status;
                        goto-generation: root.goto-generation;
                        width: parent.width;
                        height: parent.height;

                        vertical: pane.vertical;
                        // 要件 6.3: which pane the writer is in. The same flag
                        // `takes-focus` below reads, so the tab that looks
                        // focused and the pane that takes the keyboard cannot
                        // disagree.
                        focused: pane.id == root.focused-pane;
                        // 要件 6.4: which ways this pane has somebody to change
                        // places with. Rust works it out where it places them.
                        swap-left: pane.swap-left;
                        swap-right: pane.swap-right;
                        swap-up: pane.swap-up;
                        swap-down: pane.swap-down;
                        background: pane.terminal || pane.below-kind != 0 || (root.background-transparency > 0 && !pane.settings)
                            ? transparent : (pane.vertical ? Tok.paper-alt : Tok.paper);
                        background-transparency: pane.embedded-panel ? pane.panel-style.transparency : root.background-transparency;
                        // 要件 9: this pane's sheet — the paper and the margin
                        // are that direction's, like everything else on it.
                        // 追加要件 2026-09-15: TAB・Paneの色が付いていればそちら。
                        page-background: pane.vertical && !root.paper-shared
                            ? (pane.paper-v-own ? pane.paper-v : root.palette[23])
                            : (pane.paper-h-own ? pane.paper-h : root.palette[7]);
                        wall-kind: pane.embedded-panel || root.background-transparency > 0 ? 0 : root.wall-kind;
                        wall-pieces: root.wall-pieces;
                        wall-image: root.wall-image;
                        wall-image-width: root.wall-image-width;
                        wall-image-height: root.wall-image-height;
                        wall-fit: root.wall-fit;
                        wall-strength: root.wall-strength;
                        wall-origin-x: root.wall-origin-x;
                        wall-origin-y: root.wall-origin-y;
                        paper-chosen(which, colour) => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.colour-set(3 + which, pane.id, colour);
                        }
                        paper-default(which) => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.colour-default(3 + which, pane.id);
                        }
                        paper-more(which) => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.colour-more(3 + which, pane.id);
                        }

                        // **The pane picks the sheet, not the panel**: this is
                        // the margin of the direction this pane is writing in.
                        page-margin: pane.embedded-panel ? 6px : root.sheet-numbers[
                            (pane.vertical ? 1 : 0) * root.sheet-stride + 3] * 1px;
                        // **One pane says it, not both.** A failure is about the
                        // document rather than about a direction, and saying it
                        // twice reads as two failures.
                        // **紙の上には出さない**（2026-09-10）。同じ知らせが2か所に
                        // 出ると、書き手はどちらが新しいかを考えることになる。
                        status: "";
                        // The vertical pane indents its own text instead of padding
                        // the column, because its scroll view has to reach the edge.
                        text-indent: pane.vertical ? 12px : 0px;
                        // 要件 9's 余白, on the axes that are not the flow.
                        // A vertical pane keeps nothing on its left and right:
                        // that is the axis its text runs along, and the margin
                        // there belongs to the engine rather than to the box.
                        side-padding: pane.embedded-panel ? 8px : (pane.vertical ? 0px : root.sheet-numbers[3] * 1px);
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;

                        tabs: pane.tabs;
                        active-tab: pane.active-tab;
                        preview: pane.preview;
                        viewer: pane.viewer;
                        can-undo: pane.can-undo;
                        can-redo: pane.can-redo;

                        tiles: pane.tiles;
                        selection-rects: pane.selection-rects;
                        difference-rects: pane.difference-rects;
                        comparison-note: pane.comparison-note;
                        comparison-dismissed => { root.comparison-dismissed(pane.id); }
                        match-rects: pane.match-rects;
                        scope-rects: pane.scope-rects;
                        bookmark-rects: pane.bookmark-rects;
                        picture-rects: pane.picture-rects;
                        picture-outline: pane.picture-outline;
                        picture-outline-shown: pane.picture-outline-shown;
                        picture-resize(index, phase, x, y) => { root.pane-picture-resize(pane.id, index, phase, x, y); }
                        content-width: pane.content-width;
                        content-height: pane.content-height;
                        caret-visible: pane.caret-visible;
                        caret-x: pane.caret-x;
                        caret-y: pane.caret-y;
                        caret-width: pane.caret-width;
                        caret-height: pane.caret-height;
                        ime-anchor-x: pane.ime-anchor-x;
                        ime-anchor-y: pane.ime-anchor-y;
                        ime-anchor-width: pane.ime-anchor-width;
                        ime-anchor-height: pane.ime-anchor-height;
                        // The ones the pane writes. Two-way against a model row is
                        // a write to the model itself, not to a copy of the row, so
                        // Rust reads what the pane last put there.
                        ime-buffer <=> pane.ime-buffer;
                        scroll-x <=> pane.scroll-x;
                        scroll-y <=> pane.scroll-y;
                        scroll-to-x: pane.scroll-x;
                        scroll-to-y: pane.scroll-y;
                        scroll-generation: pane.scroll-generation;
                        scroll-applied(to, now) => {
                            root.pane-scroll-applied(pane.id, to, now);
                        }
                        shown-width <=> pane.shown-width;
                        shown-height <=> pane.shown-height;
                        wrap-height <=> pane.wrap-height;
                        focus-generation: root.focus-generation;
                        // **Only the pane the writer is in.** The old rule let
                    // every pane take the keyboard whenever there was no split,
                    // which meant two of them answered at once whenever the
                    // window had not been told there was one. Rust keeps
                    // `focused-pane` naming a pane that is on screen
                    // (`place_panes`), so this needs no second condition.
                    takes-focus: pane.id == root.focused-pane;

                        resized => { root.pane-resized(pane.id); }
                        scrolled(offset) => { root.pane-scroll-changed(pane.id, offset); }
                        across-scrolled(offset) => { root.pane-across-scroll-changed(pane.id, offset); }
                        selection-start(x, y, extend) => {
                            root.pane-selection-start(pane.id, x, y, extend);
                        }
                        link-open(x, y) => { root.pane-link-open(pane.id, x, y) }
                        link-hover(x, y) => { root.pane-link-hover(pane.id, x, y) }
                        link-popup-open: root.link-popup-open && root.link-popup-pane == pane.id;
                        link-popup-rows: root.link-popup-rows;
                        link-popup-selected: root.link-popup-selected;
                        link-popup-status: root.link-popup-status;
                        link-popup-key(key) => { root.pane-link-popup-key(pane.id, key) }
                        link-popup-chosen(index) => { root.pane-link-popup-chosen(pane.id, index); }
                        line-edit(what) => {
                            root.pane-line-edit(pane.id, what);
                        }
                        list-edit(what, mark) => {
                            root.pane-list-edit(pane.id, what, mark);
                        }
                        enter-pressed(soft) => {
                            root.pane-enter(pane.id, soft);
                        }
                        selection-update(x, y) => { root.pane-selection-update(pane.id, x, y); }
                        selection-end(x, y) => { root.pane-selection-end(pane.id, x, y); }
                        select-all => { root.pane-select-all(pane.id); }
                        text-input(text, committed) => {
                            root.pane-text-input(pane.id, text, committed);
                        }
                        terminal: pane.terminal;
                        empty: pane.empty;
                        settings: pane.settings;
                        terminal-shells: root.terminal-shells;
                        default-shell: root.default-shell;
                        terminal-key(text, number, ctrl, alt, shift) => {
                            root.pane-terminal-key(pane.id, text, number, ctrl, alt, shift);
                        }
                        terminal-scrolled(delta) => {
                            root.pane-terminal-scrolled(pane.id, delta);
                        }
                        terminal-mouse(spot, kind, button, x, y, delta, shift, ctrl, alt) => {
                            return root.terminal-mouse(pane.id, spot, kind, button, x, y, delta, shift, ctrl, alt);
                        }
                        terminal-focus(spot, focused) => { root.terminal-focus(pane.id, spot, focused); }
                        below-kind: pane.below-kind;
                        below-height: pane.below-height;
                        below-tiles: pane.below-tiles;
                        terminal-search-open <=> pane.terminal-search-open;
                        terminal-search-spot <=> pane.terminal-search-spot;
                        terminal-query <=> pane.terminal-query;
                        terminal-match-case <=> pane.terminal-match-case;
                        terminal-search-status <=> pane.terminal-search-status;
                        terminal-behind <=> pane.terminal-behind;
                        below-behind <=> pane.below-behind;
                        terminal-in-folder => { root.shell-profile-action(8, 0); }
                        terminal-url(spot, x, y) => { root.terminal-url(pane.id, spot, x, y); }
                        terminal-action(spot, action) => { root.terminal-action(pane.id, spot, action); }
                        terminal-new-output: pane.terminal-new-output;
                        below-new-output: pane.below-new-output;
                        front-style: pane.front-style;
                        panel-style: pane.panel-style;
                        appearance-requested(panel) => { root.appearance-requested(pane.embedded-panel ? pane.panel-owner : pane.id, pane.embedded-panel || panel ? 2 : 1); }
                        panel-caret <=> pane.panel-caret;
                        panel-tabs: pane.panel-tabs;
                        panel-active: pane.panel-active;
                        panel-read-only: pane.panel-read-only;
                        panel-follow: pane.panel-follow;
                        panel-scrolled(position, end) => { root.panel-scrolled(pane.id, position, end); }
                        panel-capturing: pane.panel-capturing;
                        panel-action(action, index) => { root.panel-action(pane.id, action, index); }
                        panel-renamed(index, name) => { root.panel-renamed(pane.id, index, name); }
                        terminal-capturing: pane.terminal-capturing;
                        terminal-file-logging: pane.terminal-file-logging;
                        panel-file-names: pane.panel-file-names;
                        panel-file-stems: pane.panel-file-stems;
                        panel-log-destination: pane.panel-log-destination;
                        below-draft <=> pane.below-draft;
                        below-draft-lines: pane.below-draft-lines;
                        below-draft-edited(text) => {
                            root.pane-below-draft-edited(pane.id, text);
                        }
                        below-focus-generation: pane.below-focus-generation;
                        below-toggled => { root.pane-below-toggled(pane.id); }
                        navigate-requested(forward) => {
                            root.pane-navigate(pane.id, forward);
                        }
                        below-resized(height) => { root.pane-below-resized(pane.id, height); }
                        below-key(text, number, ctrl, alt, shift) => {
                            root.pane-below-key(pane.id, text, number, ctrl, alt, shift);
                        }
                        below-scrolled(delta) => { root.pane-below-scrolled(pane.id, delta); }
                        // **One callback for the three phases**, told apart by
                        // the number: 0 begins, 1 drags, 2 lets go.
                        below-selection-start(x, y) => { root.pane-below-selection(pane.id, x, y, 0); }
                        below-selection-update(x, y) => { root.pane-below-selection(pane.id, x, y, 1); }
                        below-selection-end(x, y) => { root.pane-below-selection(pane.id, x, y, 2); }
                        below-sent => { root.pane-below-sent(pane.id); }
                        below-copy => { root.pane-below-copy(pane.id); }
                        below-caret-x: pane.below-caret-x;
                        below-caret-y: pane.below-caret-y;
                        below-buffer <=> pane.below-buffer;
                        below-preedit(text) => { root.pane-below-preedit(pane.id, text); }
                        below-text(text, committed) => {
                            root.pane-below-text(pane.id, text, committed);
                        }
                        quick-draft-requested => { root.quick-draft-requested(); }
                        close-clean-tabs => { root.pane-close-clean(pane.id); }
                        copy-path-requested(index) => { root.pane-copy-path(pane.id, index); }
                        duplicate-tab-requested(index) => { root.pane-duplicate-tab(pane.id, index); }
                        open-file-requested => { root.open-file-requested(); }
                        // The strip's own menu opens the default shell: the
                        // writer asked for a terminal, not for a distribution.
                        below-entered => { root.pane-below-focus(pane.id, true); }
                        below-left => { root.pane-below-focus(pane.id, false); }
                        tab-pressed(back) => { root.pane-tab(pane.id, back); }
                        preedit-changed(text) => { root.pane-preedit-changed(pane.id, text); }
                        backspace-pressed => { root.pane-backspace(pane.id); }
                        delete-pressed => { root.pane-delete(pane.id); }
                        move-caret(direction, extend) => {
                            root.pane-move(pane.id, direction, extend);
                        }
                        home-end(to-end, whole, extend) => {
                            root.pane-home-end(pane.id, to-end, whole, extend);
                        }
                        save-requested => { root.save-requested(); }
                        // **The key that opened the bar closes it** (要件 7.7):
                        // the same key, in the same pane, for the same one of
                        // the two shapes. Anything else — the other key, or the
                        // other pane — moves the bar rather than shutting it,
                        // because that is what was asked for.
                        find-requested(replacing) => { root.toggle-find(pane.id, replacing); }
                        find-step(forwards) => {
                            root.find-requested(forwards);
                        }
                        find-typed => {
                            root.find-typed();
                        }
                        find-option(which) => {
                            root.find-option(which);
                        }
                        find-history(back, replacing) => {
                            root.find-history(back, replacing);
                        }
                        // E4: 出すのはRust——**開いた瞬間に「1〜128行」と言う**
                        // には、その文書に何行あるかを知っていなければならない。
                        shortcut-keys: root.shortcut-keys;
                        insert-rows: root.insert-rows;
                        insert-children: root.insert-children;
                        insert-chosen(number) => { root.pane-insert-chosen(pane.id, number); }
                        shortcut-key(text, control, alt, shift) => { root.focused-pane = pane.id; root.focused-pane-row = index; return root.shortcut-key(text, control, alt, shift); }
                        reopen-closed-requested => { root.focused-pane = pane.id; root.focused-pane-row = index; root.reopen-closed-requested(); }
                        compare-saved-requested => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.compare-saved-requested();
                        }
                        compare-head-requested => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.compare-head-requested();
                        }
                        compare-requested => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.compare-files-requested();
                        }
                        print-requested => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.print-requested();
                        }
                        goto-requested(taking) => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.goto-requested(taking);
                        }
                        goto-typed => {
                            root.goto-typed();
                        }
                        goto-accepted => {
                            root.goto-accepted();
                        }
                        goto-dismissed => {
                            root.goto-open = false;
                            root.focus-generation += 1;
                        }
                        find-cleared => {
                            root.find-cleared();
                        }
                        // **出すだけ。**`find-requested`は同じ鍵で閉じるので、
                        // F3から呼ぶと帯が消える。鍵盤も動かさない（世代を
                        // 上げない）——F3は本文で押される鍵である。
                        find-shown => {
                            if (!root.find-open || root.find-pane != pane.id) {
                                root.find-focus = false;
                                root.find-pane = pane.id;
                                root.find-replacing = false;
                                root.find-open = true;
                                root.find-typed();
                            }
                        }
                        replace-one => {
                            root.replace-requested();
                        }
                        replace-every => {
                            root.replace-all-requested();
                        }
                        find-dismissed => {
                            root.find-open = false;
                            root.focus-generation += 1;
                            // **閉じる鍵が、色を消す鍵でもある**（E1の③）。
                            // 帯が閉じたことは窓の中の出来事なので、こう言って
                            // やらないとRustは塗り直しに来ない。
                            root.find-typed();
                        }
                        tab-selected(index) => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-tab-selected(pane.id, index);
                            root.focus-generation += 1;
                        }
                        tab-closed(index) => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-tab-closed(pane.id, index);
                            root.focus-generation += 1;
                        }
                        tab-renamed(index, name) => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-tab-renamed(pane.id, index, name);
                            // **No focus generation.** The question that opens
                            // takes the keyboard for its name field, and
                            // handing it back to the pane in the same frame is
                            // the fight 要件 5.2's four name commands already
                            // record.
                        }
                        // Whether the hand is over this pane. The rectangle
                        // is the one Rust placed it in, so this and the pane
                        // `drop_tab` decides on are the same answer.
                        carry-over: root.carrying
                            && root.carry-x >= pane.x
                            && root.carry-x < pane.x + pane.width
                            && root.carry-y >= pane.y
                            && root.carry-y < pane.y + pane.height;
                        carry-moved(at-x, at-y) => {
                            root.carry-x =
                                (at-x - editor-row.absolute-position.x) / 1px;
                            root.carry-y =
                                (at-y - editor-row.absolute-position.y) / 1px;
                            root.carrying = true;
                        }
                        carry-finished => {
                            root.carrying = false;
                        }
                        tab-dropped(from, to, at-x, at-y) => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it. Where the tab lands may
                            // move the keyboard on again; that is Rust's to say.
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-tab-dropped(
                                pane.id,
                                from,
                                to,
                                (at-x - editor-row.absolute-position.x) / 1px,
                                (at-y - editor-row.absolute-position.y) / 1px);
                            root.focus-generation += 1;
                        }
                        new-tab-requested => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-new-tab(pane.id);
                            root.focus-generation += 1;
                        }
                        new-file-requested => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-new-file(pane.id);
                            root.focus-generation += 1;
                        }
                        new-terminal-requested(shell) => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-new-terminal(pane.id, shell);
                            root.focus-generation += 1;
                        }
                        tab-shell-chosen(shell) => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-switch-shell(pane.id, shell);
                            root.focus-generation += 1;
                        }
                        preview-toggled => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-preview-toggled(pane.id);
                            root.focus-generation += 1;
                        }
                        viewer-toggled => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-viewer-toggled(pane.id);
                            root.focus-generation += 1;
                        }
                        direction-toggled => {
                            // The strip and its buttons belong to this pane, so
                            // using them is being in it.
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.pane-direction-toggled(pane.id);
                            root.focus-generation += 1;
                        }
                        // The pane's own menu. Which pane it acts on is
                        // settled once, when it opens, rather than by every
                        // row — and being the pane the menu hangs from is what
                        // the two "left pane / right pane" buttons used to
                        // have to ask.
                        menu-opened => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            // RFN01-47: **開いた時点の状態で挿入の行を組む**——選んだ字や
                            // 行の体裁で押せる行が変わるので、開くたびに組み直す。
                            root.pane-menu-opened(pane.id);
                        }
                        split-requested(right) => {
                            root.divide-requested(right);
                            root.focus-generation += 1;
                        }
                        swap-requested(towards) => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.swap-requested(towards);
                            root.focus-generation += 1;
                        }
                        close-others-requested => {
                            root.close-others-requested();
                            root.focus-generation += 1;
                        }
                        save-as-requested => {
                            root.save-as-requested();
                            root.focus-generation += 1;
                        }
                        reveal-requested => {
                            root.reveal-requested();
                            root.focus-generation += 1;
                        }
                        close-active-tab => {
                            root.pane-tab-closed(pane.id, pane.active-tab);
                            root.focus-generation += 1;
                        }
                        close-other-tabs => {
                            root.pane-close-others(pane.id);
                            root.focus-generation += 1;
                        }
                        close-all-tabs => {
                            root.pane-close-all(pane.id);
                            root.focus-generation += 1;
                        }
                        layout-requested => {
                            // **この面の組み方を開く**ので、開く先はそのタブ。
                            root.settings-tab = 3;
                            root.settings-requested();
                        }
                        // **No `focus-generation` here**: the wheel sends
                        // this from wherever the pointer is, and taking the
                        // keyboard away from the pane the writer is typing in
                        // is not part of magnifying the one they are pointing
                        // at. The menu rows come back to the pane they hang
                        // from through `menu-opened`.
                        zoom-stepped(notches) => {
                            root.pane-zoom(pane.id, notches);
                        }
                        zoom-reset-requested => {
                            root.pane-zoom-reset(pane.id);
                        }
                        undo-requested(forwards) => { root.pane-undo(pane.id, forwards); }
                        copy-requested(cut) => { root.pane-copy(pane.id, cut); }
                        copy-body-requested => { root.pane-copy-body(pane.id); }
                        bookmark-requested => { root.pane-bookmark-requested(pane.id); }
                        tab-stepped(backwards) => { root.pane-tab-stepped(pane.id, backwards); }
                        focus-moved(towards) => { root.pane-focus-moved(pane.id, towards); }
                        kill-requested(what) => { root.pane-kill(pane.id, what); }
                        // 要件 7.9（2026-09-08）: 選んだ語を単語帳へ。
                        word-sets: root.word-group-names;
                        // 要件 7.9: このタブのモードを、このタブのメニューから。
                        word-modes: root.word-mode-names;
                        word-mode: pane.word-mode;
                        word-mode-chosen(mode) => {
                            root.pane-word-mode-chosen(pane.id, mode);
                        }
                        has-selection: pane.selection-rects.length > 0;
                        word-add-requested(at) => {
                            root.pane-word-added(pane.id, at);
                        }
                        mark-toggled(rectangular) => {
                            root.pane-mark-toggled(pane.id, rectangular);
                        }
                        selection-escaped() => {
                            return root.pane-escaped(pane.id);
                        }
                        shift-held(said) => {
                            return root.shift-held(said);
                        }
                        escaped() => {
                            return root.dismiss-menus();
                        }
                        focus-taken => {
                            root.ime-vertical-requested(pane.vertical);
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                        }
                        // 余白の押下：このPaneを前にし、鍵盤を渡す（入力欄が取れば`focus-taken`が来る）。
                        margin-pressed => {
                            root.focused-pane = pane.id; root.focused-pane-row = index;
                            root.focus-generation += 1;
                        }
                        focus-trace(event) => { root.pane-focus-trace(pane.id, event); }
                        ime-area(x, y, w, h, vertical) => { root.editor-ime-area(x, y, w, h, vertical); }

                        // 追加要件 2026-09-14（書き手）: **設定はTABで開く。**
                        // 「設定を押すと、新たなダイアログを出さずに設定Paneと
                        // してTABで開く。設定カテゴリーも左側に縦に並べる」。
                        //
                        // 中身は窓の値を読み書きするので、窓がここへ差し込む
                        // （`EditorPane`の`@children`）。**窓に1つ**——どの
                        // ペインのTABであっても同じ設定を指している（要件 9）。
                        if pane.settings: Rectangle {
                            background: Tok.chrome;
                            // 字の上でない場所を押しても、下の本文へは落ちない。
                            // 押したペインがキーボードのあるペインになる。
                            TouchArea {
                                clicked => {
                                    root.focused-pane = pane.id; root.focused-pane-row = index;
                                    root.focus-generation += 1;
                                }
                            }

                            HorizontalLayout {
                                VerticalLayout {
                                    width: 168px;
                                    padding: 12px;
                                    padding-top: 18px;
                                    spacing: 2px;
                                    alignment: start;

                                    Text {
                                        text: @tr("SETTINGS");
                                        color: Tok.ink-faint;
                                        font-size: 11px;
                                        letter-spacing: 0.9px;
                                        height: 26px;
                                        vertical-alignment: top;
                                    }

                                    // 面の並びは**書字方向を持つかどうか**で切れて
                                    // いる：General・Terminal・Words は方向を持たず、
                                    // Text・Layout・Page はシート（横書き／縦書き）
                                    // の上の値である。Keys は最後。
                                    // 追加要件 2026-09-15: Left Pane は後から足した群なので番号は7、並びだけTerminalの次。
                                    for category in [
                                        { id: 0, title: @tr("General") },
                                        { id: 3, title: @tr("Editor") },
                                        { id: 1, title: @tr("Terminal") },
                                        { id: 6, title: @tr("Keys") },
                                    ]: SideTab {
                                        title: category.title;
                                        current: root.settings-tab == category.id;
                                        clicked => {
                                            root.settings-tab = category.id;
                                            if (category.id == 6) {
                                                root.shortcut-filter();
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 1px;
                                    background: Tok.rule;
                                }

                                settings-scroll := ScrollView {
                                    horizontal-stretch: 1;
                                    // 語が変われば中身の長さが変わる。前の位置のままだと何も無い所を見ている。
                                    property <string> query: root.settings-query;
                                    changed query => {
                                        self.viewport-y = 0;
                                    }

                                    HorizontalLayout {
                                        padding: 20px;
                                        padding-top: 18px;
                                        alignment: start;

                                        VerticalLayout {
                                            // Keys は一覧が主役なので、ペインの幅に合わせて広げる（左の群168px・線1px・
                                            // 両側の余白40px・スクロールバーを除く）。名前とキーが離れすぎない600pxまで。
                                            width: min(760px, max(620px, pane.width * 1px - 228px));
                                            spacing: 8px;
                                            alignment: start;

                                        if root.settings-searching ? root.shortcut-rows.length > 0 : root.settings-tab == 6: VerticalLayout {
                                            spacing: 10px;
                                            Text { text: @tr("Shortcuts"); color: Tok.ink; font-size: 16px; }

                                            // 書き手の求め 2026-09-15: **名前で探す欄と、キーを押して探す欄。**
                                            // 「CTRL+O」と綴るより押すほうが間違えない。1つの欄にまとめると
                                            // Ctrl+Z や Ctrl+A が欄の操作とぶつかるので、2つに分ける。
                                            HorizontalLayout {
                                                spacing: 8px;
                                                key-search := FocusScope {
                                                    width: 240px;
                                                    height: 28px;
                                                    key-pressed(event) => {
                                                        if event.text == Key.Tab && !event.modifiers.control && !event.modifiers.alt { return reject; }
                                                        if event.text == Key.Escape {
                                                            root.focus-generation += 1;
                                                        } else if (event.text == Key.Backspace || event.text == Key.Delete) && !event.modifiers.control && !event.modifiers.alt {
                                                            root.shortcut-key-query = "";
                                                            root.shortcut-filter();
                                                        } else {
                                                            root.shortcut-key-search(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                                        }
                                                        accept
                                                    }
                                                    Rectangle {
                                                        background: Tok.paper;
                                                        border-width: 1px;
                                                        border-color: key-search.has-focus ? Tok.accent : Tok.rule-strong;
                                                        border-radius: 5px;
                                                        TouchArea { clicked => { key-search.focus(); } }
                                                        Text {
                                                            x: 10px;
                                                            width: parent.width - 40px;
                                                            height: parent.height;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                            text: root.shortcut-key-query != "" ? root.shortcut-key-query
                                                                : (key-search.has-focus ? @tr("Press a key (Backspace to clear)") : @tr("Press a key to search"));
                                                            color: root.shortcut-key-query != "" ? Tok.ink : Tok.ink-faint;
                                                            font-size: 12px;
                                                        }
                                                        if root.shortcut-key-query != "": IconButton {
                                                            x: parent.width - self.width - 3px;
                                                            y: (parent.height - self.height) / 2;
                                                            size: 20px;
                                                            icon: Icons.close;
                                                            tip: @tr("Clear");
                                                            clicked => {
                                                                root.shortcut-key-query = "";
                                                                root.shortcut-filter();
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // 書き手の求め 2026-09-15: **タブで切り替えず、全部を並べる。**分類の
                                            // 見出しを押すと畳める。変更欄は選んだ行のすぐ下にだけ開く。
                                            VerticalLayout {
                                                spacing: 1px;
                                                for item in root.shortcut-rows: VerticalLayout {
                                                    if item.header: Rectangle {
                                                        height: 34px;
                                                        border-radius: 4px;
                                                        background: heading-touch.has-hover ? Tok.chrome-sunken : transparent;
                                                        heading-touch := TouchArea {
                                                            clicked => { root.shortcut-fold(item.category); }
                                                        }
                                                        Icon {
                                                            x: 4px;
                                                            y: (parent.height - self.height) / 2;
                                                            commands: item.open ? Icons.down : Icons.right;
                                                            tint: Tok.ink-muted;
                                                        }
                                                        Text {
                                                            x: 26px;
                                                            height: parent.height;
                                                            vertical-alignment: center;
                                                            text: item.name + "　" + item.count;
                                                            color: Tok.ink-strong;
                                                            font-size: 13px;
                                                            font-weight: 600;
                                                        }
                                                    }
                                                    if item.header && item.open: Text {
                                                        x: 26px;
                                                        text: item.note;
                                                        color: Tok.ink-faint;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                    if !item.header: Rectangle {
                                                        height: 28px;
                                                        border-radius: 4px;
                                                        background: item.id >= 0 && item.id == root.shortcut-selected ? Tok.accent-faint
                                                            : (row-touch.has-hover && !item.fixed ? Tok.chrome-sunken : transparent);
                                                        row-touch := TouchArea {
                                                            mouse-cursor: item.fixed ? default : pointer;
                                                            clicked => {
                                                                if (!item.fixed) {
                                                                    if (root.shortcut-selected == item.id) {
                                                                        root.shortcut-selected = -1;
                                                                    } else {
                                                                        root.shortcut-selected = item.id;
                                                                        root.shortcut-edit = item.key;
                                                                        root.shortcut-status = @tr("Press the key to assign, then \"Apply and Save\"");
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        HorizontalLayout {
                                                            padding-left: 26px;
                                                            padding-right: 10px;
                                                            spacing: 12px;
                                                            Text {
                                                                horizontal-stretch: 1;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                                text: item.name;
                                                                color: item.fixed ? Tok.ink-muted : Tok.ink;
                                                                font-size: 12px;
                                                            }
                                                            Text {
                                                                vertical-alignment: center;
                                                                text: item.key == "" ? @tr("Unassigned") : item.key;
                                                                color: item.key == "" ? Tok.ink-faint : Tok.ink;
                                                                font-size: 12px;
                                                            }
                                                            Text {
                                                                min-width: 24px;
                                                                vertical-alignment: center;
                                                                horizontal-alignment: right;
                                                                text: item.fixed ? @tr("Fixed") : "";
                                                                color: Tok.ink-faint;
                                                                font-size: 11px;
                                                            }
                                                        }
                                                    }
                                                    if !item.header && item.id >= 0 && item.id == root.shortcut-selected: Rectangle {
                                                        border-radius: 5px;
                                                        border-width: 1px;
                                                        border-color: Tok.rule-strong;
                                                        background: Tok.chrome-raised;
                                                        VerticalLayout {
                                                            padding: 10px;
                                                            spacing: 8px;
                                                            shortcut-capture := FocusScope {
                                                                height: 32px;
                                                                init => { self.focus(); }
                                                                key-pressed(event) => {
                                                                    if event.text == Key.Tab && !event.modifiers.control && !event.modifiers.alt { return reject; }
                                                                    if event.text == Key.Escape {
                                                                        root.shortcut-selected = -1;
                                                                        root.focus-generation += 1;
                                                                    } else if event.text == Key.Return && root.shortcut-edit != "" {
                                                                        root.shortcut-save(false);
                                                                    } else {
                                                                        root.shortcut-capture(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                                                    }
                                                                    accept
                                                                }
                                                                Rectangle {
                                                                    background: Tok.paper;
                                                                    border-width: 1px;
                                                                    border-color: shortcut-capture.has-focus ? Tok.accent : Tok.rule-strong;
                                                                    border-radius: 4px;
                                                                    Text {
                                                                        x: 10px; width: parent.width - 20px;
                                                                        height: parent.height;
                                                                        text: root.shortcut-edit == "" ? @tr("Click here and press a key") : root.shortcut-edit;
                                                                        color: Tok.ink;
                                                                        vertical-alignment: center;
                                                                    }
                                                                    TouchArea { clicked => { shortcut-capture.focus(); } }
                                                                }
                                                            }
                                                            if root.shortcut-status != "": Text { text: root.shortcut-status; color: Tok.ink; font-size: 12px; wrap: word-wrap; }
                                                            HorizontalLayout {
                                                                alignment: start;
                                                                spacing: 4px;
                                                                TextButton { title: @tr("Apply and Save"); role: Role.primary; clicked => { root.shortcut-save(false); } }
                                                                TextButton { title: @tr("Unassign"); clicked => { root.shortcut-edit = ""; root.shortcut-save(false); } }
                                                                TextButton { title: @tr("Restore Default"); clicked => { root.shortcut-save(true); } }
                                                                TextButton { title: @tr("Close"); role: Role.quiet; clicked => { root.shortcut-selected = -1; } }
                                                            }
                                                            Text { text: @tr("Assignable keys: the default keys in the list, or Ctrl+Alt+A–Z."); color: Tok.ink-faint; font-size: 11px; wrap: word-wrap; }
                                                        }
                                                    }
                                                }
                                            }

                                            // 書き手の求め 2026-09-15: この面の Reset は、キーの割り当てだけを戻す。
                                            if !root.settings-searching: Rectangle { height: 1px; background: Tok.rule; }
                                            if !root.settings-searching: HorizontalLayout {
                                                alignment: start;
                                                TextButton {
                                                    title: @tr("Reset");
                                                    clicked => { root.shortcut-reset-all(); }
                                                }
                                            }
                                        }

                                        if root.shows-group(0, []): VerticalLayout {
                                            spacing: 8px;

                                            // 追加要件 2026-09-15（書き手）: 表示の言語。言語の名前はその言語で書く
                                            // ——読めない言語で出ている画面から戻れるように。
                                            if root.shows-any([@tr("LANGUAGE"), @tr("Language")]): Text {
                                                text: root.section-title(@tr("General"), @tr("LANGUAGE"));
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                                letter-spacing: 0.9px;
                                            }
                                            if root.shows-any([@tr("LANGUAGE"), @tr("Language")]): HorizontalLayout {
                                                spacing: 6px;
                                                height: 28px;

                                                Text {
                                                    text: @tr("Language");
                                                    color: Tok.ink;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }

                                                // **プルダウン**（書き手の求め 2026-09-15：言語が増えても行を足すだけで済む）。
                                                // 押した釦と同じ箱に置き、その下に出す（技術検証 6.30）。
                                                Rectangle {
                                                    width: 160px;

                                                    TextButton {
                                                        width: parent.width;
                                                        wide: true;
                                                        title: root.language-names[root.language];
                                                        clicked => {
                                                            language-menu.show();
                                                        }
                                                    }

                                                    language-menu := PopupWindow {
                                                        x: 0px;
                                                        y: 32px;
                                                        width: 160px;
                                                        close-policy: close-on-click-outside;

                                                        MenuFrame {
                                                            width: 160px;

                                                            VerticalLayout {
                                                                padding: 6px;
                                                                spacing: 1px;

                                                                // 頼んでから閉じる（技術検証 6.24）。
                                                                for name[index] in root.language-names: MenuRow {
                                                                    title: name;
                                                                    checked: index == root.language;
                                                                    activated => {
                                                                        root.language-chosen(index);
                                                                        language-menu.close();
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if !root.settings-searching: Rectangle { height: 12px; }

                                            // 書き手の求め 2026-09-15: **全部を戻す口は General に1つ。**各面の Reset は
                                            // その面だけを戻す。単語帳とモードは書き手が作ったものなので戻さない。
                                            if !root.settings-searching: Rectangle { height: 1px; background: Tok.rule; }
                                            if !root.settings-searching: HorizontalLayout {
                                                alignment: start;
                                                spacing: 10px;
                                                TextButton {
                                                    title: @tr("Reset All");
                                                    role: Role.danger;
                                                    clicked => { root.reset-all-requested(); }
                                                }
                                                Text {
                                                    text: @tr("Restores General, Terminal, Left Pane, Text, Layout, Page and Keys to their defaults and sets each document's mode to \"None\". Word sets and modes are kept.");
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // 追加要件 2026-09-08（要件 6.8）: **端末は紙とは別の設定を持つ。**
                                        // 黒地で使う人が多く、要件9のシート（原稿の紙）と同じ値で決める
                                        // ものではない。書字方向も持たないので、シートを選ぶ釦はここにも
                                        // 無い。
                                        if root.shows-group(1, []): VerticalLayout {
                                            spacing: 8px; alignment: start; vertical-stretch: 0;
                                            ComboBox {
                                                width: 260px; height: 30px; horizontal-stretch: 0; vertical-stretch: 0;
                                                model: root.shell-profile-names;
                                                current-index: root.shell-profile-index;
                                                selected(value) => { root.shell-profile-action(0, self.current-index); }
                                            }
                                            HorizontalLayout {
                                                Text { text: @tr("Profile name"); color: Tok.ink-faint; width: 100px; vertical-alignment: center; }
                                                spacing: 8px; height: 30px; vertical-stretch: 0;
                                                Field { width: 260px; horizontal-stretch: 0; placeholder: @tr("Name"); text <=> root.shell-profile-name; }
                                                CheckBox { text: @tr("Default"); checked <=> root.shell-profile-default; toggled => { root.shell-profile-action(7, 0); } }
                                            }
                                            HorizontalLayout { Text { text: @tr("Executable"); color: Tok.ink-faint; width: 100px; vertical-alignment: center; } Field { placeholder: @tr("Executable"); text <=> root.shell-profile-executable; } }
                                            HorizontalLayout { Text { text: @tr("Arguments"); color: Tok.ink-faint; width: 100px; vertical-alignment: center; } Field { placeholder: @tr("Arguments"); text <=> root.shell-profile-arguments; } }
                                            HorizontalLayout { Text { text: @tr("Start folder"); color: Tok.ink-faint; width: 100px; vertical-alignment: center; } Field { placeholder: @tr("Start folder"); text <=> root.shell-profile-directory; } }
                                            HorizontalLayout {
                                                TextButton { title: @tr("Apply"); clicked => { root.shell-profile-action(1, 0); } }
                                                TextButton { title: @tr("Add"); clicked => { root.shell-profile-action(2, 0); } }
                                                TextButton { title: @tr("Duplicate"); clicked => { root.shell-profile-action(3, 0); } }
                                                TextButton { title: "↑"; clicked => { root.shell-profile-action(4, 0); } }
                                                TextButton { title: "↓"; clicked => { root.shell-profile-action(5, 0); } }
                                                TextButton { title: @tr("Remove"); clicked => { root.shell-profile-action(6, 0); } }
                                            }


                                            CheckBox {
                                                text: @tr("Confirm multiline paste");
                                                checked <=> root.terminal-confirm-paste;
                                            }
                                            CheckBox {
                                                text: @tr("Confirm shell termination");
                                                checked <=> root.terminal-confirm-close;
                                            }
                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: @tr("History lines"); color: Tok.ink; vertical-alignment: center; }
                                                Field { width: 100px; horizontal-stretch: 0; text: root.terminal-history-limit;
                                                    accepted => { if self.text.is-float() { root.terminal-history-limit = round(clamp(self.text.to-float(), 0, 1000000)); } }
                                                    focus-lost => { if self.text.is-float() { root.terminal-history-limit = round(clamp(self.text.to-float(), 0, 1000000)); } }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: @tr("Timestamp format"); color: Tok.ink; vertical-alignment: center; }
                                                Field { width: 220px; horizontal-stretch: 0; placeholder: "[yyyy-MM-dd HH:mm:ss] "; text <=> root.terminal-timestamp-format; }
                                                Text { text: root.terminal-timestamp-sample(root.terminal-timestamp-format) + "…"; color: Tok.ink-faint; vertical-alignment: center; }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text {
                                                text: @tr("yyyy MM dd HH mm ss fff are replaced; everything else is written as it is.");
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                            }
                                            PanelStyleEditor { font-list-requested => { root.font-list-requested(); } font-names: root.font-names; heading: "Terminal"; style: root.panel-defaults[0]; changed style => { root.panel-defaults[0] = self.style; root.terminal-settings-edited(); } defaults: true; }
                                            PanelStyleEditor { font-list-requested => { root.font-list-requested(); } font-names: root.font-names; heading: "Editor Panel"; style: root.panel-defaults[1]; changed style => { root.panel-defaults[1] = self.style; root.terminal-settings-edited(); } defaults: true; underline-allowed: false; }
                                        }

                                        if root.shows-group(7, []): VerticalLayout {
                                            spacing: 8px;

                                            if root.shows-any([@tr("LEFT PANE"), @tr("Size"), @tr("Background"), @tr("Text Color"), @tr("Folder Color"), @tr("File Color")]): Text {
                                                text: root.section-title(@tr("Left Pane"), @tr("LEFT PANE"));
                                                color: Tok.ink-faint;
                                                font-size: 10px;
                                                letter-spacing: 0.9px;
                                            }

                                            if root.shows-any([@tr("LEFT PANE"), @tr("Size")]): StepRow {
                                                label: @tr("Size");
                                                value: root.left-size + " px";
                                                stepped(by) => {
                                                    root.left-size-stepped(by);
                                                }
                                            }

                                            if root.shows-any([@tr("LEFT PANE"), @tr("Background")]): ColorCell {
                                                label: @tr("Background");
                                                shown: root.left-paper;
                                                chosen(colour) => { root.colour-set(6, 0, colour); }
                                                automatic => { root.colour-default(6, 0); }
                                                more => { root.colour-more(6, 0); }
                                            }

                                            if root.shows-any([@tr("LEFT PANE"), @tr("Text Color")]): ColorCell {
                                                label: @tr("Text Color");
                                                shown: root.left-ink;
                                                chosen(colour) => { root.colour-set(6, 1, colour); }
                                                automatic => { root.colour-default(6, 1); }
                                                more => { root.colour-more(6, 1); }
                                            }

                                            if root.shows-any([@tr("LEFT PANE"), @tr("Folder Color")]): ColorCell {
                                                label: @tr("Folder Color");
                                                shown: root.left-folder-own ? root.left-folder-ink : root.left-ink;
                                                chosen(colour) => { root.colour-set(6, 2, colour); }
                                                automatic => { root.colour-default(6, 2); }
                                                more => { root.colour-more(6, 2); }
                                            }

                                            if root.shows-any([@tr("LEFT PANE"), @tr("File Color")]): ColorCell {
                                                label: @tr("File Color");
                                                shown: root.left-file-own ? root.left-file-ink : root.left-ink;
                                                chosen(colour) => { root.colour-set(6, 3, colour); }
                                                automatic => { root.colour-default(6, 3); }
                                                more => { root.colour-more(6, 3); }
                                            }

                                            if root.shows-any([@tr("LEFT PANE"), @tr("Size"), @tr("Background"), @tr("Text Color"), @tr("Folder Color"), @tr("File Color")]): Text {
                                                text: @tr("Applies to Explorer, search results, recent files and the outline. Folder and file colors follow the text color until you choose one.");
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }

                                            if !root.settings-searching: Rectangle { height: 1px; background: Tok.rule; }
                                            if !root.settings-searching: HorizontalLayout {
                                                alignment: start;
                                                TextButton {
                                                    title: @tr("Reset");
                                                    clicked => { root.left-reset(); }
                                                }
                                            }
                                        }

                                        // 要件 7.9（2026-09-08）: **単語チェックモード。**書き手の指摘の
                                        // とおり、考え方はソースの予約語の色分けと同じ——C言語モードが
                                        // 予約語・型・前処理をそれぞれの色で持つように、**モードが語群を
                                        // 持ち、語群が色を持つ**。
                                        //
                                        // **どのモードを使うかはここで決めない。**それは文書ごとの話で、
                                        // ステータスバーから選ぶ（要件 10）。ここは中身を作る場所である。
                                        if root.shows-group(3, []): VerticalLayout {
                                            spacing: 20px;
                                            // 追加要件 2026-09-15: **背景を変えるたびに文字色を1つずつ
                                            // 選び直さない。**セットは両方のシートの文字色をまとめて持つ
                                            // ——背景を変えれば、横書きも縦書きも読めなくなるので。
                                            // 形は書き手の選択（一覧＋ボタン）。
                                            if root.shows-any([@tr("COLOR SETS"), @tr("Save to…")]): VerticalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: root.section-title(@tr("Text"), @tr("COLOR SETS"));
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    letter-spacing: 0.9px;
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 140px;
                                                        height: 28px;

                                                        TextButton {
                                                            width: parent.width;
                                                            wide: true;
                                                            title: root.ink-set-chosen < 0 ? @tr("Custom")
                                                                : (root.ink-sets[root.ink-set-chosen] == ""
                                                                    ? @tr("Set {} (empty)", root.ink-set-chosen + 1)
                                                                    : @tr("Set {}", root.ink-set-chosen + 1));
                                                            clicked => {
                                                                ink-set-menu.show();
                                                            }
                                                        }

                                                        // 押した釦と同じ箱に置き、その下に出す（技術検証 6.30）。
                                                        ink-set-menu := PopupWindow {
                                                            x: 0px;
                                                            y: 32px;
                                                            width: 160px;
                                                            close-policy: close-on-click-outside;

                                                            MenuFrame {
                                                                width: 160px;

                                                                VerticalLayout {
                                                                    padding: 6px;
                                                                    spacing: 1px;

                                                                    // **選んだら、その場で効く**（書き手の求め 2026-09-15：
                                                                    // 選んでも下の色が替わらないと分かりにくい）。空のセットは
                                                                    // 選ぶだけで、色は変えない。頼んでから閉じる（技術検証 6.24）。
                                                                    for held[index] in root.ink-sets: MenuRow {
                                                                        title: held == "" ? @tr("Set {} (empty)", index + 1) : @tr("Set {}", index + 1);
                                                                        checked: index == root.ink-set-chosen;
                                                                        activated => {
                                                                            root.ink-set-chosen = index;
                                                                            if (held != "") {
                                                                                root.ink-set-apply(index);
                                                                            }
                                                                            ink-set-menu.close();
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // **保存先は保存するときに選ぶ。**上の一覧は選べば効くので、
                                                    // あれで保存先を選ぶと、いま整えた色が先に置き換わってしまう。
                                                    Rectangle {
                                                        width: save-button.min-width;
                                                        height: 28px;

                                                        save-button := TextButton {
                                                            width: parent.width;
                                                            title: @tr("Save to…");
                                                            clicked => { ink-save-menu.show(); }
                                                        }

                                                        ink-save-menu := PopupWindow {
                                                            x: 0px;
                                                            y: 32px;
                                                            width: 160px;
                                                            close-policy: close-on-click-outside;

                                                            MenuFrame {
                                                                width: 160px;

                                                                VerticalLayout {
                                                                    padding: 6px;
                                                                    spacing: 1px;

                                                                    for held[index] in root.ink-sets: MenuRow {
                                                                        title: held == "" ? @tr("Set {} (empty)", index + 1) : @tr("Set {}", index + 1);
                                                                        checked: index == root.ink-set-chosen;
                                                                        activated => {
                                                                            root.ink-set-chosen = index;
                                                                            root.ink-set-save(index);
                                                                            ink-save-menu.close();
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    // 保存したセットを失う操作なので、赤で言う。
                                                    TextButton {
                                                        title: @tr("Delete");
                                                        role: Role.danger;
                                                        enabled: root.ink-set-chosen >= 0 && root.ink-sets[root.ink-set-chosen] != "";
                                                        clicked => { root.ink-set-delete(root.ink-set-chosen); }
                                                    }
                                                }
                                                Text {
                                                    text: @tr("Saves the text colors of Body and H1–H6 for both directions. Pick one from the list to apply it.");
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    overflow: elide;
                                                }
                                            }

                                            // 書き手の求め 2026-09-15: **横書きと縦書きを縦に並べて全部出す。**
                                            // 切り替えて見比べるより、並んでいれば1回で読める。どちらのシートの
                                            // 値かは見出しが言う。押した欄のシートを`root.sheet`へ置いてから
                                            // 頼む——Rustはそれを「どのシートの値か」として読む。
                                            for sheet-index in [0, 1]: VerticalLayout {
                                                spacing: 8px;
                                                if root.shows-any([@tr("Same as Horizontal"), "Body", "H1", "H2", "H3", "H4", "H5", "H6", @tr("Code Font"), @tr("Font"), @tr("Color"), @tr("Default Color"), @tr("Bold"), @tr("Italic"), @tr("Strikethrough"), @tr("Rule"), @tr("Paper"), @tr("Same as Paper")]): Text {
                                                    text: root.section-title(@tr("Text"), sheet-index == 0 ? @tr("HORIZONTAL") : @tr("VERTICAL"));
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    letter-spacing: 0.9px;
                                                }

                                                // 追加要件 2026-09-15（書き手）: 縦書きを横書きに合わせる（この面の値）。
                                                // On の間は縦書きだけにある設定だけを出す。
                                                if (sheet-index == 1) && (root.shows-any([@tr("Same as Horizontal")])): HorizontalLayout {
                                                    spacing: 6px;
                                                    height: 28px;

                                                    Text {
                                                        text: @tr("Same as Horizontal");
                                                        color: Tok.ink;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }

                                                    TextButton {
                                                        title: root.text-shared ? @tr("On") : @tr("Off");
                                                        role: root.text-shared ? Role.primary : Role.normal;
                                                        clicked => {
                                                            root.text-shared-toggled(!root.text-shared);
                                                        }
                                                    }
                                                }

                                                if sheet-index == 0 || !root.text-shared: VerticalLayout {
                                                    spacing: 8px;
                                                    // One row per kind of text: how large, what colour, which
                                                    // family. The numbers are the rows of the models — ten numbers,
                                                    // eight colours and eight families to a sheet — and the same
                                                    // numbers are what the callbacks carry.
                                                    if root.shows-any(["Body", @tr("Color"), @tr("Default Color"), @tr("Bold"), @tr("Italic"), @tr("Strikethrough"), @tr("Rule"), @tr("Paper"), @tr("Same as Paper")]): TextRow {
                                                        label: "Body";
                                                        number: root.sheet-numbers[sheet-index * root.sheet-stride];
                                                        unit: "px";
                                                        points: round(root.sheet-numbers[sheet-index * root.sheet-stride] * 7.5) / 10;
                                                        typed(text) => { root.sheet = sheet-index; root.sheet-typed(0, text); }
                                                        typed-points(text) => { root.sheet = sheet-index; root.sheet-typed-points(0, text); }
                                                        shown: root.palette[sheet-index * 16 + 0];
                                                        family: root.sheet-fonts[sheet-index * 8 + 0];
                                                        bold: root.sheet-numbers[sheet-index * root.sheet-stride + 19] != 0;
                                                        italic: root.sheet-numbers[sheet-index * root.sheet-stride + 20] != 0;
                                                        strike: root.sheet-numbers[sheet-index * root.sheet-stride + 21] != 0;
                                                        background-on: root.sheet-numbers[sheet-index * root.sheet-stride + 22] != 0;
                                                        rule-on: root.sheet-numbers[sheet-index * root.sheet-stride + 23] != 0;
                                                        heading: false;
                                                        background-colour: root.palette[sheet-index * 16 + 8];
                                                        paper-colour: root.palette[sheet-index * 16 + 7];
                                                        decoration-toggled(kind, on) => { root.sheet = sheet-index; root.sheet-step(19 + kind, on ? -1 : 1); }
                                                        background-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 8, colour); }
                                                        background-more => { root.sheet = sheet-index; root.colour-more(0, 8); }
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(0, by);
                                                        }
                                                        ink-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 0, colour); }
                                                        ink-automatic => { root.sheet = sheet-index; root.colour-default(0, 0); }
                                                        ink-more => { root.sheet = sheet-index; root.colour-more(0, 0); }
                                                        chose-font => {
                                                            root.sheet = sheet-index; root.font-picked(0);
                                                            root.font-menu-x = self.picker-x;
                                                            root.font-menu-y = self.picker-y;
                                                            font-menu.show();
                                                        }
                                                    }

                                                    if root.shows-any(["H1", @tr("Color"), @tr("Default Color"), @tr("Bold"), @tr("Italic"), @tr("Strikethrough"), @tr("Rule"), @tr("Paper"), @tr("Same as Paper")]): TextRow {
                                                        label: "H1";
                                                        number: root.sheet-numbers[sheet-index * root.sheet-stride + 4];
                                                        unit: "%";
                                                        points: round(root.sheet-numbers[sheet-index * root.sheet-stride] * root.sheet-numbers[sheet-index * root.sheet-stride + 4] * 0.075) / 10;
                                                        typed(text) => { root.sheet = sheet-index; root.sheet-typed(4, text); }
                                                        typed-points(text) => { root.sheet = sheet-index; root.sheet-typed-points(1, text); }
                                                        shown: root.palette[sheet-index * 16 + 1];
                                                        family: root.sheet-fonts[sheet-index * 8 + 1];
                                                        bold: root.sheet-numbers[sheet-index * root.sheet-stride + 24] != 0;
                                                        italic: root.sheet-numbers[sheet-index * root.sheet-stride + 25] != 0;
                                                        strike: root.sheet-numbers[sheet-index * root.sheet-stride + 26] != 0;
                                                        background-on: root.sheet-numbers[sheet-index * root.sheet-stride + 27] != 0;
                                                        rule-on: root.sheet-numbers[sheet-index * root.sheet-stride + 28] != 0;
                                                        heading: true;
                                                        background-colour: root.palette[sheet-index * 16 + 9];
                                                        paper-colour: root.palette[sheet-index * 16 + 7];
                                                        decoration-toggled(kind, on) => { root.sheet = sheet-index; root.sheet-step(24 + kind, on ? -1 : 1); }
                                                        background-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 9, colour); }
                                                        background-more => { root.sheet = sheet-index; root.colour-more(0, 9); }
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(4, by);
                                                        }
                                                        ink-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 1, colour); }
                                                        ink-automatic => { root.sheet = sheet-index; root.colour-default(0, 1); }
                                                        ink-more => { root.sheet = sheet-index; root.colour-more(0, 1); }
                                                        chose-font => {
                                                            root.sheet = sheet-index; root.font-picked(1);
                                                            root.font-menu-x = self.picker-x;
                                                            root.font-menu-y = self.picker-y;
                                                            font-menu.show();
                                                        }
                                                    }

                                                    if root.shows-any(["H2", @tr("Color"), @tr("Default Color"), @tr("Bold"), @tr("Italic"), @tr("Strikethrough"), @tr("Rule"), @tr("Paper"), @tr("Same as Paper")]): TextRow {
                                                        label: "H2";
                                                        number: root.sheet-numbers[sheet-index * root.sheet-stride + 5];
                                                        unit: "%";
                                                        points: round(root.sheet-numbers[sheet-index * root.sheet-stride] * root.sheet-numbers[sheet-index * root.sheet-stride + 5] * 0.075) / 10;
                                                        typed(text) => { root.sheet = sheet-index; root.sheet-typed(5, text); }
                                                        typed-points(text) => { root.sheet = sheet-index; root.sheet-typed-points(2, text); }
                                                        shown: root.palette[sheet-index * 16 + 2];
                                                        family: root.sheet-fonts[sheet-index * 8 + 2];
                                                        bold: root.sheet-numbers[sheet-index * root.sheet-stride + 29] != 0;
                                                        italic: root.sheet-numbers[sheet-index * root.sheet-stride + 30] != 0;
                                                        strike: root.sheet-numbers[sheet-index * root.sheet-stride + 31] != 0;
                                                        background-on: root.sheet-numbers[sheet-index * root.sheet-stride + 32] != 0;
                                                        rule-on: root.sheet-numbers[sheet-index * root.sheet-stride + 33] != 0;
                                                        heading: true;
                                                        background-colour: root.palette[sheet-index * 16 + 10];
                                                        paper-colour: root.palette[sheet-index * 16 + 7];
                                                        decoration-toggled(kind, on) => { root.sheet = sheet-index; root.sheet-step(29 + kind, on ? -1 : 1); }
                                                        background-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 10, colour); }
                                                        background-more => { root.sheet = sheet-index; root.colour-more(0, 10); }
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(5, by);
                                                        }
                                                        ink-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 2, colour); }
                                                        ink-automatic => { root.sheet = sheet-index; root.colour-default(0, 2); }
                                                        ink-more => { root.sheet = sheet-index; root.colour-more(0, 2); }
                                                        chose-font => {
                                                            root.sheet = sheet-index; root.font-picked(2);
                                                            root.font-menu-x = self.picker-x;
                                                            root.font-menu-y = self.picker-y;
                                                            font-menu.show();
                                                        }
                                                    }

                                                    if root.shows-any(["H3", @tr("Color"), @tr("Default Color"), @tr("Bold"), @tr("Italic"), @tr("Strikethrough"), @tr("Rule"), @tr("Paper"), @tr("Same as Paper")]): TextRow {
                                                        label: "H3";
                                                        number: root.sheet-numbers[sheet-index * root.sheet-stride + 6];
                                                        unit: "%";
                                                        points: round(root.sheet-numbers[sheet-index * root.sheet-stride] * root.sheet-numbers[sheet-index * root.sheet-stride + 6] * 0.075) / 10;
                                                        typed(text) => { root.sheet = sheet-index; root.sheet-typed(6, text); }
                                                        typed-points(text) => { root.sheet = sheet-index; root.sheet-typed-points(3, text); }
                                                        shown: root.palette[sheet-index * 16 + 3];
                                                        family: root.sheet-fonts[sheet-index * 8 + 3];
                                                        bold: root.sheet-numbers[sheet-index * root.sheet-stride + 34] != 0;
                                                        italic: root.sheet-numbers[sheet-index * root.sheet-stride + 35] != 0;
                                                        strike: root.sheet-numbers[sheet-index * root.sheet-stride + 36] != 0;
                                                        background-on: root.sheet-numbers[sheet-index * root.sheet-stride + 37] != 0;
                                                        rule-on: root.sheet-numbers[sheet-index * root.sheet-stride + 38] != 0;
                                                        heading: true;
                                                        background-colour: root.palette[sheet-index * 16 + 11];
                                                        paper-colour: root.palette[sheet-index * 16 + 7];
                                                        decoration-toggled(kind, on) => { root.sheet = sheet-index; root.sheet-step(34 + kind, on ? -1 : 1); }
                                                        background-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 11, colour); }
                                                        background-more => { root.sheet = sheet-index; root.colour-more(0, 11); }
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(6, by);
                                                        }
                                                        ink-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 3, colour); }
                                                        ink-automatic => { root.sheet = sheet-index; root.colour-default(0, 3); }
                                                        ink-more => { root.sheet = sheet-index; root.colour-more(0, 3); }
                                                        chose-font => {
                                                            root.sheet = sheet-index; root.font-picked(3);
                                                            root.font-menu-x = self.picker-x;
                                                            root.font-menu-y = self.picker-y;
                                                            font-menu.show();
                                                        }
                                                    }

                                                    if root.shows-any(["H4", @tr("Color"), @tr("Default Color"), @tr("Bold"), @tr("Italic"), @tr("Strikethrough"), @tr("Rule"), @tr("Paper"), @tr("Same as Paper")]): TextRow {
                                                        label: "H4";
                                                        number: root.sheet-numbers[sheet-index * root.sheet-stride + 7];
                                                        unit: "%";
                                                        points: round(root.sheet-numbers[sheet-index * root.sheet-stride] * root.sheet-numbers[sheet-index * root.sheet-stride + 7] * 0.075) / 10;
                                                        typed(text) => { root.sheet = sheet-index; root.sheet-typed(7, text); }
                                                        typed-points(text) => { root.sheet = sheet-index; root.sheet-typed-points(4, text); }
                                                        shown: root.palette[sheet-index * 16 + 4];
                                                        family: root.sheet-fonts[sheet-index * 8 + 4];
                                                        bold: root.sheet-numbers[sheet-index * root.sheet-stride + 39] != 0;
                                                        italic: root.sheet-numbers[sheet-index * root.sheet-stride + 40] != 0;
                                                        strike: root.sheet-numbers[sheet-index * root.sheet-stride + 41] != 0;
                                                        background-on: root.sheet-numbers[sheet-index * root.sheet-stride + 42] != 0;
                                                        rule-on: root.sheet-numbers[sheet-index * root.sheet-stride + 43] != 0;
                                                        heading: true;
                                                        background-colour: root.palette[sheet-index * 16 + 12];
                                                        paper-colour: root.palette[sheet-index * 16 + 7];
                                                        decoration-toggled(kind, on) => { root.sheet = sheet-index; root.sheet-step(39 + kind, on ? -1 : 1); }
                                                        background-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 12, colour); }
                                                        background-more => { root.sheet = sheet-index; root.colour-more(0, 12); }
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(7, by);
                                                        }
                                                        ink-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 4, colour); }
                                                        ink-automatic => { root.sheet = sheet-index; root.colour-default(0, 4); }
                                                        ink-more => { root.sheet = sheet-index; root.colour-more(0, 4); }
                                                        chose-font => {
                                                            root.sheet = sheet-index; root.font-picked(4);
                                                            root.font-menu-x = self.picker-x;
                                                            root.font-menu-y = self.picker-y;
                                                            font-menu.show();
                                                        }
                                                    }

                                                    if root.shows-any(["H5", @tr("Color"), @tr("Default Color"), @tr("Bold"), @tr("Italic"), @tr("Strikethrough"), @tr("Rule"), @tr("Paper"), @tr("Same as Paper")]): TextRow {
                                                        label: "H5";
                                                        number: root.sheet-numbers[sheet-index * root.sheet-stride + 8];
                                                        unit: "%";
                                                        points: round(root.sheet-numbers[sheet-index * root.sheet-stride] * root.sheet-numbers[sheet-index * root.sheet-stride + 8] * 0.075) / 10;
                                                        typed(text) => { root.sheet = sheet-index; root.sheet-typed(8, text); }
                                                        typed-points(text) => { root.sheet = sheet-index; root.sheet-typed-points(5, text); }
                                                        shown: root.palette[sheet-index * 16 + 5];
                                                        family: root.sheet-fonts[sheet-index * 8 + 5];
                                                        bold: root.sheet-numbers[sheet-index * root.sheet-stride + 44] != 0;
                                                        italic: root.sheet-numbers[sheet-index * root.sheet-stride + 45] != 0;
                                                        strike: root.sheet-numbers[sheet-index * root.sheet-stride + 46] != 0;
                                                        background-on: root.sheet-numbers[sheet-index * root.sheet-stride + 47] != 0;
                                                        rule-on: root.sheet-numbers[sheet-index * root.sheet-stride + 48] != 0;
                                                        heading: true;
                                                        background-colour: root.palette[sheet-index * 16 + 13];
                                                        paper-colour: root.palette[sheet-index * 16 + 7];
                                                        decoration-toggled(kind, on) => { root.sheet = sheet-index; root.sheet-step(44 + kind, on ? -1 : 1); }
                                                        background-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 13, colour); }
                                                        background-more => { root.sheet = sheet-index; root.colour-more(0, 13); }
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(8, by);
                                                        }
                                                        ink-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 5, colour); }
                                                        ink-automatic => { root.sheet = sheet-index; root.colour-default(0, 5); }
                                                        ink-more => { root.sheet = sheet-index; root.colour-more(0, 5); }
                                                        chose-font => {
                                                            root.sheet = sheet-index; root.font-picked(5);
                                                            root.font-menu-x = self.picker-x;
                                                            root.font-menu-y = self.picker-y;
                                                            font-menu.show();
                                                        }
                                                    }

                                                    if root.shows-any(["H6", @tr("Color"), @tr("Default Color"), @tr("Bold"), @tr("Italic"), @tr("Strikethrough"), @tr("Rule"), @tr("Paper"), @tr("Same as Paper")]): TextRow {
                                                        label: "H6";
                                                        number: root.sheet-numbers[sheet-index * root.sheet-stride + 9];
                                                        unit: "%";
                                                        points: round(root.sheet-numbers[sheet-index * root.sheet-stride] * root.sheet-numbers[sheet-index * root.sheet-stride + 9] * 0.075) / 10;
                                                        typed(text) => { root.sheet = sheet-index; root.sheet-typed(9, text); }
                                                        typed-points(text) => { root.sheet = sheet-index; root.sheet-typed-points(6, text); }
                                                        shown: root.palette[sheet-index * 16 + 6];
                                                        family: root.sheet-fonts[sheet-index * 8 + 6];
                                                        bold: root.sheet-numbers[sheet-index * root.sheet-stride + 49] != 0;
                                                        italic: root.sheet-numbers[sheet-index * root.sheet-stride + 50] != 0;
                                                        strike: root.sheet-numbers[sheet-index * root.sheet-stride + 51] != 0;
                                                        background-on: root.sheet-numbers[sheet-index * root.sheet-stride + 52] != 0;
                                                        rule-on: root.sheet-numbers[sheet-index * root.sheet-stride + 53] != 0;
                                                        heading: true;
                                                        background-colour: root.palette[sheet-index * 16 + 14];
                                                        paper-colour: root.palette[sheet-index * 16 + 7];
                                                        decoration-toggled(kind, on) => { root.sheet = sheet-index; root.sheet-step(49 + kind, on ? -1 : 1); }
                                                        background-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 14, colour); }
                                                        background-more => { root.sheet = sheet-index; root.colour-more(0, 14); }
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(9, by);
                                                        }
                                                        ink-chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 6, colour); }
                                                        ink-automatic => { root.sheet = sheet-index; root.colour-default(0, 6); }
                                                        ink-more => { root.sheet = sheet-index; root.colour-more(0, 6); }
                                                        chose-font => {
                                                            root.sheet = sheet-index; root.font-picked(6);
                                                            root.font-menu-x = self.picker-x;
                                                            root.font-menu-y = self.picker-y;
                                                            font-menu.show();
                                                        }
                                                    }

                                                    // 書き手の求め 2026-09-22: `==ハイライト==`の地の色。
                                                    if root.shows-any([@tr("Highlight"), @tr("Color")]): ColorCell {
                                                        label: @tr("Highlight");
                                                        shown: root.palette[sheet-index * 16 + 15];
                                                        chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 15, colour); }
                                                        automatic => { root.sheet = sheet-index; root.colour-default(0, 15); }
                                                        more => { root.sheet = sheet-index; root.colour-more(0, 15); }
                                                    }

                                                    // 書き手の求め 2026-09-15: **コードの書体も文字の設定。**本文・見出しの
                                                    // 書体と同じ面に置く（紙の面にあったのはおかしい）。
                                                    if root.shows-any([@tr("Code Font"), @tr("Font")]): PickRow {
                                                        label: @tr("Code Font");
                                                        value: root.sheet-fonts[sheet-index * 8 + 7];
                                                        pressed => {
                                                            root.sheet = sheet-index; root.font-picked(7);
                                                            root.font-menu-x = self.picker-x;
                                                            root.font-menu-y = self.picker-y;
                                                            font-menu.show();
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        if root.shows-group(3, []): VerticalLayout {
                                            alignment: start; vertical-stretch: 0; spacing: 8px;
                                            if root.shows-any([@tr("FILES"), @tr("Auto Backup")]): Text {
                                                text: root.section-title(@tr("Editor"), @tr("FILES"));
                                                color: Tok.ink-faint;
                                                font-size: 10px;
                                                letter-spacing: 0.9px;
                                            }

                                            // 追加要件 2026-09-08: 要件 8.1 の自動退避。**On/Offと、
                                            // Offが何を意味するかを、同じ場所で言う**——「切ってある
                                            // 間は書かない」だけなら、置いてある古い退避が次の起動で
                                            // 戻ってきて、書き手の言ったこととちょうど逆になる。
                                            if root.shows-any([@tr("FILES"), @tr("Auto Backup")]): HorizontalLayout {
                                                spacing: 2px;

                                                Text {
                                                    text: @tr("Auto Backup");
                                                    color: Tok.ink;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }

                                                TextButton {
                                                    title: root.autosave ? @tr("On") : @tr("Off");
                                                    role: root.autosave ? Role.primary : Role.normal;
                                                    clicked => {
                                                        root.autosave-toggled(!root.autosave);
                                                    }
                                                }
                                            }

                                            // U1: 説明は対象の直下へ。popupの寸法を安定させるため折り返さない。
                                            if root.shows-any([@tr("FILES"), @tr("Auto Backup")]): Text {
                                                text: root.autosave
                                                    ? @tr("Backs up to a work copy 2 seconds after you stop typing, or every 5 seconds while typing.")
                                                    : @tr("No backup. Turning it off also deletes the work copies.");
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                            if root.shows-any([@tr("FILES"), @tr("Auto Backup")]): Text {
                                                text: @tr("Ctrl+S writes to the original file.");
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                                overflow: elide;
                                            }

                                            // 書き手の報告 2026-09-11: **見出しが中身を言っていなかった。**
                                            // `FILES`の下にルビの記法も箇条書きの字も並んでいて、どれも
                                            // ファイルの話ではない——**画面とソースが食い違えば、書き手と
                                            // 私が別のものを指して話すことになる。**記法の読み書きは
                                            // ここから下である。
                                            if root.shows-any([@tr("MARKUP"), @tr("Count ruby"), @tr("Ruby markup"), @tr("Bullet marks")]): Text {
                                                text: root.section-title(@tr("Editor"), @tr("MARKUP"));
                                                color: Tok.ink-faint;
                                                font-size: 10px;
                                                letter-spacing: 0.9px;
                                            }

                                            // 要件 7.8（2026-09-09）: ルビを本文の字数に数えるか。
                                            // **「正解が二つある」から選ばせる**——投稿サイトへ出す
                                            // ための字数はルビを含まず、打ち込んだ量を知りたいときは
                                            // 含む。編集器がどちらかに決めると、もう一方の用事の人が
                                            // 毎回数え直すことになる。
                                            if root.shows-any([@tr("MARKUP"), @tr("Count ruby")]): HorizontalLayout {
                                                spacing: 2px;

                                                Text {
                                                    text: @tr("Count ruby");
                                                    color: Tok.ink;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }

                                                TextButton {
                                                    title: root.count-ruby ? @tr("On") : @tr("Off");
                                                    role: root.count-ruby ? Role.primary : Role.normal;
                                                    clicked => {
                                                        root.count-ruby-toggled(!root.count-ruby);
                                                    }
                                                }
                                            }

                                            if root.shows-any([@tr("MARKUP"), @tr("Count ruby")]): Text {
                                                text: root.count-ruby
                                                    ? @tr("Ruby readings 《》 count toward the character count.")
                                                    : @tr("Ruby readings 《》 do not count toward the character count.");
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                                overflow: elide;
                                            }

                                            // 要件 E9: ルビと傍点の記法を読むか。**Markdownの標準では
                                            // ない**ので、切れなければ「この編集器でしか正しく見えない
                                            // 書き方」を書き手に強いることになる。ルビと傍点を1つの旗で
                                            // 切るのは、同じ記法の一族だからである。
                                            if root.shows-any([@tr("MARKUP"), @tr("Ruby markup")]): HorizontalLayout {
                                                spacing: 2px;

                                                Text {
                                                    text: @tr("Ruby markup");
                                                    color: Tok.ink;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }

                                                TextButton {
                                                    title: root.ruby-marks ? @tr("On") : @tr("Off");
                                                    role: root.ruby-marks ? Role.primary : Role.normal;
                                                    clicked => {
                                                        root.ruby-marks-toggled(!root.ruby-marks);
                                                    }
                                                }
                                            }

                                            if root.shows-any([@tr("MARKUP"), @tr("Ruby markup")]): Text {
                                                text: root.ruby-marks
                                                    ? @tr("Reads ｜漢字《かんじ》 and 《《傍点》》 as markup.")
                                                    : @tr("Shows the marks as plain characters.");
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                                overflow: elide;
                                            }

                                            // 書き手の決定 2026-09-11: **どれを箇条書きの印として読むか。**
                                            // CommonMarkは`-`・`*`・`+`を同格に認めているので、この編集器も
                                            // 同格に扱う——**`-`も切れる**（「*も標準ということなら、扱いは
                                            // 同じであるべき」）。切った記号の行はただの本文になり、記号も
                                            // そのまま字として出る（原稿のバイト列は変えない）。
                                            if root.shows-any([@tr("MARKUP"), @tr("Bullet marks")]): HorizontalLayout {
                                                spacing: 2px;

                                                Text {
                                                    text: @tr("Bullet marks");
                                                    color: Tok.ink;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }

                                                for mark[index] in ["-", "*", "+"]: TextButton {
                                                    title: mark;
                                                    role: root.bullet-marks[index] ? Role.primary : Role.normal;
                                                    clicked => {
                                                        root.bullet-mark-toggled(index);
                                                    }
                                                }
                                            }

                                            if root.shows-any([@tr("MARKUP"), @tr("Bullet marks")]): Text {
                                                text: !root.bullet-marks[0] && !root.bullet-marks[1]
                                                    && !root.bullet-marks[2]
                                                    ? @tr("No bullet marks (every mark is plain text).")
                                                    : @tr("{}are read as bullet marks.",
                                                        (root.bullet-marks[0] ? "- " : "")
                                                        + (root.bullet-marks[1] ? "* " : "")
                                                        + (root.bullet-marks[2] ? "+ " : ""));
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                                overflow: elide;
                                            }


                                        }

                                        if root.shows-group(4, []): VerticalLayout {
                                            spacing: 20px;
                                            // 書き手の求め 2026-09-15: **横書きと縦書きを縦に並べて全部出す。**
                                            // 切り替えて見比べるより、並んでいれば1回で読める。どちらのシートの
                                            // 値かは見出しが言う。押した欄のシートを`root.sheet`へ置いてから
                                            // 頼む——Rustはそれを「どのシートの値か」として読む。
                                            for sheet-index in [0, 1]: VerticalLayout {
                                                spacing: 8px;
                                                if root.shows-any([@tr("Same as Horizontal"), @tr("Line height"), @tr("Column gap"), @tr("Char advance"), @tr("Page margin"), @tr("Wrap"), @tr("Width"), @tr("Pane"), @tr("Line length"), @tr("Line numbers"), @tr("Show spaces and line breaks"), @tr("Ruby size"), @tr("Ruby position"), @tr("Tate-chu-yoko"), @tr("Bullet marks")]): Text {
                                                    text: root.section-title(@tr("Layout"), sheet-index == 0 ? @tr("HORIZONTAL") : @tr("VERTICAL"));
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    letter-spacing: 0.9px;
                                                }

                                                // 追加要件 2026-09-15（書き手）: 縦書きを横書きに合わせる（この面の値）。
                                                // On の間は縦書きだけにある設定だけを出す。
                                                if (sheet-index == 1) && (root.shows-any([@tr("Same as Horizontal")])): HorizontalLayout {
                                                    spacing: 6px;
                                                    height: 28px;

                                                    Text {
                                                        text: @tr("Same as Horizontal");
                                                        color: Tok.ink;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }

                                                    TextButton {
                                                        title: root.layout-shared ? @tr("On") : @tr("Off");
                                                        role: root.layout-shared ? Role.primary : Role.normal;
                                                        clicked => {
                                                            root.layout-shared-toggled(!root.layout-shared);
                                                        }
                                                    }
                                                }

                                                if sheet-index == 0 || !root.layout-shared: VerticalLayout {
                                                    spacing: 8px;
                                                    // 要件 9 calls the flow advance 行間 in horizontal writing and
                                                    // 列間隔 in vertical writing. **One quantity, two names**: the
                                                    // label follows the sheet, because on this sheet that is what
                                                    // it is.
                                                    if root.shows-any([@tr("Line height"), @tr("Column gap")]): StepRow {
                                                        label: sheet-index == 0 ? @tr("Line height") : @tr("Column gap");
                                                        value: root.sheet-numbers[sheet-index * root.sheet-stride + 1] + "%";
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(1, by);
                                                        }
                                                    }

                                                    if root.shows-any([@tr("Char advance")]): StepRow {
                                                        label: @tr("Char advance");
                                                        value: root.sheet-numbers[sheet-index * root.sheet-stride + 2] + "%";
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(2, by);
                                                        }
                                                    }

                                                    if root.shows-any([@tr("Page margin")]): StepRow {
                                                        label: @tr("Page margin");
                                                        value: root.sheet-numbers[sheet-index * root.sheet-stride + 3] + " px";
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(3, by);
                                                        }
                                                    }

                                                    // 要件 9: how long a line may be. **Two switches that cannot
                                                    // both be on**, and neither of them on is the third answer: the
                                                    // line is not wrapped at all. One value holds all three, so
                                                    // "both on" is not a state this can reach — and pressing the
                                                    // one that is on turns it off, which is how the writer says
                                                    // "neither" without a button for it.
                                                    if root.shows-any([@tr("Wrap"), @tr("Width"), @tr("Pane"), @tr("Line length")]): HorizontalLayout {
                                                        spacing: 2px;

                                                        Text {
                                                            text: @tr("Wrap");
                                                            color: Tok.ink;
                                                            font-size: 12px;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }

                                                        // **The state that is an absence is still named.** With
                                                        // neither switch on, a row of unlit buttons reads as a
                                                        // setting nobody has made rather than as the setting it is.
                                                        if root.sheet-numbers[sheet-index * root.sheet-stride + 10] == 0: Text {
                                                            text: @tr("not wrapped");
                                                            color: Tok.ink-faint;
                                                            font-size: 11px;
                                                            vertical-alignment: center;
                                                        }

                                                        TextButton {
                                                            title: @tr("Width");
                                                            role: root.sheet-numbers[sheet-index * root.sheet-stride + 10] == 1
                                                                ? Role.primary
                                                                : Role.normal;
                                                            clicked => {
                                                                root.sheet = sheet-index; root.sheet-chose(10,
                                                                    root.sheet-numbers[sheet-index * root.sheet-stride + 10] == 1
                                                                        ? 0
                                                                        : 1);
                                                            }
                                                        }
                                                        TextButton {
                                                            title: @tr("Pane");
                                                            role: root.sheet-numbers[sheet-index * root.sheet-stride + 10] == 2
                                                                ? Role.primary
                                                                : Role.normal;
                                                            clicked => {
                                                                root.sheet = sheet-index; root.sheet-chose(10,
                                                                    root.sheet-numbers[sheet-index * root.sheet-stride + 10] == 2
                                                                        ? 0
                                                                        : 2);
                                                            }
                                                        }
                                                    }

                                                    // In characters of body text, because that is what a line
                                                    // length means: the number stays true when the body size or the
                                                    // zoom changes, and a width in pixels would not.
                                                    if (root.sheet-numbers[sheet-index * root.sheet-stride + 10] == 1) && (root.shows-any([@tr("Wrap"), @tr("Line length")])): StepRow {
                                                        label: @tr("Line length");
                                                        value: @tr("{} chars", root.sheet-numbers[sheet-index * root.sheet-stride + 11]);
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(11, by);
                                                        }
                                                    }

                                                    // 要件 9（2026-09-07追加）: 行番号。**どちらの面にも置く**
                                                    // ——横書きでは行の頭の余白に、縦書きでは列の頭（面の上端）に、
                                                    // 同じ形で立つ。数字はどちらでも正立させる。
                                                    if root.shows-any([@tr("Line numbers")]): HorizontalLayout {
                                                        spacing: 2px;

                                                        Text {
                                                            text: @tr("Line numbers");
                                                            color: Tok.ink;
                                                            font-size: 12px;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }

                                                        TextButton {
                                                            title: root.sheet-numbers[sheet-index * root.sheet-stride + 12] == 1
                                                                ? @tr("Shown")
                                                                : @tr("Hidden");
                                                            role: root.sheet-numbers[sheet-index * root.sheet-stride + 12] == 1
                                                                ? Role.primary
                                                                : Role.normal;
                                                            clicked => {
                                                                root.sheet = sheet-index; root.sheet-chose(12,
                                                                    root.sheet-numbers[sheet-index * root.sheet-stride + 12] == 1
                                                                        ? 0
                                                                        : 1);
                                                            }
                                                        }
                                                    }

                                                    if root.shows-any([@tr("Show spaces and line breaks")]): HorizontalLayout {
                                                        Text {
                                                            text: @tr("Show spaces and line breaks");
                                                            color: Tok.ink;
                                                            font-size: 12px;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                        TextButton {
                                                            title: root.sheet-numbers[sheet-index * root.sheet-stride + 54] == 1 ? @tr("Shown") : @tr("Hidden");
                                                            role: root.sheet-numbers[sheet-index * root.sheet-stride + 54] == 1 ? Role.primary : Role.normal;
                                                            clicked => {
                                                                root.sheet = sheet-index; root.sheet-chose(54, root.sheet-numbers[sheet-index * root.sheet-stride + 54] == 1 ? 0 : 1);
                                                            }
                                                        }
                                                    }

                                                    // 要件 7.8（2026-09-09）: ルビと傍点。**大きさも位置も
                                                    // 親文字に対する比率**で、面ごとに持つ——縦書きと横書きでは
                                                    // ルビの置き場所そのものが違うので、読める大きさも同じとは
                                                    // 限らない。位置は0が行の箱の端（行間の空きの外側）で、
                                                    // 上げるほど字に近づく。
                                                    if root.shows-any([@tr("Ruby size")]): StepRow {
                                                        label: @tr("Ruby size");
                                                        value: root.sheet-numbers[sheet-index * root.sheet-stride + 13] + "%";
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(13, by);
                                                        }
                                                    }

                                                    if root.shows-any([@tr("Ruby position")]): StepRow {
                                                        label: @tr("Ruby position");
                                                        value: root.sheet-numbers[sheet-index * root.sheet-stride + 14] + "%";
                                                        stepped(by) => {
                                                            root.sheet = sheet-index; root.sheet-step(14, by);
                                                        }
                                                    }

                                                }
                                                    // 要件 7.8（書き手の決定 2026-09-09）: 縦中横。半角の数字を
                                                    // 1〜2桁なら1マスに正立させ、3桁以上は1桁ずつ縦に並べる。
                                                    // **縦書きのシートにだけ出す**——縦中横は縦書きの中でしか
                                                    // 起きないので、横書きの面に置けば「押しても何も起きない
                                                    // 切り替え」になる。
                                                    if (sheet-index == 1) && (root.shows-any([@tr("Tate-chu-yoko")])): HorizontalLayout {
                                                        spacing: 2px;

                                                        Text {
                                                            text: @tr("Tate-chu-yoko");
                                                            color: Tok.ink;
                                                            font-size: 12px;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }

                                                        Text {
                                                            text: @tr("Digits");
                                                            color: Tok.ink-faint;
                                                            font-size: 11px;
                                                            vertical-alignment: center;
                                                        }

                                                        TextButton {
                                                            title: root.sheet-numbers[sheet-index * root.sheet-stride + 15] == 1
                                                                ? @tr("Upright")
                                                                : @tr("Sideways");
                                                            role: root.sheet-numbers[sheet-index * root.sheet-stride + 15] == 1
                                                                ? Role.primary
                                                                : Role.normal;
                                                            clicked => {
                                                                root.sheet = sheet-index; root.sheet-chose(15,
                                                                    root.sheet-numbers[sheet-index * root.sheet-stride + 15] == 1
                                                                        ? 0
                                                                        : 1);
                                                            }
                                                        }
                                                    }

                                                    // 書き手の決定 2026-09-17: **半角記号は数字と別の旗。**
                                                    // 「半角数字が縦に並ぶ違和感」と「`!?`が縦に並ぶ違和感」は
                                                    // 別のものなので、別々に入切する。数字の隣に置く。
                                                    if (sheet-index == 1) && (root.shows-any([@tr("Tate-chu-yoko")])): HorizontalLayout {
                                                        spacing: 2px;

                                                        Text {
                                                            text: "";
                                                            horizontal-stretch: 1;
                                                        }

                                                        Text {
                                                            text: @tr("Marks (!? !!)");
                                                            color: Tok.ink-faint;
                                                            font-size: 11px;
                                                            vertical-alignment: center;
                                                        }

                                                        TextButton {
                                                            title: root.sheet-numbers[sheet-index * root.sheet-stride + 55] == 1
                                                                ? @tr("Upright")
                                                                : @tr("Sideways");
                                                            role: root.sheet-numbers[sheet-index * root.sheet-stride + 55] == 1
                                                                ? Role.primary
                                                                : Role.normal;
                                                            clicked => {
                                                                root.sheet = sheet-index; root.sheet-chose(55,
                                                                    root.sheet-numbers[sheet-index * root.sheet-stride + 55] == 1
                                                                        ? 0
                                                                        : 1);
                                                            }
                                                        }
                                                    }

                                                if (sheet-index == 0 || !root.layout-shared) && (root.shows-any([@tr("Bullet marks")])): VerticalLayout {
                                                    spacing: 8px;
                                                    // 書き手の決定 2026-09-11: **原稿の記号ごとに、画面へ出る字。**
                                                    // 「三種類の文字に箇条書きの意味を与え、それぞれに、表現として
                                                    // どう見せるかを設定できるように」——`- 項目`と`* 項目`を別の
                                                    // 丸で出せる、というのがその意味である。
                                                    //
                                                    // **読むと決めていない記号は、見せ方も設定できない**（書き手の
                                                    // 求めた依存関係）。切ってある記号の行はただの本文で、印そのものが
                                                    // 出ないので、ここで丸を選んでも効くところが無い——**働かない
                                                    // 切り替えを画面に置かない**（単語チェックモード要件 2.1.1）。
                                                    for mark[at] in ["-", "*", "+"]: HorizontalLayout {
                                                        spacing: 2px;

                                                        Text {
                                                            text: at == 0 ? @tr("Bullet marks") : "";
                                                            color: Tok.ink;
                                                            font-size: 12px;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }

                                                        Text {
                                                            text: mark;
                                                            color: root.bullet-marks[at] ? Tok.ink : Tok.ink-faint;
                                                            font-size: 12px;
                                                            vertical-alignment: center;
                                                        }

                                                        if root.bullet-marks[at]: HorizontalLayout {
                                                            spacing: 2px;

                                                            for glyph[index] in ["•", "・", "○"]: TextButton {
                                                                title: glyph;
                                                                role: root.sheet-numbers[sheet-index * root.sheet-stride
                                                                    + 16 + at] == index
                                                                    ? Role.primary
                                                                    : Role.normal;
                                                                clicked => {
                                                                    root.sheet = sheet-index; root.sheet-chose(16 + at, index);
                                                                }
                                                            }
                                                        }

                                                        if !root.bullet-marks[at]: Text {
                                                            text: @tr("Turned off in Editor");
                                                            color: Tok.ink-faint;
                                                            font-size: 11px;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        if root.shows-group(5, []): VerticalLayout {
                                            spacing: 20px;
                                            // 追加要件 2026-09-15（書き手）: 新しく開いたTABにランダムな紙の色。
                                            // 淡色か濃色かを選ぶ。個別に色を付けたTAB・Paneには効かない。
                                            if root.shows-any([@tr("NEW TABS"), @tr("Random Background")]): VerticalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: root.section-title(@tr("Page"), @tr("NEW TABS"));
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    letter-spacing: 0.9px;
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    height: 28px;

                                                    Text {
                                                        text: @tr("Random Background");
                                                        color: Tok.ink;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }

                                                    for choice[index] in [@tr("Off"), @tr("Light"), @tr("Dark")]: TextButton {
                                                        title: choice;
                                                        role: root.paper-random == index ? Role.primary : Role.normal;
                                                        clicked => {
                                                            root.paper-random-chosen(index);
                                                        }
                                                    }
                                                }
                                            }
                                            if root.shows-any([@tr("TRANSPARENCY"), @tr("Background Transparency")]): VerticalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: root.section-title(@tr("Page"), @tr("TRANSPARENCY"));
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    letter-spacing: 0.9px;
                                                }
                                                HorizontalLayout {
                                                    spacing: 10px;
                                                    height: 28px;
                                                    Text {
                                                        text: @tr("Background Transparency");
                                                        color: Tok.ink;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Slider {
                                                        width: 220px;
                                                        y: 3px;
                                                        minimum: 0;
                                                        maximum: 100;
                                                        value: root.background-transparency;
                                                        moved(value) => { root.background-transparency-moved(value); }
                                                    }
                                                    Text {
                                                        text: root.background-transparency + "%";
                                                        color: Tok.ink-muted;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        min-width: 40px;
                                                    }
                                                }
                                                Text {
                                                    text: @tr("0% is opaque. Only the document background becomes transparent; text and menus stay opaque.");
                                                    color: Tok.ink-muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                                if root.background-transparency > 0 && root.wall-kind != 0: Text {
                                                    text: @tr("Background images are hidden while transparency is enabled. Set it to 0% to restore the image.");
                                                    color: Tok.ink-muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                            // 追加要件 2026-09-15（書き手）: 背景の壁紙。全体の設定だけ。
                                            // Windowsの壁紙は画面に固定して敷く（窓越しにデスクトップが見える感じ）。
                                            if root.shows-any([@tr("BACKGROUND IMAGE"), @tr("Image"), @tr("Fit"), @tr("Image Strength"), @tr("Windows Wallpaper"), @tr("Image File"), @tr("Tile"), @tr("Fit Height"), @tr("Fit Width")]): VerticalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: root.section-title(@tr("Page"), @tr("BACKGROUND IMAGE"));
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    letter-spacing: 0.9px;
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    height: 28px;

                                                    Text {
                                                        text: @tr("Image");
                                                        color: Tok.ink;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }

                                                    for choice[index] in [@tr("None"), @tr("Windows Wallpaper"), @tr("Image File")]: TextButton {
                                                        title: choice;
                                                        role: root.wall-kind == index ? Role.primary : Role.normal;
                                                        clicked => {
                                                            root.wall-kind-chosen(index);
                                                        }
                                                    }
                                                }

                                                if root.wall-kind == 2: HorizontalLayout {
                                                    spacing: 6px;
                                                    height: 28px;

                                                    Text {
                                                        text: root.wall-path == "" ? @tr("No file chosen") : root.wall-path;
                                                        color: Tok.ink-muted;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }

                                                    TextButton {
                                                        title: @tr("Choose…");
                                                        clicked => {
                                                            root.wall-file-requested();
                                                        }
                                                    }
                                                }

                                                if root.wall-kind == 2: HorizontalLayout {
                                                    spacing: 6px;
                                                    height: 28px;

                                                    Text {
                                                        text: @tr("Fit");
                                                        color: Tok.ink;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }

                                                    for choice[index] in [@tr("Tile"), @tr("Fit Height"), @tr("Fit Width")]: TextButton {
                                                        title: choice;
                                                        role: root.wall-fit == index ? Role.primary : Role.normal;
                                                        clicked => {
                                                            root.wall-fit-chosen(index);
                                                        }
                                                    }
                                                }

                                                if root.wall-kind != 0: HorizontalLayout {
                                                    spacing: 10px;
                                                    height: 28px;

                                                    Text {
                                                        text: @tr("Image Strength");
                                                        color: Tok.ink;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }

                                                    Slider {
                                                        width: 220px;
                                                        y: 3px;
                                                        minimum: 0;
                                                        maximum: 100;
                                                        value: root.wall-strength;
                                                        moved(value) => {
                                                            root.wall-strength-moved(value);
                                                        }
                                                    }

                                                    Text {
                                                        text: root.wall-strength + "%";
                                                        color: Tok.ink-muted;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        min-width: 40px;
                                                    }
                                                }
                                            }
                                            // 書き手の求め 2026-09-15: **横書きと縦書きを縦に並べて全部出す。**
                                            // 切り替えて見比べるより、並んでいれば1回で読める。どちらのシートの
                                            // 値かは見出しが言う。押した欄のシートを`root.sheet`へ置いてから
                                            // 頼む——Rustはそれを「どのシートの値か」として読む。
                                            for sheet-index in [0, 1]: VerticalLayout {
                                                spacing: 8px;
                                                if root.shows-any([@tr("Same as Horizontal"), @tr("Paper Color"), @tr("Paper")]): Text {
                                                    text: root.section-title(@tr("Page"), sheet-index == 0 ? @tr("HORIZONTAL") : @tr("VERTICAL"));
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    letter-spacing: 0.9px;
                                                }

                                                    // 追加要件 2026-09-15（書き手）: 縦書きの紙を横書きに合わせる。
                                                    // On の間は縦書きの色の欄を出さない（選んでも効かない欄を置かない）。
                                                    if (sheet-index == 1) && (root.shows-any([@tr("Same as Horizontal")])): HorizontalLayout {
                                                        spacing: 6px;
                                                        height: 28px;

                                                        Text {
                                                            text: @tr("Same as Horizontal");
                                                            color: Tok.ink;
                                                            font-size: 12px;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }

                                                        TextButton {
                                                            title: root.paper-shared ? @tr("On") : @tr("Off");
                                                            role: root.paper-shared ? Role.primary : Role.normal;
                                                            clicked => {
                                                                root.paper-shared-toggled(!root.paper-shared);
                                                            }
                                                        }
                                                    }

                                                    // 書き手の報告 2026-09-08: `Paper`だけでは何のことか読めない。
                                                    // （コードの書体は 2026-09-15 に Text へ移した。）
                                                    if (sheet-index == 0 || !root.paper-shared) && (root.shows-any([@tr("Paper Color"), @tr("Paper")])): ColorCell {
                                                        label: @tr("Paper Color");
                                                        shown: root.palette[sheet-index * 16 + 7];
                                                        chosen(colour) => { root.sheet = sheet-index; root.colour-set(0, 7, colour); }
                                                        automatic => { root.sheet = sheet-index; root.colour-default(0, 7); }
                                                        more => { root.sheet = sheet-index; root.colour-more(0, 7); }
                                                    }

                                            }
                                        }

                                        if root.shows-group(2, [@tr("Words"), @tr("MODES"), @tr("New Mode"), @tr("New Group"), @tr("Import…"), @tr("Export…"), @tr("Edit…")]): VerticalLayout {
                                            spacing: 8px;

                                            Text {
                                                text: root.section-title(@tr("Words"), @tr("MODES"));
                                                color: Tok.ink-faint;
                                                font-size: 10px;
                                                letter-spacing: 0.9px;
                                            }

                                            for mode[index] in root.word-mode-names: HorizontalLayout {
                                                spacing: 6px;

                                                // **先頭の「なし」は作ったモードではない**ので出さない。
                                                if index > 0 && !(root.word-naming == 3
                                                    && root.word-naming-at == index - 1): TextButton {
                                                    wide: true;
                                                    title: mode.name;
                                                    role: root.word-mode-opened-at == index - 1
                                                        ? Role.primary
                                                        : Role.normal;
                                                    // **開くのはRustに頼む**（書き手の報告 2026-09-08：
                                                    // モードを選んでも何も出ない）。中身（語群・語・重複）は
                                                    // Rustが作って窓へ渡すモデルなので、こちら側で数字を
                                                    // 変えただけでは**誰も作り直さない**——押した先が
                                                    // 空のままだったのはそれである。
                                                    clicked => {
                                                        root.word-mode-opened(
                                                            root.word-mode-opened-at == index - 1 ? -1 : index - 1);
                                                    }
                                                    // **長押しで名前を変える**（書き手の求め 2026-09-08）。
                                                    // タブの名前と同じ手つきで、**作るときと同じ欄**が
                                                    // その場に出る（単語チェックモード要件 7.4）。
                                                    holdable: true;
                                                    held => {
                                                        root.word-new-name = mode.name;
                                                        root.word-naming-trouble = "";
                                                        root.word-naming-at = index - 1;
                                                        root.word-naming = 3;
                                                    }
                                                }
                                                // **いまこの文書が使っているモード**（同日追加、書き手の
                                                // 報告：設定上どちらも同じに見える）。開いて中を見ている
                                                // ことと、いま色が付いていることは別のことである。
                                                if index > 0 && mode.id == root.word-mode
                                                    && !(root.word-naming == 3
                                                        && root.word-naming-at == index - 1): Text {
                                                    text: @tr("This document");
                                                    color: Tok.accent;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 0;
                                                }
                                                if index > 0 && !(root.word-naming == 3
                                                    && root.word-naming-at == index - 1): TextButton {
                                                    title: "×";
                                                    role: Role.quiet;
                                                    clicked => {
                                                        root.word-mode-removed(index - 1);
                                                    }
                                                }

                                                // 名前を変えているあいだ、この行はその欄になる。
                                                if root.word-naming == 3 && root.word-naming-at == index - 1: Field {
                                                    placeholder: @tr("Mode name");
                                                    text <=> root.word-new-name;
                                                    init => {
                                                        self.take-focus();
                                                    }
                                                    accepted => {
                                                        root.word-mode-renamed(index - 1, root.word-new-name);
                                                    }
                                                    escaped => {
                                                        root.word-naming = 0;
                                                    }
                                                }
                                                if root.word-naming == 3 && root.word-naming-at == index - 1: TextButton {
                                                    title: @tr("OK");
                                                    role: Role.primary;
                                                    clicked => {
                                                        root.word-mode-renamed(index - 1, root.word-new-name);
                                                    }
                                                }
                                                if root.word-naming == 3 && root.word-naming-at == index - 1: TextButton {
                                                    title: @tr("Cancel");
                                                    role: Role.quiet;
                                                    clicked => {
                                                        root.word-naming = 0;
                                                    }
                                                }
                                            }

                                            // 書き手の求め 2026-09-08: **設定は一枚で終える。**
                                            // 名前は別の問いにしない——問いは窓の中に描くもの（要件
                                            // 8.3・8.4）で、このパネルはその上に浮いている別の窓だから、
                                            // **訊くたびにパネルが消えて戻る**ことになる。「決定すると
                                            // 次の画面」が続くと、何をしているのか分からなくなる。
                                            // **欄はこの場に出し、この場で終える。**
                                            if root.word-naming != 1: HorizontalLayout {
                                                alignment: start;

                                                TextButton {
                                                    title: @tr("New Mode");
                                                    role: Role.primary;
                                                    clicked => {
                                                        root.word-new-name = "";
                                                        root.word-naming-trouble = "";
                                                        root.word-naming = 1;
                                                    }
                                                }
                                            }

                                            if root.word-naming == 1: HorizontalLayout {
                                                spacing: 6px;

                                                Field {
                                                    placeholder: @tr("Mode name");
                                                    text <=> root.word-new-name;
                                                    // **出たときに鍵盤をここへ。**押した手はもう名前を
                                                    // 打つつもりでいる。`if`の中の要素はここからしか
                                                    // 触れないので、外から呼ばずに自分で取る。
                                                    init => {
                                                        self.take-focus();
                                                    }
                                                    accepted => {
                                                        root.word-mode-added(root.word-new-name);
                                                    }
                                                    escaped => {
                                                        root.word-naming = 0;
                                                    }
                                                }
                                                TextButton {
                                                    title: @tr("Add");
                                                    role: Role.primary;
                                                    clicked => {
                                                        root.word-mode-added(root.word-new-name);
                                                    }
                                                }
                                                TextButton {
                                                    title: @tr("Cancel");
                                                    role: Role.quiet;
                                                    clicked => {
                                                        root.word-naming = 0;
                                                    }
                                                }
                                            }

                                            if root.word-naming != 0 && root.word-naming-trouble != "": Text {
                                                text: root.word-naming-trouble;
                                                color: Tok.alert;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }

                                            if root.word-mode-names.length <= 1: Text {
                                                text: @tr("Create a mode, then word groups (people, places, …) inside it.")
                                                    + @tr("Choose the mode for each document from the status bar below.");
                                                color: Tok.ink-faint;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }

                                            if root.word-mode-opened-at >= 0: Rectangle {
                                                height: 1px;
                                                background: Tok.rule;
                                            }

                                            // **開いたモードの名前を出す。**「GROUPS」だけでは、どの
                                            // モードの中を見ているのか画面に無かった（書き手の報告
                                            // 2026-09-08）。`+ 1`は先頭の「なし」の分。
                                            if root.word-mode-opened-at >= 0: Text {
                                                text: @tr("GROUPS — {}", root.word-mode-names[root.word-mode-opened-at + 1].name);
                                                color: Tok.ink-faint;
                                                font-size: 10px;
                                                letter-spacing: 0.9px;
                                            }

                                            if root.word-mode-opened-at >= 0: VerticalLayout {
                                                spacing: 8px;

                                                for row[index] in root.word-group-rows: HorizontalLayout {
                                                    spacing: 6px;

                                                    // 色見本。押すとWindowsの色ダイアログ（要件 9 と同じ道）。
                                                    Rectangle {
                                                        width: 24px;
                                                        horizontal-stretch: 0;

                                                        Rectangle {
                                                            y: (parent.height - self.height) / 2;
                                                            width: 24px;
                                                            height: 20px;
                                                            border-radius: 4px;
                                                            border-width: 1px;
                                                            border-color: swatch.has-hover ? Tok.accent : Tok.rule-strong;
                                                            // **色を持たない語群は、色の無い升目**
                                                            // （除外語群、2026-09-08）。
                                                            background: row.paints ? row.shown : Tok.chrome-sunken;

                                                            if !row.paints: Text {
                                                                width: 100%;
                                                                height: 100%;
                                                                text: "—";
                                                                color: Tok.ink-faint;
                                                                font-size: 11px;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }

                                                            swatch := TouchArea {
                                                                mouse-cursor: pointer;
                                                                clicked => {
                                                                    group-palette.show();
                                                                }
                                                            }

                                                            // C5（2026-09-15）: 語群の色もパレットで。
                                                            group-palette := PopupWindow {
                                                                y: parent.height + 2px;
                                                                width: 236px;
                                                                close-policy: close-on-click-outside;
                                                                MenuFrame {
                                                                    width: 236px;
                                                                    ColourPalette {
                                                                        current: row.paints ? row.shown : transparent;
                                                                        chosen(colour) => {
                                                                            root.colour-set(2, index, colour);
                                                                            group-palette.close();
                                                                        }
                                                                        more => {
                                                                            root.colour-more(2, index);
                                                                            group-palette.close();
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }

                                                    // **名前も釦である**（書き手の求め 2026-09-08）。
                                                    // 押せば語の一覧が開き、**長押しすれば名前を変えられる**
                                                    // ——モードの行と同じ手つきにする。
                                                    if !(root.word-naming == 4
                                                        && root.word-naming-at == index): TextButton {
                                                        wide: true;
                                                        // **開いている語群には印を付ける。**下に出ている
                                                        // `Import…`と`この語群を消す`がどれに効くのかは、
                                                        // この印だけが言う。
                                                        role: root.word-group-opened-at == index
                                                            ? Role.primary
                                                            : Role.quiet;
                                                        title: row.name;
                                                        clicked => {
                                                            root.word-group-opened(
                                                                root.word-group-opened-at == index ? -1 : index);
                                                        }
                                                        holdable: true;
                                                        held => {
                                                            root.word-new-name = row.name;
                                                            root.word-naming-trouble = "";
                                                            root.word-naming-at = index;
                                                            root.word-naming = 4;
                                                        }
                                                    }

                                                    // **語数と、色を付けられなかった数。**押すと一覧が開く
                                                    // ——アプリの中で見て、アプリの中で消せることが、辞書を
                                                    // 書き手に管理させないということである。
                                                    if !(root.word-naming == 4
                                                        && root.word-naming-at == index): TextButton {
                                                        role: Role.quiet;
                                                        title: row.conflicts > 0
                                                            ? @tr("{} words / {} duplicates", row.words, row.conflicts)
                                                            : (row.repeated > 0
                                                                ? @tr("{} words ({} doubled)", row.words, row.repeated)
                                                                : @tr("{} words", row.words));
                                                        clicked => {
                                                            root.word-group-opened(
                                                                root.word-group-opened-at == index ? -1 : index);
                                                        }
                                                    }

                                                    // 名前を変えているあいだ、この行はその欄になる
                                                    // （色見本だけは残す——どの語群かはそれで分かる）。
                                                    if root.word-naming == 4 && root.word-naming-at == index: Field {
                                                        placeholder: @tr("Group name");
                                                        text <=> root.word-new-name;
                                                        init => {
                                                            self.take-focus();
                                                        }
                                                        accepted => {
                                                            root.word-group-renamed(index, root.word-new-name);
                                                        }
                                                        escaped => {
                                                            root.word-naming = 0;
                                                        }
                                                    }
                                                    if root.word-naming == 4 && root.word-naming-at == index: TextButton {
                                                        title: @tr("OK");
                                                        role: Role.primary;
                                                        clicked => {
                                                            root.word-group-renamed(index, root.word-new-name);
                                                        }
                                                    }
                                                    if root.word-naming == 4 && root.word-naming-at == index: TextButton {
                                                        title: @tr("Cancel");
                                                        role: Role.quiet;
                                                        clicked => {
                                                            root.word-naming = 0;
                                                        }
                                                    }
                                                }

                                                // **語群が1つも無いモード。**作った直後はここに来る——
                                                // 何も出ないのは「効かなかった」に見える（書き手の報告
                                                // 2026-09-08）ので、**次にすることを書いておく**。
                                                if root.word-group-rows.length == 0: Text {
                                                    text: @tr("This mode has no word groups yet.")
                                                        + @tr("Use \"New Group\" to create groups such as people or places and pick their colors.");
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }

                                                // 開いている語群の語。**アプリの中で消せる**（要件 7.9）。
                                                if root.word-group-opened-at >= 0: Rectangle {
                                                    height: 152px;
                                                    background: Tok.chrome-raised;
                                                    border-radius: 6px;

                                                    ScrollView {
                                                        x: 8px;
                                                        y: 6px;
                                                        width: parent.width - 16px;
                                                        height: parent.height - 12px;

                                                        VerticalLayout {
                                                            alignment: start;
                                                            spacing: 1px;

                                                            for word in root.word-group-words: HorizontalLayout {
                                                                spacing: 6px;

                                                                Text {
                                                                    text: word.text;
                                                                    // **覚え書きは薄く。**語の並びの中で
                                                                    // 見出しとして読めればよく、語と同じ
                                                                    // 濃さで出ると語の数が分からなくなる。
                                                                    color: word.note ? Tok.ink-faint : Tok.ink;
                                                                    font-size: 12px;
                                                                    vertical-alignment: center;
                                                                    overflow: elide;
                                                                    horizontal-stretch: 1;
                                                                }
                                                                TextButton {
                                                                    title: "×";
                                                                    role: Role.quiet;
                                                                    clicked => {
                                                                        root.word-removed(
                                                                            root.word-group-opened-at, word.text);
                                                                    }
                                                                }
                                                            }

                                                            if root.word-group-words.length == 0: Text {
                                                                text: @tr("No words yet. Select a word in the text, right-click,")
                                                                    + @tr("and use \"Add to word set\".")
                                                                    + @tr("Lines starting with # are notes.");
                                                                color: Tok.ink-faint;
                                                                font-size: 11px;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                }

                                                // **開いている語群についてすることは、その語群の下に置く**
                                                // （書き手の報告 2026-09-08：名前が「…」に潰れていた）。
                                                // 行に釦を5つ並べると、380pxの幅では**いちばん大事な名前が
                                                // 先に潰れる**——名前は行に、することは開いた先に。
                                                //
                                                // **消すのもここである。**語を1万まで入れられるものを、
                                                // 一覧の行の`×`ひとつで消せてよいはずがない。
                                                if root.word-group-opened-at >= 0: HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 6px;

                                                    TextButton {
                                                        title: @tr("Import…");
                                                        clicked => {
                                                            root.word-group-imported(root.word-group-opened-at);
                                                        }
                                                    }
                                                    TextButton {
                                                        title: @tr("Export…");
                                                        clicked => {
                                                            root.word-group-exported(root.word-group-opened-at);
                                                        }
                                                    }
                                                    // **除外語群にする／やめる**（書き手と決めた 2026-09-08）。
                                                    // 色を持たない語群は木に積まれて最長一致で勝ち、しかし
                                                    // 何も塗らない——`カリオン`を入れておくと、その中で
                                                    // `リオン`が光らなくなる。
                                                    TextButton {
                                                        title: root.word-group-rows[root.word-group-opened-at].paints
                                                            ? @tr("No Color")
                                                            : @tr("Use Color");
                                                        clicked => {
                                                            root.word-group-paint-toggled(root.word-group-opened-at);
                                                        }
                                                    }
                                                    TextButton {
                                                        title: @tr("Delete This Group");
                                                        role: Role.danger;
                                                        clicked => {
                                                            root.word-group-removed(root.word-group-opened-at);
                                                        }
                                                    }
                                                }

                                                if root.word-naming == 2: HorizontalLayout {
                                                    spacing: 6px;

                                                    Field {
                                                        placeholder: @tr("Group name");
                                                        text <=> root.word-new-name;
                                                        init => {
                                                            self.take-focus();
                                                        }
                                                        accepted => {
                                                            root.word-group-added(
                                                                root.word-mode-opened-at, root.word-new-name);
                                                        }
                                                        escaped => {
                                                            root.word-naming = 0;
                                                        }
                                                    }
                                                    TextButton {
                                                        title: @tr("Add");
                                                        role: Role.primary;
                                                        clicked => {
                                                            root.word-group-added(
                                                                root.word-mode-opened-at, root.word-new-name);
                                                        }
                                                    }
                                                    TextButton {
                                                        title: @tr("Cancel");
                                                        role: Role.quiet;
                                                        clicked => {
                                                            root.word-naming = 0;
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    alignment: start;
                                                    spacing: 6px;

                                                    if root.word-naming != 2: TextButton {
                                                        title: @tr("New Group");
                                                        // **一枚で終える**（`New Mode`の注記）。
                                                        clicked => {
                                                            root.word-new-name = "";
                                                            root.word-naming-trouble = "";
                                                            root.word-naming = 2;
                                                        }
                                                    }
                                                    // **重複は畳んで置く。**普段は数だけ見えていればよく、
                                                    // 直すときにだけ開く。
                                                    if root.word-trouble-count > 0: TextButton {
                                                        title: root.word-troubles-shown
                                                            ? @tr("Hide Duplicates")
                                                            : @tr("{} duplicates", root.word-trouble-count);
                                                        clicked => {
                                                            root.word-troubles-shown = !root.word-troubles-shown;
                                                        }
                                                    }
                                                }

                                                // 要件 7.9: **参照画面。**どの語が、どこで、色が付いているのか
                                                // いないのか。
                                                if root.word-troubles-shown: Rectangle {
                                                    height: 152px;
                                                    background: Tok.chrome-raised;
                                                    border-radius: 6px;

                                                    ScrollView {
                                                        x: 8px;
                                                        y: 6px;
                                                        width: parent.width - 16px;
                                                        height: parent.height - 12px;

                                                        VerticalLayout {
                                                            alignment: start;
                                                            spacing: 2px;

                                                            for trouble in root.word-troubles: HorizontalLayout {
                                                                spacing: 6px;

                                                                Text {
                                                                    text: trouble.conflict ? @tr("No color") : @tr("Doubled");
                                                                    color: trouble.conflict ? Tok.alert : Tok.ink-faint;
                                                                    font-size: 11px;
                                                                    horizontal-stretch: 0;
                                                                    min-width: 44px;
                                                                }
                                                                Text {
                                                                    text: trouble.word;
                                                                    color: Tok.ink;
                                                                    font-size: 12px;
                                                                    overflow: elide;
                                                                    horizontal-stretch: 1;
                                                                }
                                                                Text {
                                                                    text: trouble.told;
                                                                    color: Tok.ink-faint;
                                                                    font-size: 11px;
                                                                    overflow: elide;
                                                                    horizontal-stretch: 1;
                                                                }
                                                            }

                                                            if root.word-trouble-count > root.word-troubles.length: Text {
                                                                text: @tr("{} more", root.word-trouble-count - root.word-troubles.length);
                                                                color: Tok.ink-faint;
                                                                font-size: 11px;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                height: 1px;
                                                background: Tok.rule;
                                            }

                                            // 単語チェックモード要件 5.4（書き手の求め 2026-09-08）:
                                            // **辞書そのものを開く。**画面から作った表と同じものを、
                                            // この編集器で直接直せる——**行に1つの形にしてあるのは、
                                            // 人が読んで直せるためでもある**（同要件 4.2）。
                                            HorizontalLayout {
                                                spacing: 6px;

                                                TextButton {
                                                    title: @tr("Edit…");
                                                    // **頼んでから閉じる**（技術検証 6.24）。開く先はタブで、
                                                    // 書き手はもうこの画面を見ていない。
                                                    clicked => {
                                                        root.word-file-edited();
                                                    }
                                                }
                                                Text {
                                                    text: @tr("Opens the word set file in a tab. Saving it reloads the words.");
                                                    color: Tok.ink-faint;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }


                                        // どの面にいても、値はいまのシートのもの——だから帯のすぐ
                                        // 下に在る（要件 9）。
                                        if root.shows-group(3, []): VerticalLayout {
                                            PanelStyleEditor { font-list-requested => { root.font-list-requested(); } font-names: root.font-names; heading: "Terminal Panel"; style: root.panel-defaults[2]; changed style => { root.panel-defaults[2] = self.style; root.terminal-settings-edited(); } defaults: true; }
                                        }

                                        // 初期値へ戻すのは**書式の両シート全部**（`typography_reset`）
                                        // なので、書式の面にだけ置く。General の2つはこれで戻らない。
                                        if !root.settings-searching && root.settings-tab > 2 && root.settings-tab < 6: VerticalLayout {
                                            spacing: 8px;

                                            Rectangle {
                                                height: 1px;
                                                background: Tok.rule;
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;

                                                TextButton {
                                                    title: @tr("Reset");
                                                    clicked => {
                                                        root.typography-reset(3);
                                                        root.typography-reset(4);
                                                        root.typography-reset(5);
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Wider than the line it draws, so there is something to grab. The
                // line stays 1px until the pointer is on it.
                for boundary[index] in root.boundaries: Rectangle {
                    background: Tok.chrome;
                    x: boundary.x * 1px;
                    y: boundary.y * 1px;
                    width: boundary.width * 1px;
                    height: boundary.height * 1px;

                    Rectangle {
                        x: boundary.side-by-side
                            ? (grab.has-hover || grab.pressed ? 3px : 4px)
                            : 0px;
                        y: boundary.side-by-side
                            ? 0px
                            : (grab.has-hover || grab.pressed ? 3px : 4px);
                        width: boundary.side-by-side
                            ? (grab.has-hover || grab.pressed ? 3px : 1px)
                            : parent.width;
                        height: boundary.side-by-side
                            ? parent.height
                            : (grab.has-hover || grab.pressed ? 3px : 1px);
                        background: grab.has-hover || grab.pressed ? Tok.accent : Tok.rule-strong;
                    }

                    grab := TouchArea {
                        mouse-cursor: boundary.side-by-side ? ew-resize : ns-resize;

                        // The delta, not a position: once the layout has moved this
                        // element under the pointer, `mouse-x` is back at
                        // `pressed-x` and the next event reports only what is new.
                        // Anchoring to a start position would double-count.
                        moved => {
                            root.boundary-moved(
                                index,
                                (self.mouse-x - self.pressed-x) / 1px,
                                (self.mouse-y - self.pressed-y) / 1px,
                            );
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 28px;
            background: Tok.chrome;

            // The rule is the top of this bar rather than the bottom of the
            // editing area, so that the bar is one thing.
            Rectangle {
                y: 0;
                height: 1px;
                background: Tok.rule;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 14px;

                Text {
                    // The marker is the whole of the unsaved indication, so it
                    // has to be beside the name rather than anywhere else.
                    text: root.document-edited
                        ? root.document-title + " *"
                        : root.document-title;
                    color: Tok.ink;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    // The one thing here that can be any length. Elided, so a
                    // long name gives way rather than pushing the counts off
                    // the end of the bar.
                    max-width: 280px;
                    overflow: elide;
                }

                Text {
                    text: root.count-lines;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.count-body;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.count-source;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: root.count-selected;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                // 要件 E2: **この文書が何で書かれているか。**開いたファイルの
                // 文字コードと改行で、新しい文書はこの編集器が書く形（UTF-8・LF）。
                // **押せば選べる**（E2の②、2026-09-10）——単語モードと倍率が
                // 同じ帯で押せるのと同じ形で、ここも「いま書いているものに
                // ついての設定」である。
                // 要件 8.3（S2）: **押せる印**。押すと、どうするかを訊く。
                if root.count-outside: Rectangle {
                    width: outside-text.preferred-width + 12px;
                    horizontal-stretch: 0;
                    background: outside-touch.has-hover ? Tok.alert-soft : transparent;
                    border-radius: 4px;

                    outside-text := Text {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        text: root.count-missing ? @tr("⚠ File not found") : @tr("⚠ Changed outside");
                        color: Tok.alert;
                        font-size: 12px;
                    }

                    outside-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.outside-asked();
                        }
                    }
                }

                if root.count-encoding != "": Rectangle {
                    width: encoding-text.preferred-width + 12px;
                    horizontal-stretch: 0;
                    background: encoding-touch.has-hover ? Tok.chrome-raised : transparent;
                    border-radius: 4px;

                    encoding-text := Text {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        text: root.count-encoding;
                        color: Tok.ink-muted;
                        font-size: 12px;
                    }

                    encoding-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            encoding-menu.show();
                        }
                    }

                    // **押した言葉の真上に出す**（技術検証 6.30：押した釦と
                    // 同じ箱の中に置く）。**高さは数えて書く**——自分の高さを
                    // 訊きながら位置を決めるのは輪になった問いである（倍率の
                    // 一覧と同じ）。中身は3つ（見出し・線・4行／一言）で、間は2つ：
                    // 6+22+1+11+1+115+6＝162、開き直せないときは4行(115)が
                    // 一言(40)になるので 87。
                    //
                    // **保存はここに無い**（書き手の判断 2026-09-10：「ステータス
                    // バーで切り替えるのは、読み方だと思います」）。書く文字コードは
                    // 名前を付けて保存の欄で選ぶ——保存は行き先を決める操作なので、
                    // 決めごとが1つのダイアログに集まっているほうがよい。
                    encoding-menu := PopupWindow {
                        x: 0px;
                        y: -6px - (root.count-encoding-reopenable ? 162px : 87px);
                        width: 220px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 220px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 1px;

                                // **何をする一覧かを言う。**この帯が受け持つのは
                                // **読み方**で、書き方（保存の文字コード）は名前を
                                // 付けて保存の欄にある——同じ言葉で2つのことを
                                // させない（要件 E2：2つは別の操作である）。
                                Text {
                                    height: 22px;
                                    text: @tr("Reopen with this encoding");
                                    color: Tok.ink-faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }

                                MenuSep { }

                                // **ファイルが無ければ行を出さない**（要件 7.7）。
                                // 押せて、何も起きない行は、働いていないことを
                                // 隠している。
                                if !root.count-encoding-reopenable: Text {
                                    height: 40px;
                                    text: @tr("A document that has not been saved\ncannot be reopened");
                                    color: Tok.ink-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }

                                // **頼んでから閉じる**（技術検証 6.24）。条件の
                                // 付いた行は繰り返し要素なので、先に閉じると
                                // ハンドラごと消える。
                                if root.count-encoding-reopenable: VerticalLayout {
                                    spacing: 1px;

                                    MenuRow {
                                        title: "UTF-8";
                                        checked: root.count-encoding-id == 0;
                                        activated => {
                                            root.reopen-encoding(0);
                                            encoding-menu.close();
                                        }
                                    }
                                    MenuRow {
                                        title: "UTF-16 LE";
                                        checked: root.count-encoding-id == 1;
                                        activated => {
                                            root.reopen-encoding(1);
                                            encoding-menu.close();
                                        }
                                    }
                                    MenuRow {
                                        title: "UTF-16 BE";
                                        checked: root.count-encoding-id == 2;
                                        activated => {
                                            root.reopen-encoding(2);
                                            encoding-menu.close();
                                        }
                                    }
                                    MenuRow {
                                        title: "CP932";
                                        checked: root.count-encoding-id == 3;
                                        activated => {
                                            root.reopen-encoding(3);
                                            encoding-menu.close();
                                        }
                                    }
                                }

                            }
                        }
                    }
                }

                if root.document-save-mode != "": Text {
                    text: root.document-save-mode;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                // 要件 10: only the source has a line and a column to give.
                if root.count-caret != "": Text {
                    text: root.count-caret;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                // E1: **いま探している語が、この文書に何回あるか。**帯は閉じて
                // いることがあり、F3はそれでも効く——**効いたのが見えないのは、
                // 効かないのと見分けがつかない**ので、答えはここに出ている。
                // 打鍵のたびに数え直すので古くならない。
                if root.count-find != "": Text {
                    text: root.count-find;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    max-width: 280px;
                    overflow: elide;
                }

                // **起きたことは、どの向きの面で書いていても見える**（書き手の
                // 報告 2026-09-10）。数の並びより先に読めるよう、色を持たせてある
                // ——ここに出るのは「保存できません」のような、書き手が次の一手を
                // 決めなければならない知らせである。
                //
                // **空いている幅いっぱいまで出し、切れたときだけ全文をマウス
                // オーバーで出す**（書き手の求め 2026-09-15：Gitの断りが切れて
                // 読めなかった）。伸びるのは箱で、自分の全文より広くはならない
                // ——余りは右の空きが取り、右の並びは動かない。
                if root.render-status != "": status-box := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 40px;
                    preferred-width: status-text.preferred-width;
                    max-width: status-text.preferred-width;

                    status-text := Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.render-status-shown;
                        color: Tok.alert;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // **比べる相手は名前で呼ぶ。**`parent.width`と書くと出ない
                    // （技術検証 6.39：条件は生成される要素へ移される）。
                    if status-text.preferred-width > status-box.width: Tooltip {
                        text: @markdown("\{root.render-status-shown}");
                    }
                }

                // 要件 7.3: a paragraph long enough to cost a keystroke. The
                // one thing in the bar that is not grey, because it is the one
                // thing that is about to be a problem.
                if root.count-warning != "": Text {
                    text: root.count-warning;
                    color: Tok.alert;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                // The only thing in the row that grows.
                Rectangle {
                    horizontal-stretch: 1;
                }

                // 要件 7.9（2026-09-08）: **単語チェックモード。**コードエディタが
                // 言語モードを出しているのと同じ場所である——いまどのモードかが
                // 常に見えていて、押せば切り替わる（書き手の指摘：構造として
                // 「自分の単語チェックモード」があればよい）。
                //
                // **モードは文書ごと**なので、前に出ているタブのものが出る。
                // 倍率の隣にあるのは、どちらも「いま書いているものについての
                // 設定」だからである。
                Rectangle {
                    width: mode-text.preferred-width + 12px;
                    horizontal-stretch: 0;
                    background: mode-touch.has-hover ? Tok.chrome-raised : transparent;
                    border-radius: 4px;

                    mode-text := Text {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        // **働いていない理由は、モードの名前の隣に出す。**
                        // 帯の言葉は次の報せで流れるが、これは続いているあいだ
                        // ずっと出ていなければならない。
                        text: root.word-mode-trouble == ""
                            ? root.word-mode-name
                            : root.word-mode-name + " · " + root.word-mode-trouble;
                        color: root.word-mode-trouble == "" ? Tok.ink-muted : Tok.alert;
                        font-size: 12px;
                    }

                    mode-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            mode-menu.show();
                        }
                    }

                    // **押した数の真上に出す**（倍率と同じ罠を踏まないため、
                    // 押した釦と同じ箱の中に置く＝技術検証 6.30）。
                    mode-menu := PopupWindow {
                        x: 0px;
                        y: -6px - min(root.word-mode-names.length, 12) * 30px;
                        width: 200px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 200px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 1px;

                                // **頼んでから閉じる**（技術検証 6.24）。
                                for row in root.word-mode-names: MenuRow {
                                    title: row.name;
                                    checked: row.id == root.word-mode;
                                    activated => {
                                        root.word-mode-chosen(row.id);
                                        mode-menu.close();
                                    }
                                }
                            }
                        }
                    }
                }

                // 要件 9: the zoom belongs to a pane now, so the bar shows
                // the focused pane's — the bar is about what the writer is
                // working in, the same as the counts to its left.
                // 追加要件 2026-09-06: **the number opens the bar that moves
                // it.** It was a readout; a writer who wants 130% had to press
                // Ctrl+= three times or find the pane's menu.
                Rectangle {
                    width: zoom-text.preferred-width + 12px;
                    horizontal-stretch: 0;
                    background: zoom-touch.has-hover ? Tok.chrome-raised : transparent;
                    border-radius: 4px;

                    zoom-text := Text {
                        x: 6px;
                        y: (parent.height - self.height) / 2;
                        text: root.panes[root.current-pane-row].zoom + "%";
                        color: Tok.ink-muted;
                        font-size: 12px;
                    }

                    zoom-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            zoom-menu.show();
                        }
                    }

                    // 書き手の報告 2026-09-07: **数の真上に立てる。**It hung from
                    // the row rather than from the number — a popup inside a
                    // layout is not laid out, so its corner was the *bar's*
                    // corner and the panel came up at the far left, an inch of
                    // window away from what had been clicked. Sitting inside
                    // the number's own box makes the two coordinates the same
                    // question, and standing the bar up keeps the whole thing
                    // as narrow as the number under it.
                    zoom-menu := PopupWindow {
                        x: (parent.width - 76px) / 2;
                        // **Told rather than measured.** The panel has to sit
                        // clear of the number it came from, and a popup asked
                        // for its own height while it is deciding where to be
                        // is a question in a circle: 8+16+6+150+6+28+8.
                        y: -228px;
                        width: 76px;
                        height: 222px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 76px;
                            height: 222px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                Text {
                                    text: root.panes[root.current-pane-row].zoom + "%";
                                    color: Tok.ink;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }

                                Slider {
                                    vertical: true;
                                    minimum: 50;
                                    maximum: 240;
                                    value: root.panes[root.current-pane-row].zoom;
                                    // **Ten at a time**, the step the keys and
                                    // the wheel already move by (要件 11.5):
                                    // the same number should be reachable
                                    // whichever way the writer moves it.
                                    moved(percent) => {
                                        root.pane-zoom-set(
                                            root.focused-pane,
                                            round(percent / 10) * 10);
                                    }
                                }

                                TextButton {
                                    title: "100%";
                                    wide: true;
                                    clicked => {
                                        zoom-menu.close();
                                        root.pane-zoom-reset(root.focused-pane);
                                        root.focus-generation += 1;
                                    }
                                }
                            }
                        }
                    }
                }

                // How the editing area is divided, in the one place that is
                // about the window rather than about the document.
                Rectangle {
                    width: arrangement.width + 21px;
                    horizontal-stretch: 0;
                    background: arrangement-touch.has-hover ? Tok.chrome-raised : transparent;
                    border-radius: 4px;

                    arrangement-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { arrangement-menu.show(); }
                    }

                    arrangement-menu := PopupWindow {
                        x: parent.width - 180px;
                        y: -82px;
                        width: 180px;
                        close-policy: close-on-click-outside;
                        MenuFrame {
                            width: 180px;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 1px;
                                MenuRow {
                                    title: @tr("Split Right");
                                    activated => {
                                        root.divide-requested(true);
                                        arrangement-menu.close();
                                        root.focus-generation += 1;
                                    }
                                }
                                MenuRow {
                                    title: @tr("Split Down");
                                    activated => {
                                        root.divide-requested(false);
                                        arrangement-menu.close();
                                        root.focus-generation += 1;
                                    }
                                }
                            }
                        }
                    }

                    Icon {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        commands: Icons.split;
                        tint: Tok.ink-muted;
                    }

                    arrangement := Text {
                        x: 21px;
                        y: (parent.height - self.height) / 2;
                        text: @tr("Active Pane: {}", (root.focused-pane < 65536 ? root.focused-pane : root.panes[root.current-pane-row].panel-owner) + 1);
                        color: Tok.ink-muted;
                        font-size: 12px;
                    }
                }
            }
        }
    }

    // Opened from either menu, because there is only one set of values.
    //
    // 要件 9 makes the display settings one thing for the whole app — the zoom
    // is the only part that belongs to a pane, which is why it stays in the
    // pane's own menu and is not here. Two surfaces onto one set of values
    // would be two chances to disagree.
    // 要件 9: the families this machine has. **Beside the panel rather than
    // inside it**, so that opening it is not a click inside the panel closing
    // the panel; the two stack, and clicking away closes whichever is on top.
    //
    // Chosen first, closed second — these rows are a repeater inside a popup,
    // and closing first takes the element running the handler with it
    // (技術検証 6.22).
    property <length> font-menu-x;
    property <length> font-menu-y;
    font-menu := PopupWindow {
        x: clamp(root.font-menu-x, 0px, max(0px, root.width - 320px));
        y: clamp(root.font-menu-y, 0px, max(0px, root.height - 352px));
        width: 320px;
        close-policy: close-on-click-outside;

        MenuFrame {
            width: 320px;

            VerticalLayout {
                padding: 6px;

                ScrollView {
                    height: 340px;

                    VerticalLayout {
                        alignment: start;
                        spacing: 1px;

                        for family[index] in root.font-names: MenuRow {
                            title: family;
                            checked: family == root.font-current;
                            activated => {
                                root.font-chosen(root.font-slot, family);
                                font-menu.close();
                            }
                        }
                    }
                }
            }
        }
    }

    // Last in the window, so it is drawn over everything the editor shows.
    if root.question-open: Rectangle {
        background: Tok.scrim;

        // Swallows every click that does not land on a button. While the
        // question stands, the document behind it cannot be clicked into.
        TouchArea {}

        // Takes the keyboard away from the pane's IME field, so a keystroke
        // meant for the question does not land in the document. Giving it back
        // is Rust's job (`restore_editor_focus`, 6.14).
        //
        // **The question is inside it**, so that Esc still answers when the
        // name field has the keyboard: a key a field does not use goes up to
        // the scopes above it, and a scope beside it is not above it.
        question-keys := FocusScope {
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.question-answered(root.question-choices.length - 1);
                    accept
                } else if event.text == Key.Return && root.question-enter-sends {
                    root.question-answered(0);
                    accept
                } else {
                    reject
                }
            }

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: min(root.width - 64px, 420px);
                        background: Tok.paper;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Tok.rule-strong;
                        drop-shadow-color: #1713214d;
                        drop-shadow-blur: 40px;
                        drop-shadow-offset-y: 16px;

                        VerticalBox {
                            padding: 20px;
                            spacing: 14px;

                            // What is being asked, and then what it costs. The
                            // two arrive as one string with a blank line
                            // between them, because every message was written
                            // that way before there was anywhere to put the
                            // second half.
                            Text {
                                text: root.question-text;
                                color: Tok.ink-strong;
                                font-size: 15px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            if root.question-detail != "": Text {
                                text: root.question-detail;
                                color: Tok.ink-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            // A question answered by typing (要件 5.2). Built
                            // when the question is, so it takes the keyboard at
                            // `init`; the generation is for a name asked for
                            // while one is already up, which the overlay does
                            // not allow but costs nothing to survive.
                            if root.question-is-clone: Text { text: @tr("Repository URL (HTTPS / SSH)"); color: Tok.ink; }
                            if root.question-is-bookmark: VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Link"); color: Tok.ink-muted; font-size: 11px; }
                                Text { text: root.question-bookmark-link; color: Tok.ink; font-size: 12px; wrap: word-wrap; }
                            }
                            if root.question-is-bookmark: Text { text: @tr("Title"); color: Tok.ink-muted; font-size: 11px; }
                            if root.question-asks-name: Field {
                                enabled: !root.question-is-clone || !root.workspace-cloning;
                                property <int> asked: root.question-generation;
                                text <=> root.question-name;
                                edited => { if root.question-is-clone { root.workspace-clone-url-edited(); } }
                                focus-lost => { if root.question-is-clone { root.workspace-clone-url-check(); } }
                                init => {
                                    self.take-focus();
                                }
                                changed asked => {
                                    self.take-focus();
                                }
                                // Enter is the first choice, which is the one
                                // that does the thing being named.
                                accepted => {
                                    root.question-answered(0);
                                }
                                // And Escape is the last, like every other way
                                // out of a question. **The field has to pass it
                                // on**: it is inside the scope that would
                                // otherwise hear the key, and a `TextInput`
                                // that keeps Escape keeps it from everyone.
                                escaped => {
                                    root.question-answered(
                                        root.question-choices.length - 1);
                                }
                            }

                            if root.question-is-bookmark: VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Group"); color: Tok.ink-muted; font-size: 11px; }
                                Rectangle {
                                    height: 30px;
                                    TextButton {
                                        width: parent.width; wide: true;
                                        title: (root.question-bookmark-group >= 0 && root.question-bookmark-group < root.question-bookmark-groups.length
                                            ? root.question-bookmark-groups[root.question-bookmark-group] : "") + " ▾";
                                        clicked => { bookmark-group-menu.show(); }
                                    }
                                    bookmark-group-menu := PopupWindow {
                                        x: 0px; y: 30px; width: parent.width; close-policy: close-on-click-outside;
                                        MenuFrame {
                                            width: parent.width;
                                            VerticalLayout {
                                                padding: 6px; spacing: 1px;
                                                for name[index] in root.question-bookmark-groups: MenuRow {
                                                    title: name; checked: index == root.question-bookmark-group;
                                                    activated => { root.question-bookmark-group = index; bookmark-group-menu.close(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.question-is-clone && root.workspace-clone-url-error != "": Text {
                                text: root.workspace-clone-url-error; color: Tok.alert; wrap: word-wrap; font-size: 12px;
                            }
                            if root.question-is-clone && root.workspace-clone-url-checking: Text {
                                text: "…"; color: Tok.ink-muted; font-size: 12px;
                            }
                            if root.question-is-clone: VerticalLayout {
                                spacing: 6px;
                                Text { text: @tr("Destination folder (empty)"); color: Tok.ink; }
                                HorizontalLayout {
                                spacing: 6px;
                                Field {
                                    horizontal-stretch: 1;
                                    text <=> root.workspace-clone-destination;
                                    focus-lost => { root.workspace-clone-destination-check(); }
                                    edited => { root.workspace-clone-destination-error = ""; }
                                    enabled: !root.workspace-cloning;
                                    accepted => { root.question-answered(0); }
                                    escaped => { root.question-answered(root.question-choices.length - 1); }
                                }
                                TextButton { title: @tr("Browse…"); enabled: !root.workspace-cloning; clicked => { root.workspace-clone-browse(); } }
                                }
                                if root.workspace-clone-destination-error != "": Text {
                                    text: root.workspace-clone-destination-error; color: Tok.alert; wrap: word-wrap; font-size: 12px;
                                }
                            }

                            // **One to a line, in the order Rust names them**:
                            // the first does the thing, the last changes
                            // nothing and is what Esc answers with (要件 8.4).
                            //
                            // A row was tried and does not fit. 「作業コピーを
                            // 残して閉じる」 is twelve characters, and four
                            // answers like it are wider than any card that fits
                            // on screen — and a layout that runs out of room
                            // draws over what is beside it rather than wrapping
                            // (6.23). A column fits whatever the words are, in
                            // any language.
                            VerticalLayout {
                                spacing: 8px;

                                for choice[index] in root.question-choices: TextButton {
                                    enabled: !root.question-is-clone || !root.workspace-cloning || index != 0;
                                    title: choice;
                                    wide: true;
                                    role: index == 0
                                        ? Role.primary
                                        : (index == root.question-danger
                                            ? Role.danger
                                            : (index == root.question-choices.length - 1
                                                ? Role.quiet
                                                : Role.normal));
                                    clicked => {
                                        root.question-answered(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // C5: 「その他の色」。問いと同じく窓の一番上に重ねる。
    if root.colour-mixer-open: ColourMixer {
        current: root.colour-mixer-current;
        hue <=> root.colour-mixer-hue;
        saturation <=> root.colour-mixer-saturation;
        value <=> root.colour-mixer-value;
        hex-of(colour) => { return root.colour-hex-of(colour); }
        hex-typed(text) => { root.colour-hex-typed(text); }
        channel-typed(channel, text) => { root.colour-channel-typed(channel, text); }
        accepted(colour) => {
            root.colour-mixer-open = false;
            root.colour-mixer-accepted(colour);
            root.focus-generation += 1;
        }
        cancelled => {
            root.colour-mixer-open = false;
            root.focus-generation += 1;
        }
    }

    // 編集画面はそのまま下に残す（比較と同じ作法）。
    if root.print-active: Rectangle {
        background: Tok.chrome-sunken;
        TouchArea { }
        PrintView {
            width: parent.width;
            height: parent.height;
            title: root.print-title;
            sheets: root.print-sheets;
            sheet-width: root.print-sheet-width * 1px;
            zoom: root.print-zoom;
            pan-x <=> root.print-pan-x;
            pan-y <=> root.print-pan-y;
            vertical: root.print-vertical;
            room-changed(wide, tall) => { root.print-room-changed(wide, tall); }
            zoomed(by) => { root.print-zoomed(by); }
            head: root.print-head;
            foot: root.print-foot;
            trim-written(head, at, said) => { root.print-trim-written(head, at, said); }
            aspect: root.print-aspect;
            at: root.print-at;
            pages: root.print-pages;
            status: root.print-status;
            paper-note: root.print-paper-note;
            size: root.print-size;
            size-stepped(by) => { root.print-size-stepped(by); }
            size-from-screen => { root.print-size-from-screen(); }
            paper-pressed => { root.print-paper-pressed(); }
            working: root.print-working;
            turned(to) => { root.print-turned(to); }
            margin-stepped(by) => { root.print-margin-stepped(by); }
            print-requested => { root.print-requested(); }
            dismissed => { root.print-dismissed(); }
        }
    }

    // Keep all original panes and their view state underneath the comparison.
    if root.diff-active: Rectangle {
        background: Tok.paper;
        TouchArea { }
        DiffView {
            width: parent.width;
            height: parent.height;
            rows: root.diff-rows;
            left-path: root.diff-left-path;
            right-path: root.diff-right-path;
            status <=> root.diff-status;
            selected-row <=> root.diff-selected-row;
            content-width: root.diff-content-width;
            can-previous: root.diff-can-previous;
            can-next: root.diff-can-next;
            next-difference(forward) => { root.diff-next-difference(forward); }
            select-difference(row) => { root.diff-select-difference(row); }
            copy-side(right) => { root.diff-copy-side(right); }
            dismissed => { root.diff-dismissed(); }
            merge-enabled: root.diff-merge-enabled;
            can-apply: root.diff-can-apply;
            choose-side(right) => { root.diff-choose-side(right); }
            apply-merge => { root.diff-apply-merge(); }
        }
    }

    property <int> outline-menu-row: -1;
    property <length> outline-menu-x;
    property <length> outline-menu-y;
    outline-context-menu := PopupWindow {
        x: root.outline-menu-x;
        y: root.outline-menu-y;
        width: 200px;
        close-policy: close-on-click-outside;

        MenuFrame {
            width: 200px;

            VerticalLayout {
                padding: 6px;
                spacing: 1px;

                MenuRow {
                    title: @tr("Add Bookmark…");
                    activated => {
                        outline-context-menu.close();
                        root.outline-bookmark-requested(root.outline-menu-row);
                    }
                }
            }
        }
    }

    tree-context-menu := PopupWindow {
        x: root.tree-menu-x;
        y: root.tree-menu-y;
        width: 230px;
        close-policy: close-on-click-outside;

        MenuFrame {
            width: 230px;

            VerticalLayout {
                padding: 6px;
                spacing: 1px;

                if root.left-tab == 4: VerticalLayout {
                    spacing: 1px;
                    Text { text: @tr("Workspace"); color: Tok.ink-muted; font-size: 11px; }
                    MenuRow { title: @tr("Add Folder…"); activated => { root.workspace-tree-command(0); root.close-tree-menu(); } }
                    MenuRow { title: @tr("Clone Repository…"); enabled: !root.workspace-cloning; activated => { root.workspace-tree-command(1); root.close-tree-menu(); } }
                    if root.workspace-context-folder: MenuRow { title: root.workspace-context-auto ? "AutoSave ON" : "AutoSave OFF"; checked: root.workspace-context-auto; activated => { root.workspace-tree-command(2); root.close-tree-menu(); } }
                    if root.workspace-context-folder: MenuRow { title: @tr("Detach Workspace Folder…"); activated => { root.workspace-tree-command(3); root.close-tree-menu(); } }
                    if root.workspace-context-folder: MenuRow { title: @tr("Move Up"); activated => { root.workspace-tree-command(5); root.close-tree-menu(); } }
                    if root.workspace-context-folder: MenuRow { title: @tr("Move Down"); activated => { root.workspace-tree-command(6); root.close-tree-menu(); } }
                    MenuRow { title: @tr("Reset View…"); activated => { root.workspace-tree-command(4); root.close-tree-menu(); } }
                    MenuSep { }
                }
                MenuRow {
                    enabled: root.tree-selected >= 0;
                    title: @tr("New File…");
                    activated => {
                        root.close-tree-menu();
                        root.tree-command(0);
                    }
                }
                MenuRow {
                    enabled: root.tree-selected >= 0;
                    title: @tr("New Folder…");
                    activated => {
                        root.close-tree-menu();
                        root.tree-command(1);
                    }
                }
                MenuSep { }
                MenuRow {
                    enabled: root.tree-selected >= 0 && !root.left-rows[root.tree-selected].is-root;
                    title: @tr("Rename…");
                    activated => {
                        root.close-tree-menu();
                        root.tree-command(2);
                    }
                }
                MenuRow {
                    enabled: root.tree-selected >= 0 && !root.left-rows[root.tree-selected].is-root;
                    title: @tr("Duplicate");
                    activated => {
                        root.close-tree-menu();
                        root.tree-command(3);
                        root.focus-generation += 1;
                    }
                }
                MenuRow {
                    enabled: root.tree-selected >= 0;
                    title: @tr("Terminal in This Folder");
                    activated => { root.tree-command(7); root.close-tree-menu(); }
                }
                MenuRow {
                    enabled: root.tree-selected >= 0;
                    title: @tr("Reveal in Explorer");
                    activated => {
                        root.close-tree-menu();
                        root.tree-command(5);
                        root.focus-generation += 1;
                    }
                }
                MenuSep { }
                // 要件 7.7（2026-09-07追加）: 見えて
                // いるフォルダを指して絞る。
                MenuRow {
                    enabled: root.tree-selected >= 0;
                    title: @tr("Search in This Folder");
                    activated => {
                        root.close-tree-menu();
                        root.tree-command(6);
                    }
                }
                MenuSep { }
                MenuRow {
                    enabled: root.tree-selected >= 0 && !root.left-rows[root.tree-selected].is-root;
                    title: @tr("Delete…");
                    activated => {
                        root.close-tree-menu();
                        root.tree-command(4);
                    }
                }
            }
        }
    }


    if root.appearance-open: Rectangle {
        background: #0005;
        TouchArea { }
        Rectangle {
            width: min(root.width - 40px, 620px); height: 340px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Tok.chrome;
            VerticalLayout {
                padding: 16px; spacing: 8px; alignment: start;
                Text { text: root.appearance-title; color: Tok.ink; height: 28px; vertical-stretch: 0; }
                PanelStyleEditor { font-list-requested => { root.font-list-requested(); } font-names: root.font-names; style <=> root.appearance-style; defaults: root.appearance-default; underline-allowed: root.appearance-underline-allowed; }
                HorizontalLayout {
                    TextButton { title: @tr("Default"); clicked => { root.appearance-reset(); } }
                    Rectangle { horizontal-stretch: 1; }
                    TextButton { title: @tr("Apply"); clicked => { root.appearance-applied(); } }
                    TextButton { title: @tr("Cancel"); clicked => { root.appearance-open = false; } }
                }
            }
        }
    }

}
