import { ScrollView } from "std-widgets.slint";
import { Field, Icon, IconButton, Icons, TextButton } from "controls.slint";
import { Tok } from "tokens.slint";

export struct GitCatalogRow {
    name: string,
    path: string,
    path-label: string,
    branch: string,
    workspaces: string,
    switch-workspace: bool,
    openable: bool,
    error: string,
    current: bool,
}

export component GitCatalogView inherits Rectangle {
    in property <[GitCatalogRow]> rows;
    in property <int> focus-generation;
    in property <bool> scanning;
    in property <bool> workspace-active;
    in property <bool> tooltip-enabled;
    in property <string> note;
    in-out property <int> selected: -1;
    in-out property <string> filter;
    in-out property <bool> current-only;
    callback filter-changed();
    callback action(string);
    pure callback allowed(string) -> bool;
    pure callback action-title(string) -> string;
    callback shortcut(KeyEvent) -> EventResult;

    private property <length> row-height: 64px;
    changed focus-generation => { search.take-focus(); }
    changed selected => {
        if root.selected >= 0 && (root.selected * root.row-height < -list.content-y
            || (root.selected + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = -min(root.selected * root.row-height, max(0px, list.content-height - list.visible-height));
        }
    }

    function open-selected() {
        if root.allowed("git.repository-open") { root.action("git.repository-open"); }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            height: 22px;
            Text {
                text: @tr("Repositories");
                color: Tok.ink-muted;
                font-size: 11px;
                font-weight: 650;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            IconButton {
                size: 22px;
                icon: "M13.5 6a5.7 5.7 0 1 0 .1 4M13.5 2.5V6h-3.5";
                tip: root.action-title("git.repositories-refresh");
                enabled: !root.scanning && root.allowed("git.repositories-refresh");
                clicked => { root.action("git.repositories-refresh"); }
            }
            IconButton {
                size: 22px;
                icon: Icons.close;
                tip: root.action-title("git.repositories-close");
                clicked => { root.action("git.repositories-close"); }
            }
        }
        VerticalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 4px;
                search := Field {
                    height: 28px;
                    horizontal-stretch: 1;
                    text <=> root.filter;
                    placeholder: @tr("Filter repositories");
                    init => { self.take-focus(); }
                    edited => { root.filter-changed(); }
                    accepted => { root.open-selected(); }
                    escaped => { root.action("git.repositories-close"); }
                    shortcut(event) => {
                        if root.rows.length > 0 && (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                            root.selected = clamp(root.selected + (event.text == Key.UpArrow ? -1 : 1), 0, root.rows.length - 1);
                            return accept;
                        }
                        return root.shortcut(event);
                    }
                }
                if root.workspace-active: IconButton {
                    size: 28px;
                    icon: Icons.filter;
                    checked: root.current-only;
                    tip: root.current-only ? @tr("All Workspaces") : @tr("Current Workspace");
                    clicked => {
                        root.current-only = !root.current-only;
                        root.filter-changed();
                        search.take-focus();
                    }
                }
            }
            if root.note != "" || root.scanning || root.rows.length == 0: Text {
                text: root.note != "" ? root.note : root.scanning ? @tr("Reading registered folders…")
                    : root.filter != "" ? @tr("No matching repositories.")
                    : @tr("No Git repositories in the registered folders.");
                color: Tok.ink-muted;
                wrap: word-wrap;
                font-size: 12px;
            }
            list := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                VerticalLayout {
                    width: parent.visible-width;
                    alignment: start;
                    for row[index] in root.rows: Rectangle {
                        height: root.row-height;
                        Rectangle {
                            y: 2px;
                            height: parent.height - 4px;
                            border-radius: 6px;
                            background: root.selected == index ? Tok.accent-soft
                                : (hit.has-hover ? Tok.accent-faint : Tok.chrome-raised);
                        }
                        VerticalLayout {
                            x: 0px;
                            width: parent.width - (row.openable ? 28px : 0px);
                            padding: 7px;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 5px;
                                Text {
                                    text: row.name;
                                    font-size: 13px;
                                    font-weight: 650;
                                    color: Tok.ink-strong;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if row.branch != "": Text {
                                    text: row.branch;
                                    max-width: root.width * 0.35;
                                    color: Tok.ink-muted;
                                    overflow: elide;
                                    font-size: 11px;
                                }
                                if row.current || row.switch-workspace || row.error != "": Rectangle {
                                    width: 16px;
                                    Icon {
                                        commands: row.error != "" ? Icons.warning : row.switch-workspace ? Icons.right : Icons.git;
                                        tint: row.error != "" ? Tok.alert : Tok.accent;
                                    }
                                }
                            }
                            Text {
                                text: row.workspaces;
                                font-size: 11px;
                                color: row.switch-workspace ? Tok.accent-strong : Tok.ink;
                                overflow: elide;
                            }
                            Text { text: row.path-label; font-size: 10px; color: Tok.ink-muted; overflow: elide; }
                        }
                        hit := TouchArea {
                            mouse-cursor: row.openable ? pointer : default;
                            clicked => {
                                root.selected = index;
                                search.take-focus();
                                root.open-selected();
                            }
                        }
                        if root.tooltip-enabled: Tooltip {
                            text: @markdown("\{row.path}\n\n\{row.workspaces}");
                        }
                        if row.openable: IconButton {
                            x: parent.width - self.width - 5px;
                            y: 6px;
                            size: 22px;
                            icon: "M8 2a6 6 0 1 0 0 12 6 6 0 1 0 0-12M5 8h6";
                            tip: root.tooltip-enabled ? root.action-title("git.repository-unregister") : "";
                            clicked => {
                                root.selected = index;
                                if root.allowed("git.repository-unregister") { root.action("git.repository-unregister"); }
                            }
                        }
                    }
                }
            }
            if root.selected >= 0 && root.rows[root.selected].error != "": Text {
                text: root.rows[root.selected].error;
                color: Tok.alert;
                wrap: word-wrap;
                font-size: 12px;
            }
            if root.selected >= 0 && !root.rows[root.selected].openable: TextButton {
                wide: true;
                title: root.action-title("git.repository-unregister");
                enabled: root.selected >= 0 && root.allowed("git.repository-unregister");
                clicked => { root.action("git.repository-unregister"); }
            }
        }
    }
}
