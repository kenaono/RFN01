// 要件 7.10: 紙の形で見る——印刷プレビュー。
//
// **プリンタは刷る前に何も見せない。**この面が無ければ、用紙と余白が合っているかを
// 刷ってから知ることになる。ここに映る1枚と、プリンタへ送る1枚は、同じ処理が描いた
// 同じ絵である（`directwrite_render::print::draw_page_onto`）。
import { Tok } from "tokens.slint";
import { Field, Role, TextButton } from "controls.slint";

export component PrintView inherits Rectangle {
    background: Tok.chrome-sunken;
    in property <string> title;
    /// いま映っている紙たち。**何枚出すかは拡大が決める**（書き手の求め
    /// 2026-09-17）——縮めれば並ぶ枚数が増える。縦書きは右から読むので、行の中は
    /// 右から左へ置く。
    in property <[image]> sheets;
    /// 紙1枚の幅。**組む側（Rust）が決める**——並ぶ枚数も向きもここから出る。
    in property <length> sheet-width: 100px;
    in property <bool> vertical;
    /// 拡大の百分率。Ctrl+ホイールで動く。
    in property <int> zoom: 100;
    /// 掴んで寄せた量。**はみ出したときだけ効く**（書き手の決定 2026-09-17：
    /// 拡大して大きく見たいことがある）。
    in-out property <float> pan-x;
    in-out property <float> pan-y;
    /// 天と地に入れる字、左・中・右。
    in property <[string]> head;
    in property <[string]> foot;
    /// 紙の縦横比（幅÷高さ）。**絵から測らない**——絵の大きさから紙の大きさを
    /// 決め、紙の大きさが絵の大きさを決める、という輪になる。
    in property <float> aspect: 0.707;
    in property <int> at;
    in property <int> pages;
    in property <string> status;
    /// 紙の姿を一行で：大きさ、余白、そして**何字詰めの何行**か。
    in property <string> paper-note;
    /// 紙の本文の大きさ、10分の1ポイント。**0なら画面の設定のまま**（任意の設定、
    /// 書き手の決定 2026-09-16：「Optionalで、印刷用のフォントサイズ指定が出来るのが
    /// いい」）。字体・色・倍率は画面の設定がそのまま行く。
    in property <int> size;
    in property <bool> working;
    callback turned(int);
    /// 余白を1段（5mm）ずつ。**紙の行の長さはここで決まる**——行の長さは紙から
    /// 余白を引いたぶんで、そこへ字体と大きさで組ませる（書き手の指摘 2026-09-16：
    /// 「フォントとサイズを設定して、組版するのが正しいのではないですか」）。
    callback margin-stepped(int);
    /// 本文の大きさを0.5ptずつ。
    callback size-stepped(int);
    /// 画面の設定のままへ戻す。
    callback size-from-screen();
    /// 用紙の大きさと向きを、Windowsのプリンタ設定画面で決める。
    callback paper-pressed();
    /// 天地の字を書く窓が開いているか。
    in-out property <bool> editing-trim: false;
    /// いま触っている欄（天の左が0、地の右が5）。−1はどれでもない。
    in-out property <int> slot: -1;
    /// いま並んでいる枚数。頭の帯と繰り幅がこれに従う。
    out property <int> shown: max(1, root.sheets.length);
    /// 紙を置く場所の広さが変わったことを知らせる（拡大と枚数はそこから決まる）。
    callback room-changed(length, length);
    /// Ctrl+ホイールの拡大。
    callback zoomed(int);
    /// 天（真）か地（偽）の、左0・中1・右2に、この字を入れる。
    callback trim-written(bool, int, string);
    callback print-requested();
    callback dismissed();

    // 面の中を触った音が下の編集画面へ抜けないように。そして**ホイールで紙を繰る**
    // （書き手の求め 2026-09-16）——下へ回せば次の紙。紙の上でも余白の上でも効く。
    TouchArea {
        scroll-event(event) => {
            // **Ctrlを押していれば拡大**（書き手の求め 2026-09-17）。編集画面の
            // Ctrl+ホイールと同じ手つきである。
            if (event.modifiers.control) {
                root.zoomed(event.delta-y > 0 || event.delta-x > 0 ? 1 : -1);
                return accept;
            }
            if (event.delta-y < 0 || event.delta-x < 0) {
                root.turned(root.at + root.shown);
            } else if (event.delta-y > 0 || event.delta-x > 0) {
                root.turned(root.at - root.shown);
            }
            return accept;
        }
    }

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismissed(); }
            // 紙を繰るのは矢印でもできる。**紙の向きに関わらず、左が前・右が次**
            // ——繰っているのは紙であって、本文ではない。
            if event.text == Key.LeftArrow { root.turned(root.at - root.shown); }
            if event.text == Key.RightArrow { root.turned(root.at + root.shown); }
            if event.text == Key.PageUp { root.turned(root.at - root.shown); }
            if event.text == Key.PageDown { root.turned(root.at + root.shown); }
            if event.text == Key.Home { root.turned(0); }
            if event.text == Key.End { root.turned(root.pages - 1); }
            return accept;
        }
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 44px;
            background: Tok.chrome;
            HorizontalLayout {
                padding: 7px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: @tr("Print");
                    color: Tok.ink-strong;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.title;
                    color: Tok.ink-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                TextButton {
                    title: "‹";
                    enabled: root.at > 0 && !root.working;
                    clicked => { root.turned(root.at - root.shown); }
                }
                Text {
                    // 何枚目か。**1から数える**——紙を数えるのは人である。
                    // 見開きなら2枚とも言う。
                    text: root.shown > 1
                        ? "\{root.at + 1}–\{min(root.at + root.shown, root.pages)} / \{root.pages}"
                        : "\{root.at + 1} / \{root.pages}";
                    color: Tok.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    min-width: 64px;
                }
                TextButton {
                    title: "›";
                    enabled: root.at + root.shown < root.pages && !root.working;
                    clicked => { root.turned(root.at + root.shown); }
                }
                TextButton {
                    title: @tr("Print…");
                    role: Role.primary;
                    enabled: root.pages > 0 && !root.working;
                    clicked => { root.print-requested(); }
                }
                TextButton {
                    title: @tr("Close");
                    clicked => { root.dismissed(); }
                }
            }
        }

        paper-room := Rectangle {
            background: Tok.chrome-sunken;
            changed width => { root.room-changed(self.width, self.height); }
            changed height => { root.room-changed(self.width, self.height); }
            init => { root.room-changed(self.width, self.height); }

            property <length> sheet-height: root.sheet-width / max(0.01, root.aspect);
            // はみ出したぶんだけ寄せられる。**収まっているあいだは動かない。**
            property <length> loose-x: max(0px, root.sheet-width - self.width + 48px) / 2;
            property <length> loose-y: max(0px, self.sheet-height - self.height + 48px) / 2;

            // **掴んで動かす**（書き手の決定 2026-09-17）。拡大して紙が場所から
            // はみ出したときだけ効く——収まっていれば掴んでも動かない。
            hand := TouchArea {
                property <length> from-x;
                property <length> from-y;
                mouse-cursor: parent.loose-x > 0px || parent.loose-y > 0px
                    ? MouseCursor.grab : MouseCursor.default;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.from-x = root.pan-x * 1px;
                        self.from-y = root.pan-y * 1px;
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.pan-x = clamp(
                            (self.from-x + self.mouse-x - self.pressed-x) / 1px,
                            -parent.loose-x / 1px, parent.loose-x / 1px);
                        root.pan-y = clamp(
                            (self.from-y + self.mouse-y - self.pressed-y) / 1px,
                            -parent.loose-y / 1px, parent.loose-y / 1px);
                    }
                }
            }

            for sheet[index] in root.sheets: Rectangle {
                // **並ぶ向きは本文の流れと同じ**（書き手の指摘 2026-09-17）
                // ——縦書きは右から左へ横に、横書きは上から下へ縦に。
                property <int> place: root.vertical
                    ? max(0, root.shown - 1) - index
                    : index;
                x: (root.vertical
                    ? (parent.width - (root.sheet-width + 16px) * root.shown + 16px) / 2
                        + (root.sheet-width + 16px) * self.place
                    : (parent.width - root.sheet-width) / 2) + root.pan-x * 1px;
                y: (root.vertical
                    ? (parent.height - parent.sheet-height) / 2
                    : (parent.height - (parent.sheet-height + 16px) * root.shown + 16px) / 2
                        + (parent.sheet-height + 16px) * self.place) + root.pan-y * 1px;
                width: root.sheet-width;
                height: parent.sheet-height;
                drop-shadow-blur: 12px;
                drop-shadow-color: Tok.scrim;
                background: Tok.paper;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: sheet;
                    image-fit: contain;
                }
            }
        }

        // 紙のことを言う帯。**余白はここで変える**——行の長さは紙から余白を引いた
        // ぶんで、字数はその結果の目安である（1行に何字入るかは一意に決まらない）。
        Rectangle {
            height: 34px;
            background: Tok.chrome;
            HorizontalLayout {
                padding: 4px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: start;
                // 紙の本文の大きさ。**画面の設定のままが既定**で、押せば紙だけの
                // 大きさを持てる（書き手の決定 2026-09-16）。字体・色・倍率は
                // 画面の設定がそのまま行くので、動かすのはこの1つで足りる。
                Text {
                    text: @tr("Text size");
                    color: Tok.ink-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                TextButton {
                    title: "−";
                    enabled: !root.working;
                    clicked => { root.size-stepped(-1); }
                }
                TextButton {
                    title: root.size == 0
                        ? @tr("as on screen")
                        : "\{floor(root.size / 10)}.\{mod(root.size, 10)}pt";
                    enabled: !root.working && root.size != 0;
                    clicked => { root.size-from-screen(); }
                }
                TextButton {
                    title: "+";
                    enabled: !root.working;
                    clicked => { root.size-stepped(1); }
                }
                Rectangle { width: 8px; }
                // **天地の余白に入れる字**（書き手の求め 2026-09-17）。決まった
                // ものを選ばせるのではなく、書ける窓を開く——1か所に1つしか
                // 入れられないのでは、「第一稿　3 / 17」が書けない。
                TextButton {
                    title: @tr("Head and Foot…");
                    enabled: !root.working;
                    clicked => { root.editing-trim = true; }
                }
                Rectangle { width: 8px; }
                // **用紙の大きさと向きはWindowsが持っている**（書き手の問い
                // 2026-09-16：「A4などとLandscapeの設定がどこで反映されるか
                // わかりません」）。この編集器に用紙の一覧は持たない。
                TextButton {
                    title: @tr("Paper…");
                    enabled: !root.working;
                    clicked => { root.paper-pressed(); }
                }
                Text {
                    text: @tr("Margin");
                    color: Tok.ink-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                TextButton {
                    title: "−";
                    enabled: !root.working;
                    clicked => { root.margin-stepped(-1); }
                }
                TextButton {
                    title: "+";
                    enabled: !root.working;
                    clicked => { root.margin-stepped(1); }
                }
                Text {
                    text: root.paper-note;
                    color: Tok.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    // 帯が狭いときは後ろから省く（数は前のほうが大事である）。
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.status;
                    color: Tok.ink-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    // 天地の字を書く窓（書き手の求め 2026-09-17）。**6つの欄に自由に書く**ので、
    // 「第一稿　3 / 17」のように並べられる。決まった字は押して差し込む。
    if root.editing-trim: Rectangle {
        background: Tok.scrim;
        TouchArea { clicked => { root.editing-trim = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 48px);
            height: card.preferred-height;
            background: Tok.chrome;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tok.rule;
            drop-shadow-blur: 24px;
            drop-shadow-color: Tok.scrim;
            TouchArea { }
            card := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: @tr("Head and Foot");
                    color: Tok.ink-strong;
                    font-size: 14px;
                    font-weight: 700;
                }
                Text {
                    text: @tr("Pick a box, then add what you want in it.");
                    color: Tok.ink-muted;
                    font-size: 12px;
                }
                // 差し込める決まった字。**いま触っている欄の末尾へ足す。**
                //
                // **入れるのは合言葉であって、押した字ではない**（書き手の報告
                // 2026-09-17：「{Page}/{Total}の表示がうまく設定できません」）。
                // 押す字は人が読むためのもので、画面の言葉によって変わる——それを
                // そのまま入れると、通らない合言葉が入っていた。合言葉は一組だけ。
                // 差し込みは**欄と組む側の両方へ書く**。打ち始めた欄は外からの
                // 束縛が切れているので、組む側へ書くだけでは欄の字が増えない
                // （書き手の報告 2026-09-17：「設定画面は変化しませんが、
                // プレビューでは追加されていたりします」）。
                inserter := Rectangle {
                    height: 0px;
                    function put(word: string) {
                        if (root.slot == 0) {
                            head-left.text += word;
                            root.trim-written(true, 0, head-left.text);
                        } else if (root.slot == 1) {
                            head-middle.text += word;
                            root.trim-written(true, 1, head-middle.text);
                        } else if (root.slot == 2) {
                            head-right.text += word;
                            root.trim-written(true, 2, head-right.text);
                        } else if (root.slot == 3) {
                            foot-left.text += word;
                            root.trim-written(false, 0, foot-left.text);
                        } else if (root.slot == 4) {
                            foot-middle.text += word;
                            root.trim-written(false, 1, foot-middle.text);
                        } else if (root.slot == 5) {
                            foot-right.text += word;
                            root.trim-written(false, 2, foot-right.text);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    TextButton {
                        title: @tr("File name");
                        enabled: root.slot >= 0;
                        clicked => { inserter.put("{name}"); }
                    }
                    TextButton {
                        title: @tr("Date");
                        enabled: root.slot >= 0;
                        clicked => { inserter.put("{date}"); }
                    }
                    TextButton {
                        title: @tr("Page");
                        enabled: root.slot >= 0;
                        clicked => { inserter.put("{page}"); }
                    }
                    TextButton {
                        title: @tr("Total");
                        enabled: root.slot >= 0;
                        clicked => { inserter.put("{pages}"); }
                    }
                }
                // **6つの欄を名前で置く**（並べて作らない）。打ち始めると欄の字は
                // こちらのものになり、外からの束縛は切れる——差し込む側が名指しで
                // 書き足せるように、一つずつ置いてある。
                Text {
                    text: @tr("Head");
                    color: Tok.ink-muted;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Left"); color: Tok.ink-faint; font-size: 11px; }
                        head-left := Field {
                            text: root.head[0];
                            changed has-focus => { if (head-left.has-focus) { root.slot = 0; } }
                            edited => { root.trim-written(true, 0, head-left.text); }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Centre"); color: Tok.ink-faint; font-size: 11px; }
                        head-middle := Field {
                            text: root.head[1];
                            changed has-focus => { if (head-middle.has-focus) { root.slot = 1; } }
                            edited => { root.trim-written(true, 1, head-middle.text); }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Right"); color: Tok.ink-faint; font-size: 11px; }
                        head-right := Field {
                            text: root.head[2];
                            changed has-focus => { if (head-right.has-focus) { root.slot = 2; } }
                            edited => { root.trim-written(true, 2, head-right.text); }
                        }
                    }
                }
                Text {
                    text: @tr("Foot");
                    color: Tok.ink-muted;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Left"); color: Tok.ink-faint; font-size: 11px; }
                        foot-left := Field {
                            text: root.foot[0];
                            changed has-focus => { if (foot-left.has-focus) { root.slot = 3; } }
                            edited => { root.trim-written(false, 0, foot-left.text); }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Centre"); color: Tok.ink-faint; font-size: 11px; }
                        foot-middle := Field {
                            text: root.foot[1];
                            changed has-focus => { if (foot-middle.has-focus) { root.slot = 4; } }
                            edited => { root.trim-written(false, 1, foot-middle.text); }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Right"); color: Tok.ink-faint; font-size: 11px; }
                        foot-right := Field {
                            text: root.foot[2];
                            changed has-focus => { if (foot-right.has-focus) { root.slot = 5; } }
                            edited => { root.trim-written(false, 2, foot-right.text); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    TextButton {
                        title: @tr("Close");
                        clicked => { root.editing-trim = false; }
                    }
                }
            }
        }
    }
}
