// 要件 7.10: 紙の形で見る——印刷プレビュー。
//
// **プリンタは刷る前に何も見せない。**この面が無ければ、用紙と余白が合っているかを
// 刷ってから知ることになる。ここに映る1枚と、プリンタへ送る1枚は、同じ処理が描いた
// 同じ絵である（`directwrite_render::print::draw_page_onto`）。
import { Tok } from "tokens.slint";
import { Role, TextButton } from "controls.slint";

export component PrintView inherits Rectangle {
    background: Tok.chrome-sunken;
    in property <string> title;
    in property <image> page;
    /// 次の紙。**窓が広ければ2枚並べる**（見開き）。縦書きは右から読むので、
    /// 次の紙は左に置く。
    in property <image> next-page;
    in property <bool> vertical;
    /// 紙の縦横比（幅÷高さ）。**絵から測らない**——絵の大きさから紙の大きさを
    /// 決め、紙の大きさが絵の大きさを決める、という輪になる。
    in property <float> aspect: 0.707;
    in property <int> at;
    in property <int> pages;
    in property <string> status;
    /// 紙の姿を一行で：大きさ、余白、そして**何字詰めの何行**か。
    in property <string> paper-note;
    /// 紙の本文の大きさ、10分の1ポイント。**0なら画面の設定のまま**（任意の設定、
    /// 書き手の決定 2026-09-16：「Optionalで、印刷用のフォントサイズ指定が出来るのが
    /// いい」）。字体・色・倍率は画面の設定がそのまま行く。
    in property <int> size;
    in property <bool> working;
    callback turned(int);
    /// 余白を1段（5mm）ずつ。**紙の行の長さはここで決まる**——行の長さは紙から
    /// 余白を引いたぶんで、そこへ字体と大きさで組ませる（書き手の指摘 2026-09-16：
    /// 「フォントとサイズを設定して、組版するのが正しいのではないですか」）。
    callback margin-stepped(int);
    /// 本文の大きさを0.5ptずつ。
    callback size-stepped(int);
    /// 画面の設定のままへ戻す。
    callback size-from-screen();
    /// 用紙の大きさと向きを、Windowsのプリンタ設定画面で決める。
    callback paper-pressed();
    /// 2枚並んでいるか。紙を置く側が決め、頭の帯と繰り幅がそれに従う。
    out property <bool> spread: sheets.spread;
    callback print-requested();
    callback dismissed();

    // 面の中を触った音が下の編集画面へ抜けないように。そして**ホイールで紙を繰る**
    // （書き手の求め 2026-09-16）——下へ回せば次の紙。紙の上でも余白の上でも効く。
    TouchArea {
        scroll-event(event) => {
            if (event.delta-y < 0 || event.delta-x < 0) {
                root.turned(root.at + (root.spread ? 2 : 1));
            } else if (event.delta-y > 0 || event.delta-x > 0) {
                root.turned(root.at - (root.spread ? 2 : 1));
            }
            return accept;
        }
    }

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismissed(); }
            // 紙を繰るのは矢印でもできる。**紙の向きに関わらず、左が前・右が次**
            // ——繰っているのは紙であって、本文ではない。
            if event.text == Key.LeftArrow { root.turned(root.at - 1); }
            if event.text == Key.RightArrow { root.turned(root.at + 1); }
            if event.text == Key.PageUp { root.turned(root.at - 1); }
            if event.text == Key.PageDown { root.turned(root.at + 1); }
            if event.text == Key.Home { root.turned(0); }
            if event.text == Key.End { root.turned(root.pages - 1); }
            return accept;
        }
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 44px;
            background: Tok.chrome;
            HorizontalLayout {
                padding: 7px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: @tr("Print");
                    color: Tok.ink-strong;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.title;
                    color: Tok.ink-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                TextButton {
                    title: "‹";
                    enabled: root.at > 0 && !root.working;
                    clicked => { root.turned(root.at - (root.spread ? 2 : 1)); }
                }
                Text {
                    // 何枚目か。**1から数える**——紙を数えるのは人である。
                    // 見開きなら2枚とも言う。
                    text: root.spread
                        ? "\{root.at + 1}–\{root.at + 2} / \{root.pages}"
                        : "\{root.at + 1} / \{root.pages}";
                    color: Tok.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    min-width: 64px;
                }
                TextButton {
                    title: "›";
                    enabled: root.at + (root.spread ? 2 : 1) < root.pages && !root.working;
                    clicked => { root.turned(root.at + (root.spread ? 2 : 1)); }
                }
                TextButton {
                    title: @tr("Print…");
                    role: Role.primary;
                    enabled: root.pages > 0 && !root.working;
                    clicked => { root.print-requested(); }
                }
                TextButton {
                    title: @tr("Close");
                    clicked => { root.dismissed(); }
                }
            }
        }

        sheets := Rectangle {
            background: Tok.chrome-sunken;
            // **2枚入るなら2枚見せる**（書き手の求め 2026-09-16）。紙1枚ぶんの幅を
            // 二つ並べて余白が残るかどうかで決める——数を選ばせない。
            // **窓の寸法から決める**（自分が測られた大きさからではなく）。頭の帯が
            // 何枚目かを言い、その字の幅が並びを決め、並びが高さを決め……と輪になる。
            // 帯の高さは決め打ちなので、窓から引けばよい。
            property <length> room: root.height - 44px - 34px;
            property <bool> spread: root.at + 1 < root.pages
                && root.width > (self.room - 48px) * root.aspect * 2 + 72px;
            property <length> sheet-width: self.spread
                ? min((root.width - 72px) / 2, (self.room - 48px) * root.aspect)
                : min(root.width - 48px, (self.room - 48px) * root.aspect);

            // 1枚のとき、2枚のとき。**置き方が違うだけで、同じ絵を出す。**
            if !self.spread: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.sheet-width;
                height: self.width / max(0.01, root.aspect);
                drop-shadow-blur: 12px;
                drop-shadow-color: Tok.scrim;
                background: Tok.paper;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.page;
                    image-fit: contain;
                }
            }
            if self.spread: Rectangle {
                x: root.vertical
                    ? parent.width / 2 + 12px
                    : parent.width / 2 - 12px - self.width;
                y: (parent.height - self.height) / 2;
                width: parent.sheet-width;
                height: self.width / max(0.01, root.aspect);
                drop-shadow-blur: 12px;
                drop-shadow-color: Tok.scrim;
                background: Tok.paper;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.page;
                    image-fit: contain;
                }
            }
            if self.spread: Rectangle {
                x: root.vertical
                    ? parent.width / 2 - 12px - self.width
                    : parent.width / 2 + 12px;
                y: (parent.height - self.height) / 2;
                width: parent.sheet-width;
                height: self.width / max(0.01, root.aspect);
                drop-shadow-blur: 12px;
                drop-shadow-color: Tok.scrim;
                background: Tok.paper;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.next-page;
                    image-fit: contain;
                }
            }
        }

        // 紙のことを言う帯。**余白はここで変える**——行の長さは紙から余白を引いた
        // ぶんで、字数はその結果の目安である（1行に何字入るかは一意に決まらない）。
        Rectangle {
            height: 34px;
            background: Tok.chrome;
            HorizontalLayout {
                padding: 4px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: start;
                // 紙の本文の大きさ。**画面の設定のままが既定**で、押せば紙だけの
                // 大きさを持てる（書き手の決定 2026-09-16）。字体・色・倍率は
                // 画面の設定がそのまま行くので、動かすのはこの1つで足りる。
                Text {
                    text: @tr("Text size");
                    color: Tok.ink-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                TextButton {
                    title: "−";
                    enabled: !root.working;
                    clicked => { root.size-stepped(-1); }
                }
                TextButton {
                    title: root.size == 0
                        ? @tr("as on screen")
                        : "\{floor(root.size / 10)}.\{mod(root.size, 10)}pt";
                    enabled: !root.working && root.size != 0;
                    clicked => { root.size-from-screen(); }
                }
                TextButton {
                    title: "+";
                    enabled: !root.working;
                    clicked => { root.size-stepped(1); }
                }
                Rectangle { width: 8px; }
                // **用紙の大きさと向きはWindowsが持っている**（書き手の問い
                // 2026-09-16：「A4などとLandscapeの設定がどこで反映されるか
                // わかりません」）。この編集器に用紙の一覧は持たない。
                TextButton {
                    title: @tr("Paper…");
                    enabled: !root.working;
                    clicked => { root.paper-pressed(); }
                }
                Text {
                    text: @tr("Margin");
                    color: Tok.ink-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                TextButton {
                    title: "−";
                    enabled: !root.working;
                    clicked => { root.margin-stepped(-1); }
                }
                TextButton {
                    title: "+";
                    enabled: !root.working;
                    clicked => { root.margin-stepped(1); }
                }
                Text {
                    text: root.paper-note;
                    color: Tok.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.status;
                    color: Tok.ink-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
