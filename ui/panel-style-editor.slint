import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { PanelStyle } from "editor-pane.slint";
import { AppearanceCard, AppearanceFontRow, AppearanceLabel, ColorCell, Field, MenuFrame, MenuRow, TransparencyRow } from "controls.slint";
import { Tok } from "tokens.slint";

export component PanelStyleEditor inherits VerticalLayout {
    in-out property <PanelStyle> style;
    in property <[string]> font-names;
    callback font-list-requested();
    in property <string> heading;
    in property <bool> underline-allowed: true;
    in property <bool> defaults: false;
    spacing: 10px;
    vertical-stretch: 0;
    alignment: start;
    if root.heading != "": Text { text: root.heading; color: Tok.ink; height: 24px; vertical-stretch: 0; }
    AppearanceCard {
        HorizontalLayout {
            spacing: 12px;
            ColorCell {
                width: 100px;
                horizontal-stretch: 0;
                label: @tr("Background");
                shown: root.style.paper;
                chosen(colour) => { root.style.paper = colour; root.style.paper-own = true; }
                automatic => { root.style.paper-own = false; }
            }
            if root.defaults: Text { text: "Random"; color: Tok.ink-muted; vertical-alignment: center; }
            if root.defaults: ComboBox {
                width: 100px;
                horizontal-stretch: 0;
                model: [@tr("Off"), @tr("Light"), @tr("Dark")];
                current-index <=> root.style.random;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        TransparencyRow {
            value: root.style.transparency;
            changed-value(value) => { root.style.transparency = round(clamp(value, 0, 100)); }
        }
    }
    AppearanceCard {
        AppearanceFontRow {
            family: root.style.family;
            ink: root.style.ink;
            ink-chosen(colour) => { root.style.ink = colour; }
            chose-font => { root.font-list-requested(); font-menu.show(); }

            font-menu := PopupWindow {
                x: 80px; y: 30px; width: 320px; close-policy: close-on-click-outside;
                MenuFrame {
                    width: 320px;
                    VerticalLayout {
                        padding: 6px;
                        ScrollView {
                            height: 300px;
                            VerticalLayout {
                                alignment: start; padding: 6px; spacing: 1px;
                                for family in root.font-names: MenuRow {
                                    title: family; checked: family == root.style.family;
                                    activated => { root.style.family = family; font-menu.close(); }
                                }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            AppearanceLabel { text: @tr("Size"); }
            Field { width: 45px; text: root.style.size;
                accepted => { if self.text.is-float() { root.style.size = round(clamp(self.text.to-float(), 8, 72)); } }
                focus-lost => { if self.text.is-float() { root.style.size = round(clamp(self.text.to-float(), 8, 72)); } }
            }
            Text { text: "px"; color: Tok.ink-muted; vertical-alignment: center; }
            CheckBox { text: @tr("Bold"); checked <=> root.style.bold; }
            CheckBox { text: @tr("Italic"); checked <=> root.style.italic; }
            if root.underline-allowed: CheckBox { text: @tr("Underline"); checked <=> root.style.underline; }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
