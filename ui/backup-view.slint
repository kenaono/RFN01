// RFN01-61（書き手と決めた 2026-09-27）: 自動バックアップの2つの画面。
//
// - Backup History：比較の画面の左に、そのファイルのバックアップの一覧を置く。**行を押すと
//   比較の相手が替わり、チェックは消す対象を選ぶ**——2つの役割を1つの操作に重ねない。
//   頭に「All」を置き、開いた直後はどれもチェックしない。チェックが無いあいだ消せない。
// - Backups（左ペイン）：バックアップの管理はここへ集める（書き手の求め 2026-09-27）。
//   Auto Recovery の On/Off、フォルダごとの AutoBackup の ON/OFF、バックアップのある
//   ファイルと件数。ファイルを押すと Backup History、右クリックで消す。

import { ScrollView } from "std-widgets.slint";
import { Tok } from "tokens.slint";
import { Icon, Icons, MenuFrame, MenuRow, Role, TextButton } from "controls.slint";

export struct BackupRow {
    // 一覧の文字：History は日時、Delete Backups… はフォルダのパス。
    label: string,
    // 右に添える小さい文字：History は本文文字数。
    detail: string,
    checked: bool,
}

// 比較の画面の`SideCheck`と同じ形の四角。同じ画面の中で、チェックの形を2つにしない。
component CheckMark inherits Rectangle {
    in property <bool> checked;
    in property <string> tip;
    callback toggled();
    width: 24px;
    height: 26px;
    Rectangle {
        x: 3px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 3px;
        border-width: 1px;
        border-color: root.checked || touch.has-hover ? Tok.accent : Tok.rule-strong;
        background: root.checked ? Tok.accent : touch.has-hover ? Tok.accent-faint : Tok.paper;
        if root.checked: Text {
            text: "✓";
            color: Tok.paper;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// 1行：チェック、文字、添え字。`selected`は History の「いま比べている相手」。
component CheckLine inherits Rectangle {
    in property <BackupRow> item;
    in property <bool> selected;
    callback toggled();
    callback chosen();
    height: 30px;
    border-radius: 5px;
    background: root.selected ? Tok.accent-faint : line.has-hover ? Tok.accent-faint : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Tok.accent;
    line := TouchArea {
        clicked => {
            root.chosen();
        }
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 6px;
        CheckMark {
            checked: root.item.checked;
            toggled => {
                root.toggled();
            }
        }
        Text {
            text: root.item.label;
            color: Tok.ink;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.item.detail != "": Text {
            text: root.item.detail;
            color: Tok.ink-muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
}

// 頭の「All」。全部チェックされていればチェック済みに見え、押せば全部を替える。
component AllLine inherits Rectangle {
    in property <bool> checked;
    callback toggled();
    height: 30px;
    all := TouchArea {
        clicked => {
            root.toggled();
        }
    }
    HorizontalLayout {
        padding-left: 4px;
        spacing: 6px;
        CheckMark {
            checked: root.checked;
            toggled => {
                root.toggled();
            }
        }
        Text {
            text: @tr("All");
            color: Tok.ink-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Backup History の左の列。
export component BackupHistoryList inherits Rectangle {
    in property <string> file-name;
    in property <[BackupRow]> rows;
    in property <int> selected: -1;
    in property <bool> all-checked;
    in property <bool> any-checked;
    callback chosen(int);
    callback toggled(int);
    callback all-toggled();
    callback delete-requested();

    background: Tok.paper;
    border-width: 1px;
    border-color: Tok.rule;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        Text {
            text: @tr("Backup History");
            color: Tok.ink-strong;
            font-size: 13px;
            font-weight: 600;
        }

        Text {
            text: root.file-name;
            color: Tok.ink-muted;
            font-size: 11px;
            overflow: elide;
        }

        AllLine {
            checked: root.all-checked;
            toggled => {
                root.all-toggled();
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 1px;
                for row[index] in root.rows: CheckLine {
                    item: row;
                    selected: index == root.selected;
                    toggled => {
                        root.toggled(index);
                    }
                    chosen => {
                        root.chosen(index);
                    }
                }
            }
        }

        TextButton {
            wide: true;
            title: @tr("Delete…");
            role: Role.danger;
            enabled: root.any-checked;
            clicked => {
                if root.any-checked {
                    root.delete-requested();
                }
            }
        }
    }
}

// Backups の面の1行。
export struct BackupPaneRow {
    // 0 フォルダ、1 ファイル、2 案内の文。
    kind: int,
    // フォルダは最後の名前、ファイルは名前、案内は文そのもの。
    label: string,
    // マウスを載せると出す、全体のパス。
    tip: string,
    // フォルダの添え字：`AutoSave`、未登録など。
    mode: string,
    // フォルダの AutoBackup が ON か。
    backup-on: bool,
    // この面で ON/OFF を替えられるか（使用中の Workspace の登録フォルダだけ）。
    can-toggle: bool,
    // ファイルのバックアップの件数。
    count: string,
    // フォルダを開いているか。
    open: bool,
}

// 左ペインの Backups。
export component BackupsView inherits Rectangle {
    in property <bool> recovery;
    in property <[BackupPaneRow]> rows;
    callback recovery-toggled(bool);
    // フォルダなら開閉、ファイルなら Backup History。
    callback row-clicked(int);
    callback backup-toggled(int);
    // 右クリックの行：0 Backup History…、1 Delete Backups…。
    callback menu-chosen(int, int);
    property <int> menu-row: -1;
    property <int> menu-kind: 0;
    property <length> menu-y;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        Text {
            text: @tr("BACKUPS");
            color: Tok.ink-faint;
            font-size: 10px;
            letter-spacing: 0.9px;
        }

        // 自動退避（要件 8.1）。Settings の Backup と同じ値を、ここでも切り替える。
        HorizontalLayout {
            spacing: 6px;
            height: 28px;
            Text {
                text: @tr("Auto Recovery");
                color: Tok.ink;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            TextButton {
                title: root.recovery ? @tr("On") : @tr("Off");
                role: root.recovery ? Role.primary : Role.normal;
                clicked => {
                    root.recovery-toggled(!root.recovery);
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Tok.rule;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 1px;
                for row[index] in root.rows: line := Rectangle {
                    // 案内の文は2行ぶん（狭い面では折り返す）。
                    height: row.kind == 2 ? 36px : (row.kind == 0 ? 30px : 26px);
                    border-radius: 5px;
                    background: row.kind != 2 && touch.has-hover ? Tok.accent-faint : transparent;

                    touch := TouchArea {
                        enabled: row.kind != 2;
                        clicked => {
                            root.row-clicked(index);
                        }
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                root.menu-row = index;
                                root.menu-kind = row.kind;
                                root.menu-y = line.absolute-position.y - root.absolute-position.y + line.height;
                                menu.show();
                            }
                        }
                    }

                    if row.kind == 2: Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: row.label;
                        color: Tok.ink-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    if row.kind == 0: HorizontalLayout {
                        padding-left: 2px;
                        padding-right: 4px;
                        spacing: 4px;
                        Rectangle {
                            width: 18px;
                            Icon {
                                x: 1px;
                                y: (parent.height - self.height) / 2;
                                commands: row.open ? Icons.down : Icons.right;
                                tint: Tok.ink-muted;
                            }
                        }
                        Text {
                            text: row.label;
                            color: Tok.ink;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if row.mode != "": Text {
                            text: row.mode;
                            color: Tok.ink-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        if row.can-toggle: TextButton {
                            title: "AutoBackup";
                            role: row.backup-on ? Role.primary : Role.normal;
                            clicked => {
                                root.backup-toggled(index);
                            }
                        }
                    }

                    if row.kind == 1: HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text {
                            text: row.label;
                            color: Tok.ink;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: row.count;
                            color: Tok.ink-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                    }

                    // 最後に置く：上に重なって指を見るだけで、押したことは下の TouchArea へ行く。
                    if row.kind != 2: Tooltip {
                        text: @markdown("`\{row.tip}`");
                    }
                }
            }
        }
    }

    menu := PopupWindow {
        x: 8px;
        y: root.menu-y;
        width: 220px;
        close-policy: close-on-click-outside;
        MenuFrame {
            width: 220px;
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                if root.menu-kind == 1: MenuRow {
                    title: @tr("Backup History…");
                    activated => {
                        menu.close();
                        root.menu-chosen(root.menu-row, 0);
                    }
                }
                MenuRow {
                    title: @tr("Delete Backups…");
                    activated => {
                        menu.close();
                        root.menu-chosen(root.menu-row, 1);
                    }
                }
            }
        }
    }
}
