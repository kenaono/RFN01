import { Tok } from "tokens.slint";
export component TitleMenuBar inherits Rectangle {
    in property <bool> menu-visible;
    in property <bool> blocked;
    in property <bool> maximized;
    // 1 minimise, 2 maximise, 3 close, 0 nothing: which caption button the
    // pointer is over, and whether one is held down. Windows owns the hit
    // regions (Snap and the system commands), so the frame reports the state and
    // only the faces are painted here.
    in property <int> hot: 0;
    in property <bool> pressed: false;
    in property <string> document-title;
    in property <int> focus-generation;
    in-out property <int> selected: 0;
    in property <bool> popup-open;
    callback requested(int);
    callback dismissed();
    callback toggled();
    // Windows標準のキャプションボタンに合わせる。ホバーは薄い灰、閉じるだけ
    // 赤で記号が白へ変わる。押下はその一段暗い色。**`blocked`では止めない**——
    // 質問・印刷・比較の間もこのボタンのヒット領域は生きているので、面だけ
    // 消すと押せないと読めてしまう。止めるのはタイトル行のメニュー側だけ。
    // （印刷と比較は画面がタイトル行を覆うので面は見えない。質問の幕の下では
    // 幕に暗くされた面が出る。）
    pure function caption-over(index: int) -> bool {
        return root.hot == index + 1;
    }
    pure function caption-face(index: int) -> color {
        if !root.caption-over(index) { return Tok.chrome; }
        if index == 2 { return root.pressed ? #b32b1c : #c42b1c; }
        return root.pressed ? #d8d8d8 : #e9e9e9;
    }
    pure function caption-ink(index: int) -> color {
        if root.caption-over(index) && index == 2 { return #ffffff; }
        return Tok.ink;
    }
    changed focus-generation => { keys.focus(); }
    height: 36px;
    background: Tok.chrome;
    Image { x: 8px; y: 10px; width: 16px; height: 16px; source: @image-url("icon.png"); }
    TouchArea {
        x: 0px; y: 0px; width: 32px; height: root.height;
        enabled: !root.blocked;
        clicked => { root.toggled(); }
    }
    if !root.menu-visible: Text {
        x: 36px; y: 0px; width: max(0px, root.width - 184px); height: root.height;
        text: root.document-title + " - RFN Edit";
        color: Tok.ink; font-size: 12px; vertical-alignment: center; overflow: elide;
    }
    if root.menu-visible: HorizontalLayout {
        x: 36px; y: 0px; width: 336px; height: root.height; spacing: 0px;
        for label[index] in [@tr("File"), @tr("Edit"), @tr("Insert"), @tr("Layout"), @tr("View"), @tr("Run"), @tr("Help")]: Rectangle {
            width: 48px;
            background: (touch.has-hover || ((keys.has-focus || root.popup-open) && root.selected == index)) && !root.blocked ? Tok.accent-soft : transparent;
            Text { text: label; font-size: 12px; color: Tok.ink; horizontal-alignment: center; vertical-alignment: center; }
            touch := TouchArea {
                enabled: !root.blocked;
                changed has-hover => {
                    if self.has-hover && !root.popup-open && !root.blocked {
                        root.selected = index;
                        root.requested(index);
                    }
                }
                clicked => { root.selected = index; root.requested(index); }
            }
        }
    }
    keys := FocusScope {
        // Keyboard-only focus must not cover the menu TouchAreas.
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.F10 { root.dismissed(); return accept; }
            if event.text == Key.LeftArrow { root.selected = mod(root.selected + 6, 7); return accept; }
            if event.text == Key.RightArrow { root.selected = mod(root.selected + 1, 7); return accept; }
            if event.text == Key.DownArrow || event.text == Key.Return || event.text == " " {
                if !root.blocked { root.requested(root.selected); }
                return accept;
            }
            return reject;
        }
    }
    // Windows owns these hit regions (including Snap and system commands).
    // The three faces are painted for every state, not only while hovered: the
    // restore glyph's front square hides the back one behind the same paint.
    for index in [0, 1, 2]: Rectangle {
        x: root.width - (3 - index) * 46px; y: 0px; width: 46px; height: root.height;
        background: root.caption-face(index);
    }
    for label[index] in ["─", "", "×"]: Text {
        x: root.width - (3 - index) * 46px; y: 0px; width: 46px; height: root.height;
        text: label; font-size: 15px; color: root.caption-ink(index);
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.maximized: Rectangle {
        x: root.width - 74px; y: 11px; width: 10px; height: 9px;
        border-width: 1px; border-color: root.caption-ink(1); background: root.caption-face(1);
    }
    Rectangle {
        x: root.width - 77px; y: root.maximized ? 14px : 13px;
        width: 10px; height: 9px;
        border-width: 1px; border-color: root.caption-ink(1); background: root.caption-face(1);
    }
}
