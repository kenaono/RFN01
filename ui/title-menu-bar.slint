import { AppMark, Field, Icon, Icons } from "controls.slint";
import { Tok } from "tokens.slint";
export component TitleMenuBar inherits Rectangle {
    in property <bool> menu-visible;
    in property <bool> blocked;
    in property <bool> maximized;
    // 1 minimise, 2 maximise, 3 close, 0 nothing: which caption button the
    // pointer is over, and whether one is held down. Windows owns the hit
    // regions (Snap and the system commands), so the frame reports the state and
    // only the faces are painted here.
    in property <int> hot: 0;
    in property <bool> pressed: false;
    in property <string> document-title;
    in property <int> focus-generation;
    in-out property <int> selected: 0;
    in property <bool> popup-open;
    /// 分類ごとに開けるか（RFN01-38）。**押しても何も出ない分類は灰色にする**
    /// ——書き手の決定 2026-09-21。Rustが本文を見て決める。
    in property <[bool]> openable: [true, true, true, true, true, true, true];
    callback requested(int);
    callback dismissed();
    callback toggled();
    // RFN01-87: コマンドパレット。**ふだんはファイル名を淡く出す枠**で、押すか
    // Ctrl+P／Ctrl+Shift+Pで入力欄になる（書き手の決定 2026-11-03）。メニューを
    // 出している間は隠す。
    in property <bool> palette-open;
    /// 枠にふだん出す名前（書き手の求め 2026-11-03：ファイル名はTABにあるので、探す範囲の名前を）。
    in property <string> palette-caption;
    in-out property <string> palette-text;
    in property <int> palette-focus-generation;
    callback palette-requested();
    callback palette-edited(string);
    callback palette-step(int);
    callback palette-accepted();
    callback palette-cancelled();
    callback palette-focus-trace(bool);
    /// 枠の左端と幅。**窓がタイトル行として扱う場所から、この範囲だけを外す**
    /// （`window_chrome`）——外さないと、押してもWindowsが窓のドラッグにしてしまう。
    callback palette-span(length, length);
    out property <length> palette-x: palette-box.x;
    out property <length> palette-width: palette-box.width;
    // 「> 」入りで開いたときは、その後ろへ打てるように（選んでしまうと打った字で消える）。
    changed palette-focus-generation => {
        root.palette-focus-trace(false);
        if root.palette-text == "" { palette-field.take-focus(); }
        else { palette-field.take-focus-at-end(); }
        root.palette-focus-trace(true);
    }
    // Windows標準のキャプションボタンに合わせる。ホバーは薄い灰、閉じるだけ
    // 赤で記号が白へ変わる。押下はその一段暗い色。**`blocked`では止めない**——
    // 質問・印刷・比較の間もこのボタンのヒット領域は生きているので、面だけ
    // 消すと押せないと読めてしまう。止めるのはタイトル行のメニュー側だけ。
    // （印刷と比較は画面がタイトル行を覆うので面は見えない。質問の幕の下では
    // 幕に暗くされた面が出る。）
    pure function caption-over(index: int) -> bool {
        return root.hot == index + 1;
    }
    pure function caption-face(index: int) -> color {
        if !root.caption-over(index) { return Tok.chrome; }
        if index == 2 { return root.pressed ? #b32b1c : #c42b1c; }
        return root.pressed ? #d8d8d8 : #e9e9e9;
    }
    pure function caption-ink(index: int) -> color {
        if root.caption-over(index) && index == 2 { return #ffffff; }
        return Tok.ink;
    }
    changed focus-generation => { keys.focus(); }
    height: 36px;
    background: Tok.chrome;
    // 追加要件 C3（2026-09-24）：16pxの画像を引き伸ばすとぼけるので、印は画面が描く。
    AppMark { x: 8px; y: 10px; }
    TouchArea {
        x: 0px; y: 0px; width: 32px; height: root.height;
        enabled: !root.blocked;
        clicked => { root.toggled(); }
    }
    // 枠は窓の中央。**左のアイコンとメニュー、右の3つの釦に掛からない**幅に縮める。
    palette-box := Rectangle {
        property <length> room: max(0px, root.width - 2 * 184px);
        width: min(560px, max(min(240px, self.room), root.width * 0.4), self.room);
        x: (root.width - self.width) / 2;
        y: 5px;
        height: root.height - 10px;
        visible: !root.menu-visible && self.width > 60px;
        border-radius: 6px;
        border-width: 1px;
        border-color: root.palette-open ? Tok.accent : Tok.rule;
        background: root.palette-open ? Tok.paper : Tok.chrome-sunken;
        changed x => { root.palette-span(self.visible ? self.x : 0px, self.visible ? self.width : 0px); }
        changed width => { root.palette-span(self.visible ? self.x : 0px, self.visible ? self.width : 0px); }
        changed visible => { root.palette-span(self.visible ? self.x : 0px, self.visible ? self.width : 0px); }
        init => { root.palette-span(self.visible ? self.x : 0px, self.visible ? self.width : 0px); }
        if !root.palette-open: HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            alignment: center;
            Icon { commands: Icons.search; tint: Tok.ink-faint; width: 13px; height: 13px; y: (parent.height - 13px) / 2; }
            Text {
                text: root.palette-caption;
                color: Tok.ink-faint;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if !root.palette-open: TouchArea {
            enabled: !root.blocked;
            mouse-cursor: pointer;
            clicked => { root.palette-requested(); }
        }
        palette-field := Field {
            visible: root.palette-open;
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            border-width: 0px;
            background: transparent;
            text <=> root.palette-text;
            placeholder: @tr("Search files by name (type > for commands)");
            edited => { root.palette-edited(self.text); }
            accepted => { root.palette-accepted(); }
            escaped => { root.palette-cancelled(); }
            focus-lost => { if root.palette-open { root.palette-cancelled(); } }
            shortcut(event) => {
                if event.text == Key.UpArrow { root.palette-step(-1); return accept; }
                if event.text == Key.DownArrow { root.palette-step(1); return accept; }
                if event.text == Key.PageUp { root.palette-step(-10); return accept; }
                if event.text == Key.PageDown { root.palette-step(10); return accept; }
                reject
            }
        }
    }
    if root.menu-visible: HorizontalLayout {
        x: 36px; y: 0px; width: 336px; height: root.height; spacing: 0px;
        for label[index] in [@tr("File"), @tr("Edit"), @tr("Insert"), @tr("Layout"), @tr("View"), @tr("Run"), @tr("Help")]: Rectangle {
            width: 48px;
            background: (touch.has-hover || ((keys.has-focus || root.popup-open) && root.selected == index)) && !root.blocked && root.openable[index] ? Tok.accent-soft : transparent;
            Text { text: label; font-size: 12px; color: root.openable[index] ? Tok.ink : Tok.ink-faint; horizontal-alignment: center; vertical-alignment: center; }
            touch := TouchArea {
                enabled: !root.blocked && root.openable[index];
                changed has-hover => {
                    if self.has-hover && !root.popup-open && !root.blocked && root.openable[index] {
                        root.selected = index;
                        root.requested(index);
                    }
                }
                clicked => {
                    if root.openable[index] { root.selected = index; root.requested(index); }
                }
            }
        }
    }
    keys := FocusScope {
        // Keyboard-only focus must not cover the menu TouchAreas.
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.F10 { root.dismissed(); return accept; }
            if event.text == Key.LeftArrow { root.selected = mod(root.selected + 6, 7); return accept; }
            if event.text == Key.RightArrow { root.selected = mod(root.selected + 1, 7); return accept; }
            if event.text == Key.DownArrow || event.text == Key.Return || event.text == " " {
                if !root.blocked && root.openable[root.selected] { root.requested(root.selected); }
                return accept;
            }
            return reject;
        }
    }
    // Windows owns these hit regions (including Snap and system commands).
    // The three faces are painted for every state, not only while hovered: the
    // restore glyph's front square hides the back one behind the same paint.
    for index in [0, 1, 2]: Rectangle {
        x: root.width - (3 - index) * 46px; y: 0px; width: 46px; height: root.height;
        background: root.caption-face(index);
    }
    for label[index] in ["─", "", "×"]: Text {
        x: root.width - (3 - index) * 46px; y: 0px; width: 46px; height: root.height;
        text: label; font-size: 15px; color: root.caption-ink(index);
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.maximized: Rectangle {
        x: root.width - 74px; y: 11px; width: 10px; height: 9px;
        border-width: 1px; border-color: root.caption-ink(1); background: root.caption-face(1);
    }
    Rectangle {
        x: root.width - 77px; y: root.maximized ? 14px : 13px;
        width: 10px; height: 9px;
        border-width: 1px; border-color: root.caption-ink(1); background: root.caption-face(1);
    }
}
