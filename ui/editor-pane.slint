import { ScrollView, VerticalBox } from "std-widgets.slint";
import { Tok } from "tokens.slint";
import { ColourPalette, Field, Icon, IconButton, Icons, LinkRow, MenuFrame, MenuRow, MenuSep, Tab, TextButton, ToggleChip } from "controls.slint";

// One editing pane.
//
// The two panes were the same 280 lines twice, differing only in which axis the
// document flows along and what the properties behind them were called. That
// duplication is where 6.15 and 6.16 came from: the same thing in two places
// gets fixed in one of them. Everything that differs is now `vertical`.
//
// This is also the shape 要件 6.4 needs. A pane that takes its whole state as
// parameters can be instantiated twice — as it is today — or repeated over a
// model of panes, which is the next step (ペイン分割設計 5.2).

// One rendered slice of the document. Both directions use it: the vertical pane
// stacks tiles along x and the horizontal one along y, so the placement Rust
// computes covers both and this side does not have to know which is which.
export struct PreviewTile {
    x: int,
    y: int,
    width: int,
    height: int,
    source: image,
}

// One tab in one pane's strip.
//
// Moved here from the window: the strips belong to the panes (要件 6.3), so
// what one holds is part of what that pane is showing.
export struct TabInfo {
    title: string,
    edited: bool,
    /// 要件 8.3（書き手のレビュー 2026-09-11、S2）: **外で変わったまま、まだ
    /// 片付いていない。**未保存の丸とは別の印である——片方は書き手が書いたこと、
    /// もう片方は**外で起きたこと**を言う。読み込むか上書きするまで消えない。
    outside: bool,
    // 追加要件 2026-09-06: whether this tab stands for a file on disk, and so
    // has a name the writer can change by holding the tab down. **Told rather
    // than guessed from the title**: 無題1 is a name like any other on screen,
    // and only the document knows whether anything is filed under it.
    renamable: bool,
    // How many characters of the title are the name without its extension
    // (追加要件 2026-09-06). Renaming selects that much, so that typing
    // replaces the name and leaves the extension.
    stem-length: int,
    // 追加要件 2026-09-07: whether this tab is a shell. **Holding it down
    // offers another one** — the press a document tab spends on its name.
    terminal: bool,
    // 書き手の報告 2026-09-07: whether this tab is only being looked through,
    // and so is the one the next file clicked in the left panel would take the
    // place of. **Drawn in italics**, the way a book sets a word it is only
    // mentioning.
    provisional: bool,
    /// 追加要件 2026-09-15（書き手）: TABの色（個別の色、なければそのTABに付いた紙）と、
    /// それが暗いか。`colour-own`でなければ全体の紙のまま＝今までの見た目。
    colour: color,
    colour-own: bool,
    dark: bool,
}

// One line of the draft that stands under a shell (書き手の報告 2026-09-07).
//
// **Cut by Rust, because only Rust knows where the sending stops.** `Ctrl+Enter`
// trims the end off the draft before it hands it over, so the blank lines a
// writer leaves under a command are not part of what runs — and until now
// nothing on screen said so.
export struct DraftLine {
    text: string,
    // Whether this line is inside what `Ctrl+Enter` would send.
    sent: bool,
    // Whether a newline follows it. The last line has none unless the writer
    // left one there, and that is the one the writer most needs to see.
    breaks: bool,
}

/// 要件 7.9: 選べるモードの1つ。**番号と名前**——指すのは番号で、読むのは名前。
///
/// **ここに在るのは、タブのメニューが並べるから**（要件 7.9、書き手の報告
/// 2026-09-08：ステータスバーだけではどのタブに効くのか分からない）。
export struct WordModeRow {
    id: int,
    name: string,
}

export struct PreviewSelectionRect {
    x: float,
    y: float,
    width: float,
    height: float,
}

// One pane as the screen has it: one row of the window's pane model.
//
// Named for the screen because the Rust side already has a `PaneView` — the
// half of a pane that is not a graphics object. This is the other direction:
// what one pane is currently showing, in pixels.
//
// The two panes used to be two sets of root properties named `vertical-*` and
// `horizontal-*`, bound twice. They are one repeated element over this model
// instead (ペイン分割設計 5), so adding a pane adds a row rather than another
// copy of every binding.
//
// Rust writes a row by reading it, changing one field and setting it back. The
// fields the pane itself writes — its scroll, the size it shows and its IME
// field — come back through a two-way binding, which the compiler turns into a
// write to this model rather than to a copy of the row.
export struct PaneScreen {
    // Which pane this is: its row of the window's pane model, counted from 0
    // vertical. **The callbacks carry this rather than the row's position**, so
    // that a model holding only the panes on screen still names them the same.
    id: int,
    // Which way the document flows. Everything else that differs between the
    // panes — the paper colour, the padding, the indent — follows from it, so
    // none of that is in this model.
    vertical: bool,

    tiles: [PreviewTile],
    selection-rects: [PreviewSelectionRect],
    difference-rects: [PreviewSelectionRect],
    comparison-note: string,
    /// E1: 見えている一致（書き手の求め 2026-09-09）。**選択より薄い**——
    /// 「どこにあるか」を出しつつ、「いまどれにいるか」を選択に譲る。
    match-rects: [PreviewSelectionRect],
    /// E1: 範囲内検索の範囲（書き手の求め 2026-09-09）。**いちばん薄い**——
    /// 「ここを探している」だけを言い、一致と現在地はその上に重なる。
    scope-rects: [PreviewSelectionRect],
    // The laid-out document's size, in pixels.
    content-width: int,
    content-height: int,

    caret-visible: bool,
    caret-x: float,
    caret-y: float,
    caret-width: float,
    caret-height: float,

    ime-anchor-x: float,
    ime-anchor-y: float,
    ime-anchor-width: float,
    ime-anchor-height: float,

    // This pane's own strip (要件 6.3: 各編集ペインは独立したタブ列を持つ), and
    // which of them the pane is showing.
    tabs: [TabInfo],
    active-tab: int,
    // Where this pane sits in the editing area, from the layout tree
    // (要件 6.4). **A pane with no width is not on screen at all** — the tree
    // hands out the area, and one it does not name gets none.
    x: float,
    y: float,
    width: float,
    height: float,
    // Whether the tab in front of this pane is being shown formatted rather
    // than as its source: half of the four modes (要件 7.2). **Per pane per
    // tab**, which is why it is here and not on the window.
    preview: bool,
    viewer: bool,
    can-undo: bool,
    can-redo: bool,
    // Whether the tab in front of this pane is a shell (追加要件 Terminal).
    // **The pane draws the same way either way** — one image and no caret of
    // its own — so this changes nothing here but what the keyboard does.
    terminal: bool,
    // Whether the tab in front of this pane has not been asked what it is yet
    // (追加要件 2026-09-07). The document behind the page is real and empty;
    // what stands over it is three words.
    empty: bool,
    /// 追加要件 2026-09-15（書き手）: **TAB毎・Pane毎の紙の色。**横書き・縦書きで別々に
    /// 持ち、`-own`が立っていなければ全体の設定の紙。前に出ているTABの色がPaneの色より
    /// 勝つ——Rustがその順で決めてここへ置く。
    paper-h: color,
    paper-h-own: bool,
    paper-v: color,
    paper-v-own: bool,
    /// 追加要件 2026-09-14（書き手）: **設定はTABで開く。**前に出ているタブが
    /// 設定の面なら、本文の場所には窓が差し込む設定の中身が立つ。下の文書は
    /// 端末と同じく空の代役で、字は入らない。
    settings: bool,
    /// E1（書き手の報告 2026-09-09）: **探している語は、その面のもの。**
    ///
    /// 窓に1つだけ持っていたので、Pane1で探してPane2で探し、Pane1へ戻ると
    /// F3が**Pane2の語**を探していた。帯はその文書を開いているペインの中に
    /// 出る（要件 7.7）——ならば語も置換語も、帯が言うことも、そこにある。
    find-needle: string,
    find-replacement: string,
    find-status: string,
    /// E1: この面の**探し方**。大小の別と、語の全体だけを見るかどうか。
    find-match-case: bool,
    find-whole-word: bool,
    /// E1: 語を正規表現として読むか（書き手の求め 2026-09-10）。
    find-regex: bool,
    /// 範囲内だけを探すときの、その範囲（本文のバイト）。
    /// **終わりが始まりより大きいときだけ効く**——0と0は「範囲は無い」である。
    /// 書き手が選んだものそのもので、一致へ移っても動かない（E1）。
    find-scope-start: int,
    find-scope-end: int,
    /// 要件 7.9（2026-09-08）: この面の**単語チェックモード**の名前。
    ///
    /// **モードは文書ごと**（コードエディタの言語モードと同じ粒度）なので、
    /// タブと一緒に動く。2つのペインが別の作品を開いていれば、別の色分けになる。
    word-mode: int,
    // 追加要件 Terminal: what stands along the foot of this pane. 0 nothing,
    // 1 a shell under a document, 2 a draft under a shell. **A number rather
    // than two flags**: the two can never both be there, because which one it
    // is follows from what the tab in front is.
    below-kind: int,
    below-height: length,
    below-tiles: [PreviewTile],
    // The draft's text, written at both ends: the writer types into it and
    // Rust reads it when it is sent.
    below-draft: string,
    // The same text cut into lines, with what would be sent marked out
    // (書き手の報告 2026-09-07).
    below-draft-lines: [DraftLine],
    // Bumped by Rust when the strip should take the keyboard.
    below-focus-generation: int,
    // Where the strip's own hidden field stands, so Windows opens the
    // conversion where the writing is (要件 7.2).
    below-caret-x: float,
    below-caret-y: float,
    // What that field holds. Written at both ends, like the pane's own.
    below-buffer: string,
    // How much this pane magnifies the text, as a percentage (要件 9).
    // **Per pane, not per tab**: it is how close the writer is sitting to this
    // half of the window, and a tab brought out in front of it is read at the
    // same distance as the one before it.
    zoom: int,
    // Which way this pane has a neighbour to change places with (要件 6.4).
    //
    // **Worked out from the rectangles, by the same rule the arrow keys use**
    // (`pane_layout::neighbour`), and written here so the menu can leave out a
    // direction there is nothing in. A row that does nothing looks exactly like
    // a row that is broken.
    swap-left: bool,
    swap-right: bool,
    swap-up: bool,
    swap-down: bool,

    // Written by the pane, read by Rust.
    ime-buffer: string,
    scroll-x: length,
    scroll-y: length,
    // Bumped by Rust whenever it means to move the view (要件 8.5): restoring a
    // tab, following the caret, opening a file. **A count rather than a flag**,
    // because two moves in a row have to be two events.
    scroll-generation: int,
    shown-width: length,
    shown-height: length,
    wrap-height: length,
}

export component EditorPane inherits Rectangle {
    /// Which key this is, as a number `terminal.rs` knows (追加要件 Terminal).
    /// 0 is "an ordinary character", and then the text is what matters.
    pure function key-number(text: string) -> int {
        // **修飾キーそのものは打鍵ではない。**Slintはそれらを`U+0010`〜`U+0018`の
        // 文字として渡してくるので、名前を付けずに落とすと`Ctrl+P`のバイトとして
        // シェルへ行く（Shiftを押すと履歴が戻った）。-1は「何も送らない」。
        return text == Key.Shift || text == Key.ShiftR
                || text == Key.Control || text == Key.ControlR
                || text == Key.Alt || text == Key.AltGr
                || text == Key.CapsLock
                || text == Key.Meta || text == Key.MetaR ? -1
            : text == Key.Backtab ? 12
            : text == Key.UpArrow ? 1
            : text == Key.DownArrow ? 2
            : text == Key.RightArrow ? 3
            : text == Key.LeftArrow ? 4
            : text == Key.Home ? 5
            : text == Key.End ? 6
            : text == Key.PageUp ? 7
            : text == Key.PageDown ? 8
            : text == Key.Delete ? 9
            : text == Key.Insert ? 10
            : text == Key.Backspace ? 11
            : text == Key.Tab ? 12
            : text == Key.Return ? 13
            : text == Key.Escape ? 14
            : text == Key.F1 ? 20
            : text == Key.F2 ? 21
            : text == Key.F3 ? 22
            : text == Key.F4 ? 23
            : text == Key.F5 ? 24
            : text == Key.F6 ? 25
            : text == Key.F7 ? 26
            : text == Key.F8 ? 27
            : text == Key.F9 ? 28
            : text == Key.F10 ? 29
            : text == Key.F11 ? 30
            : text == Key.F12 ? 31
            : 0;
    }

    // Which way the document flows. Everything that differs between the two
    // panes is decided by this and nothing else.
    in property <bool> vertical;
    /// Whether this is the pane holding the keyboard (要件 6.3).
    ///
    /// **Only so the strip can say which tab is being written in.** Everything
    /// else about focus is Slint's own (`takes-focus`), and asking twice would
    /// be two opinions about one thing — so this is read, never set.
    in property <bool> focused;
    // Which way there is a pane to change places with (要件 6.4), from the row.
    in property <bool> swap-left;
    in property <bool> swap-right;
    in property <bool> swap-up;
    in property <bool> swap-down;

    in property <color> page-background;
    /// 追加要件 2026-09-15: 紙の色をTAB（0）・Pane（1）に付ける。色は「いま見えている
    /// 向き」のもの。2 はTABそのものの色（向きを持たない）。既定の色へ戻す・その他の色も
    /// 同じ番号で言う。
    /// メニューの行に添える向き（縦横で別々のときだけ）。色は見えている向きに付くので、それを言う。
    in property <string> paper-direction;
    callback paper-chosen(int, color);
    callback paper-default(int);
    callback paper-more(int);
    property <int> paper-target: 0;
    property <length> paper-x;
    property <length> paper-y;
    function open-paper-palette(target: int, at-x: length, at-y: length) {
        root.paper-target = target;
        root.paper-x = at-x;
        root.paper-y = at-y;
        paper-palette.show();
    }
    // What to say above the paper when something went wrong. Empty the rest of
    // the time, and then nothing is there at all.
    in property <string> status;
    // The vertical pane's own box indents its text by hand rather than padding
    // the whole column, because the scroll view below it must reach the edge.
    in property <length> text-indent: 0px;
    in property <length> side-padding: 12px;
    /// 要件 9's 余白 along the line axis: above and below the text in a pane
    /// writing horizontally, and at the head and foot of the columns in one
    /// writing vertically.
    in property <length> page-margin: 12px;

    in property <[TabInfo]> tabs;
    /// 要件 7.7: the find bar, **inside the pane whose text it searches**. It
    /// was a band across the window once; it acts on one document, and putting
    /// it over the tabs of the pane holding that document is what says so.
    /// The window decides which pane has it, so this is `in`.
    in property <bool> find-open;
    property <length> find-bar-height: root.find-open ? (root.find-replacing ? 68px : 34px) : 0px;
    /// `Ctrl+H` rather than `Ctrl+F`: the second row is only in the way when
    /// nothing is being replaced.
    in property <bool> find-replacing;
    in-out property <string> find-needle;
    in-out property <string> find-replacement;
    in property <string> find-status;
    /// E1: この面の探し方。**帯の中の3つの入切**——大小の別、単語単位、
    /// 選んだ範囲の中だけ。
    in property <bool> find-match-case;
    in property <bool> find-whole-word;
    in property <bool> find-regex;
    in property <bool> find-in-scope;
    in property <int> find-generation;
    /// E4: 指定の行へ行く帯。**検索の帯と同じ場所・同じ作り**で、開いているのは
    /// どちらか一方とは限らない（両方出ていれば上下に並ぶ）。
    in property <bool> goto-open;
    in-out property <string> goto-line;
    in property <string> goto-status;
    in property <int> goto-generation;
    /// 帯が出たときに鍵盤をそこへ置くか（E1、書き手の求め 2026-09-09）。
    /// **F3は本文で押される鍵**なので、そのとき帯は出るが鍵盤は動かない。
    in property <bool> find-focus: true;
    in property <int> active-tab: 0;
    in property <bool> preview: false;
    in property <bool> viewer: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    /// The tab in front of this pane is a shell (追加要件 Terminal).
    ///
    /// **Then the keyboard belongs to the shell**, all of it: Ctrl+C interrupts
    /// rather than copies, Tab completes rather than indents, and Ctrl+D ends
    /// input rather than deleting a character. Sorting that out per key here
    /// would be the editor deciding what a shell means.
    in property <bool> terminal: false;
    in property <bool> empty: false;
    /// 前に出ているタブが設定の面か（追加要件 2026-09-14）。**中身は窓が
    /// 差し込む**（`@children`）——設定は窓のもので、ペインは場所を貸すだけ。
    in property <bool> settings: false;
    /// **本文を書いているタブか。**シェルにも設定の面にも本文は無いので、
    /// 文書にしか意味の無い行とボタンは、この1つで出し入れする。
    property <bool> writing: !root.terminal && !root.settings;
    // 追加要件 2026-09-15（書き手）: ソース表示で本のボタンを押した形。横書きだけ。
    property <bool> reading-only: root.viewer && !root.preview;
    /// 要件 7.9（2026-09-08）: いまこの面に効いている語群の名前。**選んだ語を
    /// 足す先**として右ボタンのメニューに並ぶ。空なら行そのものが出ない。
    in property <[string]> word-sets;
    /// 選べるモードの名前（先頭は「なし」）と、このタブのモード。
    ///
    /// **タブのメニューに出す**（書き手の報告 2026-09-08）。ステータスバーだけに
    /// 置いていたときは、**どのタブに効くのかが画面から読めなかった**——モードは
    /// 文書ごとのものなので、そのタブを右クリックして決めるのが素直である。
    in property <[WordModeRow]> word-modes;
    in property <int> word-mode;
    callback word-mode-chosen(int);
    /// 何か選んでいるか。**選択があるときだけ`単語帳へ追加`を出す**——
    /// 押しても何も起きない行は出さない（要件 6.7）。
    in property <bool> has-selection: false;
    /// 選んだ語を、何冊目のセットへ足すか。
    callback word-add-requested(int);
    /// 追加要件 2026-09-07: New Tab の三つの言葉。
    ///
    /// **接続先は New Tab の中でも選べる**（書き手の指摘 2026-09-07）——
    /// ここでWSL固定にすると、PowerShellを選ぶ道が☰しか無くなり、
    /// しかもそちらは新しいタブを開いてしまう。並びは窓が持っているもの
    /// （先頭が既定）をそのまま出す。
    in property <[string]> terminal-shells;
    /// 追加要件 2026-09-07: 既定の接続先。**訊かない道はこれを起こす**。
    in property <int> default-shell;
    callback new-file-requested();
    callback new-terminal-requested(int);
    /// 前に出ている端末のタブの接続先を替える（追加要件 2026-09-07）。
    callback tab-shell-chosen(int);
    /// 追加要件 Terminal: the strip along the foot of the pane. 0 nothing, 1 a
    /// shell under a document, 2 a draft under a shell.
    in property <int> below-kind: 0;
    in property <length> below-height: 200px;
    in property <[PreviewTile]> below-tiles;
    in-out property <string> below-draft;
    in property <[DraftLine]> below-draft-lines;
    // What the writer has just typed into the draft, so Rust can cut it into
    // lines again. **The field is asked rather than watched**: the two-way
    // binding puts the text in the model row either way, and nothing on this
    // side can split a string.
    callback below-draft-edited(string);
    in property <int> below-focus-generation;
    in property <float> below-caret-x;
    in property <float> below-caret-y;
    in-out property <string> below-buffer;
    /// What the IME is composing over the strip's shell, and what it committed.
    callback below-preedit(string);
    callback below-text(string, bool);
    /// Whether what is arriving came out of a conversion.
    property <bool> below-composing: false;
    /// A keystroke for the shell in the strip.
    callback below-key(string, int, bool, bool, bool);
    callback below-scrolled(float);
    callback below-selection-start(float, float);
    callback below-selection-update(float, float);
    callback below-selection-end(float, float);
    /// The writer dragged the boundary: how tall the strip should be now.
    callback below-resized(length);
    /// 追加要件 Terminal: open or close the strip (`Ctrl+\``).
    callback below-toggled();
    /// 書き手の報告 2026-09-08: 下段のシェルで選んでいるものを写す。
    ///
    /// **上の面の`copy-requested`とは別の口。**あちらは「前に出ているタブ」を
    /// 見て写す先を決めるが、下段は前に出ているものが何であれ下段である。
    callback below-copy();
    /// 下段の右ボタンが開いたメニューの、この帯の中での位置
    /// （書き手の報告 2026-09-08）。**開いたものと同じ座標系で数える**
    /// （技術検証 6.30）——`TouchArea`の`mouse-x`をそのまま渡し、popupは
    /// その`TouchArea`と同じ箱の中に置く。
    property <length> below-menu-x;
    property <length> below-menu-y;
    /// 書き手の報告 2026-09-07: 戻る（false）と進む（true）。**ブラウザと同じ
    /// 手つき**——左パネルの一覧を歩くと、見てきたファイルは順に並ぶ。
    callback navigate-requested(bool);
    /// Send the draft to the shell above it.
    callback below-sent();
    /// 要件 11.3 の手つきで、下段へ移る／下段から戻る。**同じCtrl+Altの矢印**で、
    /// 下段が無ければこれまでどおり隣のペインへ行く。
    callback below-entered();
    callback below-left();

    in property <[PreviewTile]> tiles;
    in property <[PreviewSelectionRect]> selection-rects;
    in property <[PreviewSelectionRect]> difference-rects;
    in property <string> comparison-note;
    callback comparison-dismissed();
    in property <[PreviewSelectionRect]> match-rects;
    in property <[PreviewSelectionRect]> scope-rects;
    // The laid-out document's size, in pixels.
    in property <int> content-width;
    in property <int> content-height;

    in property <bool> caret-visible: false;
    in property <float> caret-x: 0;
    in property <float> caret-y: 0;
    in property <float> caret-width: 1;
    in property <float> caret-height: 22;

    in property <float> ime-anchor-x: 0;
    in property <float> ime-anchor-y: 0;
    in property <float> ime-anchor-width: 1;
    in property <float> ime-anchor-height: 22;
    in-out property <string> ime-buffer;

    // The scroll offsets, both declared so the component does not have to know
    // which one its parent cares about. The unused one stays at zero.
    in-out property <length> scroll-x: 0px;
    in-out property <length> scroll-y: 0px;
    /// 要件 8.5: Rust has moved the view, and the pane has to follow.
    ///
    /// **Assigned, not left to the binding.** `Flickable` drops the binding on
    /// its `viewport-x`/`viewport-y` the first time the writer presses inside it
    /// — `remove_binding()` in `i-slint-core/items/flickable.rs`, there to stop
    /// an animation — so from that press onwards nothing Rust writes reaches the
    /// view. Which is why restoring the scroll worked at startup and stopped
    /// working the moment the pane had been clicked in: opening a file then left
    /// the pane where the last document had been, showing the middle of the new
    /// one or blank paper past its end.
    ///
    /// **Where to go is its own pair of properties**, not `scroll-x`/`scroll-y`.
    /// Those two are two-way with the view, which is the very connection that
    /// gets dropped; these are Rust's alone and are only ever read here.
    in property <length> scroll-to-x;
    in property <length> scroll-to-y;
    in property <int> scroll-generation;
    callback scroll-applied(float, float);
    function take-scroll() {
        scroll.viewport-x = root.scroll-to-x;
        scroll.viewport-y = root.scroll-to-y;
        root.scroll-applied(root.scroll-to-y / 1px, scroll.viewport-y / 1px);
    }
    changed scroll-generation => {
        root.take-scroll();
    }
    // What the pane actually shows, reported back so Rust can decide how much
    // of the document to lay out.
    in-out property <length> shown-width: 640px;
    in-out property <length> shown-height: 520px;
    // Measured together with the viewport, so opening a bar does not briefly
    // combine the old viewport with the new bar height on the Rust side.
    in-out property <length> wrap-height: 0px;

    // Whether this pane answers a request for the keyboard. The parent decides,
    // because it is the one that knows which pane the writer was last in.
    in property <bool> takes-focus: false;
    in property <int> focus-generation: 0;

    callback resized();
    callback scrolled(float);
    callback across-scrolled(float);
    callback selection-start(float, float, bool);
    callback link-open(float, float) -> bool;
    callback selection-update(float, float);
    callback selection-end(float, float);
    callback select-all();
    /// Text arriving through the hidden field: what was typed, pasted, or
    /// committed out of a conversion. **The flag says which** — a conversion is
    /// typing, and a shell shows pasted text highlighted until the next key
    /// (書き手の報告, 2026-09-06: 確定した単語が選択状態になる).
    callback text-input(string, bool);
    /// One keystroke for the shell: the text, which key it was, and the
    /// modifiers. **The name, not the bytes** — what an arrow key becomes
    /// depends on modes the shell set, and those are Rust's to read.
    callback terminal-key(string, int, bool, bool, bool);
    /// The wheel over a shell (追加要件 Terminal): how far, in pixels, positive
    /// towards what was written earlier. **Rust turns it into rows** — a
    /// terminal has no half-lines to stop on.
    callback terminal-scrolled(float);
    /// 書き手の決定 2026-09-11: どの記号を箇条書きの印として読むか（窓のもの）。
    /// **この面は表示に使うだけ**——読む記号ぶんの行を右クリックに出す。
    in property <[bool]> bullet-marks: [true, true, true];
    /// 書き手の報告 2026-09-11: 右クリックの`Bullet List`を開いているか。
    ///
    /// **右クリックの行が長くなった**ので階層にした（書き手の求め）。**入れ子の
    /// ポップアップにはしない**——popupを閉じるとその木ごと消え、消えた木から
    /// `root`へ登った生成コードは黙って何もしない（技術検証 6.24・6.30）。
    /// その場で開く形なら、木は1つのままである。
    property <bool> bullet-rows-open: false;
    /// E3の④: `Tab`と`Shift+Tab`。引数はShiftが押されているか。**行の字下げか、
    /// 字を入れるかはRustが決める**——選んだものと、その行が箇条書きかどうかで
    /// 分かれるので、本文を持っているあちらでしか決められない。
    callback tab-pressed(bool);
    /// E3の③: Enter。**ただの改行ではない**——字下げと、箇条書き・引用の印を
    /// 継ぐかどうかをRustが決める（本文を持っているのはあちらである）。
    ///
    /// 引数はShiftが押されているか。**中身の無い項目でだけ意味が変わる**
    /// （書き手の選択 2026-09-10）：Enterは段ごと捨てて素の行頭へ、Shift+Enterは
    /// 印だけ捨てて項目の本文の列に残る。
    callback enter-pressed(bool);
    /// E3の②: 行そのものを動かす・写す・消す。0=前へ、1=後へ、2=前へ写す、
    /// 3=後へ写す、4=消す。**上下ではなく文書順の前と後**（書き手の選択
    /// 2026-09-10）——縦書きでも`Alt+↑`が「前の行と入れ替える」である。
    callback line-edit(int);
    /// E10: 選んだ行を箇条書きにする、やめる。1つめは0=印、1=番号、2=数え直す。
    /// **2つめはどの記号か**（`-`／`*`／`+`の並び順。`-1`は「読む記号のいちばん前」＝
    /// 鍵が頼むときの言い方）。**もう一度頼めば外れる**（書き手の選択 2026-09-10）
    /// ——そろっているかどうかを見るのは、本文を持っているRustである。
    callback list-edit(int, int);
    callback preedit-changed(string);
    callback backspace-pressed();
    callback delete-pressed();
    callback move-caret(int, bool);
    callback home-end(bool, bool, bool);
    /// This pane now has the keyboard.
    callback focus-taken();
    callback focus-trace(string);
    callback save-requested();
    /// Show another of this pane's tabs, close one, or open a new one. The
    /// position is in this pane's strip and nobody else's.
    callback tab-selected(int);
    callback tab-closed(int);
    /// 要件 6.5: a tab was carried and let go. Its old place and the place in
    /// **this** strip it was over, both counted in the strip as it stands now,
    /// and where the hand let go in the window's coordinates.
    ///
    /// **The window decides which of the two it was.** A carry that ends inside
    /// this pane is a reordering and the pair of positions says everything; one
    /// that ends in another pane is a move, and only the point does.
    callback tab-dropped(int, int, length, length);
    /// 要件 6.5: where the hand is during a carry, in the window's coordinates,
    /// and that the carry is over. **Told to the window rather than kept here**
    /// — the tab may be over another pane, and no pane can see another one.
    callback carry-moved(length, length);
    callback carry-finished();
    /// A tab from somewhere else is being carried over this pane, or this
    /// pane's own carry is over itself. **Either way the pointer is here**, and
    /// that is what decides whether this strip shows where the tab would land.
    in property <bool> carry-over: false;
    callback new-tab-requested();
    /// What the pane's own menu asks for, beside `save-requested` above. Every
    /// one of these is the window's to carry out — a pane knows which pane it
    /// is and nothing else — so they are forwarded rather than acted on here.
    /// Sent when the pane's menu is about to open, so the window can make this
    /// the focused pane once instead of every row saying so.
    callback menu-opened();
    callback split-requested(bool);
    /// Change places with the pane in a direction (要件 6.4): 0 left, 1 right,
    /// 2 up, 3 down — the numbering the arrow keys already use (要件 11.3).
    callback swap-requested(int);
    callback close-others-requested();
    callback save-as-requested();
    /// Show this document's file in Explorer (要件 5.2).
    callback reveal-requested();
    /// 紙のシート（Settings の`Layout`タブ）を開く。
    callback layout-requested();
    /// 要件 9, 11.5: magnify this pane, in notches — positive in, negative out.
    /// **The pane the wheel is over, not the focused one**: `Ctrl+ホイール` is
    /// pointed at something, and pointing at a pane is asking about that pane.
    callback zoom-stepped(int);
    callback zoom-reset-requested();
    callback close-active-tab();
    /// 追加要件 2026-09-06: a tab was held down, which means "change this
    /// file's name" (要件 5.2's rename, reached from the strip).
    callback tab-renamed(int, string);
    /// Close every tab in the window but the one in front of this pane, or
    /// every one (要件 6.3). **すべて means the window, not this strip**: the
    /// pane the menu hangs from decides one thing only, which tab is kept.
    callback close-other-tabs();
    callback close-all-tabs();
    /// Open the find bar (要件 7.7, 11.2). True is 置換, which is the row the
    /// bar grows for it.
    callback find-requested(bool);
    /// What the bar asks for once it is open. True is forwards.
    callback find-step(bool);
    /// 検索欄に1字打たれた。**数え直すだけで、どこへも動かない**（E1）。
    callback find-typed();
    /// 探し方の入切を押した。0＝大小の別、1＝単語単位、2＝範囲の中だけ（E1）。
    callback find-option(int);
    /// 探した語を1つ遡る／戻る（E1の④）。1つめは↑か、2つめは置換欄か。
    callback find-history(bool, bool);
    /// E4: 行番号の帯を出す／閉じる（`Ctrl+G`）、打っている、行く。
    ///
    /// **引数は「鍵盤を連れてくるだけか」**（書き手の報告 2026-09-10）。本文で
    /// 押した`Ctrl+G`は同じ鍵で閉じるが、**検索の帯やメニューから来た求めは
    /// 「そちらへ移りたい」**であって、閉じてほしいという意味ではない。
    callback goto-requested(bool);
    callback compare-requested();
    callback compare-saved-requested();
    callback compare-head-requested();
    callback reopen-closed-requested();
    in property <[string]> shortcut-keys: ["Ctrl+O", "Ctrl+S", "Ctrl+Shift+S", "Ctrl+W", "Ctrl+F", "Ctrl+H", "Ctrl+G", "Ctrl+Shift+T", "Ctrl+Z", "Ctrl+Y"];
    callback shortcut-key(string, bool, bool, bool) -> bool;

    callback goto-typed();
    callback goto-accepted();
    callback goto-dismissed();
    /// 探す条件を捨てる——語・置換語・3つの入切・範囲（E1、書き手の求め）。
    callback find-cleared();
    /// 帯を出す。**開いていれば何もしない**（`find-requested`は同じ鍵で閉じる
    /// ので、F3から呼ぶと閉じてしまう）。鍵盤は動かさない——F3は本文で押される。
    callback find-shown();
    callback replace-one();
    callback replace-every();
    callback find-dismissed();
    /// The two halves of 要件 7.2's four modes, both of them this tab's: which
    /// way the text runs, and whether it is shown formatted or as its source.
    /// **The mode belongs to the tab, so the controls sit beside the tabs.**
    callback preview-toggled();
    callback viewer-toggled();
    callback direction-toggled();
    /// Take back the last change to this document, or put it back
    /// (要件 7.1, 11.2). True is the way forwards.
    callback undo-requested(bool);
    /// Put the selection on the clipboard (要件 11.2). **True also takes it out
    /// of the document** — a cut is a copy that succeeded, followed by a delete.
    callback copy-requested(bool);
    callback copy-body-requested();
    /// Bring this pane's next tab out in front, or its previous one (要件 11.3).
    /// True steps backwards. Wraps at either end of the strip.
    callback tab-stepped(bool);
    /// Give the keyboard to the pane in that direction (要件 11.3). 0 is left,
    /// 1 right, 2 up, 3 down — **directions on the screen**, whichever way the
    /// text in either pane happens to run.
    callback focus-moved(int);
    /// Ask the Kill Ring for something (要件 11.4・11.6). 0 は`Ctrl+K`＝行末まで、
    /// 1 は`Alt+W`＝控える、2 は`Alt+X`＝抜いて控える、3 は`Alt+Y`＝入れる、
    /// 4 は`Alt+Shift+Y`＝1つ前のものに入れ替える。
    callback kill-requested(int);
    /// Start selecting, or stop (要件 11.4 の`Ctrl+Space`). While it is on,
    /// every move extends the selection the way Shift does. **True asks for a
    /// rectangle** (`Ctrl+Shift+Space`, 要件 7.1).
    callback mark-toggled(bool);
    /// 要件 12: the quick draft, asked for from the pane's own menu (追加要件
    /// 2026-09-06の右クリックメニュー). **Forwarded, not opened here** — the
    /// window holds the draft, as it holds the folder and the panes.
    callback quick-draft-requested();
    /// Where the right button was pressed, in this pane's own coordinates.
    property <length> context-x;
    property <length> context-y;
    /// The tab the strip's menu is about, and where that menu opens.
    property <int> tab-menu-target: -1;
    property <length> tab-menu-x;
    property <length> tab-menu-y;

    // 書き手の報告 2026-09-07（3回目）: **タブのメニューは、渡された座標を
    // 何にも変換せずに置く。**渡ってくるのは帯（`strip`）の中の座標で、帯は
    // ペインの左上に立っているから、ペインの座標でもある。ずれていたのは
    // 窓の座標へ直してから`absolute-position`で戻していたためで、
    // 変換が2つあれば片方が古いだけで離れる。横に流れているぶんだけは足す。
    function open-tab-menu(at-x: length, at-y: length) {
        root.tab-menu-x = at-x + tabs-view.viewport-x;
        root.tab-menu-y = at-y;
        tab-menu.show();
    }
    /// Bumped for the tab that should start renaming (see `Tab::rename-asked`).
    property <int> rename-token;
    /// 追加要件 2026-09-06: close every tab nothing is waiting to be saved from.
    callback close-clean-tabs();
    /// 追加要件 2026-09-06: the path of the file in a tab, to the clipboard.
    callback copy-path-requested(int);
    callback duplicate-tab-requested(int);
    /// Open a file, asked for from the strip's own menu.
    callback open-file-requested();
    /// A new shell in this pane, asked for from the strip's own menu.
    /// Where the strip's own menu opens (the band beside the tabs).
    property <length> strip-menu-x;
    property <length> strip-menu-y;
    /// Escape was pressed and this pane had nothing open to close. **True if
    /// the window closed something of its own** — the app menu, or the
    /// typography panel — so that the key is not passed on twice.
    callback escaped() -> bool;

    /// Escapeが、窓にも畳むものが無いときに来る（書き手の報告 2026-09-12）。
    /// **選んでいる途中ならそこから戻り、`true`を返す。**
    callback selection-escaped() -> bool;

    /// 届いたShiftを、Windowsの答えと突き合わせて返す（書き手の報告 2026-09-12）。
    ///
    /// **旗は変換をまたぐと古くなる。**IMEが受け取った打鍵はSlintの手前で消えるので、
    /// Shiftを離した合図を見落とすと旗は押されたままになり、そのあとのただの
    /// クリックや矢印が「Shiftを押した」ものとして届く——「突然選択になりました」は
    /// この形であった。**旗を読む場所はこの鍵の並びに20ほどあり**、
    /// `Ctrl+K`が`Ctrl+Shift+K`（行を消す）に、`Alt+↓`が`Shift+Alt+↓`（行を写す）に
    /// 化けるのも同じ古さなので、**読むところを1つにして、そこで訊く。**
    callback shift-held(bool) -> bool;

    /// Close whichever of this pane's menus is open, and say whether one was.
    ///
    /// **`is-open` rather than a flag of our own**: a popup closes by itself
    /// when the writer clicks outside it, and a flag set at `show()` would not
    /// hear about that.
    function dismiss-menus() -> bool {
        if (tabs-menu.is-open) {
            tabs-menu.close();
            return true;
        }
        if (pane-menu.is-open) {
            pane-menu.close();
            return true;
        }
        // Last, because a menu opened over the find bar is what the writer is
        // looking at. The bar itself closes on Escape when the keyboard is in
        // one of its fields; this is the same key with the keyboard still in
        // the document.
        if (root.find-open) {
            root.find-dismissed();
            return true;
        }
        return false;
    }

    /// The two keys that raise this bar, answered from inside it (要件 11.2).
    ///
    /// **The same key closes it**, which is decided by the window: it is the
    /// one that knows whether the bar is already open, in which pane, and in
    /// which of its two shapes. All this does is pass the key on.
    function find-shortcut(event: KeyEvent) -> EventResult {
        if (event.modifiers.control
            && (event.text == "f" || event.text == "F" || event.text == "\u{6}")) {
            root.focus-trace("bar-ctrl-f-received");
            root.find-requested(false);
            return accept;
        }
        if (event.modifiers.control
            && (event.text == "h" || event.text == "H" || event.text == "\u{8}")) {
            root.focus-trace("bar-ctrl-h-received");
            root.find-requested(true);
            return accept;
        }
        // 欄の中のF3は「次へ」だけ。**帯を出す側は呼ばない**——欄が空のまま
        // `find-requested`を呼ぶと、開いているのと同じ形を頼むことになって
        // 帯が閉じる（同じ鍵は閉じる、要件 7.7）。
        if (event.text == Key.F3) {
            if (root.find-needle != "") {
                root.find-step(!event.modifiers.shift);
            }
            return accept;
        }
        // Enterは欄そのものが「次へ」として受ける（`accepted`）。Shift+Enterは
        // ここでしか受けられない——一行の入力は改行を入れないので、取らなければ
        // 何も起きない鍵になる（E1）。
        if (event.text == Key.Return && event.modifiers.shift) {
            root.find-step(false);
            return accept;
        }
        return reject;
    }

    /// 帯の欄が受ける鍵——履歴の↑↓と、上の2つ（E1の④）。
    ///
    /// **↑と↓を選んだのは、帯に足す幅が無いからである**（書き手の選択
    /// 2026-09-10）。`Match case`と書ける幅がもう無い帯に釦を1つ足せば、
    /// 半分の窓で最初にはみ出すのはこの帯である。一行の欄で↑↓は何も起こさない
    /// 鍵なので、割り当てても書き手から取り上げるものが無い。
    function find-keys(event: KeyEvent, replacing: bool) -> EventResult {
        if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
            root.find-history(event.text == Key.UpArrow, replacing);
            return accept;
        }
        // E4（書き手の報告 2026-09-10：「検索バーが出ている状態だとCtrl+Gが
        // 効きません。切り替わるといいと思いました」）。**帯の中の鍵は、その帯の
        // ものだけではない**——`Ctrl+F`が番号の帯から語の帯へ移れるのと同じ道を、
        // 逆向きにも通す。**閉じるのではなく移る**ので、探している語の色は
        // 残ったままである（E1の③）。
        if (event.modifiers.control
            && (event.text == "g" || event.text == "G" || event.text == "\u{7}")) {
            root.goto-requested(true);
            return accept;
        }
        return root.find-shortcut(event);
    }

    /// 行番号の欄が受ける鍵（E4）。**同じ`Ctrl+G`が閉じる**（帯の約束、要件 7.7）。
    /// 検索の鍵はそのまま通すので、番号の帯から`Ctrl+F`で語の帯へ移れる。
    function goto-keys(event: KeyEvent) -> EventResult {
        if (event.modifiers.control
            && (event.text == "g" || event.text == "G" || event.text == "\u{7}")) {
            root.goto-dismissed();
            return accept;
        }
        return root.find-shortcut(event);
    }

    /// 次／前の一致へ（E1）。
    ///
    /// **探す語が無ければ帯を出す。**F3は「探す」と書いてある鍵で、何も探して
    /// いないときに黙るのは効かないのと見分けがつかない——書いてあるのに効かない
    /// のと同じことである。
    function find-again(forwards: bool) {
        if (root.find-needle == "") {
            root.find-requested(false);
        } else {
            // **何で探しているかが見えるように、帯を出してから探す**
            // （書き手の求め 2026-09-09）。鍵盤は本文に置いたまま——F3は
            // 本文で押される鍵である。
            root.find-shown();
            root.find-step(forwards);
        }
    }

    // Bring the tab in front into view (要件 6.3).
    //
    // `viewport-x` is zero or negative — how far the strip has been pushed to
    // the left — so what is on screen is `-viewport-x` to
    // `-viewport-x + visible-width`. A tab before that pulls the strip back to
    // its own left edge; one after it pulls the strip up to its right edge.
    //
    // **Called by the tab, not by whatever chose it.** A tab is chosen from the
    // strip, from the list, from the tree, by closing its neighbour and by
    // being restored at startup; the one thing all of those have in common is
    // that the tab ends up in front, and only the tab knows where it is.
    function reveal-tab(at: length, wide: length) {
        if (at < -tabs-view.viewport-x) {
            tabs-view.viewport-x = -at;
        } else if (at + wide > -tabs-view.viewport-x + tabs-view.visible-width) {
            tabs-view.viewport-x = tabs-view.visible-width - at - wide;
        }
    }

    private property <bool> had-preedit: false;
    private property <bool> commit-just-finished: false;
    private property <bool> dragging: false;

    commit-reset := Timer {
        interval: 50ms;
        running: false;
        triggered => {
            root.commit-just-finished = false;
            self.stop();
        }
    }

    // 要件 6.5: the tab in the writer's hand, where the pointer is, and which
    // tab it is over. **Held here for the length of one drag and nowhere else**
    // — the strip is not reordered until the hand lets go, because
    // republishing it would take the very element whose grab is running (6.18).
    property <bool> carrying: false;
    property <int> carried-from: -1;
    property <int> carried-to: -1;
    property <length> carry-x: 0px;

    VerticalLayout {
        // The strip (要件 6.5), inside the pane it belongs to.
        Rectangle {
            height: 34px;
            // 要件 6.5: the whole band answers when a tab is being carried over
            // this pane. **The mark at the end of the tabs is not enough on its
            // own** — a strip with more tabs than fit has its end outside the
            // viewport, and an indicator that can be scrolled out of sight is
            // an indicator that is sometimes absent.
            background: root.carry-over && !root.carrying
                ? Tok.accent-faint
                : Tok.chrome-raised;

            // The tabs get the strip minus the group anchored at the far end,
            // and slide under it when there are more than fit.
            //
            // **The viewport is as wide as the tabs want to be**, which is the
            // whole of why they are not squeezed: a layout given its preferred
            // width takes nothing off anything. The same line Slint's own
            // `TextEdit` uses to stop a line of text being compressed into its
            // box (`widgets/common/textedit-base.slint`).
            //
            // A strip that is wider than the pane is reached two ways, both of
            // them 要件 6.3: the list beside it names every tab, and whichever
            // tab is in front pulls the strip to itself (`reveal-tab`).
            tabs-view := ScrollView {
                width: parent.width - 210px;
                height: parent.height;
                x: 0;
                y: 0;
                // No bars. This scrolls to follow the tab in front rather than
                // by being dragged, and a bar in a 34px band would be a second
                // thing to aim at beside the tabs themselves.
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                viewport-width: max(self.visible-width, strip.preferred-width);
                viewport-height: self.visible-height;

                strip := HorizontalLayout {
                    padding-left: 5px;
                    // 34 - 28: the tabs stand on the strip's bottom edge, so
                    // the one in front runs into the paper below it.
                    padding-top: 6px;
                    spacing: 2px;
                    // Start, so that two tabs are two tabs rather than two
                    // halves of the strip.
                    alignment: start;

                    for tab[index] in root.tabs: Tab {
                        title: tab.title;
                        edited: tab.edited;
                        outside: tab.outside;
                        provisional: tab.provisional;
                        own: tab.colour-own;
                        own-colour: tab.colour;
                        dark: tab.dark;
                        current: index == root.active-tab;
                        // 要件 6.3: the tab being written in. **Both halves** —
                        // the pane has the keyboard and this is the tab in
                        // front of it — because either alone names a tab
                        // nobody is typing into.
                        focused: root.focused && index == root.active-tab;
                        paper: root.page-background;
                        carrying: root.carrying;
                        carry-x: root.carry-x;
                        carried: root.carrying && index == root.carried-from;
                        // The mark goes on the side the carried tab is coming
                        // from, so it always stands in the gap the tab would
                        // fall into rather than on the far side of a neighbour.
                        // Nothing is marked while the hand is over another
                        // pane: the tab would not land here at all, and a mark
                        // that stays behind says it would.
                        landing: !root.carrying || !root.carry-over
                            || root.carried-to != index
                            || root.carried-from == index
                            ? 0
                            : (root.carried-from > index ? -1 : 1);
                        renamable: tab.renamable;
                        switchable: tab.terminal || (index == root.active-tab && root.terminal);
                        stem-length: tab.stem-length;
                        chosen => {
                            root.tab-selected(index);
                        }
                        rename-asked: root.tab-menu-target == index ? root.rename-token : 0;
                        // 追加要件 2026-09-07: **押し続けると、右ボタンと同じ
                        // メニューが同じところに出る。**接続先の行はその中に
                        // ある（書き手の指摘——出るなら右クリックと同じ位置が
                        // よい）。文書のタブでは同じ press が名前の書き換えに
                        // なる（そちらは`renamable`）。
                        shell-asked(x, y) => {
                            root.tab-selected(index);
                            root.tab-menu-target = index;
                            root.open-tab-menu(x, y);
                        }
                        menu-asked(x, y) => {
                            // **Chosen first.** Every row below acts on the tab
                            // in front, so the tab under the pointer has to be
                            // that one before the menu is up.
                            root.tab-selected(index);
                            root.tab-menu-target = index;
                            root.open-tab-menu(x, y);
                        }
                        renamed(name) => {
                            root.tab-renamed(index, name);
                        }
                        closed => {
                            root.tab-closed(index);
                        }
                        shown(at, wide) => {
                            root.reveal-tab(at, wide);
                        }
                        // **Where the pointer is, before there is a carry.**
                        // Every tab watches `carry-x`, so setting `carrying`
                        // first would have them all answer once against a
                        // position from no drag at all.
                        grabbed(at, window-x, window-y) => {
                            root.carry-x = at;
                            root.carried-from = index;
                            root.carried-to = index;
                            root.carrying = true;
                            root.carry-moved(window-x, window-y);
                        }
                        dragged(at, window-x, window-y) => {
                            root.carry-x = at;
                            root.carry-moved(window-x, window-y);
                        }
                        pointed-at => {
                            root.carried-to = index;
                        }
                        // **Asked first, put down second.** Clearing `carrying`
                        // rebuilds nothing, but the same order as every other
                        // row inside a repeater costs nothing to keep (6.24).
                        dropped(at-x, at-y) => {
                            root.tab-dropped(
                                root.carried-from, root.carried-to, at-x, at-y);
                        }
                        carry-ended => {
                            root.carrying = false;
                            root.carried-from = -1;
                            root.carried-to = -1;
                            root.carry-finished();
                        }
                    }

                    // 要件 6.5: where a tab carried in from another pane would
                    // land. **At the end**, because that is where it goes — a
                    // tab carried into a pane is one the writer wants in front,
                    // and the end of the strip is where a new tab belongs.
                    if root.carry-over && !root.carrying: Rectangle {
                        width: 2px;
                        // The tabs' own height, written out rather than left to
                        // the layout: the mark stands with them, and a strip
                        // that grows taller should take it along.
                        height: 28px;
                        background: Tok.accent;
                    }

                    // 追加要件 2026-09-06: **the band beside the tabs answers the
                    // right button.** It is inside the strip rather than behind
                    // it, because the tabs and this share one scrolling
                    // viewport and only the element that has the space can be
                    // sure it is the one being pointed at.
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 24px;

                        TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right
                                    && event.kind == PointerEventKind.down) {
                                    root.strip-menu-x = self.absolute-position.x
                                        + self.mouse-x - root.absolute-position.x;
                                    root.strip-menu-y = self.absolute-position.y
                                        + self.mouse-y - root.absolute-position.y;
                                    root.menu-opened();
                                    strip-menu.show();
                                }
                            }
                        }
                    }
                }
            }

            // The pane's own controls, held against the right edge.
            //
            // A stretchy spacer in the row above does not work: `alignment:
            // start` gives every child its preferred width and leaves the slack
            // at the end of the row, so nothing in the middle ever grows and
            // this group ends up packed against the tabs. Seven 26px buttons with
            // 2px between them is 194px, and that is what is held.
            //
            // **New Tab and the tab list are here rather than in the strip**
            // because the strip scrolls: a button that goes with the tabs is a
            // button that is gone exactly when there are enough tabs to need
            // it.
            Rectangle {
                width: 194px;
                height: 26px;
                x: parent.width - self.width - 8px;
                y: 4px;

                HorizontalLayout {
                    spacing: 2px;

                    // 追加要件 2026-09-07: **the `+` makes the tab, and the tab asks.**
                    // It used to ask first — a menu of three answers before there was
                    // anywhere to see the answer in. What it opens now is a New Tab
                    // with those three words standing in the middle of it, and a
                    // writer who wanted none of them can click a file in the tree.
                    IconButton {
                        icon: Icons.plus;
                        tip: "New Tab";
                        clicked => {
                            root.new-tab-requested();
                        }
                    }

                    IconButton {
                        icon: Icons.down;
                        tip: "All Tabs";
                        clicked => {
                            root.menu-opened();
                            tabs-menu.show();
                        }
                    }
                    IconButton {
                        icon: Icons.horizontal;
                        tip: "Horizontal" + (root.shortcut-keys[42] == "" ? "" : " · " + root.shortcut-keys[42]);
                        checked: !root.vertical;
                        // 追加要件 2026-09-06: **a shell has one direction.**
                        // The grid is rows of cells across; there is nothing
                        // here for 要件 7.2's other mode to mean, so the two
                        // buttons are dimmed rather than left to do nothing.
                        enabled: root.writing && !root.reading-only;
                        clicked => {
                            if (root.vertical) {
                                root.direction-toggled();
                            }
                        }
                    }
                    IconButton {
                        icon: Icons.vertical;
                        tip: "Vertical" + (root.shortcut-keys[42] == "" ? "" : " · " + root.shortcut-keys[42]);
                        checked: root.vertical;
                        enabled: root.writing && !root.reading-only;
                        clicked => {
                            if (!root.vertical) {
                                root.direction-toggled();
                            }
                        }
                    }
                    IconButton {
                        icon: Icons.preview;
                        tip: "Live Preview" + (root.shortcut-keys[43] == "" ? "" : " · " + root.shortcut-keys[43]);
                        checked: root.preview;
                        enabled: !root.viewer && !root.settings;
                        clicked => {
                            root.preview-toggled();
                        }
                    }
                    IconButton {
                        icon: "M1 2h5l2 2 2-2h5v12h-5l-2 1-2-1H1z M8 4v11";
                        tip: (root.reading-only ? "ReadOnlyを終了" : root.viewer ? "Viewerを終了" : root.preview ? "Viewerモード" : "ReadOnlyモード") + (root.shortcut-keys[44] == "" ? "" : " · " + root.shortcut-keys[44]);
                        checked: root.viewer;
                        enabled: root.writing;
                        clicked => { root.viewer-toggled(); }
                    }
                    IconButton {
                        icon: Icons.more;
                        tip: "Pane menu";
                        clicked => {
                            root.menu-opened();
                            pane-menu.show();
                        }
                    }
                }
            }

            // One of these per pane, because the menu acts on the pane it hangs
            // from: nothing in it has to name which pane it means.
            //
            // Every row closes the popup before it asks for anything. Half of
            // them change how many panes there are, and the window rebuilds the
            // repeater when that count changes — which is the same shape as
            // 6.18, where a repeater rebuilt under an open modal. Closing first
            // means the popup is already gone when its owner is replaced.
            // Every tab of this pane by name, whether it is on the strip or
            // past its end (要件 6.3). Picking one shows it, and the strip
            // scrolls to it because it is then the tab in front.
            tabs-menu := PopupWindow {
                x: parent.width - 258px;
                y: 32px;
                width: 250px;
                close-policy: close-on-click-outside;

                MenuFrame {
                    width: 250px;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 1px;

                        for tab[index] in root.tabs: MenuRow {
                            title: tab.title;
                            // The unsaved dot the tab itself carries, in the
                            // column the shortcuts use. There are no shortcuts
                            // in this menu to be confused with.
                            shortcut: (tab.outside ? "⚠" : "") + (tab.edited ? "●" : "");
                            checked: index == root.active-tab;
                            // **Chosen first, closed second**, which is the
                            // opposite of every row in the pane's menu below.
                            // These rows are a repeater inside the popup, so
                            // closing first takes the element whose handler is
                            // running with it and the line after it never runs.
                            // Slint's own `ComboBox` orders it this way for the
                            // same reason (`widgets/fluent/combobox.slint`).
                            // Nothing is rebuilt underneath the open popup by
                            // this: the Rust side hands the switch to the event
                            // loop rather than doing it in the callback.
                            activated => {
                                root.tab-selected(index);
                                tabs-menu.close();
                            }
                        }
                    }
                }
            }

            pane-menu := PopupWindow {
                x: parent.width - 256px;
                y: 32px;
                width: 250px;
                close-policy: close-on-click-outside;

                MenuFrame {
                    width: 250px;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 1px;

                        // 追加要件 2026-09-08: **シェルには名前も道も無く、
                        // 保存するものも無い**——タブのメニューが 2026-09-07 に
                        // 落とした3行と同じ理由で、こちらからも落とす。同じ
                        // ことを2か所で言っている限り、片方だけ直す日が来る。
                        //
                        // **`if`の中の行は頼んでから閉じる**（技術検証 6.24）。
                        if root.writing: VerticalLayout {
                            spacing: 1px;

                            MenuRow {
                                title: "Save";
                                shortcut: root.shortcut-keys[1];
                                activated => {
                                    root.save-requested();
                                    pane-menu.close();
                                }
                            }
                            MenuRow {
                                title: "Save As…";
                                shortcut: root.shortcut-keys[2];
                                activated => {
                                    root.save-as-requested();
                                    pane-menu.close();
                                }
                            }
                            MenuRow {
                                title: "Reveal in Explorer";
                                activated => {
                                    root.reveal-requested();
                                    pane-menu.close();
                                }
                            }
                            MenuSep { }
                        }
                        MenuRow {
                            title: "Close Tab";
                            shortcut: root.shortcut-keys[3];
                            activated => {
                                pane-menu.close();
                                root.close-active-tab();
                            }
                        }
                        MenuRow {
                            title: "Close Other Tabs";
                            activated => {
                                pane-menu.close();
                                root.close-other-tabs();
                            }
                        }
                        MenuRow {
                            title: "Close All Tabs";
                            activated => {
                                pane-menu.close();
                                root.close-all-tabs();
                            }
                        }
                        MenuSep { }
                        MenuRow {
                            title: "Split Right";
                            activated => {
                                pane-menu.close();
                                root.split-requested(true);
                            }
                        }
                        MenuRow {
                            title: "Split Down";
                            activated => {
                                pane-menu.close();
                                root.split-requested(false);
                            }
                        }
                        // 要件 6.4: 編集ペインの入れ替え。**One row per
                        // direction there is a pane in**, so the writer picks
                        // the place rather than a rule picking it for them.
                        //
                        // **The callback first, the close afterwards.** A row
                        // with an `if` on it is a repeated element (技術検証
                        // 6.24), and closing the menu takes away the very row
                        // whose handler is running.
                        if root.swap-left: MenuRow {
                            title: "Swap Left";
                            activated => {
                                root.swap-requested(0);
                                pane-menu.close();
                            }
                        }
                        if root.swap-right: MenuRow {
                            title: "Swap Right";
                            activated => {
                                root.swap-requested(1);
                                pane-menu.close();
                            }
                        }
                        if root.swap-up: MenuRow {
                            title: "Swap Up";
                            activated => {
                                root.swap-requested(2);
                                pane-menu.close();
                            }
                        }
                        if root.swap-down: MenuRow {
                            title: "Swap Down";
                            activated => {
                                root.swap-requested(3);
                                pane-menu.close();
                            }
                        }
                        MenuRow {
                            // 要件 6.4: bring the arrangement back to this pane
                            // alone. **The other panes' tabs come here** — a
                            // pane is never taken away from under the tabs it
                            // holds, which is why there is no row for closing
                            // this one: a pane goes when its last tab does.
                            title: "Close Other Panes";
                            activated => {
                                pane-menu.close();
                                root.close-others-requested();
                            }
                        }
                        MenuSep { }
                        // 追加要件 Terminal: **the strip along the foot.** Which
                        // of the two it is follows from the tab in front, so the
                        // row says which one the writer will get.
                        //
                        // **頼んでから閉じる**（技術検証 6.24、書き手の報告 2026-09-15）。
                        // 設定のTAB化で`if`に入ったとき順が残り、閉じた時点で行ごと
                        // 消えて、頼みが届いていなかった。
                        if !root.settings: MenuRow {
                            title: root.terminal ? "Editor Below" : "Terminal Below";
                            shortcut: root.terminal ? "Ctrl+`" : root.shortcut-keys[17];
                            activated => {
                                root.below-toggled();
                                pane-menu.close();
                            }
                        }
                        MenuSep { }
                        // 書き手の報告 2026-09-11: **画面とソースを合わせる。**
                        // ここは`Typography…`と言っていたが、開くのは`SETTINGS`の
                        // 面で、組み方が載っているタブの名前は`Layout`である
                        // ——3つの名前が別々を指していた。**この行が開くタブの名前で
                        // 呼ぶ**（開く先もその
                        // タブへ合わせてある）。
                        MenuRow {
                            title: "Layout…";
                            activated => {
                                pane-menu.close();
                                root.layout-requested();
                            }
                        }
                        // 追加要件 2026-09-15: このPaneの紙の色（TABの色が付いていればそちらが勝つ）。
                        if root.writing: MenuRow {
                            title: "Pane Background" + root.paper-direction + "…";
                            activated => {
                                root.open-paper-palette(1, root.width - 256px, 32px);
                                pane-menu.close();
                            }
                        }
                        if root.writing: MenuRow {
                            title: "Go to Line…";
                            shortcut: root.shortcut-keys[6];
                            activated => {
                                root.goto-requested(true);
                                pane-menu.close();
                            }
                        }
                        if root.writing: MenuRow {
                            title: "閉じたTABを開き直す";
                            shortcut: root.shortcut-keys[7];
                            activated => { root.reopen-closed-requested(); pane-menu.close(); }
                        }
                        if root.writing: MenuRow {
                            title: "保存版と比較";
                            activated => {
                                root.compare-saved-requested();
                                pane-menu.close();
                            }
                        }
                        if root.writing: MenuRow {
                            title: "前回のCommitと比較";
                            activated => {
                                root.compare-head-requested();
                                pane-menu.close();
                            }
                        }
                        if root.writing: MenuRow {
                            title: "別のファイルと比較…";
                            activated => {
                                root.compare-requested();
                                pane-menu.close();
                            }
                        }
                        // **These three take the keyboard back themselves**,
                        // where the rows above them let the window do it with
                        // `focus-generation`. The two signals they send are
                        // also the wheel's, and the wheel magnifies whatever
                        // the pointer is over without moving the keyboard —
                        // so the window cannot tell from the signal alone
                        // whether focus should follow, and this is the end
                        // that knows.
                        // 追加要件 2026-09-08: 倍率は文書のもの——シェルの
                        // 升目には効かない（右ボタンのメニューと同じ理由）。
                        if root.writing: VerticalLayout {
                            spacing: 1px;

                            MenuRow {
                                title: "Zoom In";
                                shortcut: "Ctrl+=";
                                activated => {
                                    root.zoom-stepped(1);
                                    ime-input.focus();
                                    pane-menu.close();
                                }
                            }
                            MenuRow {
                                title: "Zoom Out";
                                shortcut: "Ctrl+-";
                                activated => {
                                    root.zoom-stepped(-1);
                                    ime-input.focus();
                                    pane-menu.close();
                                }
                            }
                            MenuRow {
                                title: "Reset Zoom";
                                shortcut: "Ctrl+0";
                                activated => {
                                    root.zoom-reset-requested();
                                    ime-input.focus();
                                    pane-menu.close();
                                }
                            }
                        }
                    }
                }
            }
        }

        // 要件 7.7: finding and replacing, in the pane the document is in.
        //
        // **One row unless something is being replaced.** `Ctrl+F` and
        // `Ctrl+H` used to raise the same band with the same two fields in it,
        // and the second one was a field to look past every time the writer was
        // only looking for a word.
        //
        // The needle stretches and the count takes the slack, so the bar is at
        // home in half a window: a pane is not the width of the screen, and
        // 230px of field with a fixed gap after it is not something that fits
        // twice.
        if root.comparison-note != "": Rectangle {
            height: 34px;
            background: Tok.chrome;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 6px;
                Text {
                    text: root.comparison-note;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                TextButton {
                    title: "比較を終了";
                    clicked => { root.comparison-dismissed(); }
                }
            }
        }
        if root.find-open: Rectangle {
            height: root.find-bar-height;
            background: Tok.chrome;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Tok.rule;
            }

            VerticalLayout {
                Rectangle {
                    height: 34px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        spacing: 6px;

                        Rectangle {
                            width: 16px;
                            horizontal-stretch: 0;

                            Icon {
                                y: (parent.height - self.height) / 2;
                                commands: Icons.search;
                                tint: Tok.ink-faint;
                            }
                        }

                        needle := Field {
                            horizontal-stretch: 1;
                            min-width: 70px;
                            max-width: 230px;
                            placeholder: "Find";
                            text <=> root.find-needle;
                            // At `init` because the bar is built when it opens,
                            // and on the generation because asking for it again
                            // while it is already open has to bring the
                            // keyboard back (6.11).
                            property <int> asked: root.find-generation;
                            init => {
                                if (root.find-focus) {
                                    self.take-focus-selecting-all();
                                }
                            }
                            changed asked => {
                                if (root.find-focus) {
                                    self.take-focus-selecting-all();
                                }
                            }
                            // Enter is "the next one", which is what a writer
                            // expects from a search box they have just typed in.
                            accepted => {
                                root.find-step(true);
                            }
                            // 数だけが変わる。カーソルは動かない（E1）。
                            edited => {
                                root.find-typed();
                            }
                            escaped => {
                                if (!root.escaped()) { root.find-dismissed(); }
                            }
                            shortcut(event) => {
                                return root.find-keys(event, false);
                            }
                        }

                        Text {
                            text: root.find-status;
                            color: Tok.ink-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // E1: 探し方の3つ。**語の隣に置く**——いま何件と
                        // 言っているかは、この3つで変わるからである。
                        ToggleChip {
                            title: "Aa";
                            tip: "Match case";
                            checked: root.find-match-case;
                            clicked => {
                                root.find-option(0);
                            }
                        }
                        ToggleChip {
                            title: "W";
                            tip: "Whole word";
                            checked: root.find-whole-word;
                            clicked => {
                                root.find-option(1);
                            }
                        }
                        ToggleChip {
                            title: "[ ]";
                            tip: "In selection";
                            checked: root.find-in-scope;
                            clicked => {
                                root.find-option(2);
                            }
                        }
                        // E1（書き手の求め 2026-09-10）: 正規表現。**ワイルド
                        // カードもこれで書ける**（`*`は`.*`、`?`は`.`）ので、
                        // 切り替えは1つにしてある。
                        ToggleChip {
                            title: ".*";
                            tip: "Regular expression";
                            checked: root.find-regex;
                            clicked => {
                                root.find-option(3);
                            }
                        }

                        IconButton {
                            horizontal-stretch: 0;
                            icon: Icons.up;
                            tip: "Previous";
                            clicked => {
                                root.find-step(false);
                            }
                        }
                        IconButton {
                            horizontal-stretch: 0;
                            icon: Icons.down;
                            tip: "Next";
                            clicked => {
                                root.find-step(true);
                            }
                        }
                        IconButton {
                            horizontal-stretch: 0;
                            icon: Icons.clear;
                            tip: "Clear";
                            clicked => {
                                root.find-cleared();
                            }
                        }
                        IconButton {
                            horizontal-stretch: 0;
                            icon: Icons.close;
                            tip: "Close";
                            clicked => {
                                root.find-dismissed();
                            }
                        }
                    }
                }

                if root.find-replacing: Rectangle {
                    height: 34px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        spacing: 6px;

                        Rectangle {
                            width: 16px;
                            horizontal-stretch: 0;

                            Icon {
                                y: (parent.height - self.height) / 2;
                                commands: Icons.replace;
                                tint: Tok.ink-faint;
                            }
                        }

                        Field {
                            horizontal-stretch: 1;
                            min-width: 70px;
                            max-width: 230px;
                            placeholder: "Replace with…";
                            text <=> root.find-replacement;
                            accepted => {
                                root.replace-one();
                            }
                            escaped => {
                                if (!root.escaped()) { root.find-dismissed(); }
                            }
                            shortcut(event) => {
                                return root.find-keys(event, true);
                            }
                        }

                        TextButton {
                            horizontal-stretch: 0;
                            title: "Replace";
                            clicked => {
                                root.replace-one();
                            }
                        }
                        TextButton {
                            horizontal-stretch: 0;
                            title: "Replace All";
                            clicked => {
                                root.replace-every();
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        // E4: 指定の行へ行く帯。**検索の帯と同じ場所**——一行、Enterで行き、
        // `Esc`で閉じる。行けたら畳んで鍵盤を紙へ返す（行の指定は1回の用事で、
        // 探す語のように次があるものではない）。
        if root.goto-open: Rectangle {
            height: 34px;
            background: Tok.chrome;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Tok.rule;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 6px;

                Rectangle {
                    width: 16px;
                    horizontal-stretch: 0;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Icons.goto;
                        tint: Tok.ink-faint;
                    }
                }

                line-field := Field {
                    horizontal-stretch: 1;
                    min-width: 70px;
                    max-width: 160px;
                    placeholder: "Go to line";
                    text <=> root.goto-line;
                    property <int> asked: root.goto-generation;
                    init => {
                        self.take-focus-selecting-all();
                    }
                    changed asked => {
                        self.take-focus-selecting-all();
                    }
                    accepted => {
                        root.goto-accepted();
                    }
                    edited => {
                        root.goto-typed();
                    }
                    escaped => {
                        root.goto-dismissed();
                    }
                    shortcut(event) => {
                        return root.goto-keys(event);
                    }
                }

                // **どこまで行けるかが、開いた瞬間から出ている。**「128行までです」を
                // 打ってから知るのでは遅い（E4）。
                Text {
                    text: root.goto-status;
                    color: Tok.ink-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                IconButton {
                    horizontal-stretch: 0;
                    icon: Icons.close;
                    tip: "Close";
                    clicked => {
                        root.goto-dismissed();
                    }
                }
            }
        }

        body-clip := Rectangle {
            vertical-stretch: 1;
            clip: true;
            // The bar occupies layout space, but the document keeps its
            // original origin and height. Only its covered top is clipped.
        VerticalBox {
            y: -root.find-bar-height;
            width: parent.width;
            height: parent.height + root.find-bar-height;
            padding-top: root.page-margin;
            padding-bottom: root.page-margin;
            padding-left: root.side-padding;
            padding-right: root.side-padding;
            spacing: 8px;

            // **Nothing above the paper unless something went wrong.** The two
            // captions that used to sit here were from the verification days —
            // a fixed one naming the mode, which stopped being true once a pane
            // could switch, and the DirectWrite probe's measurements, which are
            // in `diag/Diag_*.log` where the rest of them are.
            //
            // Deliberately not wrapped: a width taken from the parent closes a
            // binding loop through VerticalBox's own sizing. The message puts
            // what matters first instead, so clipping the tail costs nothing
            // worth reading.
            if root.status != "": Text {
                text: root.status;
                color: Tok.ink-muted;
                font-size: 12px;
                x: root.text-indent;
            }

            scroll := ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: as-needed;
                vertical-scrollbar-policy: as-needed;
                viewport-x <=> root.scroll-x;
                viewport-y <=> root.scroll-y;
                viewport-width: max(self.visible-width, root.content-width * 1px);
                viewport-height: max(self.visible-height, root.content-height * 1px);

                // Reported at `init` as well as on change, for the reason 6.7 and
                // 6.11 both record: a pane is created when it becomes visible, so a
                // size that is right from birth never fires a change event and the
                // default is kept instead. Split creates it at half width, which is
                // exactly that case.
                init => {
                    root.shown-width = self.visible-width;
                    root.shown-height = self.visible-height;
                    root.wrap-height = self.visible-height;
                    root.resized();
                }
                changed viewport-x => {
                    if (root.vertical) {
                        root.scrolled(self.viewport-x / 1px);
                    } else {
                        root.across-scrolled(self.viewport-x / 1px);
                    }
                }
                changed viewport-y => {
                    if (!root.vertical) {
                        root.scrolled(self.viewport-y / 1px);
                    } else {
                        root.across-scrolled(self.viewport-y / 1px);
                    }
                }
                // One of these two is the flow axis and re-lays out the document;
                // the other only changes how much of it is on screen.
                changed visible-width => {
                    root.shown-width = self.visible-width;
                    if (root.vertical) {
                        root.scrolled(self.viewport-x / 1px);
                    } else {
                        root.resized();
                    }
                }
                changed visible-height => {
                    root.shown-height = self.visible-height;
                    root.wrap-height = self.visible-height;
                    if (root.vertical) {
                        root.resized();
                    } else {
                        root.scrolled(self.viewport-y / 1px);
                    }
                }

                page := Rectangle {
                    width: root.content-width * 1px;
                    height: root.content-height * 1px;
                    // 要件 9: when the line is shorter than the pane — the
                    // writer set a line length — the sheet stands in the middle
                    // of it rather than against one edge. **The whole of
                    // centring is here**: the tiles, the selection, the caret,
                    // the IME's anchor and the pointer that reports back are all
                    // inside this rectangle, so they are in the document's own
                    // coordinates whatever this one is. Moving the sheet instead
                    // of each of them is why none of them had to learn about it.
                    x: root.vertical ? 0px : max(0px, (parent.width - self.width) / 2);
                    y: root.vertical ? max(0px, (parent.height - self.height) / 2) : 0px;
                    background: root.page-background;
                    // 書き手の報告 2026-09-08:「設定を開いていると背面がちらつく」
                    // ——ちらついていたのはこの線だった。**Slintの`has-focus`は
                    // popupが開いた瞬間に落ちる**（`WindowInner::show_popup`が
                    // `FocusReason::PopupActivation`で焦点の要素を取り上げ、
                    // 閉じるときに返す）ので、メニューを開くたびに枠が消えて
                    // 戻っていた。指定幅で折り返しているときは、この枠が幅の
                    // 境界線そのものとして見えている（要件 9）ので、いちばん
                    // 目につく場所で点滅していたことになる。
                    //
                    // **要件 6.3 と同じ旗で言う**：アクセントは「キーボードは
                    // ここ」の色で、それを持っているのは`focused-pane`——Rust
                    // が決める値なので、popupが横から取り上げることがない。
                    // タブがアクセントを着る条件とこの枠の条件が同じになった
                    // （同じことを2か所で別々に判じていた、6.15の形）。
                    border-width: root.focused ? 2px : 0px;
                    border-color: Tok.accent;

                    // Held here rather than watched on the parent: a `changed`
                    // handler belongs to the element whose property it is, and this
                    // element only exists while the pane does. `init` as well, for
                    // 6.11's reason — switching mode creates this pane, so the bump
                    // that asked for the focus has already happened by the time it
                    // exists. Alone, either one leaves a case where the keyboard
                    // goes nowhere.
                    property <int> generation: root.focus-generation;
                    changed generation => {
                        root.focus-trace(root.takes-focus ? "request-generation" : "skip-generation");
                        if (root.takes-focus) {
                            // Reissue focus even if Slint still records this field
                            // as focused after a tab/direction change.
                            ime-input.clear-focus();
                            ime-input.focus();
                        }
                    }
                    init => {
                        if (root.takes-focus) {
                            root.focus-trace("request-init");
                            ime-input.clear-focus();
                            ime-input.focus();
                        }
                    }

                    editor := FocusScope {
                        width: parent.width;
                        height: parent.height;
                        focus-on-click: false;

                        for tile in root.tiles: Image {
                            x: tile.x * 1px;
                            y: tile.y * 1px;
                            width: tile.width * 1px;
                            height: tile.height * 1px;
                            source: tile.source;
                            image-fit: fill;
                            visible: root.vertical
                                ? (self.x + self.width + scroll.viewport-x >= 0px
                                    && self.x + scroll.viewport-x <= scroll.visible-width)
                                : (self.y + self.height + scroll.viewport-y >= 0px
                                    && self.y + scroll.viewport-y <= scroll.visible-height);
                        }

                        // E1: 範囲はいちばん下、いちばん薄く（書き手の求め
                        // 2026-09-09：「範囲を薄くハイライトしておいた方がいい」）
                        // ——検索が選択を動かすので、**範囲は選択では見えない**。
                        for scope in root.scope-rects: Rectangle {
                            x: scope.x * 1px;
                            y: scope.y * 1px;
                            width: scope.width * 1px;
                            height: scope.height * 1px;
                            background: Tok.accent-soft.transparentize(0.86);
                        }

                        // E1: 一致は薄く、下に。**同じ色の弱いほう**なので、
                        // 選択が重なれば自然に濃くなる——別の色を足すと、
                        // 「選ばれている」と「見つかっている」が別のことに
                        // 見えてしまう。
                        for difference in root.difference-rects: Rectangle {
                            x: difference.x * 1px;
                            y: difference.y * 1px;
                            width: difference.width * 1px;
                            height: difference.height * 1px;
                            background: Tok.accent-soft.transparentize(0.65);
                            border-color: Tok.accent.transparentize(0.4);
                            border-width: 1px;
                        }
                        for found in root.match-rects: Rectangle {
                            x: found.x * 1px;
                            y: found.y * 1px;
                            width: found.width * 1px;
                            height: found.height * 1px;
                            // **`opacity`ではなく色そのものを薄くする。**
                            // `opacity`は要素ごとに層を作るので、`の`のような
                            // 語では画面に何百枚も重なる——それが「色の変わり方が
                            // 壊れている」の正体である（書き手の報告 2026-09-09）。
                            // 透けた色を1枚置くのは、ただの塗りである。
                            background: Tok.accent-soft.transparentize(0.7);
                        }

                        for selection in root.selection-rects: Rectangle {
                            x: selection.x * 1px;
                            y: selection.y * 1px;
                            width: selection.width * 1px;
                            height: selection.height * 1px;
                            background: Tok.accent-soft;
                            opacity: 0.48;
                        }

                        // The caret lies across the writing direction: a bar down
                        // the line in horizontal text, a bar across the column in
                        // vertical text.
                        // **何でもないタブには文字を置く場所が無い**ので、
                        // 点滅する棒も出さない（追加要件 2026-09-07）。
                        if root.caret-visible && !root.empty: Rectangle {
                            x: root.caret-x * 1px;
                            y: root.caret-y * 1px;
                            width: root.vertical ? max(root.caret-width * 1px, 1px) : 2px;
                            height: root.vertical ? 2px : max(root.caret-height * 1px, 2px);
                            background: Tok.accent;
                        }

                        // The IME bridge. The characters are drawn by DirectWrite,
                        // so everything here is transparent; what this field is for
                        // is telling Windows where the composition is.
                        ime-input := TextInput {
                            // Moving the field is what tells Windows where the
                            // composition is, but moving it is not enough on its
                            // own: the position is reported when the field's own
                            // cursor changes, so the first conversion after a click
                            // opened where the caret used to be (技術検証 7.2).
                            // Touching the cursor here asks for it to be sent again.
                            // **Never while a conversion is up.** Over a
                            // document the caret moves when the writer moves
                            // it; over a shell it moves with every line the
                            // shell prints, and re-reporting the position
                            // starts the conversion over each time.
                            changed x => {
                                if (self.preedit-text == "") {
                                    self.set-selection-offsets(0, 0);
                                }
                            }
                            changed y => {
                                if (self.preedit-text == "") {
                                    self.set-selection-offsets(0, 0);
                                }
                            }
                            changed has-focus => {
                                root.focus-trace(self.has-focus ? "gained" : "lost");
                                if self.has-focus {
                                    root.focus-taken();
                                }
                            }
                            // Slint drops keyboard focus before dispatching a key
                            // when this item is fully clipped. Layout completion,
                            // tab changes and manual scrolling can leave the caret
                            // outside the viewport. Keep the invisible input inside
                            // it, without moving the document caret or scroll.
                            x: max(-scroll.viewport-x - page.x,
                                min(root.ime-anchor-x * 1px,
                                    -scroll.viewport-x - page.x + scroll.visible-width - self.width));
                            y: max(-scroll.viewport-y - page.y + max(0px, root.find-bar-height - scroll.y),
                                min(root.ime-anchor-y * 1px,
                                    -scroll.viewport-y - page.y + scroll.visible-height - self.height));
                            width: max(root.ime-anchor-width * 1px, 1px);
                            height: max(root.ime-anchor-height * 1px, 1px);
                            text <=> root.ime-buffer;
                            font-family: "Yu Gothic UI";
                            font-size: 1px;
                            color: transparent;
                            selection-foreground-color: transparent;
                            selection-background-color: transparent;
                            text-cursor-width: 0px;
                            // Not single-line: a single-line TextInput strips the
                            // newlines out of pasted text, and everything typed or
                            // pasted into this pane passes through here.
                            single-line: false;

                            edited => {
                                // 追加要件 2026-09-14: **設定の面に字は入らない。**
                                // 下の文書は代役で、打った字を受け取る先ではない。
                                if root.settings {
                                    root.had-preedit = false;
                                    self.text = "";
                                } else if root.had-preedit {
                                    root.had-preedit = false;
                                    root.commit-just-finished = true;
                                    commit-reset.start();
                                    root.text-input(self.text, true);
                                } else if root.commit-just-finished && self.text == "\n" {
                                    // The Enter that ended a conversion, arriving as
                                    // a line break now that the field accepts them.
                                    // The result itself came through the edit before
                                    // this one, so swallow it once.
                                    root.commit-just-finished = false;
                                    commit-reset.stop();
                                    self.text = "";
                                } else {
                                    root.text-input(self.text, false);
                                }
                            }
                            accepted => {
                                if root.settings {
                                    self.text = "";
                                } else if root.commit-just-finished {
                                    root.commit-just-finished = false;
                                    commit-reset.stop();
                                } else {
                                    root.text-input("\n", false);
                                }
                            }
                            changed preedit-text => {
                                if !root.settings {
                                    if self.preedit-text != "" {
                                        root.had-preedit = true;
                                    }
                                    root.preedit-changed(self.preedit-text);
                                }
                            }
                            key-pressed(event) => {
                                if (event.modifiers.control && (event.text == "f" || event.text == "F" || event.text == "\u{6}" || event.text == "h" || event.text == "H" || event.text == "\u{8}")) {
                                    root.focus-trace((event.text == "f" || event.text == "F" || event.text == "\u{6}") ? "body-ctrl-f-received" : "body-ctrl-h-received");
                                    if (self.preedit-text != "") { root.focus-trace("find-key-preedit-active"); }
                                    if (root.terminal) { root.focus-trace("find-key-terminal"); }
                                }
                                if (event.modifiers.control && (event.text == "w" || event.text == "W" || event.text == "\u{17}")) {
                                    root.focus-trace("ctrl-w-received");
                                    if (root.terminal) { root.focus-trace("ctrl-w-terminal"); }
                                    if (self.preedit-text != "") { root.focus-trace("ctrl-w-preedit-active"); }
                                    if (self.text != "") { root.focus-trace("ctrl-w-input-pending"); }
                                }
                                // 追加要件 2026-09-14: **設定の面が通すのは窓の
                                // 鍵だけ。**TABを閉じる・移る、ペインを移る、
                                // ファイルを開く——どれを通すかはRustが1か所で
                                // 決める（`shortcuts::wire`）。残りの鍵は、ここで
                                // 飲む：本文へ落ちれば代役の文書に字が入る。
                                if (root.settings) {
                                    if (self.preedit-text == "") {
                                        root.shortcut-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                    }
                                    return accept;
                                }
                                // **A shell takes every key.** Nothing below
                                // applies to it: those rows are the editor's
                                // shortcuts, and the same chords mean other
                                // things on the other side of the pipe.
                                if (root.terminal && event.modifiers.control
                                    && event.text == "`") {
                                    root.below-toggled();
                                    return accept;
                                }
                                // 要件 11.3 と追加要件 Terminal: **フォーカスの
                                // 移動はシェルより先。**Ctrl+Altの矢印は
                                // どのペインで押しても同じ意味でなければならず、
                                // シェルに渡してしまうと端末のタブだけ効かない。
                                if (root.terminal && event.modifiers.control
                                    && event.modifiers.alt) {
                                    if (event.text == Key.DownArrow && root.below-kind != 0) {
                                        root.below-entered();
                                        return accept;
                                    }
                                    if (event.text == Key.LeftArrow) {
                                        root.focus-moved(0);
                                        return accept;
                                    }
                                    if (event.text == Key.RightArrow) {
                                        root.focus-moved(1);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        root.focus-moved(2);
                                        return accept;
                                    }
                                    if (event.text == Key.DownArrow) {
                                        root.focus-moved(3);
                                        return accept;
                                    }
                                }
                                if (root.terminal) {
                                    // 要件 11.2: **`Ctrl+V` is left to the
                                    // field.** It fills itself from the
                                    // clipboard and hands the text over as
                                    // typing, which is exactly what a paste
                                    // into a shell is — and it is the one way
                                    // this side can read the clipboard at all.
                                    if (event.modifiers.control
                                        && (event.text == "v" || event.text == "V")) {
                                        return reject;
                                    }
                                    root.terminal-key(
                                        event.text,
                                        key-number(event.text),
                                        event.modifiers.control,
                                        event.modifiers.alt,
                                        root.shift-held(event.modifiers.shift));
                                    return accept;
                                }
                                if self.preedit-text == "" && root.shortcut-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) { return accept; }
                                // The way out of a menu (要件 6.7).
                                // **Handled here rather than inside the
                                // menus**: a `FocusScope` in a popup takes the
                                // keyboard, and a popup that is dismissed by a
                                // click outside never runs any of our code to
                                // give it back (6.14). The keyboard stays where
                                // it is, and the key travels instead.
                                //
                                // 書き手の報告 2026-09-12:「選択になって戻れなく
                                // なる」。**下の`if`の前で受ける**——欄に字が
                                // 残っているあいだ下の行はどれも動かないので、
                                // 戻る道まで一緒に塞がっていた。残っている字は
                                // ここで落とす：本文へはもう入っており、次の
                                // `edited`でもう一度渡されるだけのものである。
                                // **変換の途中は渡さない**：そのEscapeは変換を
                                // 取り消すWindowsのものである。
                                if (event.text == Key.Escape && self.preedit-text == "") {
                                    if (self.text != "") {
                                        self.text = "";
                                    }
                                    if (root.escaped() || root.dismiss-menus()
                                        || root.selection-escaped()) {
                                        return accept;
                                    }
                                    return reject;
                                }
                                if self.preedit-text == "" && self.text == "" {
                                    // 追加要件 Terminal: the strip along the
                                    // foot, on the key every terminal uses for
                                    // it.
                                    if (event.modifiers.control && event.text == "`") {
                                        root.below-toggled();
                                        return accept;
                                    }
                                    // **下段があるなら、下はそちら。**無ければ
                                    // 下の行が隣のペインへ運ぶ（要件 11.3）。
                                    if (event.modifiers.control && event.modifiers.alt
                                        && event.text == Key.DownArrow
                                        && root.below-kind != 0) {
                                        root.below-entered();
                                        return accept;
                                    }
                                    // Enter is handled here rather than left to the
                                    // field, so a line break is inserted exactly
                                    // once whatever a multi-line TextInput would do
                                    // with the key itself.
                                    if event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                                        && (event.text == "t" || event.text == "T" || event.text == "\u{14}") {
                                        root.reopen-closed-requested(); return accept;
                                    }
                                    if event.modifiers.control && !event.modifiers.alt
                                        && (event.text == "o" || event.text == "O" || event.text == "\u{f}") {
                                        root.open-file-requested();
                                        return accept;
                                    }
                                    if event.modifiers.control
                                        && (event.text == "s" || event.text == "S" || event.text == "\u{13}") {
                                        // **Shiftは別の用事**（書き手の報告
                                        // 2026-09-10：「Ctrl+Shift+Sが効いて
                                        // いないと思います。Ctrl+Sと同じ動き」）。
                                        // Shiftを押した`s`は大文字の`S`で届く
                                        // ので、修飾を見ずに`S`まで拾っていた
                                        // この行が、名前を付けて保存を飲み込んで
                                        // いた——**メニューが`Ctrl+Shift+S`と
                                        // 出しているのに受ける行が無い**のは、
                                        // 2026-09-09の`Ctrl+W`と同じ穴である。
                                        if (root.shift-held(event.modifiers.shift)) {
                                            root.save-as-requested();
                                        } else {
                                            root.save-requested();
                                        }
                                        accept
                                    // 追加要件 2026-09-09: **メニューが言って
                                    // いたことを、いま受ける。**ペインの`⋮`も
                                    // タブのメニューも「Close Tab / Ctrl+W」と
                                    // 出していたのに、その鍵を受ける行がどこにも
                                    // 無かった——書いてあるのに効かないのは、
                                    // 働いていない状態が画面に出ていないのと
                                    // 同じことである（単語チェックモード要件
                                    // 2.1.1）。**端末は上で先に返している**ので
                                    // ここには来ない：Ctrl+Wはシェルでは
                                    // 「直前の語を消す」で、そちらの意味を
                                    // 奪ってはいけない。
                                    } else if event.modifiers.control
                                        && (event.text == "w" || event.text == "W" || event.text == "\u{17}") {
                                        root.focus-trace("ctrl-w-dispatch");
                                        root.close-active-tab();
                                        accept
                                    } else if event.modifiers.control
                                        && (event.text == "f" || event.text == "F" || event.text == "\u{6}") {
                                        root.find-requested(false);
                                        accept
                                    } else if event.modifiers.control
                                        && (event.text == "h" || event.text == "H" || event.text == "\u{8}") {
                                        root.find-requested(true);
                                        accept
                                    // E4: 指定の行へ（要件 11.2）。**端末は上で
                                    // 先に返している**ので、ここには来ない。
                                    } else if event.modifiers.control
                                        && (event.text == "g" || event.text == "G" || event.text == "\u{7}") {
                                        root.goto-requested(false);
                                        accept
                                    // E3の②: 行を消す（要件 11.2）。**Shiftも
                                    // 見る**——`Ctrl+K`だけならEmacsの「行末まで
                                    // 消す」と読める鍵で、そちらは要件 11.4 の
                                    // ものである。
                                    } else if event.modifiers.control && root.shift-held(event.modifiers.shift)
                                        && (event.text == "k" || event.text == "K" || event.text == "\u{b}") {
                                        root.line-edit(4);
                                        accept
                                    // E10: 選んだ行を箇条書きにする（要件 11.2）。
                                    // **Shiftを押した8と7が何の字で届くかは
                                    // 鍵盤で違う**——JISでは`(`と`'`、USでは
                                    // `*`と`&`である。`Ctrl+Shift`を押しながら
                                    // 打った字が本文へ入ることはないので、
                                    // どれで届いても同じ意味に取る（`Ctrl+=`が
                                    // `+`でも来るのと同じ）。
                                    } else if event.modifiers.control && root.shift-held(event.modifiers.shift)
                                        && (event.text == "8" || event.text == "*" || event.text == "(") {
                                        root.list-edit(0, -1);
                                        accept
                                    } else if event.modifiers.control && root.shift-held(event.modifiers.shift)
                                        && (event.text == "7" || event.text == "&" || event.text == "'") {
                                        root.list-edit(1, -1);
                                        accept
                                    // E1: **本文に戻ってもF3で次／前へ。**帯は
                                    // 開いていなくてよい——最後に探した語は
                                    // `find-needle`に残っている。
                                    } else if event.text == Key.F3 {
                                        root.find-again(!root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.modifiers.control
                                        && (event.text == "z" || event.text == "Z" || event.text == "\u{1a}") {
                                        root.undo-requested(false);
                                        accept
                                    } else if event.modifiers.control
                                        && (event.text == "y" || event.text == "Y" || event.text == "\u{19}") {
                                        root.undo-requested(true);
                                        accept
                                    } else if event.modifiers.control
                                        && (event.text == "a" || event.text == "A" || event.text == "\u{1}") {
                                        root.select-all();
                                        accept
                                    // 要件 11.2. **Taken here rather than left
                                    // to the field**: the field is empty — it
                                    // carries a conversion, not the document —
                                    // so its own copy would hand over nothing.
                                    // Paste needs no row: Ctrl+V fills the
                                    // field, and `edited` carries it in.
                                    } else if event.modifiers.control
                                        && (event.text == "c" || event.text == "C" || event.text == "\u{3}") {
                                        root.copy-requested(false);
                                        accept
                                    } else if event.modifiers.control
                                        && (event.text == "x" || event.text == "X" || event.text == "\u{18}") {
                                        root.copy-requested(true);
                                        accept
                                    // 要件 11.5, and what the pane's own menu
                                    // has been advertising. Both shapes of
                                    // each key: the row the writer presses
                                    // sends "=" or "+" depending on Shift, and
                                    // "-" or "_".
                                    } else if event.modifiers.control
                                        && (event.text == "=" || event.text == "+") {
                                        root.zoom-stepped(1);
                                        accept
                                    } else if event.modifiers.control
                                        && (event.text == "-" || event.text == "_") {
                                        root.zoom-stepped(-1);
                                        accept
                                    } else if event.modifiers.control && event.text == "0" {
                                        root.zoom-reset-requested();
                                        accept
                                    // 要件 11.3. **Before the plain Tab row
                                    // below**, which indents: the modifier is
                                    // what tells the two apart, and the chain
                                    // is read in order.
                                    // 要件 11.4. **Ctrl+D is the Delete key**,
                                    // so it goes through the same callback:
                                    // the requirement asks for the same act,
                                    // not for a second way of doing it.
                                    } else if event.modifiers.control
                                        && (event.text == "d" || event.text == "D" || event.text == "\u{4}") {
                                        root.delete-pressed();
                                        accept
                                    } else if event.modifiers.control
                                        && (event.text == "k" || event.text == "K" || event.text == "\u{b}") {
                                        root.kill-requested(0);
                                        accept
                                    // **Alt without Ctrl** for the three that
                                    // Emacs puts on Meta: Windows reads Ctrl
                                    // held with Alt as AltGr, and a row that
                                    // did not say so would answer a writer
                                    // typing a character on a European layout.
                                    // 要件 11.4. **The same ±3 in both panes**:
                                    // a word later in the text is later in the
                                    // text whichever way the pane runs, where
                                    // the arrows' ±1/±2 are the flow's.
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && (event.text == "f" || event.text == "F") {
                                        root.move-caret(3, root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && (event.text == "b" || event.text == "B") {
                                        root.move-caret(-3, root.shift-held(event.modifiers.shift));
                                        accept
                                    // 要件 11.4 と 要件 7.1: **Shift is what
                                    // makes it a rectangle.** The two are one
                                    // key with one answer, because starting a
                                    // selection and choosing its shape are the
                                    // same act.
                                    } else if event.modifiers.control && event.text == " " {
                                        root.mark-toggled(root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && (event.text == "w" || event.text == "W") {
                                        root.kill-requested(1);
                                        accept
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && (event.text == "x" || event.text == "X") {
                                        root.kill-requested(2);
                                        accept
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && !root.shift-held(event.modifiers.shift)
                                        && (event.text == "y" || event.text == "Y") {
                                        root.kill-requested(3);
                                        accept
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && root.shift-held(event.modifiers.shift)
                                        && (event.text == "y" || event.text == "Y") {
                                        root.kill-requested(4);
                                        accept
                                    } else if event.modifiers.control && event.text == Key.Tab {
                                        root.tab-stepped(root.shift-held(event.modifiers.shift));
                                        accept
                                    // 要件 11.3, and **before the arrow rows**
                                    // for the same reason. Held together with
                                    // Alt so that Ctrl+arrow stays free for the
                                    // word-wise moves 要件 11.4 will want.
                                    } else if event.modifiers.control && event.modifiers.alt
                                        && event.text == Key.LeftArrow {
                                        root.focus-moved(0);
                                        accept
                                    } else if event.modifiers.control && event.modifiers.alt
                                        && event.text == Key.RightArrow {
                                        root.focus-moved(1);
                                        accept
                                    } else if event.modifiers.control && event.modifiers.alt
                                        && event.text == Key.UpArrow {
                                        root.focus-moved(2);
                                        accept
                                    } else if event.modifiers.control && event.modifiers.alt
                                        && event.text == Key.DownArrow {
                                        root.focus-moved(3);
                                        accept
                                    // 書き手の報告 2026-09-07: 戻ると進む。
                                    // **矢印の行より前**——下の行は修飾キーを
                                    // 見ないので、ここを通さないとキャレットが
                                    // 動くだけになる。
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && event.text == Key.LeftArrow {
                                        root.navigate-requested(false);
                                        accept
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && event.text == Key.RightArrow {
                                        root.navigate-requested(true);
                                        accept
                                    } else if event.text == Key.Return {
                                        root.enter-pressed(root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.text == Key.Backspace {
                                        root.backspace-pressed();
                                        accept
                                    } else if event.text == Key.Tab {
                                        root.tab-pressed(root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.text == Key.Delete {
                                        root.delete-pressed();
                                        accept
                                    // E3の②（要件 11.2）: 行そのものを動かす。
                                    // **Ctrlは付けない**——`Ctrl+Alt+矢印`は隣の
                                    // ペインへ移る鍵である（要件 11.3）。
                                    } else if event.modifiers.alt && !event.modifiers.control
                                        && (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                                        // 0=前へ 1=後へ 2=前へ写す 3=後へ写す
                                        root.line-edit(
                                            (root.shift-held(event.modifiers.shift) ? 2 : 0)
                                            + (event.text == Key.DownArrow ? 1 : 0));
                                        accept
                                    } else if event.text == Key.UpArrow {
                                        // A step along the line in vertical text,
                                        // a step between lines in horizontal text.
                                        root.move-caret(root.vertical ? -1 : -2, root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.text == Key.DownArrow {
                                        root.move-caret(root.vertical ? 1 : 2, root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.text == Key.LeftArrow {
                                        root.move-caret(root.vertical ? -2 : -1, root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.text == Key.RightArrow {
                                        root.move-caret(root.vertical ? 2 : 1, root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.text == Key.Home {
                                        root.home-end(false, event.modifiers.control, root.shift-held(event.modifiers.shift));
                                        accept
                                    } else if event.text == Key.End {
                                        root.home-end(true, event.modifiers.control, root.shift-held(event.modifiers.shift));
                                        accept
                                    } else {
                                        reject
                                    }
                                } else {
                                    reject
                                }
                            }
                        }

                        pointer := TouchArea {
                            // Vertical writing draws its own pointer below, so the
                            // system one is taken away there.
                            mouse-cursor: root.vertical ? none : text;
                            scroll-event(event) => {
                                // 要件 9, 11.5: with Control down the wheel
                                // magnifies this pane instead of moving it.
                                // **Whichever axis the wheel reports** — a
                                // wheel that only says y is the usual one, and
                                // a pane writing vertically still gets a
                                // notch out of it.
                                if (event.modifiers.control) {
                                    let notch = event.delta-y != 0px
                                        ? event.delta-y
                                        : event.delta-x;
                                    if (notch != 0px) {
                                        root.zoom-stepped(notch > 0px ? 1 : -1);
                                    }
                                    return accept;
                                }
                                // **A shell has its own history to move
                                // through** (追加要件 Terminal), and it is not
                                // the pane's scroll: what is on the screen is
                                // everything the pane holds, and the rest has
                                // already gone by.
                                if (root.terminal) {
                                    root.terminal-scrolled(
                                        event.delta-y != 0px
                                            ? event.delta-y / 1px
                                            : event.delta-x / 1px);
                                    return accept;
                                }
                                if (root.vertical) {
                                    // 要件 7.5: the wheel moves the document
                                    // sideways. A wheel that only reports y still
                                    // has to work, so it is turned.
                                    let delta = event.delta-x != 0px ? event.delta-x : -event.delta-y;
                                    let minimum-x = min(0px, scroll.visible-width - scroll.viewport-width);
                                    scroll.viewport-x = max(minimum-x, min(0px, scroll.viewport-x + delta));
                                } else {
                                    let delta = event.delta-y != 0px ? event.delta-y : event.delta-x;
                                    let minimum-y = min(0px, scroll.visible-height - scroll.viewport-height);
                                    scroll.viewport-y = max(minimum-y, min(0px, scroll.viewport-y + delta));
                                }
                                accept
                            }
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.back
                                    || event.button == PointerEventButton.forward) {
                                    if (event.kind == PointerEventKind.down) {
                                        root.navigate-requested(event.button == PointerEventButton.forward);
                                    }
                                    return;
                                }
                                // 追加要件 2026-09-06: **the right button opens
                                // the pane's own menu where the pointer is.**
                                // The rows are the ⋮ menu's plus the ones a
                                // hand on the text wants: what is selected, and
                                // what is beside the pane.
                                if event.button == PointerEventButton.right
                                    && event.kind == PointerEventKind.down {
                                    root.context-x = self.mouse-x;
                                    root.context-y = self.mouse-y;
                                    root.menu-opened();
                                    // **開くたびに畳んでおく**——前に開いた形が
                                    // 残っていると、右クリックの長さが回ごとに違う。
                                    root.bullet-rows-open = false;
                                    context-menu.show();
                                    return;
                                }
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                    if event.modifiers.control && root.link-open(self.mouse-x / 1px, self.mouse-y / 1px) {
                                        root.dragging = false;
                                        return;
                                    }
                                    root.dragging = true;
                                    root.selection-start(
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px,
                                        event.modifiers.shift,
                                    );
                                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                                    if root.dragging {
                                        root.selection-end(self.mouse-x / 1px, self.mouse-y / 1px);
                                    }
                                    root.dragging = false;
                                    ime-input.focus();
                                }
                            }
                            // `pressed` rather than the flag alone: the flag only
                            // clears on a pointer-up this area actually receives,
                            // and a drag that ends anywhere else leaves it set.
                            // Every mouse move over the pane then moved the caret,
                            // which looked like the two panes being wired together.
                            moved => {
                                if root.dragging && self.pressed {
                                    root.selection-update(self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            }
                        }

                        // 追加要件 2026-09-06: the right button's menu. Declared
                        // here so that `ime-input` is already in scope — Slint
                        // has no forward references, and Paste is the field's
                        // own doing (it is the one thing on this side that can
                        // read the clipboard).
                        // 追加要件 2026-09-15: 本文の右クリックから開く、このTABの紙の色。
                        // 右クリックのメニューと同じ場所に出す（同じ座標の中に置く）。
                        body-palette := PopupWindow {
                            x: root.context-x;
                            y: root.context-y;
                            width: 236px;
                            close-policy: close-on-click-outside;

                            MenuFrame {
                                width: 236px;

                                ColourPalette {
                                    automatic: "既定の色";
                                    current: root.page-background;
                                    chosen(colour) => {
                                        root.paper-chosen(0, colour);
                                        body-palette.close();
                                    }
                                    automatic-chosen => {
                                        root.paper-default(0);
                                        body-palette.close();
                                    }
                                    more => {
                                        root.paper-more(0);
                                        body-palette.close();
                                    }
                                }
                            }
                        }

                        context-menu := PopupWindow {
                            x: root.context-x;
                            y: root.context-y;
                            // **右に開くぶんの場所を、開いているあいだだけ取る**
                            // （書き手の求め 2026-09-11）。popupは自分の大きさの
                            // 外を描かないので、広げておかないと右の面が切れる。
                            width: root.bullet-rows-open ? 408px : 264px;
                            close-policy: close-on-click-outside;

                            // **左端に寄せる**（書き手の報告 2026-09-11：「元の
                            // メニューも右に動きます」「メニューが透明になりました」）。
                            // popupの中の子は**真ん中に寄る**ので、右に開くぶんを
                            // 広げた幅の半分だけメニューが動いていた。**`x`で釘を
                            // 打つと、その子はpopupの並べ方から外れて枠の高さを
                            // 失う**（透明になったのはそれ）——寄せ方そのものを
                            // 言うほうが正しい。
                            HorizontalLayout {
                                alignment: start;

                                MenuFrame {
                                    width: 264px;

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 1px;

                                        // 追加要件 2026-09-08: **押しても何も
                                        // 起きない行は出さない。**シェルが前に
                                        // 出ているとき、この面の下にある文書は
                                        // 見えていない——`Cut`はその見えない文書
                                        // から切り取り、`Ctrl+Space`はその中に印を
                                        // 置いていた。
                                        //
                                        // **`if`の中の行は頼んでから閉じる**
                                        // （技術検証 6.24・6.30）。`close`はこの木を
                                        // 捨て、捨てられた木から`root`へ登ろうと
                                        // した生成コードは黙って何もしない。
                                        if root.writing: MenuRow {
                                            title: "Undo";
                                            shortcut: root.shortcut-keys[8];
                                            enabled: root.can-undo;
                                            activated => {
                                                root.undo-requested(false);
                                                context-menu.close();
                                            }
                                        }
                                        if root.writing: MenuRow {
                                            title: "Redo";
                                            shortcut: root.shortcut-keys[9];
                                            enabled: root.can-redo;
                                            activated => {
                                                root.undo-requested(true);
                                                context-menu.close();
                                            }
                                        }
                                        if root.writing: MenuSep { }
                                        if root.writing: MenuRow {
                                            title: "Cut";
                                            shortcut: "Ctrl+X";
                                            activated => {
                                                root.copy-requested(true);
                                                context-menu.close();
                                            }
                                        }
                                        // **Copyは両方にある。**シェルにも選択は
                                        // あり（要件 11.2）、選ばれているものを
                                        // 写すのがこの行の意味——どちらから写すかは
                                        // Rustが前に出ているものを見て決める。
                                        // 綴じ目だけが違うので、そこは文言で言う。
                                        MenuRow {
                                            title: "Copy";
                                            shortcut: root.terminal ? "Ctrl+Shift+C" : "Ctrl+C";
                                            activated => {
                                                context-menu.close();
                                                root.copy-requested(false);
                                            }
                                        }
                                        MenuRow {
                                            title: "Paste";
                                            shortcut: "Ctrl+V";
                                            activated => {
                                                context-menu.close();
                                                // **The field pastes, and what it
                                                // takes comes in as typing** — the
                                                // same road every paste travels,
                                                // shell included.
                                                ime-input.focus();
                                                ime-input.paste();
                                            }
                                        }
                                        if root.writing: MenuRow {
                                            title: "本文だけをコピー";
                                            activated => {
                                                root.copy-body-requested();
                                                context-menu.close();
                                            }
                                        }
                                        // E10（2026-09-11）: 選んだ行を後から
                                        // 箇条書きにする。**もう一度押せば外れる**
                                        // ので、行は2つで足りる（書き手の選択）。
                                        //
                                        // **選択が無くても出す。**カーソルの行1行が
                                        // そのまま選ばれているものである（E3の②の
                                        // `selected_lines`と同じ見方）——押せない行を
                                        // 出さないのと、機能の入口を隠すのは違う。
                                        if root.writing: VerticalLayout {
                                            spacing: 1px;

                                            MenuSep { }

                                            // 書き手の選択 2026-09-11（案C）:
                                            // **読む記号ぶんの行を出す。**記号ごとに
                                            // 画面の印が違うので、どれで書くかは
                                            // 書き手が選ぶ——**鍵はいちばん前の記号**
                                            // で、その行にだけ鍵を書く。
                                            //
                                            // **`for`の中に`if`は書けない**ので
                                            // 3つ並べてある（技術検証の段階2b）。
                                            // 記号が3つしかないうちは、これが読める。
                                            // 書き手の求め 2026-09-11: **右に開く階層に
                                            // する。**記号ぶんの行を並べると右クリックが
                                            // 長い——**この行だけが出ていて、乗せれば
                                            // 右に開く**（Windowsのメニューの普通）。
                                            // 読む記号が1つも無ければ、開いても空である
                                            // （書き手の言葉：「何も選ばれていなければ、空」）。
                                            //
                                            // **入れ子のpopupにはしない。**popupを閉じると
                                            // その木ごと消え、消えた木から`root`へ登った
                                            // 生成コードは黙って何もしない（6.24・6.30）
                                            // ——同じ木の中で右へ出せば、その罠の外にいる。
                                            Rectangle {
                                                height: 28px;

                                                bullet-row := MenuRow {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    title: "Bullet List";
                                                    shortcut: "▸";
                                                    // **乗せれば開く。**押しても開く
                                                    // ——押した書き手を待たせない。
                                                    changed hovered => {
                                                        if (self.hovered) {
                                                            root.bullet-rows-open = true;
                                                        }
                                                    }
                                                    activated => {
                                                        root.bullet-rows-open
                                                            = !root.bullet-rows-open;
                                                    }
                                                }

                                                if root.bullet-rows-open: MenuFrame {
                                                    x: parent.width - 8px;
                                                    y: -6px;
                                                    width: 136px;
                                                    height: bullet-rows.preferred-height;

                                                    bullet-rows := VerticalLayout {
                                                        padding: 6px;
                                                        spacing: 1px;

                                                        if root.bullet-marks[0]: MenuRow {
                                                            title: "-";
                                                            shortcut: "Ctrl+Shift+8";
                                                            // **頼んでから閉じる**（6.24）。
                                                            activated => {
                                                                root.list-edit(0, 0);
                                                                context-menu.close();
                                                            }
                                                        }
                                                        if root.bullet-marks[1]: MenuRow {
                                                            title: "*";
                                                            shortcut: root.bullet-marks[0]
                                                                ? ""
                                                                : "Ctrl+Shift+8";
                                                            activated => {
                                                                root.list-edit(0, 1);
                                                                context-menu.close();
                                                            }
                                                        }
                                                        if root.bullet-marks[2]: MenuRow {
                                                            title: "+";
                                                            shortcut: root.bullet-marks[0]
                                                                || root.bullet-marks[1]
                                                                ? ""
                                                                : "Ctrl+Shift+8";
                                                            activated => {
                                                                root.list-edit(0, 2);
                                                                context-menu.close();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            MenuRow {
                                                title: "Numbered List";
                                                shortcut: "Ctrl+Shift+7";
                                                // **別の行へ移ったら畳む**（Windowsの
                                                // メニューと同じ）。
                                                changed hovered => {
                                                    if (self.hovered) {
                                                        root.bullet-rows-open = false;
                                                    }
                                                }
                                                activated => {
                                                    root.list-edit(1, -1);
                                                    context-menu.close();
                                                }
                                            }
                                            // E10の②: **開始番号は打ち直して
                                            // 揃える**（書き手の選択 2026-09-11）。
                                            // 先頭を`5.`に直してここを押せば、下が
                                            // `6. 7. …`になる——数を訊く画面は無い。
                                            MenuRow {
                                                title: "Renumber";
                                                changed hovered => {
                                                    if (self.hovered) {
                                                        root.bullet-rows-open = false;
                                                    }
                                                }
                                                activated => {
                                                    root.list-edit(2, -1);
                                                    context-menu.close();
                                                }
                                            }
                                        }
                                        // 要件 7.9（2026-09-08）: **書きながら語を
                                        // 足す、いちばん普通の道。**選んだものを
                                        // そのままセットへ入れる——一覧を開いて
                                        // 打ち込むのは、その次である（要件 3）。
                                        //
                                        // **選択があるときだけ**出す。セットが1冊
                                        // なら行は1つ、複数なら名前が並ぶ。
                                        if root.writing && root.has-selection
                                            && root.word-sets.length > 0: VerticalLayout {
                                            spacing: 1px;

                                            MenuSep { }

                                            for name[index] in root.word-sets: MenuRow {
                                                title: "単語帳へ追加：" + name;
                                                // **頼んでから閉じる**（6.24）。
                                                activated => {
                                                    root.word-add-requested(index);
                                                    context-menu.close();
                                                }
                                            }
                                        }

                                        if root.writing: VerticalLayout {
                                            spacing: 1px;

                                            MenuSep { }

                                            MenuRow {
                                                title: "Start Selection";
                                                shortcut: root.shortcut-keys[25];
                                                activated => {
                                                    root.mark-toggled(false);
                                                    context-menu.close();
                                                }
                                            }
                                            MenuRow {
                                                title: "Start Rectangle Selection";
                                                shortcut: root.shortcut-keys[26];
                                                activated => {
                                                    root.mark-toggled(true);
                                                    context-menu.close();
                                                }
                                            }

                                            MenuSep { }

                                            // 追加要件 2026-09-15（書き手）: **本文の紙の上の右クリックで背景。**
                                            // このTABの紙の色（見えている向き）。
                                            MenuRow {
                                                title: "Background" + root.paper-direction + "…";
                                                activated => {
                                                    root.paper-target = 0;
                                                    body-palette.show();
                                                    context-menu.close();
                                                }
                                            }
                                        }
                                        MenuSep { }
                                        MenuRow {
                                            title: root.terminal ? "Editor Below" : "Terminal Below";
                                            shortcut: root.terminal ? "Ctrl+`" : root.shortcut-keys[17];
                                            activated => {
                                                context-menu.close();
                                                root.below-toggled();
                                            }
                                        }
                                        MenuRow {
                                            title: "Quick Draft…";
                                            shortcut: root.shortcut-keys[10];
                                            activated => {
                                                context-menu.close();
                                                root.quick-draft-requested();
                                            }
                                        }
                                        MenuSep { }
                                        MenuRow {
                                            title: "Back";
                                            shortcut: root.shortcut-keys[19];
                                            activated => {
                                                context-menu.close();
                                                root.navigate-requested(false);
                                            }
                                        }
                                        MenuRow {
                                            title: "Forward";
                                            shortcut: root.shortcut-keys[20];
                                            activated => {
                                                context-menu.close();
                                                root.navigate-requested(true);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // The vertical pane's own pointer, lying across the column
                        // the way the caret does.
                        if root.vertical && pointer.has-hover: Rectangle {
                            x: pointer.mouse-x - 8px;
                            y: pointer.mouse-y - 1px;
                            width: 16px;
                            height: 2px;
                            background: Tok.ink-strong;

                            Rectangle {
                                x: 0px;
                                y: -3px;
                                width: 2px;
                                height: 8px;
                                background: Tok.ink-strong;
                            }

                            Rectangle {
                                x: 14px;
                                y: -3px;
                                width: 2px;
                                height: 8px;
                                background: Tok.ink-strong;
                            }
                        }
                    }
                }

                // 追加要件 2026-09-07: **まだ何でもないタブの面。**中央に三つの
                // 言葉が立っているだけで、そのどれもがこのタブをそれに変える。
                // 文書は下にちゃんとあり（空の無題）、Explorerでファイルを選んでも
                // 開いた先はこのタブになる。
                //
                // スクロール面の中に置くのは、そこが「本文の場所」だから
                // ——中身が空なので視野と viewport は同じ大きさで、動かない。
                if root.empty: Rectangle {
                    x: 0;
                    y: 0;
                    width: scroll.visible-width;
                    height: scroll.visible-height;
                    background: root.page-background;

                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;

                            VerticalLayout {
                                width: 260px;
                                spacing: 2px;

                                LinkRow {
                                    title: "New File";
                                    clicked => {
                                        root.new-file-requested();
                                    }
                                }
                                LinkRow {
                                    title: "New Terminal";
                                    hint: root.terminal-shells[root.default-shell];
                                    clicked => {
                                        root.new-terminal-requested(root.default-shell);
                                    }
                                }
                                LinkRow {
                                    title: "Open File…";
                                    hint: "Ctrl+O";
                                    clicked => {
                                        root.open-file-requested();
                                    }
                                }

                                // **四つ目の道は言葉で言う。**左のExplorerで
                                // ファイルを選べばこのタブが開き先になる、という
                                // のは押せる行ではないが、知らなければ使えない。
                                Text {
                                    text: "or pick a file in the Explorer";
                                    color: Tok.ink-faint;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 追加要件 Terminal: **the strip along the foot of the pane.** A
            // shell under a document, or a draft under a shell — which one it
            // is follows from the tab in front, so the pane is told a number
            // rather than asked to work it out.
            //
            // Outside the scroll view on purpose: what is down here does not
            // move when the document above it is scrolled.
            if root.below-kind != 0: Rectangle {
                vertical-stretch: 0;
                height: 5px;
                background: divider.has-hover || divider.pressed ? Tok.rule-strong : Tok.rule;

                divider := TouchArea {
                    mouse-cursor: ns-resize;
                    // **The height is the pane's to keep**, so the drag is
                    // reported rather than applied: dragging up makes the strip
                    // taller, which is why the delta is subtracted.
                    moved => {
                        if (self.pressed) {
                            root.below-resized(root.below-height - (self.mouse-y - self.pressed-y));
                        }
                    }
                }
            }

            if root.below-kind != 0: Rectangle {
                vertical-stretch: 0;
                height: root.below-height;
                background: root.page-background;
                // **切り取らない。**Slintはキーが来るたびに「焦点の要素は
                // 見えているか」を確かめ、見えていなければ焦点を捨てる
                // （`WindowInner::process_key_input`。`is_visible()`は祖先の
                // clipまで見る）。隠し欄はカーソルの1行下に立つので、最下行では
                // この箱の外へ出る——切り取っていると、そこで**焦点ごと落ちて
                // 二度と入らない**（書き手の報告、2026-09-06）。ペインの側が
                // 切り取っていないから最下行でも打てる、というのがその証拠だった。
                //
                // 中身がはみ出す心配は無い：帯は`rows × line ≤ below-height`に
                // 収まるように作ってある。

                // The shell under a document. Drawn from the same images the
                // pane above is drawn from, and read by the same keys.
                if root.below-kind == 1: Rectangle {
                    width: parent.width;
                    height: parent.height;

                    // **The keyboard is taken one turn after this exists.**
                    // Taking it inside `init` is too early for the IME: Slint
                    // turns the conversion on when a field *takes* the focus,
                    // and a field taking it while it is being built never gets
                    // that far — the keys arrive and the conversion does not
                    // (書き手の報告, 2026-09-06). A timer of no length is one
                    // turn of the event loop, by which time the strip is a
                    // thing on screen.
                    init => {
                        grab.running = true;
                    }

                    grab := Timer {
                        interval: 1ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            below-ime.clear-focus();
                            below-ime.focus();
                        }
                    }

                    for tile in root.below-tiles: Image {
                        x: tile.x * 1px;
                        y: tile.y * 1px;
                        width: tile.width * 1px;
                        height: tile.height * 1px;
                        source: tile.source;
                        image-fit: fill;
                    }

                    // **The strip has a hidden field of its own** (書き手の
                    // 報告, 2026-09-06: 下段でIMEが起動しない). A `FocusScope`
                    // takes keys but no conversion: Windows composes into a text
                    // field, and without one there is nothing for the IME to
                    // open on. This is the pane's own arrangement, one storey
                    // down.
                    below-ime := TextInput {
                        x: root.below-caret-x * 1px;
                        y: root.below-caret-y * 1px;
                        // **A cell's worth.** Windows opens the candidate list
                        // under the area the field reports, so an area the size
                        // of one row is a list that starts below that row.
                        width: 8px;
                        height: 18px;
                        text <=> root.below-buffer;
                        font-family: "Yu Gothic UI";
                        font-size: 1px;
                        color: transparent;
                        selection-foreground-color: transparent;
                        selection-background-color: transparent;
                        text-cursor-width: 0px;
                        single-line: false;

                        // **Focused on the bump, never at `init`** (書き手の
                        // 報告, 2026-09-06: 下段で文字が入らない). Slint turns
                        // the IME on when a text field takes the focus — and a
                        // field that takes it while it is being created never
                        // gets that far, so the keys arrive and the conversion
                        // does not. The strip is opened by a bump, so the bump
                        // is enough on its own.
                        //
                        // **Let go first, then take it.** Taking focus that is
                        // already held raises nothing, and it is the raising
                        // that turns the IME on.
                        property <int> generation: root.below-focus-generation;
                        changed generation => {
                            self.clear-focus();
                            self.focus();
                        }
                        // **変換中は触らない。**この欄はシェルのカーソルに
                        // ついて動くので、出力があるたびに位置が変わる——
                        // 文書のキャレットが滅多に動かないのとはそこが違う。
                        // 位置を報告し直すたびに変換が仕切り直しになり、
                        // 打った字がどこにも入らなくなる（書き手の報告、
                        // 2026-09-06「途中で入力が出来なくなりました」）。
                        changed x => {
                            if (self.preedit-text == "") {
                                self.set-selection-offsets(0, 0);
                            }
                        }
                        changed y => {
                            if (self.preedit-text == "") {
                                self.set-selection-offsets(0, 0);
                            }
                        }
                        edited => {
                            root.below-text(self.text, self.preedit-text == "" && root.below-composing);
                            root.below-composing = false;
                        }
                        changed preedit-text => {
                            if (self.preedit-text != "") {
                                root.below-composing = true;
                            }
                            root.below-preedit(self.preedit-text);
                        }

                    key-pressed(event) => {
                        if (event.modifiers.control && event.text == "`") {
                            root.below-toggled();
                            return accept;
                        }
                        if (event.modifiers.control && event.modifiers.alt) {
                            if (event.text == Key.UpArrow) {
                                root.below-left();
                                return accept;
                            }
                            if (event.text == Key.LeftArrow) {
                                root.focus-moved(0);
                                return accept;
                            }
                            if (event.text == Key.RightArrow) {
                                root.focus-moved(1);
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                root.focus-moved(3);
                                return accept;
                            }
                        }
                        // 要件 11.2: `Ctrl+V` is left to the field, which
                        // fills itself and hands the text over as typing.
                        if (event.modifiers.control
                            && (event.text == "v" || event.text == "V")) {
                            return reject;
                        }
                        root.below-key(
                            event.text,
                            key-number(event.text),
                            event.modifiers.control,
                            event.modifiers.alt,
                            event.modifiers.shift);
                        accept
                    }
                    }

                    below-pointer := TouchArea {
                        mouse-cursor: text;
                        scroll-event(event) => {
                            root.below-scrolled(
                                event.delta-y != 0px ? event.delta-y / 1px : event.delta-x / 1px);
                            accept
                        }
                        pointer-event(event) => {
                            // 書き手の報告 2026-09-08: **下段にも右ボタンの
                            // メニューがある。**帯はペインの一段下の面で、
                            // 手がそこにあるときに右を押して何も出ないのは、
                            // 上の面と揃っていない。
                            if event.button == PointerEventButton.right
                                && event.kind == PointerEventKind.down {
                                root.below-menu-x = self.mouse-x;
                                root.below-menu-y = self.mouse-y;
                                below-menu.show();
                                return;
                            }
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                root.below-selection-start(self.mouse-x / 1px, self.mouse-y / 1px);
                            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                                root.below-selection-end(self.mouse-x / 1px, self.mouse-y / 1px);
                                // The keyboard follows the hand, as it does in
                                // the pane above — **and it is put down before
                                // it is picked up**, so that the field raises a
                                // focus event even when it already had it, and
                                // the IME is turned on again with it.
                                below-ime.clear-focus();
                                below-ime.focus();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.below-selection-update(self.mouse-x / 1px, self.mouse-y / 1px);
                            }
                        }
                    }

                    // 書き手の報告 2026-09-08: 下段のシェルの右ボタン。
                    //
                    // **この箱の中に置く**ので、原点は帯そのもの——`below-pointer`
                    // が読んだ`mouse-x`と同じ物差しになる（技術検証 6.30の3つの
                    // 罠のうち2番目と3番目を、両方この置き方で外している）。
                    // **行は、この帯にできることだけ**（要件 6.7）：升目は組み直せ
                    // ないので倍率は無く、シェルには保存するものも無い。
                    below-menu := PopupWindow {
                        x: root.below-menu-x;
                        y: root.below-menu-y;
                        width: 264px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 264px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 1px;

                                MenuRow {
                                    title: "Copy";
                                    shortcut: "Ctrl+Shift+C";
                                    activated => {
                                        below-menu.close();
                                        root.below-copy();
                                    }
                                }
                                MenuRow {
                                    title: "Paste";
                                    shortcut: "Ctrl+V";
                                    activated => {
                                        below-menu.close();
                                        // **欄が貼り、取ったものは打鍵として
                                        // 入る**——上の面と同じ道。
                                        below-ime.focus();
                                        below-ime.paste();
                                    }
                                }
                                MenuSep { }
                                MenuRow {
                                    title: "Editor Above";
                                    shortcut: "Ctrl+Alt+↑";
                                    activated => {
                                        below-menu.close();
                                        root.below-left();
                                    }
                                }
                                MenuRow {
                                    title: "Close Terminal Below";
                                    shortcut: "Ctrl+`";
                                    activated => {
                                        below-menu.close();
                                        root.below-toggled();
                                    }
                                }
                            }
                        }
                    }
                }

                // The draft under a shell (追加要件 Terminal: サブEditor).
                // **A plain field, like Quick Draft's own** — what is wanted
                // here is somewhere to compose a command, not a second copy of
                // the editor.
                if root.below-kind == 2: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    // **切り取るのはここだけ。**行数が帯の高さを越えたとき、
                    // 下書きは上へ動いて見えている外へ出る。焦点の規則
                    // （上の箱の注記）に触れないのは、欄そのものが必ず帯と
                    // 重なっているから——`is_visible`は切り取り矩形と要素の
                    // 矩形が交わるかを見る。
                    clip: true;

                    // 書き手の報告 2026-09-08: 下段の下書きにも右ボタンの
                    // メニューを。
                    //
                    // **欄を包む`TouchArea`である**（横に並べるのではなく）。
                    // Slintの`TouchArea`は`ForwardAndInterceptGrab`——中の
                    // 要素へ先に渡し、中が拾わなかったものだけを自分で受ける
                    // ——なので、左ボタンは今までどおり`TextInput`のもの
                    // （キャレット・語の選択・ドラッグの掴み）で、`TextInput`が
                    // 見ない右ボタンだけがここへ落ちてくる。横に置くと、後から
                    // 書いた要素が上に来て左ボタンごと奪ってしまう。
                    draft-pointer := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: text;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right
                                && event.kind == PointerEventKind.down {
                                root.below-menu-x = self.mouse-x;
                                root.below-menu-y = self.mouse-y;
                                draft-menu.show();
                            }
                        }

                        sheet := Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;

                            // 一行の送り。**測って出す**——行の帯は欄の行に乗って
                            // いなければ嘘になるので、二行ぶんの高さの半分を字体
                            // 自身から取る。
                            property <length> row-height: ruler-probe.preferred-height / 2;
                            // 内容をどれだけ上へ押しやっているか。欄は自分では
                            // 動かない（Slintの`TextInput`の注記）ので、キャレットを
                            // 見失わないようこちらが追う。**横は折り返すので要らない。**
                            property <length> pan-y: 0;
                            // 字を組む幅。帯も欄も同じこれで組むから、同じところで
                            // 折り返す。
                            property <length> text-width: max(sheet.width - 16px, 40px);

                            ruler-probe := Text {
                                text: "M\nM";
                                font-family: "Consolas";
                                font-size: 14px;
                                visible: false;
                            }

                            // 書き手の報告 2026-09-07: **どこまで送られるかを見せる。**
                            // 送られる行に薄い色を敷き、改行のあるところに`↵`を置く。
                            //
                            // **折り返しは残す**（書き手の指摘 2026-09-07——折り返さ
                            // ないのは使いにくい）。折り返す以上「1行＝1段」ではないので、
                            // 行の高さは**その行を同じ幅・同じ折り返しで組んだ`Text`に
                            // 訊く**。それを縦に積めば、欄が自分で折り返した段と同じ
                            // ところに帯が来る——どちらもSlintの同じ組版を通るから。
                            bands := VerticalLayout {
                                x: 8px;
                                y: 6px - sheet.pan-y;
                                width: sheet.text-width;
                                alignment: start;
                                spacing: 0px;

                                for line in root.below-draft-lines: Rectangle {
                                    // **高さを自分で言う。**帯は矩形で、矩形は中身の
                                    // 大きさを親へ伝えない（伝えるのはレイアウトだけ）
                                    // ので、書かなければ高さ0になる。書いた高さは
                                    // レイアウトが上書きしない。
                                    height: flow.preferred-height;
                                    background: line.sent ? Tok.accent-faint : transparent;

                                    flow := Text {
                                        x: 0;
                                        y: 0;
                                        width: sheet.text-width;
                                        // **空の行にも一字置く。**組む字が無ければ
                                        // 高さも0で、空行の帯だけ潰れて以降の行が
                                        // すべて上へずれる。透明なので見えない。
                                        text: line.text == "" ? " " : line.text;
                                        wrap: word-wrap;
                                        font-family: "Consolas";
                                        font-size: 14px;
                                        color: transparent;
                                    }

                                    // 改行は**罫で言う**（書き手の報告 2026-09-07・
                                    // 3回目）。字としての`¶`はあきらめた——折り返した
                                    // 行だけ印が無いのは、印が無いことより悪い。
                                    //
                                    // **どこで折り返したかを知っているのはSlintだけ**で、
                                    // こちらは行の段数しか訊けない。だから字の終わりは
                                    // 指せず、指せない場所に印を置くのもやめた。段の下の
                                    // 罫なら、折り返した行でも折り返さない行でも、
                                    // 同じ場所に同じものが出る。
                                    if line.breaks: Rectangle {
                                        x: 0;
                                        y: flow.preferred-height - 1px;
                                        width: sheet.text-width;
                                        height: 1px;
                                        background: Tok.rule;
                                    }
                                }
                            }

                            draft := TextInput {
                                x: 8px;
                                y: 6px - sheet.pan-y;
                                // **帯と同じ幅で組む。**高さは行が増えれば伸び、
                                // 溢れた分は`pan-y`が運ぶ。
                                width: sheet.text-width;
                                height: max(sheet.height - 12px,
                                    bands.preferred-height + sheet.row-height);
                                text <=> root.below-draft;
                                font-family: "Consolas";
                                font-size: 14px;
                                color: Tok.doc-ink;
                                single-line: false;
                                wrap: word-wrap;
                                edited => {
                                    root.below-draft-edited(self.text);
                                }
                                // キャレットを窓の中に留める。「見えている端から
                                // 一行ぶん内側」。
                                cursor-position-changed(at) => {
                                    if (at.y + sheet.row-height - sheet.pan-y > sheet.height - 12px) {
                                        sheet.pan-y = at.y + sheet.row-height - sheet.height + 12px;
                                    }
                                    if (at.y < sheet.pan-y) {
                                        sheet.pan-y = at.y;
                                    }
                                }

                                property <int> generation: root.below-focus-generation;
                                changed generation => {
                                    self.focus();
                                }
                                init => {
                                    self.focus();
                                }

                                key-pressed(event) => {
                                    if (event.modifiers.control && event.text == "`") {
                                        root.below-toggled();
                                        return accept;
                                    }
                                    // **Ctrl+Enter sends it.** Enter alone is a line
                                    // break: a draft is where a command is composed
                                    // over several lines before it is run.
                                    if (event.modifiers.control && event.text == Key.Return) {
                                        root.below-sent();
                                        return accept;
                                    }
                                    if (event.modifiers.control && event.modifiers.alt
                                        && event.text == Key.UpArrow) {
                                        root.below-left();
                                        return accept;
                                    }
                                    reject
                                }
                            }

                            if root.below-draft == "": Text {
                                x: 10px;
                                y: 8px;
                                text: "Ctrl+Enter で上の端末へ送ります";
                                color: Tok.ink-faint;
                                font-size: 12px;
                            }
                        }
                    }

                    // 書き手の報告 2026-09-08: 下書きの右ボタン。
                    //
                    // **この帯は編集器のほう**なので、行はシェルの帯とは別も
                    // のになる：切り取りがあり、送る行があり、倍率は無い
                    // （下書きは組版ではなく等幅の一枚である）。切り貼りは
                    // `TextInput`自身に頼む——選んでいるのがどこかを知って
                    // いるのはあの欄だけで、Rustは字を持っていない。
                    draft-menu := PopupWindow {
                        x: root.below-menu-x;
                        y: root.below-menu-y;
                        width: 264px;
                        close-policy: close-on-click-outside;

                        MenuFrame {
                            width: 264px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 1px;

                                MenuRow {
                                    title: "Cut";
                                    shortcut: "Ctrl+X";
                                    activated => {
                                        draft-menu.close();
                                        draft.focus();
                                        draft.cut();
                                    }
                                }
                                MenuRow {
                                    title: "Copy";
                                    shortcut: "Ctrl+C";
                                    activated => {
                                        draft-menu.close();
                                        draft.copy();
                                    }
                                }
                                MenuRow {
                                    title: "Paste";
                                    shortcut: "Ctrl+V";
                                    activated => {
                                        draft-menu.close();
                                        draft.focus();
                                        draft.paste();
                                    }
                                }
                                MenuRow {
                                    title: "Select All";
                                    shortcut: "Ctrl+A";
                                    activated => {
                                        draft-menu.close();
                                        draft.focus();
                                        draft.select-all();
                                    }
                                }
                                MenuSep { }
                                MenuRow {
                                    title: "Send to Terminal";
                                    shortcut: "Ctrl+Enter";
                                    activated => {
                                        draft-menu.close();
                                        root.below-sent();
                                    }
                                }
                                MenuRow {
                                    title: "Terminal Above";
                                    shortcut: "Ctrl+Alt+↑";
                                    activated => {
                                        draft-menu.close();
                                        root.below-left();
                                    }
                                }
                                MenuSep { }
                                MenuRow {
                                    title: "Close Editor Below";
                                    shortcut: "Ctrl+`";
                                    activated => {
                                        draft-menu.close();
                                        root.below-toggled();
                                    }
                                }
                            }
                        }
                    }
                }
            }

        }

            // 追加要件 2026-09-14（書き手）: **設定の面が立つ場所。**本文と同じ
            // 大きさで、中身は窓が`EditorPane`の子として渡す——設定は窓のもので、
            // 何百行もの値をペインへ通すより、場所を貸すほうが短い。何も
            // 渡されていなければ空の箱で、押しても何も受け取らない。
            Rectangle {
                width: parent.width;
                height: parent.height;
                @children
            }
        }
    }

    // 追加要件 2026-09-15: TAB・Paneの紙の色を選ぶパレット。メニューの行から開くので、
    // メニューと同じ場所に出す。
    paper-palette := PopupWindow {
        x: min(root.paper-x, root.width - 240px);
        y: root.paper-y;
        width: 236px;
        close-policy: close-on-click-outside;

        MenuFrame {
            width: 236px;

            ColourPalette {
                automatic: "既定の色";
                current: root.page-background;
                chosen(colour) => {
                    root.paper-chosen(root.paper-target, colour);
                    paper-palette.close();
                }
                automatic-chosen => {
                    root.paper-default(root.paper-target);
                    paper-palette.close();
                }
                more => {
                    root.paper-more(root.paper-target);
                    paper-palette.close();
                }
            }
        }
    }

    // 追加要件 2026-09-06: **the right button on a tab.** Every row acts on the
    // tab in front, and the press that opened this made that tab the one in
    // front — so the menu says nothing about which tab it is about, because
    // there is only ever one it could be.
    tab-menu := PopupWindow {
        x: root.tab-menu-x;
        y: root.tab-menu-y;
        width: 264px;
        close-policy: close-on-click-outside;

        MenuFrame {
            width: 264px;

            VerticalLayout {
                padding: 6px;
                spacing: 1px;

                MenuRow {
                    title: "Close";
                    shortcut: root.shortcut-keys[3];
                    activated => {
                        tab-menu.close();
                        root.close-active-tab();
                    }
                }
                MenuRow {
                    title: "Close Others";
                    activated => {
                        tab-menu.close();
                        root.close-other-tabs();
                    }
                }
                MenuRow {
                    title: "Close Clean";
                    activated => {
                        tab-menu.close();
                        root.close-clean-tabs();
                    }
                }
                // 追加要件 2026-09-15: このTABの色。TABが残っている限り付いている。
                if root.writing: VerticalLayout {
                    spacing: 1px;

                    MenuSep { }

                    // 追加要件 2026-09-15（書き手）: TABの右クリックはTABの色。背景はPaperの右クリックから。
                    MenuRow {
                        title: "Tab Color…";
                        activated => {
                            root.open-paper-palette(2, root.tab-menu-x, root.tab-menu-y);
                            tab-menu.close();
                        }
                    }
                }
                // 追加要件 2026-09-07: **端末のタブにはもう一群ある。**長押しでも
                // 出るが、そちらは押し続ける手つきに慣れが要る——右ボタンは
                // この窓のどのメニューとも同じに開く。
                //
                // `if`の中に`for`を置くのは書ける（逆は書けない——`for`の本体に
                // `if`は置けない、ペイン分割設計2b）。
                // **`root.terminal`で訊く。**このメニューが効くのは前に出ている
                // タブで、`terminal`はまさに「前に出ているタブはシェルか」を
                // 言う旗である（`Terminal Below`の行がずっとこれで文言を変えて
                // いる）。一覧の行から数え直すより、窓が直に置いたものを読む。
                if root.terminal: VerticalLayout {
                    spacing: 1px;

                    MenuSep { }

                    for shell[index] in root.terminal-shells: MenuRow {
                        title: "Switch to " + shell;
                        // **頼んでから閉じる。**`close`はこのメニューの木を捨てる
                        // ——そこにはこの行自身と、行を包む`for`と`if`が入っている。
                        // 捨てられた木の中から`root`へ登ろうとすると、生成された
                        // コードは`parent.upgrade()`に失敗して**黙って何もしない**
                        // （書き手の報告 2026-09-07：切り替えが動かない。ログには
                        // 届いた形跡が1行も無かった）。浅い行が同じ書き方で
                        // 動いていたのは、登る段数が少ないからにすぎない。
                        activated => {
                            root.tab-shell-chosen(index);
                            tab-menu.close();
                        }
                    }
                }

                // 要件 7.9（2026-09-08、書き手の報告）: **このタブの単語チェック
                // モード。**モードは文書ごとのものなので、**そのタブのメニューに
                // 在るのがいちばん素直**である——ステータスバーだけに置いて
                // いたときは、どのタブに効くのかが画面から読めなかった。
                // 端末のタブには本文が無いので出さない。
                if root.writing && root.word-modes.length > 1: VerticalLayout {
                    spacing: 1px;

                    MenuSep { }

                    for row in root.word-modes: MenuRow {
                        title: "モード：" + row.name;
                        checked: row.id == root.word-mode;
                        // **頼んでから閉じる**（技術検証 6.24）。
                        activated => {
                            root.word-mode-chosen(row.id);
                            tab-menu.close();
                        }
                    }
                }

                // 追加要件 2026-09-07: **シェルには名前も道も無く、保存する
                // ものも無い**（書き手の指摘）。文書のタブだけが持つ4行は、
                // 端末のタブでは出さない——押せる行が何もしないより、
                // 無いほうがよい。
                //
                // 追加要件 2026-09-08: **名前と道はさらに、ディスクの上に
                // 何かあるタブだけのもの。**`Rename`はタブの`renamable`が
                // 立っていなければ黙って何もしない（`controls.slint`の
                // `changed rename-asked`）——長押しが何も起こさないのと同じ
                // 理由で、右ボタンからも消える。無題の文書は`Save`で名前を
                // もらう側なので、そちらの2行は残る。
                if root.writing && root.tabs[root.tab-menu-target].renamable:
                VerticalLayout {
                    spacing: 1px;

                    MenuSep { }

                    MenuRow {
                        title: "Rename";
                        activated => {
                            // **The count is bumped after the menu is closed**,
                            // so the field that appears takes the keyboard from
                            // a menu that has already let go of it. 頼むほうを
                            // 先に書けないのはこの1行だけで、`rename-token`は
                            // 木を降りずに読める`root`の値だから届く。
                            root.rename-token += 1;
                            tab-menu.close();
                        }
                    }
                    MenuRow {
                        title: "同じ文書を別TABで開く";
                        activated => {
                            root.duplicate-tab-requested(root.tab-menu-target);
                            tab-menu.close();
                        }
                    }
                    MenuRow {
                        title: "Copy Path";
                        activated => {
                            root.copy-path-requested(root.tab-menu-target);
                            tab-menu.close();
                        }
                    }
                }

                if root.writing: VerticalLayout {
                    spacing: 1px;

                    MenuSep { }

                    MenuRow {
                        title: "Save";
                        shortcut: root.shortcut-keys[1];
                        activated => {
                            root.save-requested();
                            tab-menu.close();
                        }
                    }
                    MenuRow {
                        title: "Save As…";
                        shortcut: root.shortcut-keys[2];
                        activated => {
                            root.save-as-requested();
                            tab-menu.close();
                        }
                    }
                }
            }
        }
    }

    // 追加要件 2026-09-06: **the right button on the band beside the tabs.**
    // What is asked for there is a tab, not a tab's business — so the rows are
    // the ones that make one, and the ones that take them away.
    strip-menu := PopupWindow {
        x: root.strip-menu-x;
        y: root.strip-menu-y;
        width: 264px;
        close-policy: close-on-click-outside;

        MenuFrame {
            width: 264px;

            VerticalLayout {
                padding: 6px;
                spacing: 1px;

                // 追加要件 2026-09-07: **ここは答えを直に選ぶ場所**なので、
                // New Tab を作って訊き直したりはしない。前に出ているタブが
                // まだ何でもないなら、そのタブがそれになる。
                MenuRow {
                    title: "New File";
                    activated => {
                        strip-menu.close();
                        root.new-file-requested();
                    }
                }
                MenuRow {
                    title: "New Tab";
                    activated => {
                        strip-menu.close();
                        root.new-tab-requested();
                    }
                }
                MenuRow {
                    title: "New Terminal";
                    shortcut: root.terminal-shells[root.default-shell];
                    activated => {
                        strip-menu.close();
                        root.new-terminal-requested(root.default-shell);
                    }
                }

                MenuRow {
                    title: "Open File…";
                    shortcut: root.shortcut-keys[0];
                    activated => {
                        strip-menu.close();
                        root.open-file-requested();
                    }
                }
                MenuSep { }
                MenuRow {
                    title: "Close";
                    shortcut: root.shortcut-keys[3];
                    activated => {
                        strip-menu.close();
                        root.close-active-tab();
                    }
                }
                MenuRow {
                    title: "Close All";
                    activated => {
                        strip-menu.close();
                        root.close-all-tabs();
                    }
                }
                MenuRow {
                    title: "Close Clean";
                    activated => {
                        strip-menu.close();
                        root.close-clean-tabs();
                    }
                }
            }
        }
    }

}
