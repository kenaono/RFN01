import { Tok } from "tokens.slint";
import { MenuFrame, MenuRow, Role, TextButton } from "controls.slint";

// 要件 12: the quick draft.
//
// **A window for text that is going somewhere else.** What it is for is written
// in 要件 12.1: a message bound for a chat box, written where `Enter` cannot
// send it by accident. So `Enter` is a newline and nothing here sends anything;
// the way out is the clipboard.
//
// **Plain text, and Slint's own editing.** The main window's panes exist
// because Markdown has to be laid out two ways (要件 7.2); a draft has none of
// that, and the built-in `TextInput` already carries the cursor, the selection,
// undo, cut, copy, paste and select-all that 要件 12.2 asks for. Writing a
// second editor for this would be writing one to be worse.
export component QuickDraft inherits Window {
    title: "Quick Draft";
    // preferred-*, not width/height, for the reason the main window gives: a
    // Window given a width is a Window the writer cannot resize.
    preferred-width: 690px;
    preferred-height: 340px;
    min-width: 280px;
    min-height: 200px;
    background: Tok.chrome;
    always-on-top <=> root.on-top;

    in-out property <string> text <=> input.text;
    in-out property <bool> on-top: false;
    /// What just happened, shown small and taken away again by whoever set it
    /// (要件 12.3: "非侵襲的な表示").
    in property <string> notice;
    /// Where the caret is, so the next run opens where this one was left
    /// (要件 12.4).
    out property <int> caret <=> input.cursor-position-byte-offset;

    /// The drafts kept behind this one, newest first — a line each, for the
    /// list to show (要件 12.4).
    in property <[string]> history;
    /// The tabs the draft may be sent to, and which of them the editor is in.
    /// **Filled when the list is opened**, not held: a tab may have been opened
    /// or closed since the window was.
    in property <[string]> tabs;
    in property <int> tab-current: -1;
    /// What the send button says, which is the name of the tab a click sends
    /// to (要件 12.4).
    in property <string> target-name: "Paste to tab";

    /// One row of the tab list, and how tall the list is.
    ///
    /// **The rows know which of them the pointer is over.** The list is a popup
    /// and a popup takes the pointer when it opens, so the button's press ends
    /// there and the rows are hovered and clicked as they would be at any other
    /// time — releasing over one is a click on it. An earlier version worked
    /// the row out from the pointer's position instead, on the belief that the
    /// button kept the grab; it did not, and what that arithmetic lit up was a
    /// row nobody was pointing at.
    property <length> row-height: 29px;
    property <length> menu-height: root.tabs.length * root.row-height + 12px;
    /// Where the list sits above the button, in the button's own coordinates.
    property <length> menu-top: -6px - root.menu-height;

    callback edited();
    callback copied();
    callback copy-and-close();
    callback clear-requested();
    /// Put the draft into one of the editor's tabs, by its place in `tabs`, and
    /// let the window clear itself: the text has gone where it was going.
    callback paste-to-tab-requested(int);
    /// Asked just before the list is shown, so that what it lists is what is
    /// open now.
    callback tabs-requested();
    /// A plain click on the send button: the tab it names, if that tab is still
    /// open. **The editor answers that** — it is the one that knows — and asks
    /// for the list instead when it is not.
    callback send-requested();

    /// Show the tab list, for the editor to call when a click had nowhere to go.
    public function show-tabs() {
        tabs-menu.show();
    }
    /// Bring one of the kept drafts back, by its place in the list.
    callback history-picked(int);

    /// 要件 12.3: the whole draft, whatever is selected.
    ///
    /// **The selection is put back afterwards.** Copying is not an edit and
    /// must not look like one; a caret that jumped to the end would be the
    /// writer's place lost to a button.
    public function copy-all() {
        input.select-all();
        input.copy();
        input.set-selection-offsets(root.caret, root.caret);
        root.copied();
    }

    public function take-focus() {
        input.focus();
    }

    /// Put the caret back where the last run left it (要件 12.4).
    public function set-caret(at: int) {
        input.set-selection-offsets(at, at);
    }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // The paper the draft is written on, which is the document's paper
        // rather than the chrome's: this is text being written, not a field
        // being filled in.
        Rectangle {
            background: Tok.paper;
            border-radius: 6px;
            border-width: 1px;
            border-color: input.has-focus ? Tok.accent : Tok.rule;
            clip: true;

            // **The enclosing element scrolls the text**, which is what
            // `cursor-position-changed` is for: `TextInput` reports where the
            // cursor went and expects whoever holds it to bring it into view.
            paper := Flickable {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                viewport-width: self.width;
                viewport-height: max(input.preferred-height, self.height);
                interactive: true;

                input := TextInput {
                    width: parent.width;
                    height: max(self.preferred-height, paper.height);
                    font-size: 14px;
                    color: Tok.doc-ink;
                    selection-background-color: Tok.accent-soft;
                    selection-foreground-color: Tok.ink-strong;
                    // 要件 12.2: horizontal plain text, and `Enter` is always a
                    // newline. Both are this one line.
                    single-line: false;
                    wrap: word-wrap;

                    edited => {
                        root.edited();
                    }
                    cursor-position-changed(position) => {
                        // Keep the caret on screen, top and bottom alike. The
                        // viewport's y is negative as it scrolls down, which is
                        // why the two comparisons look the way they do.
                        if (position.y + 24px > -paper.viewport-y + paper.height) {
                            paper.viewport-y = paper.height - position.y - 24px;
                        }
                        if (position.y < -paper.viewport-y) {
                            paper.viewport-y = -position.y;
                        }
                    }
                    key-pressed(event) => {
                        // 要件 12.3: the whole draft, without selecting it by
                        // hand. `Ctrl+C` is the selection and is Slint's own.
                        if (event.text == "C" && event.modifiers.control && event.modifiers.shift) {
                            root.copy-all();
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            // 要件 12.2: "常に手前に表示" — a switch rather than a menu item,
            // because it is the one thing about this window a writer changes
            // while looking at it.
            Rectangle {
                height: 28px;
                width: pin-label.preferred-width + 40px;
                border-radius: 5px;
                border-width: 1px;
                border-color: root.on-top ? Tok.accent : Tok.rule-strong;
                background: root.on-top ? Tok.accent-faint : transparent;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        y: (parent.height - 12px) / 2;
                        width: 12px;
                        height: 12px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.on-top ? Tok.accent : Tok.rule-strong;
                        background: root.on-top ? Tok.accent : Tok.paper;
                    }

                    pin-label := Text {
                        text: "On top";
                        color: root.on-top ? Tok.accent-strong : Tok.ink-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => {
                        root.on-top = !root.on-top;
                    }
                }
            }

            Text {
                text: root.notice;
                color: Tok.ink-muted;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
                // Takes the room left over, so the buttons stay where they are
                // whatever it says.
                horizontal-stretch: 1;
            }

            // 要件 12.4: the drafts that have been sent and cleared.
            //
            // **Opened upward**, because this row is at the foot of the window.
            // The height is worked out from the number of rows rather than read
            // back off the popup, which would be a binding loop.
            HorizontalLayout {
                history-button := TextButton {
                    title: "History";
                    enabled: root.history.length > 0;
                    clicked => {
                        history-menu.show();
                    }
                }

                history-menu := PopupWindow {
                    property <length> rows-height: root.history.length * 29px + 12px;
                    x: 0;
                    y: -6px - self.rows-height;
                    width: 320px;
                    height: self.rows-height;
                    close-policy: close-on-click-outside;

                    MenuFrame {
                        width: 320px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;

                            for kept[index] in root.history: MenuRow {
                                title: kept;
                                activated => {
                                    history-menu.close();
                                    root.history-picked(index);
                                }
                            }
                        }
                    }
                }
            }

            TextButton {
                title: "Clear";
                role: Role.danger;
                enabled: root.text != "";
                clicked => {
                    root.clear-requested();
                }
            }

            // 要件 12.4: the one button the draft leaves by.
            //
            // **A click sends it where it went last time; holding says where
            // else.** The name on it is the tab it would go to, so the common
            // act — send it to the same place again — is one click that needs
            // no reading. The list is for changing one's mind, and a writer who
            // has to change it every time would rather see the list, which is
            // why the button opens it when its tab is gone.
            HorizontalLayout {
                send := Rectangle {
                    height: 28px;
                    // **Both ends, and the same expression.** A `min-width`
                    // the layout may shrink past is a button squeezed down to
                    // nothing by whatever else is in the row — which is what
                    // happened with a floor of 44px and the notice beside it
                    // taking the slack (6.23). Pinned like `TextButton`, and
                    // free between the two ends: a file name is as long as it
                    // likes, so it grows to a point and elides after it.
                    min-width: clamp(send-label.preferred-width + 22px, 96px, 260px);
                    max-width: clamp(send-label.preferred-width + 22px, 96px, 260px);
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: root.text == "" ? Tok.rule : Tok.accent;
                    background: root.text == ""
                        ? transparent
                        : (send-touch.pressed
                            ? Tok.accent-soft
                            : (send-touch.has-hover ? Tok.accent-faint : transparent));

                    send-label := Text {
                        x: 11px;
                        width: parent.width - 22px;
                        height: parent.height;
                        text: root.target-name;
                        color: root.text == "" ? Tok.ink-faint : Tok.accent-strong;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    send-touch := TouchArea {
                        enabled: root.text != "";
                        pointer-event(event) => {
                            if (event.kind != PointerEventKind.up) {
                                return;
                            }
                            // **The grab is this button's**, so the pointer is
                            // still ours wherever it went — which is what lets
                            // the row be read off `mouse-y` (`aiming`).
                            // **Only a release that is still this button's.**
                            // Once the list is up it has the pointer, and the
                            // row under it answers for itself.
                            if (!tabs-menu.is-open) {
                                root.send-requested();
                            }
                        }
                    }

                    // Holding is what asks for the list. **Not a click** — a
                    // click is the answer the writer already gave.
                    Timer {
                        interval: 300ms;
                        running: send-touch.pressed && !tabs-menu.is-open;
                        triggered => {
                            root.tabs-requested();
                            tabs-menu.show();
                        }
                    }
                }

                tabs-menu := PopupWindow {
                    x: 0;
                    y: root.menu-top;
                    width: 320px;
                    height: root.menu-height;
                    close-policy: close-on-click-outside;

                    MenuFrame {
                        width: 320px;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;

                            for tab[index] in root.tabs: MenuRow {
                                title: tab;
                                // The mark says where the editor is; the row
                                // under the pointer lights itself.
                                checked: index == root.tab-current;
                                activated => {
                                    root.paste-to-tab-requested(index);
                                    tabs-menu.close();
                                }
                            }
                        }
                    }
                }
            }

            TextButton {
                title: "Copy & close";
                enabled: root.text != "";
                clicked => {
                    root.copy-all();
                    root.copy-and-close();
                }
            }

            TextButton {
                title: "Copy all";
                role: Role.primary;
                enabled: root.text != "";
                clicked => {
                    root.copy-all();
                }
            }
        }
    }
}
